+use super::*;
+use crate::{
+    domain::{ToolCall, ToolContent, ToolResult},
+    model_standard::{CanonicalMessage, ContentPart, MessageRole},
+};
+use serde_json::json;
+
+#[tokio::test]
+async fn root_tool_text_matches_live_reconnect_and_completed_projection() {
+    let long = "x".repeat(10_000) + "я FINAL_DIAGNOSTIC";
+    let mut failure = ToolResult::error("call".into(), long.clone());
+    failure.output = "lower-priority output".into();
+    for result in [
+        ToolResult::ok("call".into(), "short control"),
+        ToolResult::ok("call".into(), long.clone()),
+        failure,
+        ToolResult::ok("call".into(), "").with_content(vec![ToolContent::Text {
+            text: long.clone(),
+        }]),
+        ToolResult::ok("call".into(), "").with_content(vec![ToolContent::Json {
+            value: json!({"detail": long}),
+        }]),
+        ToolResult::ok("call".into(), ""),
+    ] {
+        let result = result.with_metadata(json!({"source": "projection-test"}));
+        let expected = result.text_or_status();
+        let call = ToolCall::new("call", "probe", json!({"input": "synthetic"}));
+        let (events, _) = test_event_channel(8);
+        let sink = RuntimeEventSink::default();
+        assert!(sink.0.set(events.clone()).is_ok());
+        let context = EventContext::new(
+            events.pending_snapshot().session_id,
+            new_thread_id(),
+            Some(new_turn_id()),
+        );
+        let mut live = events.subscribe_session();
+        assert!(matches!(
+            live.recv().await.unwrap(),
+            AppServerEvent::PendingRequestsUpdated { .. }
+        ));
+        assert!(matches!(
+            live.recv().await.unwrap(),
+            AppServerEvent::SessionSnapshot { .. }
+        ));
+        for (index, event) in [
+            Event::TurnStarted {
+                session_id: context.session_id,
+                thread_id: context.thread_id,
+                turn_id: context.turn_id.unwrap(),
+            },
+            Event::ToolCallRequested { call: call.clone() },
+            Event::ToolFinished { result: result.clone() },
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            sink.append(EventEnvelope::new(context.clone(), index as u64 + 1, event))
+                .await
+                .unwrap();
+            let AppServerEvent::Runtime { envelope } = live.recv().await.unwrap() else {
+                panic!("live runtime event")
+            };
+            if let Event::ToolFinished { result: delivered } = envelope.event {
+                assert_eq!(delivered, result);
+            }
+        }
+
+        let mut reopened = events.subscribe_session();
+        assert!(matches!(
+            reopened.recv().await.unwrap(),
+            AppServerEvent::PendingRequestsUpdated { .. }
+        ));
+        let AppServerEvent::SessionSnapshot { snapshot } = reopened.recv().await.unwrap() else {
+            panic!("reconnect snapshot")
+        };
+        assert_eq!(snapshot.transcript.len(), 1);
+        let tool = snapshot.transcript[0].tool.as_ref().unwrap();
+        assert_eq!(tool.result.as_deref(), Some(expected.as_str()));
+        assert_eq!(tool.metadata, result.metadata);
+        assert_eq!(tool.status, if result.ok { "done" } else { "failed" });
+
+        let completed = crate::app_server::transcript_messages(&[
+            CanonicalMessage::new(MessageRole::Assistant, vec![ContentPart::ToolCall { call }]),
+            CanonicalMessage::new(MessageRole::Tool, vec![ContentPart::ToolResult { result }]),
+        ]);
+        let expected_tool = serde_json::to_value(tool).unwrap();
+        assert_eq!(serde_json::to_value(&completed[0].tool).unwrap(), expected_tool);
+        events.finish_progress(Ok(completed.into()));
+        let settled = events.session_snapshot().unwrap();
+        assert_eq!(settled.transcript.len(), 1);
+        assert_eq!(serde_json::to_value(&settled.transcript[0].tool).unwrap(), expected_tool);
+    }
+}

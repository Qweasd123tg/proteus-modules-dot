+use super::*;
+
+#[test]
+fn child_result_preview_is_independent_of_background_json_compaction() {
+    for background in [false, true] {
+        let mut progress = TurnProgress::default();
+        let child = child_thread_id();
+        if background {
+            apply(
+                &mut progress,
+                Event::ToolCallRequested {
+                    call: ToolCall::new("spawn", "spawn_agent", json!({"task_name": "scan"})),
+                },
+            );
+        }
+        apply(
+            &mut progress,
+            Event::SubagentStarted {
+                role: "helper".into(),
+                description: Some("scan".into()),
+                child_thread_id: child,
+            },
+        );
+        let args = json!({"input": "x".repeat(MAX_BACKGROUND_TOOL_JSON_BYTES + 1)});
+        let metadata = json!({"detail": "y".repeat(MAX_BACKGROUND_TOOL_JSON_BYTES + 1)});
+        let long = "a".repeat(MAX_SUBAGENT_TOOL_RESULT_BYTES - 1) + &"я".repeat(100_000);
+        progress.apply(&envelope(
+            child,
+            Event::ToolCallRequested {
+                call: ToolCall::new("child-tool", "probe", args.clone()),
+            },
+        ));
+        progress.apply(&envelope(
+            child,
+            Event::ToolFinished {
+                result: ToolResult::ok("child-tool".into(), long.clone())
+                    .with_metadata(metadata.clone()),
+            },
+        ));
+        let rows = if background {
+            &progress.background_subagents
+        } else {
+            &progress.messages
+        };
+        let tool = &rows[0].subagent.as_ref().unwrap().tools[0];
+        let retained = tool.result.as_ref().unwrap();
+        assert_eq!(retained, &long[..MAX_SUBAGENT_TOOL_RESULT_BYTES - 1]);
+        assert!(retained.capacity() < long.len());
+        assert_eq!(tool.status, "done");
+        if background {
+            assert_eq!(tool.args["truncated"], true);
+            assert_eq!(tool.metadata["truncated"], true);
+        } else {
+            assert_eq!(tool.args, args);
+            assert_eq!(tool.metadata, metadata);
+        }
+    }
+}

@@ -0,0 +1,115 @@
+use super::*;
+
+#[derive(Default)]
+struct NavigationProbe {
+    rendered: Vec<(String, Option<Value>, Vec<String>)>,
+}
+
+impl Extension for NavigationProbe {
+    fn render(&mut self, host: &mut Host, view: &str, _: Surface, _: Option<&str>) -> Result {
+        self.rendered.push((
+            view.into(),
+            host.active_document.clone(),
+            host.active_pane_documents.clone(),
+        ));
+        Ok(())
+    }
+}
+
+fn context(host: &mut Host, extension: &mut NavigationProbe, id: &str) {
+    host.handle(extension, json!({"type":"context", "context":id,
+        "workspace":"/fixture/project", "session_dir":"/fixture/session"})).unwrap();
+}
+
+fn navigation(host: &mut Host, extension: &mut NavigationProbe, id: &str,
+    focused: Option<&str>, documents: &[&str]) {
+    host.handle(extension, json!({"type":"event", "context":id,
+        "event":"navigation_changed", "session_dir":"/fixture/session",
+        "document":focused, "active_pane_documents":documents})).unwrap();
+}
+
+fn render(host: &mut Host, extension: &mut NavigationProbe, context: &str, view: &str) {
+    host.handle(extension, json!({"type":"render", "context":context,
+        "view":view, "surface":"document", "argument":"fixture.rs",
+        "session_dir":"/fixture/session"})).unwrap();
+}
+
+#[test]
+fn bootstrap_list_is_available_before_first_render_independently_of_focus() {
+    let (mut host, mut extension) = (Host::default(), NavigationProbe::default());
+    context(&mut host, &mut extension, "window");
+    navigation(&mut host, &mut extension, "window", None, &["left.rs", "right.rs"]);
+    assert!(extension.rendered.is_empty());
+    render(&mut host, &mut extension, "window", "first");
+    assert_eq!(extension.rendered, vec![
+        ("first".into(), None, vec!["left.rs".into(), "right.rs".into()]),
+    ]);
+}
+
+#[test]
+fn contexts_in_one_session_keep_independent_lists_during_poll_style_renders() {
+    let (mut host, mut extension) = (Host::default(), NavigationProbe::default());
+    for (id, focused, documents) in [
+        ("a", Some("a.rs"), vec!["a.rs", "a2.rs"]),
+        ("b", None, vec!["b.rs"]),
+    ] {
+        context(&mut host, &mut extension, id);
+        navigation(&mut host, &mut extension, id, focused, &documents);
+        render(&mut host, &mut extension, id, id);
+    }
+    extension.rendered.clear();
+    host.render_every_context(&mut extension);
+    assert_eq!(extension.rendered, vec![
+        ("a".into(), Some(json!("a.rs")), vec!["a.rs".into(), "a2.rs".into()]),
+        ("b".into(), None, vec!["b.rs".into()]),
+    ]);
+}
+
+#[test]
+fn replacement_empty_and_absent_lists_do_not_fall_back_to_focused_document() {
+    let (mut host, mut extension) = (Host::default(), NavigationProbe::default());
+    context(&mut host, &mut extension, "window");
+    navigation(&mut host, &mut extension, "window", Some("a.rs"), &["a.rs", "b.rs"]);
+    navigation(&mut host, &mut extension, "window", Some("a.rs"), &[]);
+    assert!(host.active_pane_documents.is_empty());
+    assert_eq!(host.active_document, Some(json!("a.rs")));
+    navigation(&mut host, &mut extension, "window", Some("b.rs"), &["b.rs"]);
+    host.handle(&mut extension, json!({"type":"event", "context":"window",
+        "event":"navigation_changed", "document":"b.rs"})).unwrap();
+    assert!(host.active_pane_documents.is_empty());
+    assert_eq!(host.active_document, Some(json!("b.rs")));
+}
+
+#[test]
+fn rehost_and_close_do_not_inherit_another_contexts_list() {
+    let (mut host, mut extension) = (Host::default(), NavigationProbe::default());
+    context(&mut host, &mut extension, "source");
+    navigation(&mut host, &mut extension, "source", Some("source.rs"), &["source.rs"]);
+    render(&mut host, &mut extension, "source", "moving");
+    context(&mut host, &mut extension, "target");
+    navigation(&mut host, &mut extension, "target", None, &["target.rs"]);
+    host.handle(&mut extension, json!({"type":"rehost", "view":"moving",
+        "context":"target"})).unwrap();
+    host.handle(&mut extension, json!({"type":"close_context", "context":"source"})).unwrap();
+    extension.rendered.clear();
+    host.render_every_context(&mut extension);
+    assert_eq!(extension.rendered, vec![
+        ("moving".into(), None, vec!["target.rs".into()]),
+    ]);
+    host.handle(&mut extension, json!({"type":"close", "view":"moving"})).unwrap();
+    host.handle(&mut extension, json!({"type":"close_context", "context":"target"})).unwrap();
+    assert!(host.active_pane_documents.is_empty());
+    context(&mut host, &mut extension, "fresh");
+    assert!(host.active_pane_documents.is_empty());
+}
+
+#[test]
+fn new_context_starts_empty_until_its_own_navigation_arrives() {
+    let (mut host, mut extension) = (Host::default(), NavigationProbe::default());
+    context(&mut host, &mut extension, "a");
+    navigation(&mut host, &mut extension, "a", Some("a.rs"), &["a.rs"]);
+    context(&mut host, &mut extension, "b");
+    assert!(host.active_pane_documents.is_empty());
+    host.activate_context("a");
+    assert_eq!(host.active_pane_documents, ["a.rs"]);
+}

+/// One logical layout sample. Settings/occlusion do not change this projection.
+#[derive(Default)]
+pub(in crate::ui) struct DocumentNavigation {
+    pub(in crate::ui) focused: Option<String>,
+    pub(in crate::ui) active_panes: Vec<String>,
+}
+
+impl DocumentNavigation {
+    fn for_layout(layout: &crate::tabs::TabLayout, extension: &str) -> Self {
+        let argument = |id: &str| {
+            crate::tabs::split_document(id)
+                .filter(|(owner, _)| *owner == extension)
+                .map(|(_, argument)| argument.to_owned())
+        };
+        Self {
+            focused: layout.active(layout.focused).and_then(|id| argument(id)),
+            active_panes: layout.visible().filter_map(argument).collect(),
+        }
+    }
+}

+use super::DocumentNavigation;
+use crate::tabs::{self, Edge, TabLayout};
+
+fn split_documents() -> (TabLayout, String, String, String) {
+    let (left, right, hidden) = (
+        tabs::document("files", "left.rs"),
+        tabs::document("files", "right.rs"),
+        tabs::document("files", "hidden.rs"),
+    );
+    let mut layout = TabLayout::default();
+    for id in [&left, &hidden, &right] {
+        layout.open(id, |_| false);
+    }
+    let pane = layout.focused;
+    layout.split(&right, pane, Edge::Right);
+    layout.activate(pane, &left);
+    (layout, left, right, hidden)
+}
+
+#[test]
+fn every_active_document_pane_is_projected_without_hidden_tabs() {
+    let (layout, _, _, hidden) = split_documents();
+    assert!(layout.contains(&hidden));
+    let navigation = DocumentNavigation::for_layout(&layout, "files");
+    assert_eq!(navigation.focused.as_deref(), Some("left.rs"));
+    assert_eq!(navigation.active_panes, ["left.rs", "right.rs"]);
+}
+
+#[test]
+fn focus_changes_do_not_remove_other_active_panes_and_close_removes_its_argument() {
+    let (mut layout, left, right, _) = split_documents();
+    layout.focus(layout.pane_of(&right).unwrap());
+    let navigation = DocumentNavigation::for_layout(&layout, "files");
+    assert_eq!(navigation.focused.as_deref(), Some("right.rs"));
+    assert_eq!(navigation.active_panes, ["left.rs", "right.rs"]);
+    layout.close(&right);
+    layout.activate(layout.pane_of(&left).unwrap(), &left);
+    let navigation = DocumentNavigation::for_layout(&layout, "files");
+    assert_eq!(navigation.focused.as_deref(), Some("left.rs"));
+    assert_eq!(navigation.active_panes, ["left.rs"]);
+}
+
+#[test]
+fn a_focused_chat_or_other_extension_does_not_hide_an_owned_sibling() {
+    for other in ["codex:fixture".to_owned(), tabs::document("git", "diff")] {
+        let (mut layout, _, _, _) = split_documents();
+        layout.open(&other, |_| false);
+        let navigation = DocumentNavigation::for_layout(&layout, "files");
+        assert_eq!(navigation.focused, None);
+        assert_eq!(navigation.active_panes, ["right.rs"]);
+        assert!(DocumentNavigation::for_layout(&layout, "absent").active_panes.is_empty());
+    }
+}
+
+#[test]
+fn empty_layout_has_no_document_projection() {
+    let navigation = DocumentNavigation::for_layout(&TabLayout::default(), "files");
+    assert_eq!(navigation.focused, None);
+    assert!(navigation.active_panes.is_empty());
+}

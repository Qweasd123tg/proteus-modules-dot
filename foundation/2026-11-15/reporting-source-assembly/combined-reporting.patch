+                            'assert sys.modules[__name__].__dict__ is globals()\nraise error\n')
+                        with self.assertRaises(type(error)) as caught:
+                            scope['archiver']()
+                        self.assertIs(caught.exception, error)
+                        self.assertNotIn('archive_under_test', sys.modules)

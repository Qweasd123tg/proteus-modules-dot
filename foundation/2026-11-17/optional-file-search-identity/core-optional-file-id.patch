diff --git a/crates/proteus-contracts/tests/file_search_result.rs b/crates/proteus-contracts/tests/file_search_result.rs
new file mode 100644
index 0000000..155f393
--- /dev/null
+++ b/crates/proteus-contracts/tests/file_search_result.rs
@@ -0,0 +1,85 @@
+//! The file identity is optional result metadata, not the hosted activity ID.
+use proteus_contracts::{
+    domain::{FileSearchResult, HostedToolActivity, HostedToolStatus},
+    model_standard::{
+        CanonicalMessage, CanonicalModelResponse, ContentPart, FinishReason, MessageRole,
+    },
+};
+use serde_json::{Value, json};
+
+fn result() -> Value {
+    json!({
+        "filename": "architecture.md", "score": 0.9, "text": "Core owns DTOs.",
+        "attributes": {"kind": "design"},
+    })
+}
+
+#[test]
+fn known_file_identity_keeps_existing_canonical_json() {
+    for id in ["file-1", ""] {
+        let mut raw = result();
+        raw["file_id"] = json!(id);
+        let decoded: FileSearchResult = serde_json::from_value(raw.clone()).unwrap();
+        assert_eq!(serde_json::to_value(decoded).unwrap(), raw);
+    }
+}
+
+#[test]
+fn optional_file_identity_survives_canonical_response_round_trip() {
+    for id in [None, Some(Value::Null)] {
+        let mut raw = result();
+        if let Some(id) = id {
+            raw["file_id"] = id;
+        }
+        let activity: HostedToolActivity = serde_json::from_value(json!({
+            "kind": "file_search", "id": "search-1", "status": HostedToolStatus::Completed,
+            "queries": ["architecture"], "results": [raw],
+        }))
+        .expect("a result may lack its own file identity");
+        let response = CanonicalModelResponse::from_messages(
+            vec![CanonicalMessage::new(
+                MessageRole::Assistant,
+                vec![
+                    ContentPart::HostedToolActivity { activity },
+                    ContentPart::Text {
+                        text: "Answer remains available.".to_owned(),
+                    },
+                ],
+            )],
+            vec![],
+            FinishReason::Stop,
+        );
+        let encoded = serde_json::to_string(&response).unwrap();
+        let restored: CanonicalModelResponse = serde_json::from_str(&encoded).unwrap();
+        assert_eq!(restored, response);
+        let ContentPart::HostedToolActivity { activity } = &restored.messages[0].parts[0].payload
+        else {
+            panic!("hosted activity missing");
+        };
+        let activity = serde_json::to_value(activity).unwrap();
+        assert_eq!(activity["id"], "search-1");
+        assert!(activity["results"][0].get("file_id").is_some());
+        assert!(activity["results"][0]["file_id"].is_null());
+        assert_eq!(activity["results"][0]["filename"], raw["filename"]);
+        assert_eq!(activity["results"][0]["score"], raw["score"]);
+        assert_eq!(activity["results"][0]["text"], raw["text"]);
+        assert_eq!(activity["results"][0]["attributes"], raw["attributes"]);
+        assert_eq!(
+            restored.messages[0].display_text(),
+            "Answer remains available."
+        );
+    }
+}
+
+#[test]
+fn file_identity_stays_typed_and_result_stays_strict() {
+    for invalid in [json!(1), json!(true), json!([]), json!({})] {
+        let mut raw = result();
+        raw["file_id"] = invalid;
+        assert!(serde_json::from_value::<FileSearchResult>(raw).is_err());
+    }
+    let mut raw = result();
+    raw["file_id"] = json!("file-1");
+    raw["unexpected"] = json!(true);
+    assert!(serde_json::from_value::<FileSearchResult>(raw).is_err());
+}

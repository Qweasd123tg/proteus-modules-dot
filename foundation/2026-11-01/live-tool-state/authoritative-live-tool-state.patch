+/// Read exactly the completed display's index, even while the journal advances.
+/// Its owning SessionView combines this prefix with authoritative live progress.
+pub(in crate::core::session_store::read_model) fn tool_states(
+    store: &SessionStore,
+    revision: &str,
+) -> Option<std::collections::HashMap<String, AppToolState>> {
+    let reader = Reader::open(store.session_dir(), VIEW_CACHE)?;
+    let header: Header = reader.one("header")?;
+    if !matches(store, &header) || reader.revision()?.as_str() != revision {
+        return None;
+    }
+    let indexed = (|| {
+        let fingerprint: (usize, [u8; 32]) = reader.one(INDEX)?;
+        if reader.keyed_fingerprint(TOOL_STATE)? != fingerprint {
+            return None;
+        }
+        let mut tools = std::collections::HashMap::new();
+        for (name, tool) in reader.keyed_rows::<AppToolState>(TOOL_STATE)? {
+            if tool.name != name || !accepted(&tool.status) {
+                return None;
+            }
+            tools.insert(name, tool);
+        }
+        Some(tools)
+    })();
+    let tools = match indexed {
+        Some(tools) => tools,
+        None => {
+            // Older or damaged auxiliary indexes do not make a verified display
+            // unreadable. Decode compact fields one checksummed row at a time,
+            // once at attachment, never replay the canonical journal here.
+            let mut tools = std::collections::HashMap::new();
+            for position in 0..header.transcript_len {
+                let row: CompactRow = reader
+                    .page("transcript", position, position.checked_add(1)?)?
+                    .pop()?;
+                if let Some(tool) = row.tool
+                    && accepted(&tool.status)
+                {
+                    let tool = tool.into_state();
+                    tools.insert(tool.name.clone(), tool);
+                }
+            }
+            tools
+        }
+    };
+    reader.finish()?;
+    Some(tools)
 }
 

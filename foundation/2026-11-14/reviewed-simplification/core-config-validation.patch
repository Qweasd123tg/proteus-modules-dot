index 0000000..f4dbae1
--- /dev/null
+++ b/crates/proteus-core/src/core/config/validation.rs
@@ -0,0 +1,36 @@
+//! Source-independent profile rules shared by loading and edited configs.
+use anyhow::{Result, bail};
+
+use crate::core::core_slots::{CoreSlotSelection, core_slot_descriptor_by_id};
+
+use super::AppConfig;
+
+impl AppConfig {
+    /// Validate typed profile semantics without rereading sources or resolving
+    /// instructions. Loaded file instructions already carry both file and text;
+    /// their source-shape checks belong to the loader, not this shared pass.
+    pub(crate) fn validate_semantics(&self) -> Result<()> {
+        self.selected_model_config()?;
+        self.validate_module_config_slots()?;
+        self.modules.validate_hooks()?;
+        self.validate_commands()?;
+        Ok(())
+    }
+
+    fn validate_module_config_slots(&self) -> Result<()> {
+        for slot in self.module_config.keys() {
+            if matches!(
+                slot.as_str(),
+                "tool" | "context_provider" | "model" | "hook"
+            ) {
+                continue;
+            }
+            match core_slot_descriptor_by_id(slot) {
+                Some(descriptor) if descriptor.selection == CoreSlotSelection::ModulesConfig => {}
+                Some(_) => bail!("module_config is not supported for slot {slot:?}"),
+                None => bail!("unknown module_config slot {slot:?}"),
+            }
+        }
+        Ok(())
+    }
+}
diff --git a/docs/guides/configuration.md b/docs/guides/configuration.md
index 0a16b44..5477caa 100644
--- a/docs/guides/configuration.md
+++ b/docs/guides/configuration.md
@@ -1625,6 +1625,12 @@ host, клиент не редактирует его напрямую.
 
 Save сериализует read/prepare/persist/publish по каноническому пути профиля;
 повторное сохранение читает актуальный source, а файл заменяется atomic rename.
+После применения request итоговый config проходит те же semantic checks,
+что загрузка с диска: выбор provider, допустимые `module_config` slots, hooks
+и prompt commands. Неизвестный slot отвергается до подготовки сборки, записи
+истории и файла; live config и epoch остаются прежними. Разрешение instruction
+files остаётся в reader: уже загруженный текст не проверяется как новый source.
+TOML-представимость значений и подготовка runtime остаются отдельными проверками.
 Все fallible проверки runtime проходят до persistence. Выбор модели и reload
 используют один lock, поэтому изменение selection не может сорвать publication
 уже записанного config. Принятый save завершается и при отключении HTTP caller.

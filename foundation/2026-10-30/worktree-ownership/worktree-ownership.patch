+struct WaiterCancellation(Option<CancellationToken>);
+
+impl Drop for WaiterCancellation {
+    fn drop(&mut self) {
+        if let Some(cancellation) = self.0.take() {
+            cancellation.cancel();
+        }
+    }
+}

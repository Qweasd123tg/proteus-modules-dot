+fn record_date<const SCOPED: bool, K: Eq + Hash>(
+    dates: &mut HashMap<K, RecordedAt>,
+    key: K,
+    at: RecordedAt,
+) {
+    if SCOPED {
+        if let Some(slot) = dates.get_mut(&key)
+            && slot.sequence.is_none()
+        {
+            *slot = at;
+        }
+    } else {
+        dates.entry(key).or_insert(at);
+    }

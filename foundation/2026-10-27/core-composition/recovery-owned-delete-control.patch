+#[cfg(all(test, unix))]
+mod recovery_delete_control {
+    use super::SessionStore;
+    use std::{cell::RefCell, path::PathBuf, sync::mpsc, time::Duration};
+
+    struct Pause {
+        session_dir: PathBuf,
+        entered: tokio::sync::oneshot::Sender<()>,
+        resume: mpsc::Receiver<()>,
+    }
+
+    thread_local! {
+        static PAUSE: RefCell<Option<Pause>> = const { RefCell::new(None) };
+    }
+
+    pub(super) fn after_projection(store: &SessionStore) -> anyhow::Result<()> {
+        let pause = PAUSE.with(|slot| {
+            let mut slot = slot.borrow_mut();
+            if slot
+                .as_ref()
+                .is_some_and(|pause| pause.session_dir.as_path() == store.session_dir())
+            {
+                slot.take()
+            } else {
+                None
+            }
+        });
+        if let Some(pause) = pause {
+            pause
+                .entered
+                .send(())
+                .map_err(|_| anyhow::anyhow!("recovery control observer dropped"))?;
+            pause
+                .resume
+                .recv_timeout(Duration::from_secs(10))
+                .map_err(|error| anyhow::anyhow!("bounded recovery projection pause: {error}"))?;
+        }
+        Ok(())
+    }
+
+    impl SessionStore {
+        /// Arm only this blocking thread and exact session; cleanup also runs on panic.
+        pub(crate) fn with_project_read_model_pause_for_test<T>(
+            &self,
+            entered: tokio::sync::oneshot::Sender<()>,
+            resume: mpsc::Receiver<()>,
+            read: impl FnOnce() -> anyhow::Result<T>,
+        ) -> anyhow::Result<T> {
+            PAUSE.with(|slot| {
+                let mut slot = slot.borrow_mut();
+                assert!(slot.is_none(), "nested recovery control");
+                *slot = Some(Pause {
+                    session_dir: self.session_dir().to_owned(),
+                    entered,
+                    resume,
+                });
+            });
+            struct Reset;
+            impl Drop for Reset {
+                fn drop(&mut self) {
+                    PAUSE.with(|slot| {
+                        slot.borrow_mut().take();
+                    });
+                }
+            }
+            let _reset = Reset;
+            read()
+        }
+    }
+}

diff --git a/crates/proteus-core/src/app_server/read_model/tests.rs b/crates/proteus-core/src/app_server/read_model/tests.rs
--- a/crates/proteus-core/src/app_server/read_model/tests.rs
+++ b/crates/proteus-core/src/app_server/read_model/tests.rs
@@ -112,3 +112,270 @@
     assert!(!index.exists());
     assert_eq!(std::fs::read(store.journal_path()).unwrap(), damaged);

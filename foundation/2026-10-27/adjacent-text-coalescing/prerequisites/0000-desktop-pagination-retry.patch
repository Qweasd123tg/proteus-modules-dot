diff --git a/src/ui/chat/history_flow.rs b/src/ui/chat/history_flow.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b3eac537895b28b9dabbce7fed665bc28316e421
--- /dev/null
+++ b/src/ui/chat/history_flow.rs
@@ -0,0 +1,120 @@
+//! Request identity and viewport demand for older chat pages, without UI/I/O.
+
+#[derive(Default)]
+pub(super) struct HistoryRequests {
+    generation: u64,
+    in_flight: Option<u64>,
+}
+
+impl HistoryRequests {
+    pub fn begin(&mut self) -> Option<u64> {
+        if self.in_flight.is_some() {
+            return None;
+        }
+        self.generation = self.generation.wrapping_add(1);
+        self.in_flight = Some(self.generation);
+        Some(self.generation)
+    }
+
+    /// A snapshot invalidates the old page and reports cancelled demand.
+    pub fn invalidate(&mut self) -> bool {
+        self.in_flight.take().is_some()
+    }
+
+    /// Old or duplicate completions must not release a newer request's slot.
+    pub fn finish(&mut self, request: u64) -> bool {
+        if self.in_flight != Some(request) {
+            return false;
+        }
+        self.in_flight = None;
+        true
+    }
+}
+
+#[derive(Default)]
+pub(super) struct HistoryDemand {
+    latched: bool,
+}
+
+impl HistoryDemand {
+    pub fn check(&mut self, at_edge: bool) -> bool {
+        let request = at_edge && !self.latched;
+        self.latched = at_edge;
+        request
+    }
+
+    /// Only an interrupted request rearms automatic demand. In particular,
+    /// errors followed by redraws or idle snapshots do not retry forever.
+    pub fn snapshot(&mut self, cancelled: bool) -> bool {
+        if cancelled {
+            return std::mem::take(&mut self.latched);
+        }
+        false
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cancelled_page_rearms_same_edge_once() {
+        let mut demand = HistoryDemand::default();
+        let mut requests = HistoryRequests::default();
+        assert!(demand.check(true));
+        let old = requests.begin().unwrap();
+        assert!(requests.begin().is_none());
+        assert!(demand.snapshot(requests.invalidate()));
+        assert!(demand.check(true));
+        assert!(!demand.check(true));
+        let new = requests.begin().unwrap();
+        assert_ne!(old, new);
+        assert!(!requests.finish(old));
+        assert!(requests.begin().is_none());
+        assert!(requests.finish(new));
+    }
+
+    #[test]
+    fn error_needs_user_retry_not_redraw_or_idle_snapshot() {
+        let mut demand = HistoryDemand::default();
+        let mut requests = HistoryRequests::default();
+        assert!(demand.check(true));
+        let first = requests.begin().unwrap();
+        assert!(requests.finish(first)); // Failure releases only the request.
+        assert!(!demand.snapshot(requests.invalidate()));
+        for _ in 0..100 {
+            assert!(!demand.check(true));
+        }
+        let retry = requests.begin().unwrap(); // Explicit Retry action.
+        assert!(!requests.finish(first));
+        assert!(requests.begin().is_none());
+        assert!(requests.finish(retry));
+    }
+
+    #[test]
+    fn leaving_edge_cancels_visible_demand_but_not_response_identity() {
+        let mut demand = HistoryDemand::default();
+        let mut requests = HistoryRequests::default();
+        assert!(demand.check(true));
+        let old = requests.begin().unwrap();
+        assert!(!demand.check(false));
+        assert!(!demand.snapshot(requests.invalidate()));
+        assert!(!demand.check(false)); // Snapshot must not drag user back.
+        assert!(demand.check(true)); // A later deliberate return can request.
+        let new = requests.begin().unwrap();
+        assert!(!requests.finish(old));
+        assert!(requests.finish(new));
+    }
+
+    #[test]
+    fn repeated_snapshots_coalesce_before_next_render() {
+        let mut demand = HistoryDemand::default();
+        let mut requests = HistoryRequests::default();
+        assert!(demand.check(true));
+        requests.begin().unwrap();
+        assert!(demand.snapshot(requests.invalidate()));
+        assert!(!demand.snapshot(requests.invalidate()));
+        assert!(demand.check(true));
+        assert!(!demand.check(true));
+    }
+}

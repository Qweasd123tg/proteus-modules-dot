+#[tokio::test]
+async fn accepted_hook_arguments_clear_raw_before_policy_and_invocation() {
+    let mut harness = Harness::new(true, Fault::None);
+    harness.mutations(vec![json!({"text": "hook"})]);
+    let call = ToolCall::new("hook-raw", "probe", json!({"text": "args"}))
+        .with_raw_arguments(r#"{"text":"raw"}"#);
+    let requested = normalized(call.clone());
+    let mut effective = requested.clone();
+    effective.args = json!({"text": "hook"});
+    effective.raw_arguments = None;
+    let result = harness.execute(call).await.unwrap();
+    assert!(result.ok, "{result:?}");
+    assert_eq!(
+        stages(&harness.trace),
+        [
+            "requested",
+            "observed",
+            "hook-0",
+            "policy",
+            "allowed",
+            "observer-resolved",
+            "invoked",
+            "effect",
+            "recorded",
+            "finished"
+        ]
+    );
+    for step in harness.trace.lock().unwrap().iter() {
+        match step {
+            Step::Call("requested" | "observed" | "hook-0", call) => assert_eq!(call, &requested),
+            Step::Call(_, call) | Step::Resolution(call, _) => assert_eq!(call, &effective),
+            Step::Result(_, _) => {}
+        }
+    }
+    assert_result_snapshots(&harness.trace, &result);
+}
+
+#[tokio::test]
+async fn each_hook_argument_replacement_is_validated_before_the_next_handler() {
+    let mut harness = Harness::new(true, Fault::None);
+    harness.mutations(vec![
+        json!({"text": "first"}),
+        json!({"text": 7}),
+        json!({"text": "never"}),
+    ]);
+    let call = ToolCall::new("hook-invalid", "probe", json!({"text": "args"}))
+        .with_raw_arguments(r#"{"text":"raw"}"#);
+    let requested = normalized(call.clone());
+    let expected_error = format!(
+        "invalid hook tool arguments: {}",
+        validate_tool_call_args(
+            &ToolCall::new("hook-invalid", "probe", json!({"text": 7})),
+            &spec(schema()),
+        )
+        .unwrap()
+    );
+    assert_eq!(
+        harness.execute(call).await.unwrap_err().to_string(),
+        expected_error
+    );
+    assert_eq!(
+        stages(&harness.trace),
+        [
+            "requested",
+            "observed",
+            "hook-0",
+            "hook-1",
+            "hook-blocked",
+            "recorded",
+            "finished"
+        ]
+    );
+    for step in harness.trace.lock().unwrap().iter() {
+        match step {
+            Step::Call("hook-1", call) => {
+                assert_eq!(call.args, json!({"text": "first"}));
+                assert_eq!(call.raw_arguments, None);
+            }
+            Step::Call(_, call) | Step::Resolution(call, _) => assert_eq!(call, &requested),
+            Step::Result(_, result) => {
+                assert_eq!(result.error.as_deref(), Some(expected_error.as_str()))
+            }
+        }
+    }
+}

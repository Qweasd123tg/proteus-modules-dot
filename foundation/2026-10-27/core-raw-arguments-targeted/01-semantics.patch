+#[tokio::test]
+async fn raw_parse_error_precedes_a_dynamically_invalid_current_schema() {
+    for raw in ["{bad", r#"{"text":"raw"}"#] {
+        let harness = Harness::new(true, Fault::None);
+        let invalid_schema = json!({"type": "typo"});
+        *harness.input_schema.lock().unwrap() = invalid_schema.clone();
+        let call = ToolCall::new("changed-schema", "probe", json!({"text": "args"}))
+            .with_raw_arguments(raw);
+        let expected_error = validate_tool_call_args(&call, &spec(invalid_schema)).unwrap();
+        if raw == "{bad" {
+            assert!(expected_error.starts_with("failed to parse function arguments:"));
+        } else {
+            assert!(expected_error.starts_with("tool 'probe' has invalid input schema:"));
+        }
+        let expected_call = normalized(call.clone());
+        let result = harness.execute(call).await.unwrap();
+        assert_eq!(result.error.as_deref(), Some(expected_error.as_str()));
+        assert_eq!(
+            stages(&harness.trace),
+            [
+                "requested",
+                "observed",
+                "validation-failed",
+                "recorded",
+                "finished"
+            ]
+        );
+        assert_call_snapshots(&harness.trace, &expected_call);
+    }
+}
+
+#[tokio::test]
+async fn recorder_observer_and_cancellation_boundaries_still_precede_validation() {
+    for (fault, error, expected_stages) in [
+        (
+            Fault::RequestedRecorder,
+            "requested recorder failed",
+            vec!["requested"],
+        ),
+        (
+            Fault::RequestedObserver,
+            "requested observer failed",
+            vec!["requested", "observed"],
+        ),
+        (
+            Fault::CancelAfterRequested,
+            "tool execution canceled",
+            vec!["requested"],
+        ),
+        (Fault::AlreadyCanceled, "tool execution canceled", vec![]),
+    ] {
+        for raw in ["{bad", r#"{"text":"raw"}"#] {
+            let harness = Harness::new(true, fault);
+            let call = ToolCall::new("boundary-failure", "probe", json!({"text": "args"}))
+                .with_raw_arguments(raw);
+            let expected_call = normalized(call.clone());
+            assert_eq!(harness.execute(call).await.unwrap_err().to_string(), error);
+            assert_eq!(stages(&harness.trace), expected_stages);
+            assert_call_snapshots(&harness.trace, &expected_call);
+        }
+    }
+}

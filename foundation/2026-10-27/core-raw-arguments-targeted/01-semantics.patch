+#[tokio::test]
+async fn unknown_tools_keep_unknown_tool_resolution_even_with_malformed_raw_json() {
+    for raw in ["{bad", r#"{"text":"raw"}"#] {
+        let harness = Harness::new(true, Fault::None);
+        let call = ToolCall::new("unknown-raw", "missing", json!({"text": "args"}))
+            .with_raw_arguments(raw);
+        let expected_call = normalized(call.clone());
+        let result = harness.execute(call).await.unwrap();
+        assert_eq!(result.error.as_deref(), Some("unknown tool: missing"));
+        assert_eq!(result.metadata, Value::Null);
+        assert_eq!(
+            stages(&harness.trace),
+            [
+                "requested",
+                "observed",
+                "policy-denied",
+                "recorded",
+                "finished"
+            ]
+        );
+        assert_call_snapshots(&harness.trace, &expected_call);
+        assert_result_snapshots(&harness.trace, &result);
+    }
+}

     source: &SourceFingerprint,
     data: &T,
 ) -> bool {
+    #[cfg(test)]
+    {
+        note_save_stage(SaveStage::Start);
+        note_save_outcome(SaveOutcome::InProgress);
+    }
     let save = || {
         let writer = Writer::new(dir, name, source)?;
+        #[cfg(test)]
+        note_save_stage(SaveStage::DataRow);
         writer.one("data", data)?;
         writer.finish()
     };
-    save().is_some()
+    let saved = save().is_some();
+    #[cfg(test)]
+    {
+        if saved {
+            note_save_stage(SaveStage::Complete);
+        }
+        note_save_outcome(if saved {
+            SaveOutcome::Saved
+        } else {
+            SaveOutcome::Failed
+        });
+    }
+    saved
 }
 

+pub(crate) enum SaveStage {
+    Start,
+    CachePath,
+    GateOpen,
+    GateAcquire,
+    SourceBefore,
+    TempCreate,
+    SqliteOpen,
+    SqliteBegin,
+    SqliteSchema,
+    SourceRow,
+    DataRow,
+    Commit,
+    Close,
+    Sync,
+    SourceAfter,
+    JournalCleanup,
+    Rename,
+    Complete,
+}
+
+#[cfg(test)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum SaveOutcome {
+    InProgress,
+    Saved,
+    Failed,
+}
+
+#[cfg(test)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct SaveDiagnostic {
+    stage: SaveStage,
+    outcome: SaveOutcome,
+}
+
+#[cfg(test)]
+std::thread_local! {
+    static SAVE_DIAGNOSTIC: std::cell::Cell<SaveDiagnostic> =
+        const { std::cell::Cell::new(SaveDiagnostic {
+            stage: SaveStage::Start,
+            outcome: SaveOutcome::InProgress,
+        }) };
+}
+
+#[cfg(test)]
+fn note_save_stage(stage: SaveStage) {
+    SAVE_DIAGNOSTIC.with(|slot| {
+        let mut diagnostic = slot.get();
+        diagnostic.stage = stage;
+        slot.set(diagnostic);
+    });
+}
+
+#[cfg(test)]
+fn note_save_outcome(outcome: SaveOutcome) {
+    SAVE_DIAGNOSTIC.with(|slot| {
+        let mut diagnostic = slot.get();
+        diagnostic.outcome = outcome;
+        slot.set(diagnostic);
+    });
+}
+
+/// Synchronous, thread-local test evidence only; not a production error API.
+#[cfg(test)]
+pub(crate) fn last_save_diagnostic() -> SaveDiagnostic {
+    SAVE_DIAGNOSTIC.with(std::cell::Cell::get)
+}

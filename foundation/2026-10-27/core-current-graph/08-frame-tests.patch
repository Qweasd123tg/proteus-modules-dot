+//! Differential and ownership regressions for the component-v3 envelope parser.
+use super::{ComponentFrame, ProcessModuleRpcError, parse_component_frame};
+use anyhow::Result;
+use serde_json::{Map, Value, json};
+
+fn outcome(result: Result<ComponentFrame>) -> Result<Value, Vec<String>> {
+    result
+        .map(|frame| match frame {
+            ComponentFrame::Response {
+                id,
+                result: Ok(value),
+            } => {
+                json!({"kind":"success", "id":id, "value":value})
+            }
+            ComponentFrame::Response {
+                id,
+                result: Err(error),
+            } => {
+                json!({"kind":"error", "id":id, "error":error})
+            }
+            ComponentFrame::Request { id, method, params } => {
+                json!({"kind":"request", "id":id, "method":method, "params":params})
+            }
+            ComponentFrame::Notification { method, params } => {
+                json!({"kind":"notification", "method":method, "params":params})
+            }
+        })
+        .map_err(|error| error.chain().map(ToString::to_string).collect())
+}
+
+fn assert_equivalent(value: Value) {
+    let expected = outcome(borrowed_reference::parse_component_frame(value.clone()));
+    let actual = outcome(parse_component_frame(value.clone()));
+    assert_eq!(actual, expected, "different parser outcome for {value}");
+}
+
+#[test]
+fn owned_parser_matches_borrowed_reference_for_envelope_shapes() {
+    for value in [
+        json!(null),
+        json!(false),
+        json!(1),
+        json!("frame"),
+        json!([]),
+    ] {
+        assert_equivalent(value);
+    }
+    let fields = [
+        ("id", json!("h:1:1")),
+        ("method", json!("run")),
+        ("result", json!({"nested":[null, true, "payload"]})),
+        (
+            "error",
+            json!({"code":-32000, "message":"failed", "data":{"nested":["payload"]}}),
+        ),
+        ("params", json!({"nested":[null, true, "payload"]})),
+        ("unknown", json!(true)),
+    ];
+    for version in [
+        None,
+        Some(json!("2.0")),
+        Some(json!("1.0")),
+        Some(json!(null)),
+        Some(json!(2)),
+    ] {
+        for mask in 0..(1usize << fields.len()) {
+            let mut object = Map::new();
+            if let Some(version) = &version {
+                object.insert("jsonrpc".to_owned(), version.clone());
+            }
+            for (bit, (name, value)) in fields.iter().enumerate() {
+                if mask & (1usize << bit) != 0 {
+                    object.insert((*name).to_owned(), value.clone());
+                }
+            }
+            assert_equivalent(Value::Object(object));
+        }
+    }
+}
+
+#[test]
+fn owned_parser_matches_borrowed_reference_for_ids_methods_and_payload_values() {
+    let values = [
+        json!(null),
+        json!(false),
+        json!(true),
+        json!(0),
+        json!(-1),
+        json!(1.25),
+        json!(u64::MAX),
+        json!(""),
+        json!(" \t\n "),
+        json!("\u{2003}"),
+        json!("not-a-wire-id"),
+        json!(" run "),
+        json!("Unicode \u{1f680}\n\"\\"),
+        json!([]),
+        json!({}),
+        json!([null, false, 1, {"deep":["payload"]}]),
+        json!({"deep":[{"text":"payload", "empty":null}]}),
+    ];
+    for value in values {
+        for (template, field) in [
+            (json!({"jsonrpc":"2.0", "id":"h:1:1", "result":null}), "id"),
+            (
+                json!({"jsonrpc":"2.0", "id":"h:1:1", "error":{"code":-1, "message":"failed"}}),
+                "id",
+            ),
+            (
+                json!({"jsonrpc":"2.0", "id":"h:1:1", "method":"run", "params":null}),
+                "id",
+            ),
+            (
+                json!({"jsonrpc":"2.0", "id":"h:1:1", "method":"run", "params":null}),
+                "method",
+            ),
+            (
+                json!({"jsonrpc":"2.0", "method":"run", "params":null}),
+                "method",
+            ),
+            (
+                json!({"jsonrpc":"2.0", "id":"h:1:1", "method":"run", "params":null}),
+                "params",
+            ),
+            (
+                json!({"jsonrpc":"2.0", "method":"run", "params":null}),
+                "params",
+            ),
+            (
+                json!({"jsonrpc":"2.0", "id":"h:1:1", "result":null}),
+                "result",
+            ),
+            (
+                json!({"jsonrpc":"2.0", "id":"h:1:1", "error":{"code":-1, "message":"failed"}}),
+                "error",
+            ),
+        ] {
+            let mut frame = template;
+            frame[field] = value.clone();
+            assert_equivalent(frame);
+        }
+        assert_equivalent(json!({
+            "jsonrpc":"2.0", "id":"h:1:1",
+            "error":{"code":-32000, "message":"failed", "data":value}
+        }));
+    }
+}
+
+#[test]
+fn owned_parser_matches_borrowed_reference_for_error_bodies_and_error_precedence() {
+    for error in [
+        json!(null),
+        json!({}),
+        json!({"code":-1}),
+        json!({"message":"failed"}),
+        json!({"code":"-1", "message":"failed"}),
+        json!({"code":1.5, "message":"failed"}),
+        json!({"code":u64::MAX, "message":"failed"}),
+        json!({"code":-1, "message":null}),
+        json!({"code":-1, "message":false}),
+        json!({"code":-1, "message":""}),
+        json!({"code":i64::MIN, "message":"failed"}),
+        json!({"code":i64::MAX, "message":"failed"}),
+        json!({"code":-1, "message":"failed", "data":null}),
+        json!({"code":-1, "message":"failed", "data":{"nested":["payload"]}}),
+        json!({"code":-1, "message":"failed", "unknown":true}),
+    ] {
+        for id in [json!("h:1:1"), json!(null), json!(1)] {
+            for extra in [false, true] {
+                let mut frame = json!({"jsonrpc":"2.0", "id":id, "error":error});
+                if extra {
+                    frame["unknown"] = json!(true);
+                }
+                assert_equivalent(frame);
+            }
+        }
+    }
+
+    for (frame, expected) in [
+        (
+            json!({"jsonrpc":"1.0", "id":null, "method":0, "result":null, "error":null}),
+            "JSON-RPC frame must declare jsonrpc=\"2.0\"",
+        ),
+        (
+            json!({"jsonrpc":"2.0", "id":null, "method":0, "result":null, "params":null}),
+            "invalid or ambiguous JSON-RPC envelope",
+        ),
+        (
+            json!({"jsonrpc":"2.0", "id":null, "result":null, "unknown":true}),
+            "JSON-RPC envelope contains unknown or missing fields",
+        ),
+        (
+            json!({"jsonrpc":"2.0", "id":null, "method":0, "params":null}),
+            "component-v3 JSON-RPC id must be a string",
+        ),
+        (
+            json!({"jsonrpc":"2.0", "id":null, "error":null}),
+            "invalid JSON-RPC error body",
+        ),
+        (
+            json!({"jsonrpc":"2.0", "id":null, "error":{"code":-1, "message":"failed"}}),
+            "component-v3 JSON-RPC id must be a string",
+        ),
+    ] {
+        assert_equivalent(frame.clone());
+        assert_eq!(
+            parse_component_frame(frame).unwrap_err().to_string(),
+            expected
+        );
+    }
+}
+
+fn string_allocations(value: &Value, pointers: &mut Vec<usize>) {
+    match value {
+        Value::String(value) if !value.is_empty() => pointers.push(value.as_ptr() as usize),
+        Value::Array(values) => {
+            for value in values {
+                string_allocations(value, pointers);
+            }
+        }
+        Value::Object(values) => {
+            for value in values.values() {
+                string_allocations(value, pointers);
+            }
+        }
+        _ => {}
+    }
+}
+
+#[test]
+fn owned_parser_moves_nonempty_strings_instead_of_deep_cloning_payloads() {
+    let payload =
+        json!({"nested":["payload ".repeat(1024), {"text":"another payload".repeat(128)}]});
+    for frame in [
+        json!({"jsonrpc":"2.0", "id":"h:1:1", "result":payload}),
+        json!({"jsonrpc":"2.0", "id":"h:1:1", "method":" run ", "params":payload}),
+        json!({"jsonrpc":"2.0", "method":"run", "params":payload}),
+        json!({"jsonrpc":"2.0", "id":"h:1:1", "error":{"code":-1, "message":"failed", "data":payload}}),
+    ] {
+        let expected_id = frame
+            .get("id")
+            .map(|id| id.as_str().unwrap().as_ptr() as usize);
+        let expected_method = frame
+            .get("method")
+            .map(|method| method.as_str().unwrap().as_ptr() as usize);
+        let expected_message = frame
+            .get("error")
+            .map(|error| error["message"].as_str().unwrap().as_ptr() as usize);
+        let mut expected_payload = Vec::new();
+        let input_payload = frame
+            .get("params")
+            .or_else(|| frame.get("result"))
+            .unwrap_or(&frame["error"]["data"]);
+        string_allocations(input_payload, &mut expected_payload);
+
+        let (id, method, message, payload) = match parse_component_frame(frame).unwrap() {
+            ComponentFrame::Response {
+                id,
+                result: Ok(value),
+            } => (Some(id), None, None, value),
+            ComponentFrame::Response {
+                id,
+                result: Err(error),
+            } => (Some(id), None, Some(error.message), error.data.unwrap()),
+            ComponentFrame::Request { id, method, params } => {
+                (Some(id), Some(method), None, params)
+            }
+            ComponentFrame::Notification { method, params } => (None, Some(method), None, params),
+        };
+        assert_eq!(id.as_ref().map(|id| id.as_ptr() as usize), expected_id);
+        assert_eq!(
+            method.as_ref().map(|method| method.as_ptr() as usize),
+            expected_method
+        );
+        assert_eq!(
+            message.as_ref().map(|message| message.as_ptr() as usize),
+            expected_message
+        );
+        let mut actual_payload = Vec::new();
+        string_allocations(&payload, &mut actual_payload);
+        assert_eq!(actual_payload, expected_payload);
+    }
+}

+use super::super::*;
+use std::cell::Cell;
+
+#[test]
+fn metadata_gate_bounds_scan_age_without_poll_reads_or_deadline_sliding() {
+    let start = Instant::now();
+    let probes = Cell::new(0);
+    let current = || {
+        probes.set(probes.get() + 1);
+        true
+    };
+    assert!(!metadata_allows_skip(false, None, start, current));
+    assert_eq!(probes.get(), 0, "first scan must not probe cached metadata");
+    let last = Some(start);
+    for tick in 1..10 {
+        assert!(metadata_allows_skip(
+            false,
+            last,
+            start + Duration::from_millis(tick * 300),
+            current,
+        ));
+    }
+    assert_eq!(probes.get(), 9);
+    assert!(!metadata_allows_skip(
+        false,
+        last,
+        start + MAX_SEMANTIC_SCAN_AGE,
+        current,
+    ));
+    assert_eq!(probes.get(), 9, "overdue scans bypass metadata probes");
+    assert!(!metadata_allows_skip(
+        true,
+        last,
+        start + Duration::from_millis(300),
+        current,
+    ));
+    assert_eq!(probes.get(), 9, "pending second sample bypasses metadata");
+    assert!(!metadata_allows_skip(
+        false,
+        last,
+        start + Duration::from_millis(300),
+        || false,
+    ));
+    // A completed attempt, whether valid or invalid, starts the next age.
+    let next = start + MAX_SEMANTIC_SCAN_AGE;
+    assert!(metadata_allows_skip(
+        false,
+        Some(next),
+        next + Duration::from_millis(300),
+        current,
+    ));
+}
diff --git a/crates/proteus-core/src/app_server/profile_watch/tests/bounded_age.rs b/crates/proteus-core/src/app_server/profile_watch/tests/bounded_age.rs

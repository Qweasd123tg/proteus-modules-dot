+#[tokio::test]
+async fn notification_failure_records_later_handler_and_completed_output() {
+    let (mut chain, calls) = chain(
+        &[("failed", true, false), ("continued", false, false)],
+        CancellationToken::new(),
+    );
+    let recorder = Arc::new(TraceRecorder::default());
+    chain.recorder = recorder.clone();
+    let input = bound_input(
+        &chain,
+        HookEvent::TurnSettled {
+            status: crate::contracts::HookTurnStatus::Error,
+            output: None,
+            error: Some("turn failed".into()),
+        },
+    );
+    let output = chain.apply(input.clone()).await.unwrap();
+    let traces = recorder.traces.lock().unwrap();
+    assert_eq!(traces.len(), 1);
+    assert_eq!(traces[0].input, input);
+    assert_eq!(traces[0].output.as_ref(), Some(&output));
+    assert_eq!(traces[0].steps.len(), 2);
+    assert!(matches!(
+        &traces[0].steps[0].outcome,
+        HookStepOutcome::Failed { .. }
+    ));
+    assert!(matches!(
+        &traces[0].steps[1].outcome,
+        HookStepOutcome::Accepted {
+            response: HookResponse::Continue
+        }
+    ));
+    assert_eq!(*calls.lock().unwrap(), vec!["failed", "continued"]);
+}

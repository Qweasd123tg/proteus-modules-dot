+#[tokio::test]
+async fn completed_hook_trace_returns_the_recorded_output_allocation() {
+    let (mut chain, calls) = chain(&[("continue", false, false)], CancellationToken::new());
+    let recorder = Arc::new(TraceRecorder::default());
+    chain.recorder = recorder.clone();
+    let call = ToolCall::new(new_call_id(), "read", serde_json::json!({}));
+    let event = HookEvent::AfterTool {
+        result: crate::domain::ToolResult::ok(call.id.clone(), "payload".repeat(8192)),
+        call,
+    };
+    let input = bound_input(&chain, event);
+    let output = chain.apply(input.clone()).await.unwrap();
+    let HookEvent::AfterTool { result, .. } = &output else {
+        panic!("hook changed event kind");
+    };
+    assert_eq!(
+        Some(result.output.as_ptr() as usize),
+        *recorder.output_pointer.lock().unwrap(),
+        "return the output already observed by the recorder, without a second payload allocation"
+    );
+    let traces = recorder.traces.lock().unwrap();
+    assert_eq!(traces.len(), 1);
+    assert_eq!(traces[0].input, input);
+    assert_eq!(traces[0].output.as_ref(), Some(&output));
+    assert_eq!(traces[0].steps.len(), 1);
+    assert_eq!(traces[0].steps[0].module_id, "continue");
+    assert!(matches!(
+        &traces[0].steps[0].outcome,
+        HookStepOutcome::Accepted {
+            response: HookResponse::Continue
+        }
+    ));
+    assert_eq!(*calls.lock().unwrap(), vec!["continue"]);
+}

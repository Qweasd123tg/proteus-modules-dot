+#[tokio::test]
+async fn actionable_failure_records_no_output_and_stops_later_handlers() {
+    let (mut chain, calls) = chain(
+        &[("failed", true, false), ("never", false, false)],
+        CancellationToken::new(),
+    );
+    let recorder = Arc::new(TraceRecorder::default());
+    chain.recorder = recorder.clone();
+    let input = bound_input(&chain, model_event());
+    let error = chain.apply(input.clone()).await.unwrap_err();
+    assert_eq!(error.to_string(), "handler failed");
+    let traces = recorder.traces.lock().unwrap();
+    assert_eq!(traces.len(), 1);
+    assert_eq!(traces[0].input, input);
+    assert!(traces[0].output.is_none());
+    assert_eq!(traces[0].steps.len(), 1);
+    assert!(matches!(
+        &traces[0].steps[0].outcome,
+        HookStepOutcome::Failed { .. }
+    ));
+    assert_eq!(*calls.lock().unwrap(), vec!["failed"]);
+}

+#[tokio::test]
+async fn completed_hook_trace_recorder_failure_does_not_return_output() {
+    let (mut chain, calls) = chain(&[("continue", false, false)], CancellationToken::new());
+    let recorder = Arc::new(TraceRecorder {
+        reject: true,
+        ..Default::default()
+    });
+    chain.recorder = recorder.clone();
+    let input = bound_input(&chain, model_event());
+    let error = chain.apply(input.clone()).await.unwrap_err();
+    assert!(error.downcast_ref::<HookRecordingFailure>().is_some());
+    let traces = recorder.traces.lock().unwrap();
+    assert_eq!(traces.len(), 1);
+    assert_eq!(traces[0].input, input);
+    assert!(traces[0].output.is_some());
+    assert_eq!(traces[0].steps.len(), 1);
+    assert_eq!(*calls.lock().unwrap(), vec!["continue"]);
+}

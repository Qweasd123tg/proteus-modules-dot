+#[derive(Debug)]
+struct HookRecordingFailure;
+impl std::fmt::Display for HookRecordingFailure {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("hook recorder rejected trace")
+    }
+}
+impl std::error::Error for HookRecordingFailure {}
+
+#[derive(Default)]
+struct TraceRecorder {
+    traces: Mutex<Vec<HookTrace>>,
+    output_pointer: Mutex<Option<usize>>,
+    reject: bool,
+}
+#[async_trait]
+impl ExecutionRecorder for TraceRecorder {
+    async fn hook_recorded(&self, trace: &HookTrace) -> Result<()> {
+        let output_pointer = match &trace.output {
+            Some(HookEvent::AfterTool { result, .. }) => Some(result.output.as_ptr() as usize),
+            _ => None,
+        };
+        // The borrowed trace must remain complete across a suspended recorder.
+        tokio::task::yield_now().await;
+        if let Some(pointer) = output_pointer {
+            let Some(HookEvent::AfterTool { result, .. }) = &trace.output else {
+                panic!("recorded output disappeared");
+            };
+            assert_eq!(result.output.as_ptr() as usize, pointer);
+        }
+        self.traces.lock().unwrap().push(trace.clone());
+        *self.output_pointer.lock().unwrap() = output_pointer;
+        if self.reject {
+            return Err(anyhow::Error::new(HookRecordingFailure));
+        }
+        Ok(())
+    }
+
+    async fn model_request_recorded(
+        &self,
+        _: crate::domain::ExchangeId,
+        _: ModelCallOrigin,
+        _: crate::contracts::OperationOwner,
+        _: &CanonicalModelRequest,
+    ) -> Result<()> {
+        panic!("hook trace test must not record a model request")
+    }
+
+    async fn model_response_recorded(
+        &self,
+        _: crate::domain::ExchangeId,
+        _: &crate::model_standard::CanonicalModelResponse,
+    ) -> Result<()> {
+        panic!("hook trace test must not record a model response")
+    }
+
+    async fn model_error_recorded(
+        &self,
+        _: crate::domain::ExchangeId,
+        _: &crate::model_standard::ModelFailure,
+    ) -> Result<()> {
+        panic!("hook trace test must not record a model failure")
+    }
+}

+#[tokio::test]
+async fn empty_selection_chain_still_records_complete_boundary() {
+    let (mut chain, _) = chain(&[], CancellationToken::new());
+    let recorder = Arc::new(TraceRecorder::default());
+    chain.recorder = recorder.clone();
+    let selection = crate::contracts::ToolSelectionInput::new(
+        crate::contracts::ToolSelectionRequest::new(crate::domain::AgentTask::new(
+            "select",
+            "/tmp".into(),
+        )),
+        vec![],
+    );
+    let input = bound_input(
+        &chain,
+        HookEvent::BeforeToolSelection {
+            input: selection,
+            output: crate::contracts::ToolSelectionOutput::new(vec![]),
+        },
+    );
+    assert!(!chain.is_active());
+    let output = chain.apply(input.clone()).await.unwrap();
+    let traces = recorder.traces.lock().unwrap();
+    assert_eq!(traces.len(), 1);
+    assert_eq!(traces[0].input, input);
+    assert!(traces[0].steps.is_empty());
+    assert_eq!(traces[0].output.as_ref(), Some(&output));
+    assert_eq!(output, input.event);
+}

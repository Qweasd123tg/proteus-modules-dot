+#[tokio::test]
+async fn empty_terminal_suffix_still_validates_response_envelope() {
+    let prefix = completed("accepted prefix", MessagePhase::Commentary);
+    let cases = [
+        (
+            vec![],
+            CanonicalModelResponse::from_messages(vec![], vec![], FinishReason::Stop),
+            "model response must contain at least one message",
+        ),
+        (
+            vec![prefix.clone()],
+            CanonicalModelResponse::new(prefix.clone(), vec![], FinishReason::ToolCalls),
+            "finish_reason=ToolCalls without tool calls",
+        ),
+        (
+            vec![prefix.clone()],
+            CanonicalModelResponse::new(prefix.clone(), vec![], FinishReason::Length),
+            "hit the length limit",
+        ),
+        (
+            vec![prefix.clone()],
+            CanonicalModelResponse::new(
+                prefix.clone(),
+                vec![ToolCall::new("stray_call", "probe", serde_json::json!({}))],
+                FinishReason::Stop,
+            ),
+            "included tool calls with finish_reason=Stop",
+        ),
+    ];
+    for (completed_messages, response, expected_error) in cases {
+        let mut events = completed_messages
+            .iter()
+            .cloned()
+            .map(|message| ModelStreamEvent::MessageCompleted { message })
+            .collect::<Vec<_>>();
+        events.push(ModelStreamEvent::Response { response });
+        let (model, recorder) = recording_model(events);
+        let error = model
+            .complete(request("failure-progress", "empty suffix envelope"))
+            .await
+            .unwrap_err();
+        let failure = ModelFailure::from_error(&error);
+        assert!(
+            failure.message.contains(expected_error),
+            "expected {expected_error:?}, got {failure:?}"
+        );
+        assert_eq!(failure.completed_messages, completed_messages);
+        let facts = recorder.facts.lock().await;
+        assert!(facts.responses.is_empty());
+        assert_eq!(facts.errors.len(), 1);
+        assert_eq!(facts.errors[0].2, completed_messages);
+    }
 }
 

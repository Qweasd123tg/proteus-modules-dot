 use super::*;
+
+struct Counted<'a> {
+    value: &'a str,
+    calls: std::cell::Cell<usize>,
+}
+
+impl<'a> Counted<'a> {
+    fn new(value: &'a str) -> Self {
+        Self {
+            value,
+            calls: std::cell::Cell::new(0),
+        }
+    }
+}
+
+impl Serialize for Counted<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        self.calls.set(self.calls.get() + 1);
+        serializer.serialize_str(self.value)
+    }
+}
+
+struct Failing(std::cell::Cell<usize>);
+
+impl Serialize for Failing {
+    fn serialize<S: serde::Serializer>(&self, _serializer: S) -> Result<S::Ok, S::Error> {
+        self.0.set(self.0.get() + 1);
+        Err(serde::ser::Error::custom(
+            "deliberate serialization failure",
+        ))
+    }
+}
+
+#[test]
+fn failed_serialization_is_not_retried_as_a_row_mismatch() {
+    let dir = source();
+    let source = SourceFingerprint::read(dir.path(), MAX_BLOBS).unwrap();
+    let writer = Writer::new(dir.path(), "test", &source).unwrap();
+    writer.row("data", 0, &"before").unwrap();
+    writer.finish().unwrap();
+    for position in [0, 1] {
+        let writer = Updater::new(dir.path(), "test", &source).unwrap();
+        let data = Failing(std::cell::Cell::new(0));
+        assert_eq!(writer.row("data", position, &data), None);
+        assert_eq!(data.0.get(), 1);
+        drop(writer);
+        assert_eq!(
+            Reader::open(dir.path(), "test")
+                .unwrap()
+                .one::<String>("data")
+                .unwrap(),
+            "before"
+        );
+    }
+}
+
+#[test]
+fn failed_lookup_does_not_invoke_the_expected_hash_supplier() {
+    let conn = Connection::open_in_memory().unwrap();
+    let calls = std::cell::Cell::new(0);

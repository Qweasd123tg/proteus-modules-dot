+#[test]
+fn missing_keys_serialize_once_including_a_hole_between_existing_rows() {
+    let dir = source();
+    let source = SourceFingerprint::read(dir.path(), MAX_BLOBS).unwrap();
+    let writer = Writer::new(dir.path(), "test", &source).unwrap();
+    writer.row("data", 0, &"zero").unwrap();
+    writer.row("data", 2, &"two").unwrap();
+    writer.finish().unwrap();
+
+    let writer = Updater::new(dir.path(), "test", &source).unwrap();
+    for (position, value) in [(1, "hole"), (3, "tail")] {
+        let data = Counted::new(value);
+        assert_eq!(writer.row("data", position, &data), Some(false));
+        assert_eq!(data.calls.get(), 1);
+    }
+    writer.finish().unwrap();
+    assert_eq!(
+        Reader::open(dir.path(), "test")
+            .unwrap()
+            .page::<String>("data", 0, 4)
+            .unwrap(),
+        ["zero", "hole", "two", "tail"]
+    );
+}
+
+#[test]
+fn existing_keys_keep_streaming_comparison_and_repair_serialization_counts() {
+    let dir = source();
+    let source = SourceFingerprint::read(dir.path(), MAX_BLOBS).unwrap();
+    let writer = Writer::new(dir.path(), "test", &source).unwrap();
+    for position in 0..3 {
+        writer.row("data", position, &"before").unwrap();
+    }
+    writer.finish().unwrap();
+    let connection = Connection::open(cache_path(dir.path(), "test").unwrap()).unwrap();
+    connection
+        .execute(
+            "UPDATE records SET payload=x'00' WHERE section='data' AND position=2",
+            [],
+        )
+        .unwrap();
+    drop(connection);
+
+    let writer = Updater::new(dir.path(), "test", &source).unwrap();
+    for (position, value, unchanged, calls) in [
+        (0, "before", true, 1),
+        (1, "after", false, 2),
+        (2, "before", false, 2),
+    ] {
+        let data = Counted::new(value);
+        assert_eq!(writer.row("data", position, &data), Some(unchanged));
+        assert_eq!(data.calls.get(), calls);
+    }
+    writer.finish().unwrap();
+    assert_eq!(
+        Reader::open(dir.path(), "test")
+            .unwrap()
+            .page::<String>("data", 0, 3)
+            .unwrap(),
+        ["before", "after", "before"]
+    );
+}
+
+#[test]
+fn oversized_missing_or_existing_row_fails_once_and_rolls_back() {
+    let dir = source();
+    let source = SourceFingerprint::read(dir.path(), MAX_BLOBS).unwrap();
+    let writer = Writer::new(dir.path(), "test", &source).unwrap();
+    writer.row("data", 0, &"before").unwrap();
+    writer.finish().unwrap();
+    // JSON quotes alone take this beyond the per-row bounded writer limit.
+    let oversized = "x".repeat(MAX_BYTES);
+    for position in [0, 2] {
+        let writer = Updater::new(dir.path(), "test", &source).unwrap();
+        assert_eq!(writer.row("data", 1, &"uncommitted"), Some(false));
+        let data = Counted::new(&oversized);
+        assert_eq!(writer.row("data", position, &data), None);
+        assert_eq!(data.calls.get(), 1);
+        drop(writer);
+        let reader = Reader::open(dir.path(), "test").unwrap();
+        assert_eq!(reader.one::<String>("data").unwrap(), "before");
+        assert!(reader.page::<String>("data", 1, 2).is_none());
+        assert!(reader.page::<String>("data", 2, 3).is_none());
+    }
+}
 

+            false,
+            "FIX",
+            94.0,
+            "intent_match",
+        ),
+        (
+            "write_file",
+            "",
+            ToolSafety::WritesFiles,
+            false,
+            "CREATE",
+            73.0,
+            "intent_match",
+        ),
+        (
+            "remember_fact",
+            "",
+            ToolSafety::ReadOnly,
+            false,
+            "MEMORY",
+            56.5,
+            "intent_match",
+        ),
+        (
+            "shell",
+            "",
+            ToolSafety::RunsCommands,
+            true,
+            "TEST",
+            126.5,
+            "metadata_hot",
+        ),
+        (
+            "read_file",
+            "",
+            ToolSafety::ReadOnly,
+            false,
+            "READ_FILE",
+            18.5,
+            "codex_hot_set",
+        ),
+        (
+            "extra",
+            "Needle NEEDLE",
+            ToolSafety::ReadOnly,
+            false,
+            "needle",
+            2.5,
+            "lexical_match",
+        ),
+        (
+            "extra",
+            "needle",
+            ToolSafety::ReadOnly,
+            true,
+            "needle",
+            27.5,
+            "metadata_hot",
+        ),
+        (
+            "extra",
+            "",
+            ToolSafety::ReadOnly,
+            false,
+            "",
+            0.5,
+            "codex_hot_set",
+        ),
+        (
+            "extra",
+            "",
+            ToolSafety::Network,
+            false,
+            "",
+            -1.0,
+            "codex_hot_set",
+        ),
+        (
+            "extra",
+            "needle",

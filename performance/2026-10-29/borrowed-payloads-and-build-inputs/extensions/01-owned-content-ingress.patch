+#[test]
+fn moved_content_keeps_optional_metadata_and_empty_string_rules() {
+    for (content, context, revision) in [
+        (json!({"language":"", "source":""}), Value::Null, None),
+        (json!({"language":"", "source":"", "context":false, "source_revision":0}), json!(false), Some(0)),
+        (json!({"language":"", "source":"", "context":["future"], "source_revision":u64::MAX}), json!(["future"]), Some(u64::MAX)),
+        (json!({"language":"", "source":"", "context":{"future":1}, "source_revision":-1}), json!({"future":1}), None),
+        (json!({"language":"", "source":"", "source_revision":1.5}), Value::Null, None),
+        (json!({"language":"", "source":"", "source_revision":"7"}), Value::Null, None),
+    ] {
+        let mut message = json!({"content":content});
+        assert_eq!(Content::take_from(&mut message).unwrap(), Content {
+            language: String::new(),
+            source: String::new(),
+            context,
+            source_revision: revision,
+        });
+    }
+}

+    ack_rx
+        .recv_timeout(CONTROL_ACK_TIMEOUT)
+        .map_err(|_| ComponentBrokerError::stopped("component broker did not acknowledge cancel"))?
+}
+
+fn enqueue_cancel(
+    control_tx: &super::signal::CommandSender<ControlCommand>,
+    id: &str,
+    generation: u64,
+    cause: CancelCause,
+    ack: CancelAck,
+) -> Result<(), ComponentBrokerError> {

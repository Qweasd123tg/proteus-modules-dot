@@ -0,0 +1,13 @@
+[package]
+name = "proteus-tabs"
+version = "0.1.0-alpha.3"
+edition = "2024"
+publish = false
+license = "GPL-3.0-or-later"
+description = "Headless tab, pane and split-layout state for Proteus Desktop"
+
+[dependencies]
+serde = { version = "1", features = ["derive"] }
+
+[dev-dependencies]
+serde_json = "1"

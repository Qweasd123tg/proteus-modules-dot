#![allow(dead_code)]
extern crate self as proteus_extension;
use std::collections::HashSet;
use std::marker::PhantomData;
pub use serde_json::{Value,json};
mod val{/*VALUE*/}
use val::ValueExt;
mod model{use super::*;/*MODEL*/}
use model::{Group,Section,Staging};
pub mod ui{use super::*;/*HEADER*/}
/*HELPERS*/
use ui::stats;
trait Node: Sized{fn with(self,k:&str,v:impl Into<Value>)->Self;}
impl Node for Value {fn with(mut self,k:&str,v:impl Into<Value>)->Self{self[k]=v.into();self}}
fn entry_menu(_:&Value)->Vec<Value>{vec![]} // no menu actions evaluated
/*CHANGE_ROWS*/
#[derive(Default)]struct Git{collapsed:HashSet<&'static str>}
impl Git{
fn header(&mut self,identity:&str,event:&str){
 /*HANDLER*/
}
fn render(&self,entries:&[Value],group:Group)->Vec<Row>{
 let data=ui::tree("changes",change_rows(entries,group,&self.collapsed,None),"tree");
 assert_eq!(data["id"],"changes");assert_eq!(data["action"],"tree");
 data["rows"].as_array().unwrap().iter().map(|v|Row{id:v.str("id").to_owned(),kind:if v.str("kind")=="header"{Kind::Header}else{Kind::Item},depth:v["depth"].as_u64().unwrap() as usize,expanded:v["expanded"].as_bool(),selected:v.bool("selected")}).collect()
}}
#[derive(Clone,Copy,PartialEq,Eq)]enum Kind{Header,Item}
#[derive(Clone)]struct Row{id:String,kind:Kind,depth:usize,expanded:Option<bool>,selected:bool}
impl Row{/*ISHEADER*/}
struct KeyDownEvent{keystroke:Stroke}struct Stroke{key:String}
struct List{scroll:Vec<usize>}impl List{fn scroll_to_reveal_item(&mut self,i:usize){self.scroll.push(i)}}
struct Context<T>{stopped:bool,notify:u32,t:PhantomData<T>,ev:Vec<(String,&'static str)>}
impl<T>Context<T>{fn stop_propagation(&mut self){self.stopped=true;}fn notify(&mut self){self.notify+=1;}}
type App=Context<Tree>;
struct Tree{rows:Vec<Row>,cursor:usize,list:List}
impl Tree{
fn new(rows:Vec<Row>)->Self{let mut tree=Tree{rows,cursor:0,list:List{scroll:vec![]}};/*NEW*/tree}
fn replace(&mut self,rows:Vec<Row>){/*RECONCILE*/self.rows=rows;self.cursor=self.step(self.cursor,1);}
fn act_at(&self,index:usize,event:&'static str,cx:&mut Context<Self>){if let Some(r)=self.rows.get(index){cx.ev.push((r.id.clone(),event));}}
/*ACT*/
/*KEYS*/
fn press(&mut self,key:&str,git:&mut Git,entries:&[Value],group:Group)->(Vec<(String,&'static str)>,bool){
 let mut cx=Context{stopped:false,notify:0,t:PhantomData,ev:vec![]};
 self.key(&KeyDownEvent{keystroke:Stroke{key:key.into()}},&mut cx);
 let prev=git.collapsed.clone();
 for (id,e) in &cx.ev{if id.starts_with("section:"){git.header(id,e)}}
 if prev!=git.collapsed{self.replace(git.render(entries,group));}
 (cx.ev,cx.stopped)
}}
fn run(){
 let(mut total,mut nav_ok,mut explicit,mut resumed_count,mut previews_total)=(0,0,0,0,0);
 for n in 1..=3 {
 let available=[json!({"path":"conflict.md","status":"conflict","unstaged":true}),json!({"path":"edited.md","status":"modified","staged":true}),json!({"path":"new.md","status":"untracked","unstaged":true})];
 let entries=&available[..n];
 for group in [Group::Status,Group::Staging]{
 let mut git=Git::default();let open=git.render(entries,group);
 let headers:Vec<String>=open.iter().filter(|r|r.header()).map(|r|r.id.clone()).collect();assert_eq!(headers.len(),n);
 for id in &headers{git.header(id,"collapse");}
 let closed=git.render(entries,group);assert_eq!(closed.len(),n);assert!(closed.iter().all(|r|r.header()&&r.expanded==Some(false)));
 if n==1{let other=git.render(entries,if group==Group::Status{Group::Staging}else{Group::Status});assert_eq!(other.len(),1);assert_eq!(other[0].id,"section:conflicts");}
 for start in 0..n {for target in 0..n {for activation in ["right","enter","space"]{
 let mut g=Git{collapsed:git.collapsed.clone()};let mut tree=Tree::new(open.clone());tree.cursor=start*2+1;tree.replace(closed.clone());assert!(tree.rows[tree.cursor].header());
 let (home_ev,_)=tree.press("home",&mut g,entries,group);
 let mut previews=home_ev.iter().filter(|(_,e)|*e=="preview").count();
 for _ in 0..target{let (e,_)=tree.press("down",&mut g,entries,group);previews+=e.iter().filter(|(_,k)|*k=="preview").count();}
 let nav=tree.cursor;let (ev,_)=tree.press(activation,&mut g,entries,group);
 let item=tree.rows.get(tree.cursor).and_then(|r|(!r.header()).then(||r.id.clone()));
 let want_child=open.iter().skip_while(|r|r.id!=headers[target]).nth(1).unwrap().id.clone();
 let targeted=ev==[(headers[target].clone(),"expand")];let resumed=item.as_ref()==Some(&want_child);
 total+=1;nav_ok+=usize::from(nav==target);explicit+=usize::from(targeted);resumed_count+=usize::from(resumed);previews_total+=previews;
 if PHASE=="final"{assert_eq!(nav,target);assert_eq!(previews,0);assert!(targeted&&resumed,"{target} {activation} {ev:?}");let (e,_)=tree.press("enter",&mut g,entries,group);assert_eq!(e,[(want_child,"open")]);}
 if PHASE=="guard"{assert!(item.is_none() && ev.is_empty());}
 if n==1 && start==0 && target==0 && activation=="right"{println!("phase={PHASE} group={group:?} headers={n} Right->{ev:?} next item={item:?}");}
 }}}}}
 assert_eq!(total,84);println!("cases={total}; navigated-to-requested-header={nav_ok}; explicit-expand-to-requested-section={explicit}; target-section-item-restored={resumed_count}; spurious-preview-callbacks={previews_total}");
 }
fn main(){run();println!("1–3 sections, two real groupings, every starting/target section, Right/Enter/Space: 84 combinations.");}

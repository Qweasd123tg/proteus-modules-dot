/* Extracted actual old/new functions are inserted by native_check.py. */
mod old {
    BASELINE
    pub fn call(body: &str, wrap: bool) -> usize { height(body, wrap) }
}
mod new {
    CANDIDATE
    pub fn call(body: &str, wrap: bool) -> usize { height(body, wrap) }
}

use std::hint::black_box;
#[cfg(not(count_alloc))] use std::time::Instant;
#[cfg(count_alloc)] use std::alloc::{GlobalAlloc, Layout, System};
#[cfg(count_alloc)] use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
#[cfg(count_alloc)] struct Counts;
#[cfg(count_alloc)] static CALLS: AtomicUsize = AtomicUsize::new(0);
#[cfg(count_alloc)] static PEAK: AtomicUsize = AtomicUsize::new(0);
#[cfg(count_alloc)] static LIVE: AtomicUsize = AtomicUsize::new(0);
#[cfg(count_alloc)] static ENABLE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
#[cfg(count_alloc)]
unsafe impl GlobalAlloc for Counts {
    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
        let p=unsafe{System.alloc(l)}; if ENABLE.load(Relaxed)&&!p.is_null(){
            CALLS.fetch_add(1,Relaxed); PEAK.fetch_max(LIVE.fetch_add(l.size(),Relaxed)+l.size(),Relaxed);
        }p
    }
    unsafe fn dealloc(&self,p:*mut u8,l:Layout) {
        if ENABLE.load(Relaxed) { LIVE.fetch_sub(l.size(),Relaxed); } unsafe{System.dealloc(p,l);}
    }
    unsafe fn realloc(&self,p:*mut u8,l:Layout,n:usize)->*mut u8{
        let v=unsafe{System.realloc(p,l,n)}; if ENABLE.load(Relaxed)&&!v.is_null(){
            CALLS.fetch_add(1,Relaxed); LIVE.fetch_sub(l.size(),Relaxed);
            PEAK.fetch_max(LIVE.fetch_add(n,Relaxed)+n,Relaxed);
        }v
    }
}
#[cfg(count_alloc)] #[global_allocator] static ALLOC: Counts = Counts;
#[cfg(count_alloc)]
fn allocation(f:fn(&str,bool)->usize,s:&str,w:bool)->(usize,usize){
    CALLS.store(0,Relaxed);PEAK.store(0,Relaxed);LIVE.store(0,Relaxed);
    ENABLE.store(true,Relaxed);let _ = black_box(f(black_box(s),black_box(w)));ENABLE.store(false,Relaxed);
    assert_eq!(LIVE.load(Relaxed),0);(CALLS.load(Relaxed),PEAK.load(Relaxed))
}
#[cfg(not(count_alloc))]
fn nanos(f:fn(&str,bool)->usize,s:&str,w:bool,n:usize)->f64{
    let start=Instant::now();
    for _ in 0..n { black_box(f(black_box(s),black_box(w))); }
    start.elapsed().as_nanos() as f64/n as f64
}

fn main(){
    let args:Vec<String>=std::env::args().collect();
    if args.get(1).map(String::as_str)==Some("parity"){
        let bytes=std::fs::read(&args[2]).unwrap();let mut i=0;let mut cases=0;
        while i<bytes.len(){
            let n=u32::from_le_bytes(bytes[i..i+4].try_into().unwrap())as usize;
            let ref0=u16::from_le_bytes(bytes[i+4..i+6].try_into().unwrap())as usize;
            let ref1=u16::from_le_bytes(bytes[i+6..i+8].try_into().unwrap())as usize;
            let s=std::str::from_utf8(&bytes[i+8..i+8+n]).unwrap();i+=n+8;
            for (w,expected) in [(false,ref0),(true,ref1)]{
                assert_eq!(old::call(s,w),expected);assert_eq!(new::call(s,w),expected);cases+=1;
            }
        }
        println!("native old and new vs Python splitlines reference: {cases}/{cases}");return;
    }
    let cases=[
        ("short-text","Приём отчёта. OK.".to_owned(),true,50000),
        ("short-json","{\n  \"x\": \"tiny\"\n}".to_owned(),false,50000),
        ("7-mixed-lines","Пример короткой строки.\r\n".repeat(7),true,5000),
        ("100k-lines","x\n".repeat(100000),false,10),
        ("1m-wrapped-emoji","🦀".repeat(1000000),true,2),
        ("1m-unwrapped-ascii","x".repeat(1000000),false,5),
    ];
    for (label,body,wrap,_iterations) in cases{
        let out=old::call(&body,wrap);assert_eq!(new::call(&body,wrap),out);
        #[cfg(count_alloc)]{
            let a=allocation(old::call,&body,wrap);let b=allocation(new::call,&body,wrap);
            println!("{label} wrap={wrap} height={out}: allocator (alloc/realloc requests, peak vector bytes) {:?} -> {:?}",a,b);
        }
        #[cfg(not(count_alloc))]{
            let mut a=vec![];let mut b=vec![];
            for pass in 0..11{
                let (x,y)=if pass%2==0{(nanos(old::call,&body,wrap,_iterations),nanos(new::call,&body,wrap,_iterations))}else{
                    let y=nanos(new::call,&body,wrap,_iterations);(nanos(old::call,&body,wrap,_iterations),y)
                };a.push(x);b.push(y);
            }
            a.sort_by(f64::total_cmp);b.sort_by(f64::total_cmp);
            println!("{label} wrap={wrap} height={out}: median ns/call {:.1} -> {:.1}; {} calls/sample, 11 alternating pairs",a[5],b[5],_iterations);
        }
    }
}

+    #[tokio::test]
+    async fn round4_projection_trace() {
+        use crate::{
+            app_server::http::round4::Tap,
+            contracts::ExecutionAttribution,
+            core::{JournalEntry, SessionExecutionRecorder, SessionStore, TurnOpened},
+            domain::AgentTask,
+        };
+        for (shape, chunked, tagged) in [
+            ("terminal", false, false),
+            ("deltas-terminal", true, false),
+            ("deltas-completed-terminal", true, true),
+        ] {
+            // Deliberately invalid as JSON. The answer must remain uninterpreted
+            // text, byte for byte, including fences, braces and UTF-8.
+            let chunks = ["{\"answer\":", " не JSON ", "\n```rust\n", "x()\n```"];
+            let text = chunks.concat();
+            let message = CanonicalMessage::text(MessageRole::Assistant, text.clone());
+            let mut events = Vec::new();
+            if chunked {
+                for c in chunks {
+                    events.push(ModelStreamEvent::TextDelta {
+                        message_id: message.id,
+                        phase: None,
+                        text: c.into(),
+                    });
+                }
+            }
+            if tagged {
+                events.push(ModelStreamEvent::MessageCompleted {
+                    message: message.clone(),
+                });
+            }
+            events.push(ModelStreamEvent::Response {
+                response: CanonicalModelResponse::new(message.clone(), vec![], FinishReason::Stop),
+            });
+            let message = if tagged {
+                let file =
+                    std::fs::read(concat!(env!("CARGO_MANIFEST_DIR"), "/r4-provider.json")).unwrap();
+                events = serde_json::from_slice(&file).unwrap();
+                let Some(ModelStreamEvent::Response { response }) = events.last() else {
+                    panic!()
+                };
+                response.messages[0].clone()
+            } else {
+                message
+            };
+            let root = tempfile::tempdir().unwrap();
+            let session = new_session_id();
+            let thread = new_thread_id();
+            let turn = new_turn_id();
+            let scope = ExecutionScope::fresh(CancellationToken::new());
+            let exec = scope.execution_id;
+            let store = SessionStore::new(
+                crate::test_support::storage(std::path::Path::new(".")),
+                root.path(),
+                root.path(),
+                session,
+            )
+            .unwrap();
+            store
+                .append_execution_journal_entry(
+                    ExecutionAttribution::for_turn(exec, session, thread, turn),
+                    JournalEntry::TurnOpened(TurnOpened {
+                        intent: None,
+                        task: AgentTask::new("round4", root.path().to_owned()),
+                        base_history_revision: 0,
+                        module_epoch: 0,
+                        config_snapshot: serde_json::json!({}),
+                    }),
+                )
+                .await
+                .unwrap();
+            let mut tap = Tap::new(session).await;
+            let model = BoundModel::new(
+                Arc::new(ModelService::new(Arc::new(ScriptedAdapter::new(events)))),
+                ModelExecutionBinding::for_turn(
+                    scope,
+                    Arc::new(EventEmitter::new(tap.sink.clone())),
+                    session,
+                    thread,
+                    turn,
+                    Arc::new(SessionExecutionRecorder::for_turn(
+                        store.clone(),
+                        exec,
+                        thread,
+                        turn,
+                    )),
+                ),
+                0,
+            );
+            eprintln!("R4 begin {shape}");
+            let result = model.complete(sample_request()).await.unwrap();
+            assert_eq!(result.messages, vec![message.clone()]);
+            tap.verify(&text, if chunked { chunks.len() } else { 0 })
+                .await;
+            let journal = store.load_records().unwrap();
+            let completed=journal.iter().filter(|r| matches!(&r.entry, JournalEntry::ModelMessageRecorded(v) if v.message == message)).count();
+            let terminal = journal
+                .iter()
+                .filter(|r| matches!(&r.entry, JournalEntry::ModelResponseRecorded(_)))
+                .count();
+            assert_eq!(completed, usize::from(tagged));
+            assert_eq!(terminal, 1);
+            eprintln!(
+                "R4 journal item_completed={completed} terminal_response={terminal}; end {shape}"
+            );
+        }
+    }

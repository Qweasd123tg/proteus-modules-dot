+#[cfg(test)]
+pub(crate) mod round4 {
+    use super::super::{AppEventPublisher, RuntimeEventSink, events::AppSubscription};
+    use super::{AppServerEvent, StdioOutput, encode_sse_output};
+    use crate::{
+        contracts::{EventSink, FilteredEventSink, is_streaming_delta},
+        core::{FanoutEventSink, JsonlEventStore},
+        domain::{Event, EventEnvelope, SessionId},
+    };
+    use std::sync::Arc;
+    pub(crate) struct Tap {
+        pub sink: Arc<dyn EventSink>,
+        published: AppEventPublisher,
+        sub: AppSubscription,
+        root: tempfile::TempDir,
+    }
+    impl Tap {
+        pub async fn new(id: SessionId) -> Self {
+            let published = AppEventPublisher::new(64, id, None);
+            let mut sub = published.subscribe_session();
+            sub.recv().await.unwrap();
+            sub.recv().await.unwrap();
+            let live = Arc::new(RuntimeEventSink::default());
+            assert!(live.0.set(published.clone()).is_ok());
+            let root = tempfile::tempdir().unwrap();
+            let jsonl = Arc::new(JsonlEventStore::new(root.path().join("events.jsonl")));
+            let sink = Arc::new(FanoutEventSink::new(vec![
+                Arc::new(FilteredEventSink::new(jsonl, |e| !is_streaming_delta(e))),
+                live,
+            ]));
+            Self {
+                sink,
+                published,
+                sub,
+                root,
+            }
+        }
+        pub async fn verify(&mut self, text: &str, n: usize) {
+            let (mut d, mut c, mut dx, mut full) = (0, 0, String::new(), String::new());
+            for _ in 0..n + 1 {
+                let event =
+                    tokio::time::timeout(std::time::Duration::from_secs(2), self.sub.recv())
+                        .await
+                        .unwrap()
+                        .unwrap();
+                let wire = encode_sse_output(&StdioOutput::Event {
+                    event: Box::new(event),
+                });
+                let body = std::str::from_utf8(&wire)
+                    .unwrap()
+                    .strip_prefix("event: output\ndata: ")
+                    .unwrap()
+                    .strip_suffix("\n\n")
+                    .unwrap();
+                let StdioOutput::Event { event } = serde_json::from_str(body).unwrap() else {
+                    panic!()
+                };
+                let AppServerEvent::Runtime { envelope } = *event else {
+                    panic!()
+                };
+                match envelope.event {
+                    Event::AssistantTextDelta { text, offset, .. } => {
+                        assert_eq!(offset, dx.len());
+                        d += 1;
+                        dx.push_str(&text);
+                    }
+                    Event::AssistantMessageCompleted { text, .. } => {
+                        c += 1;
+                        full = text;
+                    }
+                    _ => panic!(),
+                }
+            }
+            assert_eq!(d, n);
+            assert_eq!(c, 1);
+            assert_eq!(full, text);
+            if n > 0 {
+                assert_eq!(dx, text);
+            }
+            let rows = self.published.session_snapshot().unwrap().transcript;
+            assert_eq!(rows.len(), 1);
+            assert_eq!(rows[0].text, text);
+            assert!(!rows[0].streaming);
+            let file = std::fs::read_to_string(self.root.path().join("events.jsonl")).unwrap();
+            let jsonl: Vec<EventEnvelope> = file
+                .lines()
+                .map(|line| serde_json::from_str(line).unwrap())
+                .collect();
+            assert_eq!(jsonl.len(), 1);
+            assert!(
+                matches!(&jsonl[0].event,Event::AssistantMessageCompleted{text:t,..} if t==text)
+            );
+            eprintln!(
+                "R4 transport deltas={d} delta_bytes={} completed={c} completed_bytes={} encoded_frames={} client_envelope_decodes={} durable_eventlog_rows={} progress_final_rows=1",
+                dx.len(),
+                full.len(),
+                d + c,
+                d + c,
+                jsonl.len()
+            );
+        }
+    }
+}

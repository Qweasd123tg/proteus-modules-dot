+    #[test]
+    fn one_cell_flattens_each_logical_line_break_once() {
+        for br in ["\n", "\r\n", "\r"] {
+            assert_eq!(
+                md_cell(&format!(" first|part{br}{br}last ")),
+                "first\\|part  last"
+            );
+        }
+    }
+}

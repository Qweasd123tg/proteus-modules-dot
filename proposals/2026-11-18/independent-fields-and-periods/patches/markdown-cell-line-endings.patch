 fn md_cell(value: &str) -> String {
-    value
-        .replace('\n', " ")
-        .replace('|', "\\|")
-        .trim()
-        .to_owned()
+    let value = value.trim();
+    let mut escaped = String::with_capacity(value.len());
+    let mut chars = value.chars().peekable();
+    while let Some(ch) = chars.next() {
+        match ch {
+            '\r' => {
+                chars.next_if_eq(&'\n');
+                escaped.push(' ');
+            }
+            '\n' => escaped.push(' '),
+            '|' => escaped.push_str("\\|"),
+            ch => escaped.push(ch),
+        }
+    }
+    escaped
 }
 
 fn md_inline(value: &str) -> String {
     value.replace('`', "\\`")
 }

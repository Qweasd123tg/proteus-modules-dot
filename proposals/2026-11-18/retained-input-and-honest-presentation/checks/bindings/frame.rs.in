#![allow(dead_code)]
use std::{cell::{RefCell,Ref},collections::HashMap,rc::Rc};
type SharedString=Rc<str>;
struct Window;
#[derive(Clone)] struct Entity<T>(Rc<RefCell<T>>);
impl<T> Entity<T>{fn read<'a,C>(&'a self,_:&C)->Ref<'a,T>{self.0.borrow()} fn id(&self)->usize{Rc::as_ptr(&self.0) as usize}}
#[derive(Clone)] struct InputState{value:SharedString,placeholder:String,min:usize,max:usize}
type TextareaState=InputState;
impl InputState{
    fn new<C>(_:&mut Window,_:&mut C)->Self{Self{value:"".into(),placeholder:String::new(),min:1,max:1}}
    fn value(&self)->SharedString{self.value.clone()}
    fn placeholder(mut self,p:String)->Self{self.placeholder=p;self}
    fn set_value<C>(&mut self,v:String,_:&mut Window,_:&mut C){self.value=v.into()}
    fn auto_grow(mut self,min:usize,max:usize)->Self{self.min=min;self.max=max;self}
}
struct TextInput {/*INPUT_PROPS*/}
enum Text { Line(Entity<InputState>), Area(Entity<TextareaState>) }
impl Text{
    fn e(&self)->&Entity<InputState>{match self{Self::Line(s)|Self::Area(s)=>s}}
    fn set_value<C>(&self,v:String,w:&mut Window,cx:&mut C){self.e().0.borrow_mut().set_value(v,w,cx)}
    fn set_placeholder<C>(&self,p:String,_:&mut Window,_:&mut C){self.e().0.borrow_mut().placeholder=p}
    fn value<C>(&self,cx:&C)->SharedString{self.e().read(cx).value()}
}
enum InputEvent{Change,PressEnter{secondary:bool},Other}
struct Subscription;
type Handler=Rc<dyn Fn(&mut DeclarativeView,&InputEvent,&mut Context<DeclarativeView>)>;
struct Context<T>{handlers:HashMap<usize,Handler>,_t:std::marker::PhantomData<T>}
impl Context<DeclarativeView>{
    fn new<T>(&mut self,f:impl FnOnce(&mut Self)->T)->Entity<T>{Entity(Rc::new(RefCell::new(f(self))))}
    fn subscribe<T:Clone+'static>(&mut self,state:&Entity<T>,f:impl Fn(&mut DeclarativeView,Entity<T>,&InputEvent,&mut Self)+'static)->Subscription{
        let entity=state.clone();self.handlers.insert(entity.id(),Rc::new(move|v,e,c|f(v,entity.clone(),e,c)));Subscription
    }
}
mod textarea{
    use super::*; pub fn max_rows(value:&str,min:usize,grow:bool)->usize{if grow{(value.chars().count()+1).max(min)}else{min}}
    pub fn resize<C>(entity:&Entity<TextareaState>,min:usize,grow:bool,_:&mut C){let mut r=entity.0.borrow_mut();r.min=min;r.max=max_rows(&r.value,min,grow);}
    pub fn preview(_:&str)->Option<String>{None} pub fn disclosure_id(id:&str)->String{format!("input-preview:{id}")}
}
#[derive(Default)] struct Fields{inputs:HashMap<String,TextInput>,disclosures:HashMap<String,bool>}
#[derive(Default)] struct DeclarativeView{fields:Fields,sent:Vec<(String,serde_json::Value)>}
enum Node{Input{id:String,value:String,placeholder:String,action:String,lines:usize,submit:Option<String>,search:bool}}
impl DeclarativeView{
    fn act(&mut self,a:String,v:Option<serde_json::Value>,_:&mut Context<Self>){self.sent.push((a,v.unwrap()))}
    fn prepare(&mut self,node:&Node,settings:bool,window:&mut Window,cx:&mut Context<Self>){ match node{/*ARM*/} }
}
fn node(height:usize,search:bool,change:&str,submit:Option<&str>)->Node{
    Node::Input{id:"note".into(),value:"server value".into(),placeholder:"hint".into(),action:change.into(),lines:height,submit:submit.map(str::to_owned),search}
}
fn valid(n:&Node)->bool{match n { Node::Input{search:true,lines,..} if *lines!=1=>false,Node::Input{lines,..} if !(1..=40).contains(lines)=>false,_=>true}}
fn fire(v:&mut DeclarativeView,cx:&mut Context<DeclarativeView>,event:InputEvent,text:&str)->Option<String>{
    let e=v.fields.inputs["note"].state.e().clone();e.0.borrow_mut().value=text.into();
    let h=cx.handlers[&e.id()].clone();let last=v.sent.len();h(v,&event,cx);if last==v.sent.len(){None}else{let (a,x)=v.sent.last().unwrap();assert_eq!(x.as_str(),Some(text));Some(a.clone())}
}
fn main(){
    let mut good=0;let mut failed=0;let mut stable=0;let mut resize_bad=0;let mut resize_count=0;
    for initial in [1,2,3,8] {for revised in [1,2,3,8]{if (initial==1)!=(revised==1){continue}
    for start in [None,Some("save.previous"),Some("save.next")] {for next in [None,Some("save.previous"),Some("save.next")] {
    for a in ["draft.previous","draft.next"] {for match_value in [false,true]{
        let mut w=Window;let mut v=DeclarativeView::default();let mut c=Context{handlers:HashMap::new(),_t:std::marker::PhantomData};let first=node(initial,false,"draft.previous",start);let second=node(revised,false,a,next);
        assert!(valid(&first)&&valid(&second));v.prepare(&first,false,&mut w,&mut c);let native=v.fields.inputs["note"].state.e().id();v.prepare(&second,false,&mut w,&mut c);
        assert_eq!(native,v.fields.inputs["note"].state.e().id());assert_eq!(c.handlers.len(),1);stable+=1;
        let text=if match_value{"server value"}else{"new draft"};
        for (event,expected) in [(InputEvent::Change,(!match_value).then_some(a)),(InputEvent::PressEnter{secondary:false},if revised==1{next}else{None}),(InputEvent::PressEnter{secondary:true},if revised>1{next}else{None}),(InputEvent::Other,None)]{
            let got=fire(&mut v,&mut c,event,text);if got.as_deref()==expected{good+=1}else{failed+=1;}
        }
        if revised>1{resize_count+=1;if v.fields.inputs["note"].state.e().read(&c).min!=revised{resize_bad+=1;}}
    }}}}}}
    println!("{stable} stable same-kind field transitions; {good} correct events, {failed} wrong events vs latest definition; {resize_bad}/{resize_count} wrong textarea minimums after editing");
    if cfg!(before){assert!(failed>0&&resize_bad>0)}else{assert_eq!((failed,resize_bad),(0,0))}
    let mut c=Context{handlers:HashMap::new(),_t:std::marker::PhantomData};let mut v=DeclarativeView::default();let mut w=Window;
    let first=node(3,false,"first",None);let second=node(1,true,"find",None);assert!(valid(&first)&&valid(&second));v.prepare(&first,false,&mut w,&mut c);v.prepare(&second,false,&mut w,&mut c);
    assert!(matches!(&v.fields.inputs["note"].state,Text::Area(_)));
    println!("OPEN separately: valid textarea -> same-id compact search retains Text::Area; production search branch paints an empty div in this case.");
}

+    fn rows(n: usize, chars: usize) -> Vec<AppTranscriptMessage> {
+        (0..n)
+            .map(|i| AppTranscriptMessage {
+                message_id: Some(uuid::Uuid::from_u128(i as u128 + 7)),
+                timestamp_ms: Some(i as i64),
+                phase: None,
+                role: if i % 2 == 0 { "user" } else { "assistant" }.into(),
+                text: format!("{i} \"первая строка\"\n終\\ {}", "x".repeat(chars)),
+                images: vec![],
+                tool: None,
+                subagent: None,
+                streaming: false,
+            })
+            .collect()
+    }
+    fn event(n: usize, len: usize) -> StdioOutput {
+        StdioOutput::Event {
+            event: Box::new(AppServerEvent::SessionSnapshot {
+                snapshot: Box::new(AppSessionSnapshot {
+                    session_id: uuid::Uuid::from_u128(42),
+                    stream_id: "stream".into(),
+                    seq: 43,
+                    root_thread_id: None,
+                    transcript: rows(n, len),
+                    history: None,
+                    execution: Default::default(),
+                }),
+            }),
+        }
+    }
+    fn reference(output: &StdioOutput) -> Vec<u8> {
+        let json=serde_json::to_string(output).unwrap_or_else(|error|
+            serde_json::to_string(&serde_json::json!({"type":"response","id":null,"ok":false,"output":null,"error":format!("{error:#}")})).unwrap());
+        format!("event: output\ndata: {json}\n\n").into_bytes()
+    }
+
+    #[test]
+    fn exact_wire_and_partial_json_failure() {
+        for (n, len) in [(0, 0), (1, 0), (2, 1), (50, 1024), (1, 1048576)] {
+            let item = event(n, len);
+            assert_eq!(encode_sse_output(&item).as_ref(), reference(&item));
+        }
+        #[cfg(unix)]
+        {
+            use std::os::unix::ffi::OsStringExt;
+            let mut o = event(1, 1024);
+            let StdioOutput::Event { event } = &mut o else {
+                unreachable!()
+            };
+            let AppServerEvent::SessionSnapshot { snapshot } = event.as_mut() else {
+                unreachable!()
+            };
+            snapshot.transcript[0].images.push(crate::domain::ImageRef {
+                id: "img".into(),
+                name: "fixture".into(),
+                mime_type: "image/png".into(),
+                path: std::ffi::OsString::from_vec(vec![255, 254]).into(),
+            });
+            assert!(serde_json::to_string(&o).is_err());
+            let actual = encode_sse_output(&o);
+            assert_eq!(actual.as_ref(), reference(&o));
+            let body = std::str::from_utf8(&actual)
+                .unwrap()
+                .strip_prefix("event: output\ndata: ")
+                .unwrap()
+                .strip_suffix("\n\n")
+                .unwrap();
+            assert!(matches!(
+                serde_json::from_str::<StdioOutput>(body).unwrap(),
+                StdioOutput::Response { ok: false, .. }
+            ));
+        }
+    }

+    // Small independent test client: real HTTP/1.1 chunk boundaries do not
+    // necessarily coincide with SSE frames. No Desktop widget/paint is timed.
+    fn receive(addr: SocketAddr, dir: &str, expected: &serde_json::Value) -> u128 {
+        let start = Instant::now();
+        let mut stream = TcpStream::connect(addr).unwrap();
+        stream.set_nodelay(true).unwrap();
+        stream
+            .set_read_timeout(Some(Duration::from_secs(15)))
+            .unwrap();
+        write!(stream,"GET /events?session_dir={dir} HTTP/1.1\r\nHost: {addr}\r\nAuthorization: Bearer session-secret\r\nOrigin: http://127.0.0.1:1430\r\nAccept: text/event-stream\r\n\r\n").unwrap();
+        let mut rd = BufReader::new(stream);
+        let mut line = String::new();
+        rd.read_line(&mut line).unwrap();
+        assert!(line.contains(" 200 "), "{line}");
+        loop {
+            line.clear();
+            rd.read_line(&mut line).unwrap();
+            if line == "\r\n" {
+                break;
+            }
+        }
+        let mut buf = Vec::new();
+        loop {
+            line.clear();
+            assert!(rd.read_line(&mut line).unwrap() > 0);
+            let n = usize::from_str_radix(line.trim().split(';').next().unwrap(), 16).unwrap();
+            assert!(n > 0);
+            let pos = buf.len();
+            buf.resize(pos + n, 0);
+            rd.read_exact(&mut buf[pos..]).unwrap();
+            let mut crlf = [0; 2];
+            rd.read_exact(&mut crlf).unwrap();
+            assert_eq!(crlf, *b"\r\n");
+            let received_at = start.elapsed().as_nanos();
+            while let Some(end) = buf.windows(2).position(|x| x == b"\n\n") {
+                let frame = &buf[..end];
+                if let Some(data) = frame.strip_prefix(b"event: output\ndata: ") {
+                    if let StdioOutput::Event { event } =
+                        serde_json::from_slice::<StdioOutput>(data).unwrap()
+                        && let AppServerEvent::SessionSnapshot { snapshot } = *event
+                    {
+                        assert_eq!(
+                            serde_json::to_value(snapshot.transcript).unwrap(),
+                            *expected
+                        );
+                        return received_at;
+                    }
+                }
+                buf.drain(..end + 2);
+            }
+        }
+    }

+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    #[ignore = "paired Core/HTTP benchmark, release binaries run sequentially"]
+    async fn measure_initial_frame() {
+        let (state, server, _root) = test_state().await;
+        server.start_session().await.unwrap();
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let accept = tokio::spawn(async move {
+            loop {
+                let (stream, _) = listener.accept().await.unwrap();
+                let state = state.clone();
+                tokio::spawn(async move {
+                    let service = service_fn(move |req| route_request(state.clone(), req));
+                    let _ = http1::Builder::new()
+                        .serve_connection(TokioIo::new(stream), service)
+                        .await;
+                });
+            }
+        });
+        let dir = server
+            .session_dir_path()
+            .unwrap()
+            .to_str()
+            .unwrap()
+            .to_owned();
+        for (shape, n, len) in [
+            ("empty", 0, 0),
+            ("short", 1, 80),
+            ("typical", 50, 1024),
+            ("large", 50, 65536),
+        ] {
+            let payload = event(n, len);
+            let fixture = rows(n, len);
+            // Load canonical rows via the actual configured JSONL worker before
+            // timing a warm connection. This stage is not included in GET latency.
+            let store = server.runtime.session_store().unwrap();
+            let thread = crate::domain::new_thread_id();
+            store.clear_history(thread).await.unwrap();
+            let canon: Vec<_> = fixture
+                .iter()
+                .map(|row| {
+                    use crate::model_standard::{CanonicalMessage, MessageRole};
+                    CanonicalMessage::text(
+                        if row.role == "user" {
+                            MessageRole::User
+                        } else {
+                            MessageRole::Assistant
+                        },
+                        row.text.clone(),
+                    )
+                })
+                .collect();
+            if !canon.is_empty() {
+                store.append_history(thread, None, &canon).await.unwrap();
+            }
+            let completed =
+                crate::app_server::read_model::project_completed_transcript(store).unwrap();
+            assert!(
+                completed
+                    .messages
+                    .iter()
+                    .map(|row| (&row.role, &row.text))
+                    .eq(fixture.iter().map(|row| (&row.role, &row.text)))
+            );
+            let expected = Arc::new(serde_json::to_value(&completed.messages).unwrap());
+            server.events.finish_progress(Ok(completed));
+            for rep in 0..10 {
+                let start = Instant::now();
+                let mut byte_count = 0;
+                let loops = if n * len < 10000 {
+                    512
+                } else if len < 65536 {
+                    64
+                } else {
+                    8
+                };
+                for _ in 0..loops {
+                    let bytes: Bytes =
+                        std::hint::black_box(encode_sse_output(std::hint::black_box(&payload)));
+                    byte_count = bytes.len();
+                }
+                let local = start.elapsed().as_nanos() / loops as u128;
+                let d = dir.clone();
+                let e = expected.clone();
+                let wire = tokio::task::spawn_blocking(move || receive(addr, &d, &e))
+                    .await
+                    .unwrap();
+                println!(
+                    "FRAME shape={shape} rep={rep} bytes={byte_count} encoder_ns={local} tcp_to_full_snapshot_ns={wire}"
+                );
+            }
+        }
+        accept.abort();
+        server.shutdown().await;
+    }

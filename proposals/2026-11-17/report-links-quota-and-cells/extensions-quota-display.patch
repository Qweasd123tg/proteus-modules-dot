+/// Extra text only when the reported percentage actually exceeds the limit.
+pub fn overage(used: f64) -> String {
+    if used <= 100. {
+        return String::new();
+    }
+    if used < 100.1 {
+        return " · сверх лимита <0,1%".to_owned();
+    }
+    format!(" · сверх лимита {}%", number(used - 100.))
+}

+/// Full preview before the row clips it, or the title shown for an empty session.
+pub(crate) fn preview_title(summary: &ConversationSummary) -> &str {
+    summary
+        .preview
+        .as_deref()
+        .map(str::trim)
+        .filter(|preview| !preview.is_empty())
+        .unwrap_or("Новая сессия")
+}

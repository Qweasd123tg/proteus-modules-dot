 }
 fn split_oracle(s:&str)->Vec<&str>{let bytes=s.as_bytes();let mut beg=0;let mut out=Vec::new();
  for (i,&b) in bytes.iter().enumerate(){if b==b'\n' {let end=if i>beg&&bytes[i-1]==b'\r'{i-1}else{i};out.push(&s[beg..end]);beg=i+1;}}out.push(&s[beg..]);out}
 fn state(n:usize,selected:bool)->State{let mut d=String::new();let mut v=Vec::new();for i in 0..n{let a=d.len();d.push_str("猫");let b=if selected{d.len()}else{a};v.push(CursorSelection{start:a,end:b});d.push(char::from(b'1'+i as u8));d.push('\n');}v.reverse();State{selections:Selections(v),undo_manager:UndoManager::new(),multi:true,doc:d,probe:false,dispatched:0}}
 fn result(d:&str,sel:&[CursorSelection],s:&str)->String{let mut after=String::new();let mut prev=0;let mut v=sel.to_vec();v.sort_by_key(|x|x.start);let f=split_oracle(s);for (i,r) in v.iter().enumerate(){after.push_str(&d[prev..r.start]);after.push_str(if f.len()==v.len()&&v.len()>1{f[i]}else{s});prev=r.end;}after.push_str(&d[prev..]);after}
 pub fn run(){let mut strings=vec![String::new(),"A\r\nБ".into(),"A\r\nБ\nC".into(),"x\r\r\ny\r".into()];let mut layer=vec![String::new()];for _ in 0..4{layer=layer.iter().flat_map(|s|["A","\r","\n","я","🦀"].iter().map(move |c|format!("{s}{c}"))).collect();strings.extend_from_slice(&layer);}
  strings.sort();strings.dedup();
  let mut tot=0;let mut wrong=0;let mut undos=0;let mut controls=0;
  for s in &strings {for n in 1..=5{for selected in [false,true]{let mut st=state(n,selected);let d=st.doc.clone();let sel=st.selections.0.clone();let expected=if s.is_empty(){d.clone()}else{result(&d,&sel,s)};let mut cx=Context(std::marker::PhantomData);st.insert_clipboard(ClipboardItem(Some(s.clone())),&mut Window,&mut cx);
  let got=st.doc.clone();tot+=1;
  if got!=expected{wrong+=1;assert!(n>1&&s.contains("\r\n")&&split_oracle(s).len()==n);}else if n==1||!s.contains("\r\n")||split_oracle(s).len()!=n{controls+=1;}
  if got!=d{
   let replay=st.undo_manager.undo().expect("one undo");for ch in replay.changes{st.doc.replace_range(ch.new_range,&ch.old_text);}assert_eq!(st.doc,d);assert_eq!(replay.selections.as_deref(),Some(sel.as_slice()));assert!(st.undo_manager.undo().is_none());let redo=st.undo_manager.redo().unwrap();for ch in redo.changes{st.doc.replace_range(ch.old_range,&ch.new_text);}assert_eq!(st.doc,got);undos+=1;
  }
  }}}
  println!("native matrix={tot} incorrect text={wrong}, not-affected controls={controls}, changed pastes restoring original text/selections in one real UndoManager transaction and redoing={undos}");
  if cfg!(candidate){assert_eq!(wrong,0);}else{assert!(wrong>0);}
  for n in [1,2]{let mut st=state(n,false);st.probe=true;let mut cx=Context(std::marker::PhantomData);
   let input=ClipboardItem(Some("x\n".repeat(10_000)));CALLS.store(0,Ordering::Relaxed);BYTES.store(0,Ordering::Relaxed);TRACK.store(true,Ordering::Relaxed);
   st.insert_clipboard(input,&mut Window,&mut cx);TRACK.store(false,Ordering::Relaxed);let (a,b)=(CALLS.load(Ordering::Relaxed),BYTES.load(Ordering::Relaxed));println!("20,000 byte synthetic paste ({n} cursors, fallback): {a} allocation/reallocation calls; {b} bytes requested cumulatively (not live bytes), including one cloned clipboard string; replacement sink disabled.");
   if cfg!(candidate){assert_eq!((a,b),(1,20000));}else{assert!(a>=10001);}
  }
 }
}

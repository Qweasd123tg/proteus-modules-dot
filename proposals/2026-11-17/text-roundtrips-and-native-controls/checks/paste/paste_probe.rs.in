 mod change { include!("change.rs"); }
 mod undo_manager { include!("undo_manager.rs"); }
 use cursor::CursorSelection;use undo_manager::{EditIntent,UndoManager};
 struct Window;struct Context<T>(std::marker::PhantomData<T>);struct ClipboardItem(Option<String>);
 impl ClipboardItem{fn text(&self)->Option<String>{self.0.clone()}}
 struct Selections(Vec<CursorSelection>);impl Selections{fn is_single(&self)->bool{self.0.len()==1}fn merge_overlapping(&mut self){}fn len(&self)->usize{self.0.len()}fn iter(&self)->std::slice::Iter<'_,CursorSelection>{self.0.iter()}}
 struct State{selections:Selections,undo_manager:UndoManager,multi:bool,doc:String,probe:bool,dispatched:usize}
 impl State{
 fn is_multi_line(&self)->bool{self.multi}
 fn cursor(&self)->usize{self.selections.0[0].end}
 fn scroll_to(&mut self,_:usize,_:Option<()>,_:&mut Context<Self>){}
 fn replace_text_in_range_silent(&mut self,_:Option<Range<usize>>,s:&str,w:&mut Window,c:&mut Context<Self>){if self.probe {self.dispatched+=1;return;}let e:Vec<_>=self.selections.iter().map(|c|(c.start..c.end,s.to_owned())).collect();self.replace_text_in_ranges(&e,w,c);}
 fn replace_text_in_ranges(&mut self,edits:&[(Range<usize>,String)],_:&mut Window,_:&mut Context<Self>){
  self.dispatched+=1;if self.probe{return;}
  let intent=self.undo_manager.take_pending_intent().unwrap(); assert_eq!(intent,EditIntent::Atomic);
  let mut es=edits.to_vec();es.sort_by_key(|e|std::cmp::Reverse(e.0.start));let grouped=es.len()>1;
  if grouped{self.undo_manager.begin_transaction();}
  let mut recorded=false;for (r,s) in &es{
   let ch=change::Change::new(r.clone(),&self.doc[r.clone()],r.start..r.start+s.len(),s);
   self.doc.replace_range(r.clone(),s);recorded|=self.undo_manager.record_transaction(ch,intent);
  }
  if grouped{self.undo_manager.commit_transaction();}
  let before=self.selections.0.clone();let mut d=0isize;let mut after=Vec::new();for (r,s) in es.iter().rev(){
   let pos=(r.start as isize+d) as usize+s.len();after.push(CursorSelection{start:pos,end:pos});d+=s.len() as isize-r.len() as isize;
  }
  if recorded {self.undo_manager.record_selections(before,after.clone());}self.selections.0=after;
 }

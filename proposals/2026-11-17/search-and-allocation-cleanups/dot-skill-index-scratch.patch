@@ -0,0 +1,71 @@
+use proteus_bounded_skill_index_prototype::{
+    BodyExcerpt, CurrentSkill, Error, Limits, SkillFacts, SkillIndex, SnapshotKey,
+};
+
+#[test]
+fn tokenize_fields_independently_without_leaking_incomplete_words() {
+    let key = SnapshotKey {
+        binding_epoch: 1,
+        catalog_revision: 2,
+    };
+    let long = "X".repeat(65);
+    let first = SkillFacts {
+        id: "a",
+        source_id: "demo",
+        sha256: [1; 32],
+        name: "İ",
+        description: &long,
+        body: Some(BodyExcerpt {
+            text: "shown hidden",
+            complete: false,
+        }),
+    };
+    let second = SkillFacts {
+        id: "b",
+        source_id: "demo",
+        sha256: [2; 32],
+        name: "Beta",
+        description: "second",
+        body: Some(BodyExcerpt {
+            text: "visible",
+            complete: true,
+        }),
+    };
+    let index = SkillIndex::build(key, &[second, first], Limits::default()).unwrap();
+    let current = [first, second].map(|f| CurrentSkill {
+        id: f.id,
+        source_id: f.source_id,
+        sha256: f.sha256,
+    });
+    for (query, id, weight) in [
+        ("i", "a", 4),
+        ("shown", "a", 1),
+        ("beta", "b", 4),
+        ("second", "b", 2),
+        ("visible", "b", 1),
+    ] {
+        let result = index.search(key, &current, query, 2).unwrap();
+        assert_eq!(result.hits.len(), 1, "{query}");
+        assert_eq!(
+            (result.hits[0].id, result.hits[0].score.field_weight),
+            (id, weight)
+        );
+    }
+    for absent in ["hidden", "hiddenvisible", "secondshown", &"x".repeat(64)] {
+        assert!(
+            index
+                .search(key, &current, absent, 2)
+                .unwrap()
+                .hits
+                .is_empty(),
+            "{absent}"
+        );
+    }
+    let partial = index.search(key, &current, "shown", 2).unwrap().hits[0].coverage;
+    assert!(partial.body_partial);
+    assert_eq!(partial.metadata_long_tokens_omitted, 1);
+    assert_eq!(
+        index.search(key, &current, &long, 2).unwrap_err(),
+        Error::QueryTokenTooLong
+    );
+}

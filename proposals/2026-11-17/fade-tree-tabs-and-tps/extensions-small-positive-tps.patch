 pub fn decimal(value: f64) -> String {
+    // A small positive rate or duration would otherwise read exactly like zero.
+    if value > 0.0 && value < 0.05 {
+        return "<0,1".into();
+    }
     format!("{value:.1}").replace('.', ",")
 }
 

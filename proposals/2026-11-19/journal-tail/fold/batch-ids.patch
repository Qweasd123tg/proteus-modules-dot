+/// The retained prefix is already valid. Store only the candidate IDs from
+/// this append, strike IDs seen in the prefix, then consume candidates in
+/// canonical order. A missing ID is precisely the first duplicate that the
+/// full pass would report, whether it was reused in the prefix or the batch.
+fn validate_appended_ids(prefix: &[CanonicalMessage], added: &[CanonicalMessage]) -> Result<()> {
+    let mut messages = added.iter().map(|m| m.id).collect::<HashSet<_>>();
+    let mut parts = added
+        .iter()
+        .flat_map(|m| m.parts.iter().map(|p| p.part_id))
+        .collect::<HashSet<_>>();
+    for message in prefix {
+        messages.remove(&message.id);
+        for part in &message.parts {
+            parts.remove(&part.part_id);
+        }
+    }
+    for message in added {
+        validate_message_ids(message, messages.remove(&message.id), |id| parts.remove(&id))?;
+    }
+    Ok(())
+}

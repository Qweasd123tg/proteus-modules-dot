index 0000000000000000000000000000000000000000..d781c7d734cc9041814c2a95da71b4477d911348
--- /dev/null
+++ b/crates/proteus-core/src/core/session_store/remote/snapshot/suffix.rs
@@ -0,0 +1,52 @@
+//! One short-lived owned replay buffer, only for a strictly read append.
+//! Budgets are record count and canonical encoded bytes, not heap estimates.
+use std::io::{self, Write};
+
+use super::JournalRecord;
+
+const MAX_RECORDS: u64 = 16;
+const MAX_BYTES: usize = 256 * 1024;
+
+pub(super) struct SmallSuffix {
+    records: Vec<JournalRecord>,
+    remaining: usize,
+}
+
+impl SmallSuffix {
+    pub(super) fn for_range(previous: u64, end: u64) -> Option<Self> {
+        let count = end.checked_sub(previous)?;
+        // Preserve ordinary scan/error behavior for an empty suffix.
+        (1..=MAX_RECORDS).contains(&count).then(|| Self {
+            records: Vec::with_capacity(count as usize),
+            remaining: MAX_BYTES,
+        })
+    }
+    pub(super) fn try_push(&mut self, record: JournalRecord) -> bool {
+        let mut budget = Budget(self.remaining);
+        if self.records.len() >= MAX_RECORDS as usize
+            || serde_json::to_writer(&mut budget, &record).is_err()
+        {
+            return false;
+        }
+        self.remaining = budget.0;
+        self.records.push(record);
+        true
+    }
+    pub(super) fn into_records(self) -> Vec<JournalRecord> {
+        self.records
+    }
+}
+
+struct Budget(usize);
+impl Write for Budget {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.0 = self
+            .0
+            .checked_sub(bytes.len())
+            .ok_or_else(|| io::Error::other("display suffix exceeds its byte budget"))?;
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}

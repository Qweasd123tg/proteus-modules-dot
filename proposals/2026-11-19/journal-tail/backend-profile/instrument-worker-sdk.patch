 //! The worker remains an executable with its configured OS permissions. Host
 //! callbacks retain the active invocation's authority; SDK use grants no rights.
 
+
+pub(crate) mod perf8 {
+use std::time::{Instant,SystemTime,UNIX_EPOCH};
+use std::io::Write;
+pub fn now()->u128 {SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos()}
+pub fn log(label:&str, stage:&str, value:usize,start:u128, t:Instant) {
+ let n=t.elapsed().as_nanos();
+ let worker=std::env::current_exe().unwrap(); let side=worker.parent().unwrap().file_name().unwrap().to_str().unwrap();
+ let p=std::path::PathBuf::from(env!("PERF8_SDK_TRACE")); let _=side;
+ let mut f=std::fs::OpenOptions::new().append(true).create(true).open(p).unwrap();
+ writeln!(f,"{start}\t{n}\t{stage}\t{label}\t{value}\t{}\t{}",std::process::id(),std::thread::current().name().unwrap_or("unnamed")).unwrap();
+}
+}

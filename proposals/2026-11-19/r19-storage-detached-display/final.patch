+#[test]
+fn jsonl_freeze_defers_hashing_and_refuses_a_changed_unauthenticated_prefix() {
+    use crate::backend::{JournalBackend, Jsonl};
+
+    let mut f = Fixture::new(BackendKind::Jsonl);
+    f.append(vec![text("pinned")]);
+    let dir = f.descriptor.local_path.clone().unwrap();
+    let id = f.descriptor.session.session_id;
+    let mut backend = Jsonl::new();
+    crate::diagnostics::reset();
+    let frozen = backend.freeze(&dir, id).unwrap();
+    assert_eq!(crate::diagnostics::get().fingerprint_bytes, 0);
+    assert_eq!(crate::diagnostics::get().decoded, 0);
+    let mut reader = frozen.open().unwrap();
+    assert_eq!(crate::diagnostics::get().fingerprint_bytes, reader.extent());
+    assert_eq!(reader.next().unwrap().unwrap().session_seq, 1);
+    assert!(reader.next().unwrap().is_none());
+
+    let frozen = backend.freeze(&dir, id).unwrap();
+    f.append(vec![text("new suffix")]);
+    assert!(
+        frozen.open().is_err(),
+        "no prior digest to prove the old prefix"
+    );
+    reader.verify_fixed_prefix().unwrap(); // Published reader still pins N.
+
+    let frozen = backend.freeze(&dir, id).unwrap();
+    let path = f.descriptor.record_location.as_ref().unwrap();
+    let bytes = std::fs::read_to_string(path).unwrap();
+    std::fs::write(path, bytes.replace("pinned", "edited")).unwrap();
+    // Make this deterministic even on filesystems with coarse mtime resolution.
+    let modified = std::fs::metadata(path).unwrap().modified().unwrap();
+    std::fs::File::options()
+        .write(true)
+        .open(path)
+        .unwrap()
+        .set_modified(modified + std::time::Duration::from_secs(2))
+        .unwrap();
+    assert!(
+        frozen.open().is_err(),
+        "a valid new history is not the frozen one"
+    );
+    assert!(reader.verify_fixed_prefix().is_err());
+}

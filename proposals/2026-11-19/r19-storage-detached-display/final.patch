+#[test]
+fn concurrent_display_stages_share_one_budget_and_release_or_eviction_reclaims_it() {
+    for kind in backends() {
+        let mut f = Fixture::new(kind);
+        f.append(vec![text("one display record")]);
+        let identity = f.snapshot();
+        let Res::Records { page } = f
+            .service
+            .execute(Req::ReadRecords {
+                snapshot: identity,
+                after_seq: 0,
+                limit: 1,
+            })
+            .unwrap()
+        else {
+            panic!()
+        };
+        let one_stage = serde_json::to_vec(&page.records[0]).unwrap().len() as u64 + 1;
+        f.service.limit_display_staging_for_test(one_stage);
+        let req = display_request(&f.descriptor.session);
+        let service = &f.service;
+        let single = thread::scope(|scope| {
+            let (frozen, release) = pause(service);
+            let r = req.clone();
+            let first = scope.spawn(move || service.execute(r));
+            frozen.recv_timeout(WAIT).unwrap();
+            let r = req.clone();
+            let second = scope.spawn(move || service.execute(r));
+            drop(release);
+            let Res::DisplaySnapshot {
+                projection: Some(first),
+            } = first.join().unwrap().unwrap()
+            else {
+                panic!()
+            };
+            assert!(matches!(
+                second.join().unwrap().unwrap(),
+                Res::DisplaySnapshot { projection: None }
+            ));
+            first.snapshot
+        });
+        service
+            .execute(Req::ReleaseSnapshot { snapshot: single })
+            .unwrap();
+        let next = open(&f).snapshot;
+        for _ in 0..32 {
+            f.snapshot();
+        }
+        assert!(
+            service
+                .execute(Req::ReleaseSnapshot { snapshot: next })
+                .is_err()
+        );
+        assert_eq!(open(&f).snapshot.revision, f.revision);
+    }
+}

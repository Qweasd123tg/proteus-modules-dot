+#[cfg(test)]
+#[test]
+fn freeze_pins_the_read_view_before_hash_and_releases_the_wal_on_drop() {
+    use crate::{
+        service::BackendKind,
+        tests::{Fixture, text},
+    };
+
+    let mut f = Fixture::new(BackendKind::Sqlite);
+    let commit = f.append(vec![text("frozen prefix")]);
+    let dir = f.descriptor.local_path.as_ref().unwrap().clone();
+    let db = Connection::open(dir.join(FILE)).unwrap();
+    db.busy_timeout(std::time::Duration::ZERO).unwrap();
+    let bytes: Vec<u8> = db
+        .query_row("SELECT payload FROM journal WHERE sequence=1", [], |r| {
+            r.get(0)
+        })
+        .unwrap();
+    let checkpoint = || {
+        db.query_row("PRAGMA wal_checkpoint(TRUNCATE)", [], |r| {
+            r.get::<_, i64>(0)
+        })
+        .unwrap()
+    };
+
+    crate::diagnostics::reset();
+    let frozen = Sqlite::default()
+        .freeze(&dir, commit.lease.session.session_id)
+        .unwrap();
+    assert_eq!(crate::diagnostics::get().fingerprint_bytes, 0);
+    assert_eq!(crate::diagnostics::get().decoded, 0);
+    // A normal durable commit succeeds while the frozen view is idle. Changing
+    // the old row as well distinguishes a read transaction from just MAX(seq).
+    f.append(vec![text("later append")]);
+    db.execute("UPDATE journal SET payload=x'00' WHERE sequence=1", [])
+        .unwrap();
+    assert_eq!(checkpoint(), 1);
+
+    let mut source = frozen.open().unwrap();
+    assert_eq!(source.extent(), 1);
+    assert_eq!(source.fingerprint(), crate::io::sha256_hex(&bytes));
+    for _ in 0..2 {
+        source.reset().unwrap();
+        assert_eq!(
+            source.next().unwrap().unwrap().record_id,
+            commit.operation_id
+        );
+        assert!(source.next().unwrap().is_none());
+    }
+    assert_eq!(checkpoint(), 1, "replay must retain the original read mark");
+    drop(source);
+    assert_eq!(checkpoint(), 0, "the last reader must not leak a WAL pin");
+}

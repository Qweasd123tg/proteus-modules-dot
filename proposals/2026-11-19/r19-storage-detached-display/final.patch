+use super::*;
+use SessionStorageRequest as Req;
+use SessionStorageResponse as Res;
+use std::{sync::mpsc, thread, time::Duration};
+
+const WAIT: Duration = Duration::from_secs(3);
+
+/// Pause the real request dispatcher once the fd/WAL transaction is pinned,
+/// before hashing or decoding. A failed assertion also releases the builder.
+fn pause(service: &StorageService) -> (mpsc::Receiver<()>, mpsc::Sender<()>) {
+    let (started, frozen) = mpsc::channel();
+    let (release, wait) = mpsc::channel();
+    *service.after_display_freeze.lock().unwrap() = Some(Box::new(move || {
+        started.send(()).unwrap();
+        let _ = wait.recv_timeout(WAIT * 2);
+    }));
+    (frozen, release)
+}
+
+fn display_request(session: &SessionLocator) -> Req {
+    Req::OpenDisplaySnapshot {
+        session: session.clone(),
+    }
+}
+
+fn increased(mut commit: StorageCommit) -> StorageCommit {
+    commit.operation_id = new_record_id();
+    commit.expected.session_seq += 1;
+    commit.expected.history_revision += 1;
+    let JournalEntry::HistoryMutated(change) = &mut commit.entry else {
+        panic!()
+    };
+    change.previous_revision += 1;
+    change.new_revision += 1;
+    change.messages = vec![text("active writer progressed")];
+    commit
+}
+
+#[test]
+fn other_session_commits_durably_before_cold_display_is_unblocked() {
+    for kind in backends() {
+        let mut a = Fixture::new(kind);
+        let commit = increased(a.append(vec![text("warm writer A")]));
+        let mut b = Fixture::new(kind);
+        b.append(vec![text("cold B")]);
+        append_hook_with(&mut b, "hidden diagnostic");
+        b.append(vec![text("visible tail")]);
+        let req = display_request(&b.descriptor.session);
+        let service = &a.service;
+        let pending = thread::scope(|scope| {
+            let (frozen, release) = pause(service);
+            let reader = scope.spawn(move || service.execute(req));
+            frozen.recv_timeout(WAIT).expect("freeze was not reached");
+            let (sent, ack) = mpsc::channel();
+            scope.spawn(move || {
+                let _ = sent.send(service.execute(Req::Commit { commit }));
+            });
+            let ack = ack.recv_timeout(WAIT);
+            drop(release);
+            assert!(
+                matches!(ack.expect("commit waited for a different session's cold display").unwrap(),
+                Res::Committed { ack } if ack.revision.session_seq == 2)
+            );
+            reader.join().unwrap().unwrap()
+        });
+        let Res::DisplaySnapshot {
+            projection: Some(got),
+        } = pending
+        else {
+            panic!()
+        };
+        let serial = open(&b);
+        assert_eq!(got.state, serial.state);
+        assert_eq!(got.snapshot.session, serial.snapshot.session);
+        assert_eq!(got.snapshot.content_sha256, serial.snapshot.content_sha256);
+        assert_eq!(got.snapshot.revision, serial.snapshot.revision);
+        assert_eq!(got.snapshot.revision.session_seq, 3);
+        assert_eq!(got.snapshot.revision.history_revision, 2);
+        assert_ne!(got.snapshot.snapshot_id, serial.snapshot.snapshot_id);
+        for (after, seq) in [(0, 1), (1, 3)] {
+            let req = Req::ReadDisplayRecords {
+                snapshot: got.snapshot.clone(),
+                after_seq: after,
+                limit: 1,
+            };
+            let Res::Records { page: actual } = service.execute(req).unwrap() else {
+                panic!()
+            };
+            let expected = page(&b, &serial.snapshot, after);
+            assert_eq!(actual.records, expected.records);
+            assert_eq!(actual.records[0].session_seq, seq);
+            assert_eq!(actual.next_after_seq, expected.next_after_seq);
+        }
+    }
+}

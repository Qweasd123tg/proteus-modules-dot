+#[test]
+fn jsonl_complete_line_search_obeys_its_original_physical_ceiling() {
+    use std::io::{Seek, Write};
+    let mut journal = tempfile::tempfile().unwrap();
+    journal.write_all(b"line\n").unwrap();
+    journal.write_all(&[b'x'; 20_000]).unwrap();
+    let ceiling = journal.stream_position().unwrap();
+    journal.write_all(b"newly-completed\n").unwrap();
+    assert_eq!(
+        crate::io::complete_jsonl_offset_at(&mut journal, ceiling).unwrap(),
+        5
+    );
+    assert!(crate::io::complete_jsonl_offset(&mut journal).unwrap() > ceiling);
+}

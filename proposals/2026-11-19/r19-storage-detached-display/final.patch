+#[test]
+fn concurrent_append_or_recreation_cannot_publish_stale_handle_or_head() {
+    for kind in backends() {
+        for retire in [false, true] {
+            let mut f = Fixture::new(kind);
+            let commit = increased(f.append(vec![text("old head")]));
+            let lease = f.lease.clone();
+            let old = f.descriptor.clone();
+            let root = f.root.path();
+            let index = old
+                .local_path
+                .as_ref()
+                .unwrap()
+                .join(".storage-catalog-v1.json");
+            let service = &f.service;
+            let (err, current) = thread::scope(|scope| {
+                let (frozen, release) = pause(service);
+                let request = display_request(&old.session);
+                let reader = scope.spawn(move || service.execute(request));
+                frozen.recv_timeout(WAIT).expect("freeze was not reached");
+                let current = if retire {
+                    service
+                        .execute(Req::Delete {
+                            lease,
+                            operation_id: new_record_id(),
+                        })
+                        .unwrap();
+                    let Res::Session { descriptor } = service
+                        .execute(Req::Create {
+                            config_root: root.into(),
+                            workspace_path: old.workspace_path.clone(),
+                            session_id: old.session.session_id,
+                            parent_session_id: None,
+                        })
+                        .unwrap()
+                    else {
+                        panic!()
+                    };
+                    assert_ne!(old.session, descriptor.session);
+                    service
+                        .execute(Req::AcquireWriter {
+                            session: descriptor.session.clone(),
+                        })
+                        .unwrap();
+                    descriptor.session
+                } else {
+                    service.execute(Req::Commit { commit }).unwrap();
+                    old.session.clone()
+                };
+                let before = std::fs::read(&index).ok();
+                drop(release);
+                let err = reader.join().unwrap().unwrap_err();
+                assert_eq!(std::fs::read(&index).ok(), before);
+                (err, current)
+            });
+            assert!(!err.to_string().is_empty());
+            let Res::DisplaySnapshot {
+                projection: Some(latest),
+            } = service.execute(display_request(&current)).unwrap()
+            else {
+                panic!()
+            };
+            assert_eq!(
+                latest.snapshot.revision.session_seq,
+                if retire { 0 } else { 2 }
+            );
+        }
+    }
+}

+use super::{Backend, RemoteCacheSource, cache};
+use serde_json::{Value, json};
+
+fn digest(value: &Value) -> String {
+    proteus_contracts::contracts::storage_value_etag(value).unwrap()
+}
+fn key(digest: &str) -> String {

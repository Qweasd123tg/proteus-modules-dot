+//! Admission for missing passive HTTP history pages, not a storage-wide lock.
+use std::{fmt, path::PathBuf, sync::Arc};
+
+use anyhow::{Context, Result};
+use proteus_contracts::app_protocol::AppTranscriptPage;
+use tokio::sync::Semaphore;
+
+use super::HttpAppState;
+use crate::{app_server::read_model::transcript_page, core::SessionStore};
+
+#[derive(Debug)]
+pub(super) struct QueueFull;
+
+impl fmt::Display for QueueFull {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("archive history recovery queue is full; retry later")
+    }
+}
+
+impl std::error::Error for QueueFull {}
+
+// A full rebuild materializes the whole source. Budget one such passive
+// request per HTTP storage binding, not one per socket or per archive.
+// Limit waiting misses separately so a burst cannot create an unbounded queue.
+pub(super) struct RecoveryAdmission {
+    worker: Arc<Semaphore>,
+    capacity: Semaphore,
+}
+
+impl Default for RecoveryAdmission {
+    fn default() -> Self {
+        Self {
+            worker: Arc::new(Semaphore::new(1)),
+            capacity: Semaphore::new(8),
+        }
+    }
+}
+
+impl RecoveryAdmission {
+    async fn run<T: Send + 'static>(
+        &self,
+        work: impl FnOnce() -> Result<T> + Send + 'static,
+    ) -> Result<T> {
+        let slot = self.capacity.try_acquire().map_err(|_| QueueFull)?;
+        let worker = self.worker.clone().acquire_owned().await?;
+        drop(slot);
+        // If a client goes away after dispatch, the source still consumes memory
+        // until this closure ends. The HTTP future must not own this permit.
+        tokio::task::spawn_blocking(move || {
+            let _worker = worker;
+            work()
+        })
+        .await
+        .context("archive history recovery task failed")?
+    }
+}
+
+enum Probe {
+    Ready(AppTranscriptPage),
+    Miss(SessionStore, Option<String>),
+}
+
+pub(super) async fn read(
+    state: &HttpAppState,
+    dir: PathBuf,
+    before: Option<usize>,
+    revision: Option<String>,
+) -> Result<AppTranscriptPage> {
+    let storage = state.storage_service()?;
+    let active = state.server_for_session_dir(&dir).await.is_some();
+    let probe = tokio::task::spawn_blocking(move || -> Result<Probe> {
+        let store = SessionStore::open(storage, dir)?;
+        // Active and immutable cached reads do not wait behind cold archives.
+        if active {
+            Ok(Probe::Ready(transcript_page(
+                &store,
+                before,
+                revision.as_deref(),
+            )?))
+        } else if let Some(page) = store.saved_transcript_page(before, revision.as_deref()) {
+            Ok(Probe::Ready(page))
+        } else {
+            Ok(Probe::Miss(store, revision))
+        }
+    })
+    .await
+    .context("history page task failed")??;
+    match probe {
+        Probe::Ready(page) => Ok(page),
+        // transcript_page probes again after admission: a preceding request
+        // might already have repaired this exact source or pinned revision.
+        Probe::Miss(store, revision) => {
+            state
+                .archive_pages
+                .run(move || transcript_page(&store, before, revision.as_deref()))
+                .await
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio::sync::oneshot;
+
+    #[tokio::test]
+    async fn disconnect_releases_waiter_but_not_running_recovery() {
+        let admission = Arc::new(RecoveryAdmission {
+            worker: Arc::new(Semaphore::new(1)),
+            capacity: Semaphore::new(1),
+        });
+        let (started, running) = oneshot::channel();
+        let (finish, finished) = std::sync::mpsc::channel();
+        let server = admission.clone();
+        let first = tokio::spawn(async move {
+            server
+                .run(move || {
+                    let _ = started.send(());
+                    finished.recv()?;
+                    Ok(())
+                })
+                .await
+        });
+        running.await.unwrap();
+        first.abort();
+        assert!(first.await.unwrap_err().is_cancelled());
+        {
+            let waiting = admission.run(|| -> Result<()> { anyhow::bail!("canceled job ran") });
+            tokio::pin!(waiting);
+            tokio::select! {
+                biased;
+                _ = &mut waiting => panic!("running work lost its permit"),
+                _ = std::future::ready(()) => {}
+            }
+            assert!(
+                admission
+                    .run(|| Ok(()))
+                    .await
+                    .unwrap_err()
+                    .is::<QueueFull>()
+            );
+        }
+        finish.send(()).unwrap();
+        assert_eq!(admission.run(|| Ok(7)).await.unwrap(), 7);
+    }
+}

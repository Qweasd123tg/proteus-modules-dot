+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn nested_maps_hash_sorted_compact_json_even_with_insertion_order_maps() {
+        let value = json!({"z": [null, {"y": "Ж", "a": -7}], "a": true});
+        let canonical = r#"{"a":true,"z":[null,{"a":-7,"y":"Ж"}]}"#.as_bytes();
+        let expected = ring::digest::digest(&SHA256, canonical);
+        let expected: String = expected.as_ref().iter().map(|b| format!("{b:02x}")).collect();
+        assert_eq!(storage_value_etag(&value).unwrap(), expected);
+    }
+}

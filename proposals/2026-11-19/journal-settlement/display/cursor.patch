+#[test]
+fn first_settle_after_cold_start_uses_only_the_exact_validated_cursor() {
+    let (backend, store) = Backend::store();
+    backend.append(3);
+    let cold = super::super::prepared::PreparedSession::from_dir(
+        backend.clone(),
+        store.session_dir().to_owned(),
+    )
+    .unwrap();
+    let (store, first, deferred, stale) = cold.into_display_view(full).unwrap();
+    assert!(!deferred && !stale);
+    let revision = first.cursor.unwrap().revision;
+    let header = cache::header(&store).unwrap();
+    assert_eq!(header.cursor.unwrap().snapshot, header.source.snapshot);
+    backend.append(1);
+    let appended = project(&store, |_| {
+        panic!("independent first turn used full display")
+    })
+    .unwrap();
+    let base = appended.cursor.unwrap().base.unwrap();
+    assert_eq!((base.revision, base.common_prefix), (revision, 3));
+}
+
+#[test]
+fn an_older_validated_read_cannot_publish_its_view_under_a_newer_source() {
+    let (backend, store) = Backend::store();
+    backend.append(1);
+    let read = RemoteValidatedRead::open(store.clone()).unwrap();
+    backend.append(1);
+    let model = store.project_validated_model(read, full).unwrap();
+    assert_eq!(model.summary.message_count, 1);
+    assert!(cache::header(&store).is_none());
+    let current = store.project_read_model(full).unwrap();
+    assert_eq!(current.summary.message_count, 2);
+    let header = cache::header(&store).unwrap();
+    assert_eq!(header.cursor.unwrap().snapshot, header.source.snapshot);
+}

+#[test]
+fn comparing_a_cut_after_admission_uses_its_history_revision_not_sequence() {
+    for kind in backends() {
+        let mut f = Fixture::new(kind);
+        f.append(vec![text("history")]);
+        admit(&mut f);
+        let old = f.snapshot();
+        assert_eq!(
+            (old.revision.session_seq, old.revision.history_revision),
+            (2, 1)
+        );
+        admit(&mut f);
+        let head = f.snapshot();
+        let compare = |prefix| {
+            f.service
+                .execute(SessionStorageRequest::CompareSnapshots {
+                    snapshot: head.clone(),
+                    prefix,
+                })
+                .unwrap()
+        };
+        crate::diagnostics::reset();
+        assert_eq!(
+            compare(old.clone()),
+            SessionStorageResponse::SnapshotPrefix { matches: true }
+        );
+        let mut wrong = old;
+        wrong.revision.history_revision = 2;
+        assert_eq!(
+            compare(wrong),
+            SessionStorageResponse::SnapshotPrefix { matches: false }
+        );
+        assert_eq!(crate::diagnostics::get().decoded, 0);
+    }
+}

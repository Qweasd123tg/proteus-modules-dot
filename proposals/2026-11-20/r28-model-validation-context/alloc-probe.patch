+#[test]
+fn r28_raw_replay_allocation() {
+    let rt = tokio::runtime::Builder::new_current_thread()
+        .build()
+        .unwrap();
+    for size in [1024, 1 << 20, 8 << 20] {
+        let adapter = Arc::new(RecordingModel::new(text_response("complete")));
+        let input = request(&"x".repeat(size));
+        let (result, allocated) =
+            crate::test_alloc::measure(|| rt.block_on(invoke_model(adapter.clone(), input)));
+        assert_eq!(result.unwrap().finish_reason, FinishReason::Stop);
+        assert_eq!(adapter.requests.lock().unwrap().len(), 1);
+        eprintln!(
+            "R28ALLOC path=replay fixture={} bytes={} calls={}",
+            size, allocated.bytes, allocated.calls
+        );
+    }

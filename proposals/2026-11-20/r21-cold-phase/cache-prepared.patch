diff --git a/storage/session-storage/src/tests/cache.rs b/storage/session-storage/src/tests/cache.rs
new file mode 100644
index 0000000..0950ddd
--- /dev/null
+++ b/storage/session-storage/src/tests/cache.rs
@@ -0,0 +1,76 @@
+use super::*;
+use serde_json::json;
+
+fn write(f: &Fixture, source: StorageSnapshot, value: serde_json::Value) -> Option<String> {
+    let request = SessionStorageRequest::WriteCache {
+        session: f.descriptor.session.clone(),
+        key: "test-preview".to_owned(),
+        source,
+        value,
+    };
+    let response = f.service.execute(request.clone()).unwrap();
+    request.validate_response(&response).unwrap();
+    let SessionStorageResponse::CacheWritten { etag } = response else {
+        panic!("unexpected cache write response");
+    };
+    etag
+}
+
+fn read(f: &Fixture, source: StorageSnapshot) -> Option<StorageMetadataDocument> {
+    let request = SessionStorageRequest::ReadCache {
+        session: f.descriptor.session.clone(),
+        key: "test-preview".to_owned(),
+        source: Some(source),
+    };
+    let response = f.service.execute(request.clone()).unwrap();
+    request.validate_response(&response).unwrap();
+    let SessionStorageResponse::Metadata { document } = response else {
+        panic!("unexpected cache read response");
+    };
+    document
+}
+
+#[test]
+fn prepared_cache_returns_the_exact_etag_and_round_trips_both_backends() {
+    for kind in backends() {
+        let mut f = Fixture::new(kind);
+        f.append(vec![text("before")]);
+        let source = f.snapshot();
+        let value = json!({"rows": [[["пример 😀", null], 11.1]], "visible": true});
+        let expected = storage_value_etag(&value).unwrap();
+        assert_eq!(
+            write(&f, source.clone(), value.clone()),
+            Some(expected.clone())
+        );
+        let document = read(&f, source).unwrap();
+        assert_eq!(document.etag, expected);
+        assert_eq!(document.value, value);
+    }
+}
+
+#[test]
+fn prepared_stale_cache_cannot_replace_current_or_leave_a_named_tmp() {
+    for kind in backends() {
+        let mut f = Fixture::new(kind);
+        f.append(vec![text("before")]);
+        let old = f.snapshot();
+        f.append(vec![text("after")]);
+        let current = f.snapshot();
+        assert_ne!(old.revision, current.revision);
+        assert_ne!(old.content_sha256, current.content_sha256);
+        let current_value = json!({"rows": ["current"]});
+        assert!(write(&f, current.clone(), current_value.clone()).is_some());
+        assert!(write(&f, old.clone(), json!({"rows": ["stale"]})).is_none());
+        assert!(read(&f, old).is_none());
+        assert_eq!(read(&f, current).unwrap().value, current_value);
+        assert!(
+            std::fs::read_dir(f.descriptor.local_path.as_ref().unwrap())
+                .unwrap()
+                .all(|entry| !entry
+                    .unwrap()
+                    .file_name()
+                    .to_string_lossy()
+                    .ends_with(".tmp"))
+        );
+    }
+}

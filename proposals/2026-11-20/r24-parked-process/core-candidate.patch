+++ b/crates/proteus-core/src/app_server/peer_settings.rs
@@ -0,0 +1,23 @@
+use anyhow::{Result, ensure};
+
+impl super::AppServerHandle {
+    /// Includes the current published profile as well as the effective model,
+    /// stream, behavior, permission and actual tool surface. Never retain the
+    /// raw configuration, module secrets, or a live registry in a parked entry.
+    pub(crate) async fn peer_effective_fingerprint(&self) -> Result<String> {
+        let _transition = self.settings_transition.lock().await;
+        ensure!(
+            self.profile_error.lock().await.is_none(),
+            "child profile reload has failed"
+        );
+        let config = self.config.read().await;
+        let baseline = crate::core::peer_authority_fingerprint(
+            &config,
+            self.config_path.as_deref(),
+            &self.cwd,
+        )?;
+        let behavior = self.behavior.read().await;
+        let runtime = self.runtime.peer_settings_fingerprint().await?;
+        crate::core::peer_digest(&("peer-effective-v1", baseline, &*behavior, runtime))
+    }
+}

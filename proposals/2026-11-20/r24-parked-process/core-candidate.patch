diff --git a/crates/proteus-core/src/app_server/stdio/parked.rs b/crates/proteus-core/src/app_server/stdio/parked.rs
new file mode 100644
index 0000000..8fd948e
--- /dev/null
+++ b/crates/proteus-core/src/app_server/stdio/parked.rs
@@ -0,0 +1,172 @@
+//! A cold process never chooses a workspace or a session. Validate the actual
+//! loaded profile before starting a storage worker; open only the parked
+//! descriptor, then retain its verified writer lease through normal admission.
+use std::path::{Path, PathBuf};
+
+use super::super::{AgentAppServer, AppServerHandle, selected_storage};
+use crate::{
+    core::{AppConfig, PreparedSession, SessionStore},
+    peer_checkpoint::{ParkedCheckpoint, PeerReady},
+};
+use anyhow::{Context, Result, ensure};
+use proteus_contracts::app_protocol::AppSubagentSession;
+
+pub(super) async fn launch(
+    config: AppConfig,
+    cwd: PathBuf,
+    config_path: Option<&Path>,
+    dir: Option<PathBuf>,
+    baseline: &str,
+    expected: &ParkedCheckpoint,
+) -> Result<AppServerHandle> {
+    expected.validate()?;
+    ensure!(
+        baseline == expected.authority_sha256,
+        "parked child profile changed"
+    );
+    ensure!(
+        dir.as_deref() == Some(&expected.session.session_dir)
+            && cwd.canonicalize()? == expected.workspace_path,
+        "parked child launch identity changed"
+    );
+    let storage = selected_storage(&config, &cwd)
+        .await?
+        .context("no child session storage")?;
+    let selected = storage.clone();
+    let dir = expected.session.session_dir.clone();
+    let store = tokio::task::spawn_blocking(move || SessionStore::open(selected, dir)).await??;
+    ensure!(
+        store.session_id() == expected.session.session_id
+            && store.session_dir() == expected.session.session_dir
+            && store.workspace_path()? == expected.workspace_path
+            && store.parent_session_id() == Some(expected.parent_session_id),
+        "parked child storage identity changed"
+    );
+
+    // Acquires the writer and strictly checks the journal without adding any
+    // records. The SAME store/writer is moved into the resumed runtime.
+    store.pin_parked_writer().await?;
+    let (revision, content) = durable_head(&store).await?;
+    ensure!(
+        revision == expected.revision && content == expected.content_sha256,
+        "parked child journal changed"
+    );
+    let prepared =
+        tokio::task::spawn_blocking(move || PreparedSession::from_store(store)).await??;
+    let server = Box::pin(AgentAppServer::launch_inner(
+        config,
+        cwd,
+        config_path,
+        None,
+        Some(prepared),
+        None,
+        Some(storage),
+        false,
+    ))
+    .await?;
+    ensure!(
+        server.peer_effective_fingerprint().await? == expected.effective_sha256,
+        "parked child effective settings changed"
+    );
+    Ok(server)
+}
+
+pub(super) async fn checkpoint(server: &AppServerHandle, baseline: &str) -> Result<PeerReady> {
+    server
+        .runs
+        .lock()
+        .await
+        .ensure_idle_for_model_configuration()?;
+    let pending = server.pending_requests().await;
+    ensure!(
+        pending.approvals.is_empty()
+            && pending.user_inputs.is_empty()
+            && pending.queued_user_messages.is_empty(),
+        "child has pending interaction"
+    );
+    let store = server
+        .runtime
+        .session_store()
+        .context("child has no durable store")?;
+    let (revision, content_sha256) = durable_head(store).await?;
+    let checkpoint = ParkedCheckpoint {
+        session: AppSubagentSession {
+            session_id: store.session_id(),
+            session_dir: store.session_dir().to_owned(),
+        },
+        parent_session_id: store
+            .parent_session_id()
+            .context("child has no persisted parent")?,
+        workspace_path: store.workspace_path()?,
+        revision,
+        content_sha256,
+        authority_sha256: baseline.to_owned(),
+        effective_sha256: server.peer_effective_fingerprint().await?,
+    };
+    checkpoint.validate()?;
+    ensure!(
+        server.cwd_path().canonicalize()? == checkpoint.workspace_path,
+        "child workspace differs from its store"
+    );
+    Ok(PeerReady {
+        checkpoint,
+        root_thread_id: server.runtime.root_thread_id(),
+    })
+}
+
+async fn durable_head(store: &SessionStore) -> Result<(crate::contracts::StorageRevision, String)> {
+    // The writer belongs to this process and remains in the store. Concurrent
+    // external writers must not slip between proof collection and first Send.
+    let (history, interrupted) = store.execution_state().await?;
+    ensure!(
+        history > 0 && interrupted.is_empty(),
+        "child history is empty or interrupted"
+    );
+    let store = store.clone();
+    tokio::task::spawn_blocking(move || read_settled_head(store, history)).await?
+}
+
+fn read_settled_head(
+    store: SessionStore,
+    history_revision: u64,
+) -> Result<(crate::contracts::StorageRevision, String)> {
+    use crate::contracts::{SessionStorageRequest as Request, SessionStorageResponse as Response};
+    use proteus_contracts::storage::journal::{JournalEntry, TurnSettlementStatus};
+    let snapshot = store.snapshot()?;
+    let head = snapshot.descriptor();
+    ensure!(
+        head.revision.history_revision == history_revision && head.revision.session_seq > 0,
+        "child history and journal disagree"
+    );
+    let Response::Records { page } = store.request(Request::ReadRecords {
+        snapshot: head.clone(),
+        after_seq: head.revision.session_seq - 1,
+        limit: 1,
+    })?
+    else {
+        anyhow::bail!("storage did not return the child settlement")
+    };
+    ensure!(
+        page.snapshot == *head && page.next_after_seq.is_none() && page.records.len() == 1,
+        "missing exact terminal child record"
+    );
+    let last = &page.records[0];
+    ensure!(
+        last.session_id == store.session_id()
+            && last.session_seq == head.revision.session_seq
+            && last.turn_id.is_some()
+            && matches!(&last.entry, JournalEntry::TurnSettled(s)
+                if s.status == TurnSettlementStatus::Success && s.output.is_some() && s.error.is_none()),
+        "child journal does not end in successful settlement"
+    );
+    // These selection documents live outside the canonical journal. Seal them
+    // under its writer lease too, before any resumed assembly consults them.
+    let content = crate::core::peer_digest(&(
+        "settled-peer-content-v1",
+        &head.content_sha256,
+        store.read_metadata(super::super::session_selection::FILE)?,
+        store.read_metadata(super::super::session_model::FILE)?,
+        store.read_metadata(super::super::session_behavior::FILE)?,
+    ))?;
+    Ok((head.revision, content))
+}

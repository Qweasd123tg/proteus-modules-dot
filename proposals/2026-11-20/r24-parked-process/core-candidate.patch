index 0000000..9fe8452
--- /dev/null
+++ b/crates/proteus-core/src/peer_checkpoint.rs
@@ -0,0 +1,51 @@
+//! Private parent/child control proof. The logical binding stays in the
+//! parent's pool; no control request can open a locator from a client.
+use proteus_contracts::{
+    app_protocol::AppSubagentSession,
+    contracts::StorageRevision,
+    domain::{SessionId, ThreadId},
+};
+use serde::{Deserialize, Serialize};
+use std::path::PathBuf;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct ParkedCheckpoint {
+    pub session: AppSubagentSession,
+    pub parent_session_id: SessionId,
+    pub workspace_path: PathBuf,
+    pub revision: StorageRevision,
+    // Journal content and the session-level selection documents (not snapshot_id).
+    pub content_sha256: String,
+    pub authority_sha256: String,
+    pub effective_sha256: String,
+}
+
+impl ParkedCheckpoint {
+    pub(crate) fn validate(&self) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            self.parent_session_id != self.session.session_id
+                && self.session.session_dir.is_absolute()
+                && self.workspace_path.is_absolute()
+                && self.revision.session_seq > 0
+                && self.revision.history_revision > 0
+                && [
+                    &self.content_sha256,
+                    &self.authority_sha256,
+                    &self.effective_sha256
+                ]
+                .into_iter()
+                .all(|s| s.len() == 64 && s.bytes().all(|b| b.is_ascii_hexdigit())),
+            "invalid durable child checkpoint"
+        );
+        Ok(())
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct PeerReady {
+    pub checkpoint: ParkedCheckpoint,
+    // Physical runtime incarnation, not a durable session or logical task id.
+    pub root_thread_id: ThreadId,
+}
diff --git a/crates/proteus-core/tests/fixtures/parking_probe.py b/crates/proteus-core/tests/fixtures/parking_probe.py
new file mode 100644
index 0000000..f800723
--- /dev/null
+++ b/crates/proteus-core/tests/fixtures/parking_probe.py
@@ -0,0 +1,76 @@
+"""Model-free workflow reads only its supplied history; a separate tool appends one effect."""
+import json
+import os
+import sys
+import uuid
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4] / "examples/modules"))
+from component_runtime import ProtocolError, run_component
+
+# Each configured component is a separate process with a single export.
+ledger = None
+
+
+def initialize(params):
+    global ledger
+    export, = params["exports"]
+    ledger = (export.get("module_config") or {}).get("ledger")
+    descriptor = {k: export[k] for k in ("slot", "module_id", "contract_version", "composition")}
+    return {"protocol_version": "v3", "component_id": params["component_id"],
+            "exports": [dict(descriptor, module_features=[], config_schema=None)]}
+
+
+def assistant(text):
+    return {"id": str(uuid.uuid4()), "role": "Assistant", "phase": None, "parts": [
+        {"part_id": str(uuid.uuid4()), "provenance": "model", "scope": "conversation",
+         "payload": {"Text": {"text": text}}}], "name": None, "tool_call_id": None, "metadata": None}
+
+
+def invoke(context, method, params):
+    if context.export["slot"] == "tool":
+        if method == "list":
+            return {"result": [{"spec": {
+                "name": "read_probe", "description": "Return a synthetic read; instrumented in the private fixture ledger",
+                "input_schema": {"type": "object", "properties": {}},
+                "surface": {"kind": "function", "strict": False, "output_schema": None},
+                "safety": "ReadOnly", "supports_parallel_tool_calls": False,
+                "timeout_ms": 5000, "metadata": {}}, "model_visible": True, "user_command": None}]}
+        if method != "invoke" or params["call"]["name"] != "read_probe":
+            raise ProtocolError("unexpected receipt tool call")
+        # Out-of-band test instrumentation only; no workspace writes. Replaying
+        # even the same read produces two receipts, unlike an idempotent file write.
+        call_id = params["call"]["id"]
+        with Path(ledger).open("a", encoding="utf-8") as out:
+            out.write(call_id + "\n")
+        return {"result": {"call_id": call_id, "ok": True, "output": "appended",
+                           "content": [], "error": None, "metadata": {}}}
+
+    if method != "run":
+        raise ProtocolError("expected workflow run")
+    task = params["task"]
+    command = task["text"].splitlines()[-1]
+    if command == "seed":
+        call = {"id": str(uuid.uuid4()), "name": "read_probe", "args": {},
+                "surface": "function", "raw_arguments": None}
+        result = context.host_call("host.tools.execute", {"task": task, "call": call})
+        if not result["ok"]:
+            raise ProtocolError(f"receipt tool failed: {result}")
+        # This value is not in the follow-up prompt, the receipt or static fixture data.
+        answer = "A:" + str(uuid.uuid4())
+    elif command == "unrelated":
+        answer = "B:" + str(uuid.uuid4())
+    elif command == "recall":
+        prior = [part["payload"]["Text"]["text"] for msg in params["history"]
+                 if msg["role"] == "Assistant" for part in msg["parts"] if "Text" in part["payload"]]
+        if len(prior) != 1:
+            raise ProtocolError(f"expected exactly one previous assistant answer, got {prior!r}")
+        answer = prior[0]
+    else:
+        raise ProtocolError("unknown probe command")
+    output = json.dumps({"peer_pid": os.getppid(), "answer": answer})
+    return {"status": "success", "result": {"output": {"text": output, "metadata": None},
+            "new_messages": [assistant(answer)], "history_replacement": None, "compactions": []}}
+
+
+run_component(initialize, invoke)

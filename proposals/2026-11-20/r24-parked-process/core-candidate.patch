+++ b/crates/proteus-core/src/core/session_store/remote/writer/parked_tests.rs
@@ -0,0 +1,121 @@
+use super::*;
+use crate::process_adapters::{ProcessInvocationError, ProcessInvocationFailure};
+use proteus_contracts::contracts::SessionLocator;
+use proteus_module_protocol::v3::ComponentFailure;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use uuid::Uuid;
+
+/// After the first operational lease is lost, the replacement exposes a
+/// different history. Only the ordinary (non-parked) path may acquire it.
+#[derive(Default)]
+struct ReplacingStorage {
+    invalid_lease_reply: bool,
+    lost: AtomicBool,
+    acquires: AtomicU64,
+    reads: AtomicU64,
+}
+
+fn revision(generation: u64) -> StorageRevision {
+    StorageRevision {
+        session_seq: generation * 2,
+        history_revision: generation,
+    }
+}
+
+#[async_trait::async_trait]
+impl crate::contracts::SessionStorage for ReplacingStorage {
+    async fn execute(&self, request: Request) -> Result<Response> {
+        self.execute_blocking(request)
+    }
+
+    fn execute_blocking(&self, request: Request) -> Result<Response> {
+        match request {
+            Request::AcquireWriter { session } => {
+                let generation = self.acquires.fetch_add(1, Ordering::SeqCst) + 1;
+                Ok(Response::Writer {
+                    lease: StorageWriterLease {
+                        session,
+                        token: Uuid::new_v4(),
+                        generation: Uuid::from_u128(generation.into()),
+                    },
+                    revision: revision(generation),
+                })
+            }
+            Request::ReadExecutionState { lease } => {
+                self.reads.fetch_add(1, Ordering::SeqCst);
+                let generation = u64::try_from(lease.generation.as_u128())?;
+                if generation == 1 && self.lost.load(Ordering::SeqCst) {
+                    if self.invalid_lease_reply {
+                        return Err(SessionStorageFailure::InvalidWriterLease.into());
+                    }
+                    return Err(ProcessInvocationError::new(
+                        "storage fixture",
+                        "read execution state",
+                        ProcessInvocationFailure::ComponentLost(ComponentFailure::ProcessExit),
+                    )
+                    .into());
+                }
+                Ok(Response::ExecutionState {
+                    revision: revision(generation),
+                    interrupted_turns: Vec::new(),
+                })
+            }
+            Request::ReleaseWriter { .. } => Ok(Response::Done),
+            request => panic!("unexpected fake storage request: {request:?}"),
+        }
+    }
+}
+
+fn fixture(invalid_lease_reply: bool) -> (Arc<ReplacingStorage>, RemoteWriter) {
+    let storage = Arc::new(ReplacingStorage {
+        invalid_lease_reply,
+        ..ReplacingStorage::default()
+    });
+    let writer = RemoteWriter::new(
+        storage.clone(),
+        SessionLocator {
+            session_id: crate::domain::new_session_id(),
+            key: "parking-unit-test".to_owned(),
+        },
+    );
+    (storage, writer)
+}
+
+async fn read_revision(writer: &mut RemoteWriter) -> Result<StorageRevision> {
+    match writer
+        .read_state(|lease| Request::ReadExecutionState { lease })
+        .await?
+    {
+        Response::ExecutionState { revision, .. } => Ok(revision),
+        response => panic!("unexpected fake storage response: {response:?}"),
+    }
+}
+
+#[tokio::test]
+async fn pinned_writer_never_reacquires_after_storage_loss() {
+    for invalid_lease_reply in [false, true] {
+        let (storage, mut writer) = fixture(invalid_lease_reply);
+        writer.pin_lease().await.unwrap();
+        assert_eq!(read_revision(&mut writer).await.unwrap(), revision(1));
+        storage.lost.store(true, Ordering::SeqCst);
+
+        let loss = read_revision(&mut writer).await.unwrap_err();
+        assert!(lease_lost(&loss), "{loss:#}");
+        assert!(read_revision(&mut writer).await.is_err());
+        assert_eq!(storage.acquires.load(Ordering::SeqCst), 1);
+        assert_eq!(storage.reads.load(Ordering::SeqCst), 2);
+    }
+}
+
+#[tokio::test]
+async fn ordinary_writer_still_reacquires_after_storage_loss() {
+    for invalid_lease_reply in [false, true] {
+        let (storage, mut writer) = fixture(invalid_lease_reply);
+        assert_eq!(read_revision(&mut writer).await.unwrap(), revision(1));
+        storage.lost.store(true, Ordering::SeqCst);
+
+        assert_eq!(read_revision(&mut writer).await.unwrap(), revision(2));
+        assert_eq!(storage.acquires.load(Ordering::SeqCst), 2);
+        assert_eq!(storage.reads.load(Ordering::SeqCst), 3);
+    }
+}

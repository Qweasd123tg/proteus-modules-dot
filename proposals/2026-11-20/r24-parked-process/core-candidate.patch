@@ -0,0 +1,48 @@
+//! A parking attempt is an optional postcondition of a settled turn, not a
+//! condition for its success. Never rerun a completed turn to obtain a receipt.
+use super::{HistoryRetention, PooledChild, RunnerInner};
+use crate::contracts::CancellationToken;
+use anyhow::Result;
+use std::time::Duration;
+use tokio::time::timeout;
+
+impl RunnerInner {
+    pub(super) async fn park_after_turn(
+        &self,
+        mut leased: PooledChild,
+        task_id: String,
+        history: HistoryRetention,
+        cancel: &CancellationToken,
+    ) -> Result<bool> {
+        let budget = self
+            .roles
+            .get(&leased.role)
+            .and_then(|role| role.config.timeout_ms)
+            .map(Duration::from_millis)
+            .unwrap_or(Duration::from_secs(5))
+            .min(Duration::from_secs(5));
+        let checkpoint = tokio::select! {
+            biased;
+            _ = cancel.cancelled() => None,
+            result = timeout(budget, leased.child.park_checkpoint(leased.parent_session_id, &leased.cwd))
+                => result.ok().and_then(|check| check.ok()),
+        };
+        // No parked entry exists while this old peer could still own its
+        // session's writer. A timeout, failed wait or late cancellation only
+        // forfeits *resumability*, not the proven completed turn.
+        let reaped = matches!(
+            timeout(Duration::from_secs(5), leased.child.terminate_verified()).await,
+            Ok(Ok(()))
+        );
+        let mut pool = self.lock_pool()?;
+        if let Some(checkpoint) = checkpoint
+            && reaped
+            && !cancel.is_cancelled()
+        {
+            return pool.park(leased, checkpoint, task_id, history);
+        }
+        history.expire();
+        pool.discard(leased);
+        Ok(false)
+    }
+}

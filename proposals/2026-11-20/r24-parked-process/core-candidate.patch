--- /dev/null
+++ b/crates/proteus-core/src/core/agent_control/process/parked.rs
@@ -0,0 +1,138 @@
+//! Parent-lifetime, bounded receipts for leaf peers reaped after a successful
+//! turn. The store belongs to the same mutex as resident process admission.
+//! It accepts no session paths, launch profiles or resume receipts from callers.
+
+use anyhow::{Context, Result, anyhow, ensure};
+use std::{
+    collections::VecDeque,
+    path::{Path, PathBuf},
+};
+
+use super::{
+    super::history::HistoryRetention, child::ParkedCheckpoint, parking_authority::ParkingAuthority,
+    pool::ResumeReservation,
+};
+use crate::domain::SessionId;
+
+// Global, including reservations from pending spawn futures. Does not change
+// the existing per-session collaboration, pending, process or mailbox limits.
+const MAX_PARKED: usize = 64;
+
+pub(super) struct ParkedTask {
+    pub checkpoint: ParkedCheckpoint,
+    pub parent: SessionId,
+    pub cwd: PathBuf,
+    pub role: String,
+    pub authority: ParkingAuthority,
+    pub history: HistoryRetention,
+}
+
+struct Entry {
+    id: String,
+    task: ParkedTask,
+    ticket: Option<u64>,
+}
+
+#[derive(Default)]
+pub(super) struct ParkedTasks {
+    order: VecDeque<Entry>,
+    next_ticket: u64,
+}
+
+impl ParkedTasks {
+    pub fn reserve(
+        &mut self,
+        id: &str,
+        parent: SessionId,
+        role: &str,
+        cwd: &Path,
+    ) -> Result<Option<ResumeReservation>> {
+        let Some(entry) = self.order.iter_mut().find(|e| e.id == id) else {
+            return Ok(None);
+        };
+        ensure!(
+            entry.task.parent == parent,
+            "unknown task_id (expired or from another session)"
+        );
+        ensure!(
+            entry.task.role == role,
+            "task_id belongs to a different agent profile"
+        );
+        ensure!(
+            std::fs::canonicalize(cwd).context("resolve resume workspace")? == entry.task.cwd,
+            "task_id belongs to a different workspace"
+        );
+        ensure!(
+            entry.ticket.is_none(),
+            "task_id belongs to a subagent resume that is still starting"
+        );
+        let ticket = self.next_ticket;
+        self.next_ticket = ticket
+            .checked_add(1)
+            .context("parking reservation identifier exhausted")?;
+        entry.ticket = Some(ticket);
+        Ok(Some(ResumeReservation {
+            parked: true,
+            process_id: ticket,
+            task_id: id.to_owned(),
+            history: entry.task.history.clone(),
+        }))
+    }
+
+    fn reserved_index(&self, res: &ResumeReservation) -> Result<usize> {
+        self.order
+            .iter()
+            .position(|e| e.id == res.task_id && e.ticket == Some(res.process_id))
+            .ok_or_else(|| anyhow!("parked subagent resume reservation was lost"))
+    }
+
+    pub fn cancel(&mut self, res: &ResumeReservation) -> Result<()> {
+        let i = self.reserved_index(res)?;
+        self.order[i].ticket = None;
+        Ok(())
+    }
+
+    pub fn take(&mut self, res: &ResumeReservation) -> Result<ParkedTask> {
+        let i = self.reserved_index(res)?;
+        Ok(self.order.remove(i).expect("index found").task)
+    }
+
+    pub fn insert(&mut self, id: String, task: ParkedTask) -> bool {
+        // A leased task cannot already have a parked copy. Do not overwrite
+        // any outstanding reservation on a bookkeeping error.
+        if self.order.iter().any(|e| e.id == id) {
+            task.history.expire();
+            return false;
+        }
+        if self.order.len() == MAX_PARKED {
+            let Some(i) = self.order.iter().position(|e| e.ticket.is_none()) else {
+                task.history.expire();
+                return false;
+            };
+            self.order
+                .remove(i)
+                .expect("index found")
+                .task
+                .history
+                .expire();
+        }
+        self.order.push_back(Entry {
+            id,
+            task,
+            ticket: None,
+        });
+        true
+    }
+}
+
+impl Drop for ParkedTasks {
+    fn drop(&mut self) {
+        for e in &self.order {
+            e.task.history.expire();
+        }
+    }
+}
+
+#[cfg(all(test, unix))]
+#[path = "parked_tests.rs"]
+mod tests;

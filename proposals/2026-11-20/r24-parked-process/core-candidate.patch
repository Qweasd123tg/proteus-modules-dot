@@ -0,0 +1,73 @@
+//! Pins the parsed configuration of an explicitly parked process peer. The
+//! digest is an equality witness, not a bearer credential or a session key.
+use std::{io, path::Path};
+
+use anyhow::{Context, Result, ensure};
+use ring::digest::{Context as Sha256, SHA256};
+use serde::Serialize;
+
+pub(crate) fn peer_digest(value: &impl Serialize) -> Result<String> {
+    struct Writer(Sha256);
+    impl io::Write for Writer {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            self.0.update(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut writer = Writer(Sha256::new(&SHA256));
+    serde_json::to_writer(&mut writer, value)?;
+    Ok(writer
+        .0
+        .finish()
+        .as_ref()
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect())
+}
+
+pub(crate) fn peer_authority_fingerprint(
+    config: &super::AppConfig,
+    config_path: Option<&Path>,
+    cwd: &Path,
+) -> Result<String> {
+    let path = config_path.context("parking requires a resolved child profile")?;
+    // The plugin manifests may contribute executable settings independently
+    // of AppConfig. This prototype cannot pin their actually assembled inputs.
+    ensure!(
+        config.addons.plugins.is_empty(),
+        "plugin-backed profiles cannot park"
+    );
+    let source = super::physical_config_path(path).canonicalize()?;
+    let cwd = cwd.canonicalize()?;
+    peer_digest(&(
+        "peer-baseline-v1",
+        source,
+        super::config_selection(path)?,
+        cwd,
+        config,
+        &config.behavior_tools,
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn equal_loaded_policy_and_profile_selector_required() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("peer.toml");
+        std::fs::write(&path, "").unwrap();
+        let mut config = crate::core::AppConfig::default();
+        let hash = |config: &_, path: &Path| {
+            peer_authority_fingerprint(config, Some(path), dir.path()).unwrap()
+        };
+        let prior = hash(&config, &path);
+        let other = crate::core::config_reference(&path, "alternative").unwrap();
+        assert_ne!(hash(&config, &other), prior);
+        config.tools.enabled.push("another-tool".into());
+        assert_ne!(hash(&config, &path), prior);
+    }
+}

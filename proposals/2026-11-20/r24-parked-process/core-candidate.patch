+++ b/crates/proteus-core/src/core/agent_control/process/parking_authority.rs
@@ -0,0 +1,107 @@
+//! Cheap parent-owned witness. Capture at physical process creation, not just
+//! after settlement: a replacement directory can have the same pathname.
+use std::path::{Path, PathBuf};
+
+use anyhow::{Result, ensure};
+
+use super::config::ProcessRoleConfig;
+
+type FileIdentity = (PathBuf, u64, u64);
+type BinaryStamp = (u64, i64, i64, i64, i64);
+type BinaryWitness = (FileIdentity, BinaryStamp);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct ParkingAuthority {
+    role: String,
+    cwd: FileIdentity,
+    binary: BinaryWitness,
+}
+
+impl ParkingAuthority {
+    pub(super) fn capture(role: &ProcessRoleConfig, cwd: &Path, binary: &Path) -> Result<Self> {
+        // A PATH search is intentionally not emulated by the parent.
+        ensure!(
+            binary.is_absolute(),
+            "parked peer requires an absolute executable"
+        );
+        Ok(Self {
+            role: crate::core::peer_digest(role)?,
+            cwd: directory_witness(cwd)?,
+            binary: binary_witness(binary)?,
+        })
+    }
+
+    pub(super) fn verify(&self, role: &ProcessRoleConfig, cwd: &Path, binary: &Path) -> Result<()> {
+        ensure!(
+            self == &Self::capture(role, cwd, binary)?,
+            "parked peer role, workspace or executable changed"
+        );
+        Ok(())
+    }
+}
+
+#[cfg(unix)]
+fn directory_witness(path: &Path) -> Result<FileIdentity> {
+    use std::os::unix::fs::MetadataExt;
+    let path = path.canonicalize()?;
+    let stat = std::fs::metadata(&path)?;
+    ensure!(stat.is_dir(), "parked peer workspace is not a directory");
+    Ok((path, stat.dev(), stat.ino()))
+}
+
+#[cfg(unix)]
+fn binary_witness(path: &Path) -> Result<BinaryWitness> {
+    use std::os::unix::fs::MetadataExt;
+    let path = path.canonicalize()?;
+    let stat = std::fs::metadata(&path)?;
+    ensure!(stat.is_file(), "parked peer executable is not a file");
+    Ok((
+        (path, stat.dev(), stat.ino()),
+        (
+            stat.len(),
+            stat.mtime(),
+            stat.mtime_nsec(),
+            stat.ctime(),
+            stat.ctime_nsec(),
+        ),
+    ))
+}
+
+#[cfg(not(unix))]
+fn binary_witness(_path: &Path) -> Result<BinaryWitness> {
+    anyhow::bail!("stable parked-peer executable identities are unavailable on this platform")
+}
+
+#[cfg(not(unix))]
+fn directory_witness(_path: &Path) -> Result<FileIdentity> {
+    anyhow::bail!("stable parked-peer filesystem identities are unavailable on this platform")
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn replacing_workspace_at_same_path_denies_cold_resume() {
+        let dir = tempfile::tempdir().unwrap();
+        let cwd = dir.path().join("cwd");
+        std::fs::create_dir(&cwd).unwrap();
+        let binary = dir.path().join("peer");
+        std::fs::write(&binary, "first").unwrap();
+        let role: ProcessRoleConfig = serde_json::from_value(serde_json::json!({
+            "name": "peer", "description": "", "config": "example"
+        }))
+        .unwrap();
+        let witness = ParkingAuthority::capture(&role, &cwd, &binary).unwrap();
+        witness.verify(&role, &cwd, &binary).unwrap();
+        let mut other = role.clone();
+        other.args.push("--another-profile-arg".into());
+        assert!(witness.verify(&other, &cwd, &binary).is_err());
+        std::fs::write(&binary, "rewritten").unwrap();
+        assert!(witness.verify(&role, &cwd, &binary).is_err());

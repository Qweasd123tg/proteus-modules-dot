+//! Correlated proof from the one already-addressed child. A generic snapshot
+//! lacks the persisted dir/parent/workspace and may omit the physical root.
+use super::*;
+use crate::{domain::SessionId, peer_checkpoint::PeerReady};
+impl ChildProcess {
+    pub(in super::super) fn spawn_resumed(
+        binary: &Path,
+        config_ref: &str,
+        extra_args: &[String],
+        cwd: &Path,
+        parent_session_id: SessionId,
+        depth_budget: u64,
+        expected: &ParkedCheckpoint,
+    ) -> Result<Self> {
+        Self::spawn_process(
+            binary,
+            config_ref,
+            extra_args,
+            cwd,
+            parent_session_id,
+            depth_budget,
+            false,
+            Some(expected.clone()),
+        )
+    }
+
+    pub(in super::super) async fn park_checkpoint(
+        &mut self,
+        expected_parent: SessionId,
+        expected_cwd: &Path,
+    ) -> Result<ParkedCheckpoint> {
+        anyhow::ensure!(
+            self.has_complete_write(),
+            "child has an incomplete control write"
+        );
+        let (session, root) = self.session.clone().context("unbound child cannot park")?;
+        let proof = self.read_checkpoint().await?;
+        let checkpoint = proof.checkpoint;
+        anyhow::ensure!(
+            checkpoint.session == session
+                && proof.root_thread_id == root
+                && checkpoint.parent_session_id == expected_parent
+                && checkpoint.workspace_path == expected_cwd.canonicalize()?,
+            "child checkpoint does not match its parent binding"
+        );
+        Ok(checkpoint)
+    }
+
+    pub(super) async fn read_checkpoint(&mut self) -> Result<PeerReady> {
+        let id = crate::domain::new_call_id();
+        self.send(&StdioRequest::ChildSessionCheckpoint {
+            id: Some(id.clone()),
+        })
+        .await?;
+        loop {
+            match self.next_control_output().await? {
+                StdioOutput::Response {
+                    id: Some(r),
+                    ok,
+                    output,
+                    ..
+                } if r == id => {
+                    // Do not report child-owned data, paths or config in these errors.
+                    anyhow::ensure!(ok, "child did not acknowledge a durable checkpoint");
+                    let proof: PeerReady =
+                        serde_json::from_value(output.context("child checkpoint is absent")?)?;
+                    proof.checkpoint.validate()?;
+                    return Ok(proof);
+                }
+                StdioOutput::Event { event } if matches!(*event, AppServerEvent::Shutdown) => {
+                    anyhow::bail!("child shut down before checkpoint")
+                }
+                _ => {}
+            }
+        }
+    }
+
+    pub(super) fn reject_foreign_cold_output(
+        expected: &ParkedCheckpoint,
+        output: &StdioOutput,
+    ) -> Result<()> {
+        if let StdioOutput::Event { event } = output {
+            let id = match event.as_ref() {
+                AppServerEvent::SessionSnapshot { snapshot } => Some(snapshot.session_id),
+                AppServerEvent::PendingRequestsUpdated { snapshot } => Some(snapshot.session_id),
+                AppServerEvent::Runtime { envelope } => {
+                    anyhow::ensure!(
+                        !matches!(envelope.event, crate::domain::Event::SessionStarted { .. }),
+                        "cold child unexpectedly started a fresh session"
+                    );
+                    Some(envelope.session_id)
+                }
+                _ => None,
+            };
+            anyhow::ensure!(
+                id.is_none_or(|id| id == expected.session.session_id),
+                "cold child stream changed session"
+            );
+        }
+        Ok(())
+    }
+
+    pub(in super::super) async fn terminate_verified(&mut self) -> Result<()> {
+        // Let the peer release its selected storage writer and join ordinary
+        // workers before reaping. A nonresponsive peer is killed only for
+        // cleanup; its checkpoint must not be advertised as resumable.
+        let clean = tokio::time::timeout(std::time::Duration::from_secs(2), async {
+            anyhow::ensure!(self.has_complete_write(), "child framing was interrupted");
+            self.send(&StdioRequest::Shutdown {
+                id: Some(crate::domain::new_call_id()),
+            })
+            .await?;
+            let status = self.child.wait().await?;
+            anyhow::ensure!(status.success(), "child did not exit cleanly");
+            Ok::<_, anyhow::Error>(())
+        })
+        .await;
+        if !matches!(clean, Ok(Ok(()))) {
+            if self.child.try_wait()?.is_none() {
+                self.child.start_kill()?;
+            }
+            self.child
+                .wait()
+                .await
+                .context("cannot confirm subagent process exit")?;
+            anyhow::bail!("could not verify clean child shutdown");
+        }
+        Ok(())
+    }
+}

+//! Queue and bound invariants independent of any child subprocess.
+use super::*;
+use crate::{contracts::StorageRevision, domain::new_session_id};
+use proteus_contracts::app_protocol::AppSubagentSession;
+
+fn task(cwd: &Path, parent: SessionId) -> ParkedTask {
+    let role: super::super::config::ProcessRoleConfig = serde_json::from_value(serde_json::json!({
+        "name":"r","description":"","config":"fixture"
+    }))
+    .unwrap();
+    ParkedTask {
+        checkpoint: ParkedCheckpoint {
+            session: AppSubagentSession {
+                session_id: new_session_id(),
+                session_dir: cwd.to_owned(),
+            },
+            parent_session_id: parent,
+            workspace_path: cwd.to_owned(),
+            revision: StorageRevision {
+                session_seq: 1,
+                history_revision: 1,
+            },
+            content_sha256: "0".repeat(64),
+            authority_sha256: "1".repeat(64),
+            effective_sha256: "2".repeat(64),
+        },
+        parent,
+        cwd: cwd.into(),
+        role: "r".into(),
+        history: HistoryRetention::new(),
+        authority: ParkingAuthority::capture(&role, cwd, &std::env::current_exe().unwrap())
+            .unwrap(),
+    }
+}
+
+#[test]
+fn cancelled_old_ticket_cannot_steal_a_new_reservation() {
+    let cwd = tempfile::tempdir().unwrap();
+    let cwd = cwd.path();
+    let parent = new_session_id();
+    let mut book = ParkedTasks::default();
+    let record = task(cwd, parent);
+    let history = record.history.clone();
+    assert!(book.insert("a".into(), record));
+    let old = book.reserve("a", parent, "r", cwd).unwrap().unwrap();
+    assert!(book.reserve("a", parent, "r", cwd).is_err());
+    book.cancel(&old).unwrap();
+    let current = book.reserve("a", parent, "r", cwd).unwrap().unwrap();
+    assert!(book.cancel(&old).is_err());
+    assert!(book.take(&old).is_err());
+    let consumed = book.take(&current).unwrap();
+    assert!(consumed.history.same_history(&history));
+    assert!(book.reserve("a", parent, "r", cwd).unwrap().is_none());
+}
+
+#[test]
+fn at_capacity_reservations_are_never_displaced_and_unreservable_history_expires() {
+    let cwd = tempfile::tempdir().unwrap();
+    let cwd = cwd.path();
+    let parent = new_session_id();
+    let mut book = ParkedTasks::default();
+    let mut active = Vec::new();
+    for n in 0..MAX_PARKED {
+        let id = n.to_string();
+        assert!(book.insert(id.clone(), task(cwd, parent)));
+        active.push(book.reserve(&id, parent, "r", cwd).unwrap().unwrap());
+    }
+    let omitted = task(cwd, parent);
+    let observer = omitted.history.clone();
+    assert!(!book.insert("new".into(), omitted));
+    assert!(!observer.is_retained());
+    let last = active.pop().unwrap();
+    book.cancel(&last).unwrap();
+    assert!(book.insert("new".into(), task(cwd, parent)));
+    assert!(!last.history.is_retained());
+    assert!(active.iter().all(|res| res.history.is_retained()));
+    drop(book);
+    assert!(active.iter().all(|res| !res.history.is_retained()));
+}
diff --git a/crates/proteus-core/src/core/agent_control/process/parking_authority.rs b/crates/proteus-core/src/core/agent_control/process/parking_authority.rs
new file mode 100644

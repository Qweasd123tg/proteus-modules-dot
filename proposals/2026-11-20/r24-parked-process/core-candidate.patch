diff --git a/crates/proteus-core/tests/process_agent_pool/durable_parking.rs b/crates/proteus-core/tests/process_agent_pool/durable_parking.rs
new file mode 100644
index 0000000..4fd61da
--- /dev/null
+++ b/crates/proteus-core/tests/process_agent_pool/durable_parking.rs
@@ -0,0 +1,317 @@
+//! Named collaboration follow-up after an actual OS process exit, without re-executing old work.
+use super::*;
+use crate::{AgentLifecycleStatus, test_model};
+use proteus_contracts::{
+    app_protocol::AppSubagentSession,
+    contracts::AgentRecordSnapshot,
+    domain::{Event, ThreadId, new_thread_id},
+};
+use std::{fs, path::PathBuf};
+
+fn probe_config(home: &Path, ledger: &Path) -> PathBuf {
+    let configs = home.join("configs");
+    fs::create_dir_all(&configs).unwrap();
+    let config = configs.join("config.toml");
+    let fixtures = Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures");
+    let probe = json!(fixtures.join("parking_probe.py"));
+    let reference = json!(test_model::reference_module());
+    fs::write(
+        &config,
+        format!(
+            r#"
+active_provider = "fake"
+[providers.fake]
+provider = "fake"
+model = "fake-tool-model"
+[modules]
+workflow = "parking_probe"
+policy = "allow_all"
+[tools]
+enabled = ["read_probe"]
+[components.test-policy]
+command = {reference}
+[components.test-policy.exports.policy.allow_all]
+[components.probe-workflow]
+command = "python3"
+args = ["-B", {probe}]
+[components.probe-workflow.exports.workflow.parking_probe]
+[components.probe-tool]
+command = "python3"
+args = ["-B", {probe}]
+[components.probe-tool.exports.tool.parking_receipt]
+[module_config.tool.parking_receipt]
+ledger = {}
+"#,
+            json!(ledger)
+        ) + &test_model::toml_component(),
+    )
+    .unwrap();
+    test_model::storage_config_file(&config);
+    config
+}
+
+async fn turn(
+    tools: &ToolRegistry,
+    ctx: &ToolContext,
+    tool: &str,
+    args: Value,
+) -> AgentRecordSnapshot {
+    let accepted = invoke(tools, ctx, tool, args).await;
+    assert!(accepted.ok, "{accepted:?}");
+    let mut snapshot = wait(tools, ctx).await;
+    let row = snapshot.agents.pop().unwrap();
+    assert_eq!(row.status, AgentLifecycleStatus::Completed, "{row:?}");
+    row
+}
+
+fn pid_and_answer(row: &AgentRecordSnapshot) -> (u64, String) {
+    let output = row.summary.as_deref().expect("workflow receipt");
+    let value: Value = serde_json::from_str(output).expect(output);
+    let pid = value["peer_pid"].as_u64().unwrap();
+    #[cfg(target_os = "linux")]
+    assert!(
+        !Path::new("/proc").join(pid.to_string()).exists(),
+        "wait returned while owned peer {pid} was still resident"
+    );
+    (pid, value["answer"].as_str().unwrap().to_owned())
+}
+
+async fn bindings(events: &InMemoryEventStore, thread: ThreadId) -> Vec<AppSubagentSession> {
+    events
+        .envelopes()
+        .await
+        .into_iter()
+        .filter_map(|e| match e.event {
+            Event::SubagentSessionBound {
+                child_thread_id,
+                session_id,
+                session_dir,
+            } if child_thread_id == thread => Some(AppSubagentSession {
+                session_id,
+                session_dir,
+            }),
+            _ => None,
+        })
+        .collect()
+}
+
+fn records(bytes: &[u8]) -> Vec<Value> {
+    serde_json::Deserializer::from_slice(bytes)
+        .into_iter::<Value>()
+        .map(Result::unwrap)
+        .collect()
+}
+
+#[tokio::test]
+async fn parked_named_agent_reopens_original_history_without_replaying_effect() {
+    let home = tempfile::tempdir().unwrap();
+    let workspace = tempfile::tempdir().unwrap();
+    let ledger = home.path().join("receipts.txt");
+    let config = probe_config(home.path(), &ledger);
+    let setup: AgentControlConfig = serde_json::from_value(json!({
+        "binary":proteus_binary(), "surface":"collaboration", "max_idle_processes":0, "durable_parking":true,
+        "roles":[{"name":"helper","description":"fixture","parallel_safe":true,"config":config,"timeout_ms":60_000},
+                 {"name":"other","description":"other fixture role","parallel_safe":true,"config":config,"timeout_ms":60_000}]
+    })).unwrap();
+    let runtime = AgentControlRuntime::from_config(&setup).unwrap();
+    let runner = runtime.service().unwrap();
+    let mut tools = ToolRegistry::new();
+    runtime.register_tools(&mut tools, 60_000).unwrap();
+    let events = Arc::new(InMemoryEventStore::new());
+    let owner = test_runtime_context(events.clone());
+    let task = AgentTask::new("delegate", workspace.path().into());
+    let mut ctx = ToolContext::new(
+        workspace.path().into(),
+        ExecutionAttribution::detached(new_execution_id()),
+    );
+    ctx.task = Some(task.clone());
+    ctx.agent_control = Some(Arc::new(ProcessHost {
+        service: runner.clone(),
+        ctx: owner.clone(),
+    }));
+
+    let a = turn(
+        &tools,
+        &ctx,
+        "spawn_agent",
+        json!({"task_name":"first","message":"seed","agent_type":"helper"}),
+    )
+    .await;
+    let (old_pid, secret) = pid_and_answer(&a);
+    assert!(secret.starts_with("A:"));
+    let a_id = a.child_thread_id.expect("parked A remains addressable");
+    let a_links = bindings(&events, a_id).await;
+    assert_eq!(a_links.len(), 1);
+    let a_file = a_links[0].session_dir.join("journal.jsonl");
+    let prefix = fs::read(&a_file).unwrap();
+    let effect = fs::read_to_string(&ledger).unwrap();
+    assert_eq!(effect.lines().count(), 1);
+    let a_records = records(&prefix);
+    assert_eq!(a_records.last().unwrap()["kind"], "turn_settled");
+    assert_eq!(
+        a_records
+            .iter()
+            .filter(|r| r["kind"] == "tool_result_recorded"
+                && r["payload"]["value"]["result"]["call_id"] == effect.trim_end()
+                && r["payload"]["value"]["result"]["ok"] == true)
+            .count(),
+        1
+    );
+
+    let b = turn(
+        &tools,
+        &ctx,
+        "spawn_agent",
+        json!({"task_name":"second","message":"unrelated","agent_type":"helper"}),
+    )
+    .await;
+    let (b_pid, independent) = pid_and_answer(&b);
+    assert_ne!(b_pid, old_pid);
+    assert!(independent.starts_with("B:"));
+    let b_id = b.child_thread_id.expect("parked B remains addressable");
+    assert_ne!(a_id, b_id);
+    let b_links = bindings(&events, b_id).await;
+    assert_eq!(b_links.len(), 1);
+    assert_ne!(a_links[0].session_id, b_links[0].session_id);
+    assert_ne!(a_links[0].session_dir, b_links[0].session_dir);
+    let b_file = b_links[0].session_dir.join("journal.jsonl");
+    let b_prefix = fs::read(&b_file).unwrap();
+
+    let other = tempfile::tempdir().unwrap();
+    let mut foreign = owner.clone();
+    foreign.session_id = proteus_contracts::domain::new_session_id();
+    let event_count = events.envelopes().await.len();
+    for (id, role, task, parent) in [
+        (new_thread_id(), "helper", task.clone(), owner.clone()),
+        (a_id, "helper", task.clone(), foreign),
+        (a_id, "other", task.clone(), owner.clone()),
+        (
+            a_id,
+            "helper",
+            AgentTask::new("delegate", other.path().into()),
+            owner.clone(),
+        ),
+    ] {
+        runner
+            .spawn(
+                AgentControlRequest::new(role, "recall", task).with_metadata(json!({"task_id":id})),
+                parent,
+            )
+            .await
+            .expect_err("unknown/foreign parking request rejected before dispatch");
+    }
+    assert_eq!(events.envelopes().await.len(), event_count);
+    assert_eq!(fs::read(&a_file).unwrap(), prefix);
+
+    let resumed = turn(
+        &tools,
+        &ctx,
+        "followup_task",
+        json!({"target":"first","message":"recall"}),
+    )
+    .await;
+    let (new_pid, recalled) = pid_and_answer(&resumed);
+    assert_ne!(new_pid, old_pid);
+    assert_ne!(new_pid, b_pid);
+    assert_eq!(recalled, secret);
+    assert_eq!(resumed.path, a.path);
+    assert_eq!(resumed.generation, 2);
+    assert_eq!(resumed.child_thread_id, Some(a_id));
+    let final_links = bindings(&events, a_id).await;
+    assert_eq!(
+        final_links,
+        vec![a_links[0].clone(); 2],
+        "unchanged durable session UUID and directory"
+    );
+    assert_eq!(fs::read(&b_file).unwrap(), b_prefix);
+    assert_eq!(
+        fs::read_to_string(&ledger).unwrap(),
+        effect,
+        "no duplicate tool execution"
+    );
+
+    let final_history = fs::read(&a_file).unwrap();
+    let delta = records(
+        final_history
+            .strip_prefix(&prefix[..])
+            .expect("exact canonical prefix"),
+    );
+    let turn_id = &delta.first().unwrap()["turn_id"];
+    assert!(!turn_id.is_null());
+    assert_ne!(turn_id, &a_records.last().unwrap()["turn_id"]);
+    assert_eq!(delta.first().unwrap()["kind"], "turn_opened");
+    assert_eq!(delta.last().unwrap()["kind"], "turn_settled");
+    for kind in ["turn_opened", "turn_settled"] {
+        assert_eq!(delta.iter().filter(|r| r["kind"] == kind).count(), 1);
+    }
+    assert!(delta.iter().all(|r| &r["turn_id"] == turn_id
+        && r["session_id"] == json!(a_links[0].session_id)
+        && !matches!(
+            r["kind"].as_str(),
+            Some("tool_call_recorded" | "tool_result_recorded" | "tool_effect_recorded")
+        )));
+    // A legitimate independent CLI turn advances B while the parent's parked
+    // descriptor still refers to the earlier settled prefix. The old logical
+    // reference must not silently adopt the new state (or create a new child).
+    let advanced = tokio::time::timeout(
+        std::time::Duration::from_secs(20),
+        tokio::process::Command::new(proteus_binary())
+            .arg("--config")
+            .arg(&config)
+            .arg("--cwd")
+            .arg(workspace.path())
+            .arg("--resume-session")
+            .arg(&b_links[0].session_dir)
+            .arg("unrelated")
+            .kill_on_drop(true)
+            .output(),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert!(
+        advanced.status.success(),
+        "{}",
+        String::from_utf8_lossy(&advanced.stderr)
+    );
+    let advanced_prefix = fs::read(&b_file).unwrap();
+    assert!(advanced_prefix.starts_with(&b_prefix) && advanced_prefix.len() > b_prefix.len());
+    let stale = invoke(
+        &tools,
+        &ctx,
+        "followup_task",
+        json!({"target":"second","message":"seed"}),
+    )
+    .await;
+    if stale.ok {
+        let denied = wait(&tools, &ctx).await;
+        assert_eq!(
+            denied.agents[0].status,
+            AgentLifecycleStatus::Errored,
+            "{denied:?}"
+        );
+    }
+    assert_eq!(
+        fs::read(&b_file).unwrap(),
+        advanced_prefix,
+        "stale descriptor must not submit another turn"
+    );
+    assert_eq!(fs::read_to_string(&ledger).unwrap(), effect);
+    assert_eq!(
+        bindings(&events, b_id).await.len(),
+        1,
+        "unverified resume must not publish a binding"
+    );
+    let sessions = proteus_core::core::list_workspace_session_summaries(
+        test_model::storage(workspace.path()),
+        home.path(),
+        workspace.path(),
+    )
+    .unwrap();
+    assert_eq!(sessions.len(), 2, "no fresh fallback session");
+    eprintln!(
+        "cold-followup completed: pids={old_pid},{b_pid},{new_pid}; generations=1,1,2; A prefix={} bytes; appended={} records; physical effect count=1; B untouched",
+        prefix.len(),
+        delta.len()
+    );
+}
diff --git a/docs/architecture/subagents.md b/docs/architecture/subagents.md
index b665ff7..b3ab96d 100644
--- a/docs/architecture/subagents.md
+++ b/docs/architecture/subagents.md
@@ -202,6 +202,48 @@ source/target отклоняются до enqueue. `AgentControlMessage` хра
 в model-visible user message. Authority при доставке не объединяется: peer
 продолжает исполнять tools только через собственные registry, policy и safety.
 
+### Эксперимент: продолжение leaf-agent без резидентного процесса
+
+По умолчанию правила выше не меняются. Для изолированного доверенного
+профиля на Unix можно явно включить `agent_control.durable_parking = true`
+совместно с `max_idle_processes = 0` и `max_depth = 1`. Это не восстановление
+после рестарта родителя и не поддержка сотни одновременно работающих процессов.
+
+После успешного завершения и закрытия mailbox родитель просит у ребёнка
+контрольную запись. Для неё нужны успешный последний `TurnSettled`,
+отсутствие прерванных операций, открытых терминалов и ожидающих интерактивных
+запросов. В ней связываются фактические session ID/каталог, workspace,
+immediate parent, ревизия и хеш содержимого журнала, отпечатки загруженного
+профиля и эффективных настроек. Родитель также фиксирует исходную роль,
+канонический workspace и идентичность исполняемого файла. Сервер не принимает
+эквивалент этой записи или путь журнала из task metadata. После подтверждённого
+выхода старого процесса он хранит только запись, без загруженного runtime.
+Недоказанная парковка не отменяет уже успешно сделанную работу, но её
+`task_id` не объявляется продолжабельным.
+
+Продолжение резервирует запись атомарно, ждёт обычный permit роли и запускает
+новый PID. Холодный child открывает именно сохранённый journal с writer lease,
+сверяет его состояние и настройки, подтверждает физический root своего
+текущего runtime и только затем получает **новый** `Send`. Заменить профиль,
+workspace или модель через follow-up, автоматически повторить неоднозначный
+`Send` или стартовать чистую сессию вместо изменившейся истории нельзя.
+Прежний logical task ID и durable session сохраняются, но physical thread
+нового runtime не обязан совпадать с прежним. Отмена до выдачи permit
+возвращает запись в ограниченный реестр; ошибка после потребления записи
+делает её недоступной. Родитель держит максимум 64 таких записей на runtime,
+удаляя старейшую незарезервированную, и не повышает лимиты параллелизма.
+После остановки родителя остаётся только обычная история, а не authority для
+повторного запуска.
+
+Это opt-in для согласованных leaf-ролей, чьё состояние восстанавливается
+штатной сессией. Доверенные локальные executable и реализации компонентов
+должны оставаться теми же; это не защита от модификации частей процесса
+локальным администратором и не snapshot внешних систем. Проверка свежего
+head требует поддержки строгого snapshot/writer contract у storage. Живые
+process-local ресурсы стороннего компонента без такого контракта не
+переносятся. При положительном idle cap этот режим не включается.
+
+

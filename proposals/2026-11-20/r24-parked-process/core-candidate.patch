+//! A comparable projection of *live* settings; do not use journal summaries
+//! or the launch configuration to infer a transient delegated model choice.
+use anyhow::{Context, Result, ensure};
+
+impl super::AgentRuntime {
+    pub(crate) async fn peer_settings_fingerprint(&self) -> Result<String> {
+        ensure!(
+            self.services.terminals.is_empty().await,
+            "child retains process-local terminal handles"
+        );
+        let captured = self.capture_execution_snapshot().await;
+        let mut config = captured
+            .config_snapshot
+            .context("parking requires a durable execution configuration")?;
+        // Construction timestamp is not execution authority.
+        config.ts = 0;
+        let stream = captured
+            .runtime
+            .registry
+            .model_config
+            .as_ref()
+            .map(|m| m.stream);
+        crate::core::peer_digest(&("peer-runtime-v1", config, stream))
+    }
+}

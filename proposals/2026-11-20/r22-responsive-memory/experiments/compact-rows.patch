diff --git a/crates/proteus-contracts/tests/sparse_transcript.rs b/crates/proteus-contracts/tests/sparse_transcript.rs
new file mode 100644
index 0000000..325e7c9
--- /dev/null
+++ b/crates/proteus-contracts/tests/sparse_transcript.rs
@@ -0,0 +1,33 @@
+//! Diagnostic proof: public Rust field types change; serialized HTTP/SSE and cache rows must not.
+use proteus_contracts::app_protocol::{
+    AppTranscriptMessage, AppTranscriptSubagent, AppTranscriptTool,
+};
+
+#[test]
+#[cfg(target_pointer_width = "64")]
+fn plain_rows_no_longer_reserve_inline_space_for_absent_rich_cards() {
+    use std::mem::size_of;
+    assert_eq!(
+        size_of::<Option<Box<AppTranscriptTool>>>(),
+        size_of::<usize>()
+    );
+    assert_eq!(
+        size_of::<Option<Box<AppTranscriptSubagent>>>(),
+        size_of::<usize>()
+    );
+    assert!(
+        size_of::<AppTranscriptMessage>() <= 144,
+        "row no longer sparse"
+    );
+}
+
+#[test]
+fn golden_plain_tool_and_subagent_rows_roundtrip_without_wire_changes() {
+    const PLAIN: &str = r#"{"message_id":"00000000-0000-0000-0000-000000000001","timestamp_ms":7,"phase":null,"role":"assistant","text":"текст","images":[],"tool":null,"subagent":null,"streaming":false}"#;
+    const TOOL: &str = r#"{"message_id":null,"timestamp_ms":9,"phase":null,"role":"system","text":"","images":[],"tool":{"call_id":"c","name":"edit","args":{"a":3},"effective_args":null,"status":"done","result":"ok","metadata":{}},"subagent":null,"streaming":false}"#;
+    const SUBAGENT: &str = r#"{"message_id":null,"timestamp_ms":11,"phase":null,"role":"system","text":"","images":[],"tool":null,"subagent":{"child_thread_id":"t","session":{"session_id":"00000000-0000-0000-0000-000000000002","session_dir":"/test"},"role":"worker","description":null,"status":"running","iterations":1,"tools":[{"call_id":"s","name":"read","args":{},"effective_args":{},"status":"running","result":null,"metadata":null}]},"streaming":true}"#;
+    for golden in [PLAIN, TOOL, SUBAGENT] {
+        let row: AppTranscriptMessage = serde_json::from_str(golden).unwrap();
+        assert_eq!(serde_json::to_string(&row).unwrap(), golden);
+    }
+}

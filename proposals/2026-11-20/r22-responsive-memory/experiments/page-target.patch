+#[test]
+fn projected_pages_bound_regular_batches_and_deliver_oversized_records_intact() {
+    for kind in backends() {
+        let mut f = Fixture::new(kind);
+        let messages = [
+            text(&"a".repeat(360 * 1024)),
+            text(&"b".repeat(360 * 1024)),
+            text(&"c".repeat(360 * 1024)),
+            text(&"d".repeat(1120 * 1024)),
+            text("tail"),
+        ];
+        for msg in &messages {
+            f.append(vec![msg.clone()]);
+        }
+        let projection = open(&f);
+        let read = |request: SessionStorageRequest| {
+            let response = f.service.execute(request.clone()).unwrap();
+            request.validate_response(&response).unwrap();
+            let SessionStorageResponse::Records { page } = response else {
+                panic!()
+            };
+            page
+        };
+        let canonical = read(SessionStorageRequest::ReadRecords {
+            snapshot: f.snapshot(),
+            after_seq: 0,
+            limit: 64,
+        });
+        // Full canonical paging retains its existing 4 MiB policy.
+        assert_eq!(canonical.records.len(), 5);
+        let display = |after_seq| {
+            read(SessionStorageRequest::ReadDisplayRecords {
+                snapshot: projection.snapshot.clone(),
+                after_seq,
+                limit: 64,
+            })
+        };
+        let mut after = 0;
+        let mut returned = Vec::new();
+        for (count, next) in [(2, Some(2)), (1, Some(3)), (1, Some(4)), (1, None)] {
+            let page = display(after);
+            assert_eq!(page.records.len(), count);
+            assert_eq!(page.next_after_seq, next);
+            returned.extend(page.records);
+            after = next.unwrap_or(0);
+        }
+        assert_eq!(returned, canonical.records);
+        assert_eq!(display(0).records, canonical.records[..2]); // Independent rewind.
+    }
+}
+
 mod concurrency;

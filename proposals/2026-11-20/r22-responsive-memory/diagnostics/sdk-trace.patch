@@ -0,0 +1,192 @@
+//! Opt-in diagnostic observer for terminal session-storage responses.
+//! One invocation thread owns each sample. Never log request/response values.
+use std::{
+    cell::RefCell,
+    fs::{File, OpenOptions},
+    io::{self, Write},
+    sync::Mutex,
+};
+
+use anyhow::{Context, Result};
+use serde::Serialize;
+
+pub(crate) struct TraceFile(Mutex<File>);
+
+impl TraceFile {
+    pub fn open() -> Result<Option<Self>> {
+        let Some(path) = std::env::var_os("PROTEUS_SDK_TRACE_PATH") else {
+            return Ok(None);
+        };
+        let mut options = OpenOptions::new();
+        options.create(true).append(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let file = options.open(path).context("open SDK diagnostic trace")?;
+        Ok(Some(Self(Mutex::new(file))))
+    }
+
+    pub fn finish(&self, id: &str, operation: &'static str, ok: bool) -> Result<()> {
+        let Some(stages) = ACTIVE.with(|a| a.take()) else {
+            return Ok(());
+        };
+        #[derive(Serialize)]
+        struct Row<'a> {
+            clock: &'static str,
+            pid: u32,
+            id: &'a str,
+            operation: &'static str,
+            terminal_ok: bool,
+            #[serde(flatten)]
+            timing: Stages,
+        }
+        let mut row = serde_json::to_vec(&Row {
+            clock: CLOCK_NAME,
+            pid: std::process::id(),
+            id,
+            operation,
+            terminal_ok: ok,
+            timing: stages,
+        })?;
+        row.push(b'\n');
+        self.0
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .write_all(&row)?;
+        Ok(())
+    }
+}
+
+#[cfg(target_os = "linux")]
+const CLOCK_NAME: &str = "CLOCK_MONOTONIC";
+#[cfg(target_os = "linux")]
+pub fn now() -> u64 {
+    let mut ts = std::mem::MaybeUninit::<libc::timespec>::uninit();
+    // CLOCK_MONOTONIC matches the peer's Python time.monotonic_ns() on Linux.
+    // SAFETY: the pointer is writable and read only when the call succeeds.
+    let result = unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, ts.as_mut_ptr()) };
+    assert_eq!(result, 0, "diagnostic clock unavailable");
+    let ts = unsafe { ts.assume_init() };
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+#[cfg(not(target_os = "linux"))]
+const CLOCK_NAME: &str = "process_local_monotonic";
+#[cfg(not(target_os = "linux"))]
+pub fn now() -> u64 {
+    use std::{sync::OnceLock, time::Instant};
+    static ORIGIN: OnceLock<Instant> = OnceLock::new();
+    ORIGIN.get_or_init(Instant::now).elapsed().as_nanos() as u64
+}
+
+// Null = this stage was never reached, including errors and closed transports.
+#[derive(Default, Serialize)]
+pub(crate) struct Stages {
+    admitted_ns: u64,
+    dispatch_start_ns: u64,
+    pub storage_start_ns: Option<u64>,
+    pub value_start_ns: Option<u64>,
+    pub value_end_ns: Option<u64>,
+    pub dispatch_end_ns: Option<u64>,
+    pub count_start_ns: Option<u64>,
+    pub count_end_ns: Option<u64>,
+    pub stdout_lock_ns: Option<u64>,
+    pub encode_end_ns: Option<u64>,
+    pub flush_end_ns: Option<u64>,
+    pub frame_bytes: Option<usize>,
+    pub sink_write_calls: usize,
+    pub sink_write_ns: u64,
+    pub sink_write_ns_at_encode_end: u64,
+    pub sink_flush_ns: u64,
+}
+
+thread_local! {
+    static ACTIVE: RefCell<Option<Stages>> = const { RefCell::new(None) };
+}
+
+pub fn begin(admitted_ns: u64) {
+    ACTIVE.with(|a| {
+        a.replace(Some(Stages {
+            admitted_ns,
+            dispatch_start_ns: now(),
+            ..Default::default()
+        }))
+    });
+}
+
+pub fn mark(f: impl FnOnce(&mut Stages, u64)) {
+    ACTIVE.with(|a| {
+        if let Some(stages) = a.borrow_mut().as_mut() {
+            f(stages, now());
+        }
+    });
+}
+
+// Wrap only the original sink *below* the same BufWriter, when diagnostics are enabled.
+// Counting serde's many small writes individually would distort the lock under test.
+pub(crate) struct Metered<W>(pub W);
+
+impl<W: Write> Write for Metered<W> {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        let start = ACTIVE.with(|a| a.borrow().is_some().then(now));
+        let r = self.0.write(bytes);
+        if let Some(start) = start {
+            mark(|s, end| {
+                s.sink_write_ns += end - start;
+                s.sink_write_calls += 1;
+            });
+        }
+        r
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        let start = ACTIVE.with(|a| a.borrow().is_some().then(now));
+        let r = self.0.flush();
+        if let Some(start) = start {
+            mark(|s, end| s.sink_flush_ns += end - start);
+        }
+        r
+    }
+}
+
+// Accept fixed labels only. Unknown or malformed operation names are never logged verbatim.
+pub fn operation(raw: Option<&str>) -> &'static str {
+    const NAMES: &[&str] = &[
+        "create",
+        "open",
+        "describe",
+        "list",
+        "list_candidates",
+        "acquire_writer",
+        "release_writer",
+        "hibernate_writer",
+        "commit",
+        "commit_status",
+        "open_snapshot",
+        "open_display_snapshot",
+        "release_snapshot",
+        "compare_snapshots",
+        "read_records",
+        "read_display_records",
+        "read_conversation",
+        "read_usage",
+        "resume",
+        "read_execution_state",
+        "read_committed_turn",
+        "read_model_context_before_turn",
+        "read_writer_model_context_before_turn",
+        "read_metadata",
+        "read_cache",
+        "write_cache",
+        "compare_exchange_metadata",
+        "put_blob",
+        "read_blob",
+        "read_blob_by_hash",
+        "delete",
+    ];
+    NAMES
+        .iter()
+        .copied()
+        .find(|known| Some(*known) == raw)
+        .unwrap_or("other")
+}

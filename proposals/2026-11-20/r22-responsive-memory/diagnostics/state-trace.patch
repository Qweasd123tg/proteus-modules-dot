index 0000000..074570c
--- /dev/null
+++ b/storage/session-storage/src/service/state_trace.rs
@@ -0,0 +1,271 @@
+//! Diagnostic-only Linux x86_64 bench probe. Never serialize request/response payloads.
+use super::*;
+use std::{
+    cell::RefCell,
+    fs::{File, OpenOptions},
+    io::Write,
+    ops::{Deref, DerefMut},
+    sync::{
+        MutexGuard, OnceLock,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+#[cfg(not(all(target_os = "linux", target_arch = "x86_64")))]
+compile_error!("This diagnostic CLOCK_MONOTONIC ABI is for Linux x86_64 only");
+
+pub(super) fn now() -> u64 {
+    #[repr(C)]
+    struct Timespec {
+        sec: i64,
+        nsec: i64,
+    }
+    unsafe extern "C" {
+        fn clock_gettime(clockid: i32, ts: *mut Timespec) -> i32;
+    }
+    let mut ts = Timespec { sec: 0, nsec: 0 };
+    // Linux x86_64 libc timespec layout; CLOCK_MONOTONIC = 1, same clock as Python.
+    assert_eq!(unsafe { clock_gettime(1, &mut ts) }, 0);
+    ts.sec as u64 * 1_000_000_000 + ts.nsec as u64
+}
+
+static LOG: OnceLock<Option<Mutex<File>>> = OnceLock::new();
+static SEQUENCE: AtomicU64 = AtomicU64::new(1);
+fn log() -> Option<&'static Mutex<File>> {
+    LOG.get_or_init(|| {
+        std::env::var_os("PROTEUS_R22_STATE_TRACE").map(|p| {
+            Mutex::new(
+                OpenOptions::new()
+                    .append(true)
+                    .create(true)
+                    .open(p)
+                    .expect("unable to open diagnostic trace"),
+            )
+        })
+    })
+    .as_ref()
+}
+
+#[derive(Default, Serialize)]
+struct Stages {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    writer_fold: Option<&'static str>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    writer_acquire: Option<&'static str>,
+    writer_recover_ns: u64,
+    writer_replay_ns: u64,
+    writer_records: u64,
+    resume_clone_ns: u64,
+    display_setup_ns: u64,
+    display_next_ns: u64,
+    display_apply_ns: u64,
+    display_push_ns: u64,
+    display_scan_ns: u64,
+    display_records: u64,
+    display_pushes: u64,
+    display_verify_catalog_ns: u64,
+    display_finish_ns: u64,
+    display_into_resume_ns: u64,
+    display_state_fits_ns: u64,
+    display_publish_ns: u64,
+    display_bytes: Option<u64>,
+}
+thread_local! { static STAGES: RefCell<Stages> = RefCell::new(Stages::default()); }
+
+pub(super) fn acquire(mode: &'static str) {
+    STAGES.with_borrow_mut(|s| s.writer_acquire = Some(mode));
+}
+pub(super) fn fold(mode: &'static str) {
+    STAGES.with_borrow_mut(|s| s.writer_fold = Some(mode));
+}
+pub(super) fn writer_recover(ns: u64) {
+    STAGES.with_borrow_mut(|s| s.writer_recover_ns += ns);
+}
+pub(super) fn writer_replay(ns: u64, records: u64) {
+    STAGES.with_borrow_mut(|s| {
+        s.writer_replay_ns += ns;
+        s.writer_records += records;
+    });
+}
+pub(super) fn resume(ns: u64) {
+    STAGES.with_borrow_mut(|s| s.resume_clone_ns += ns);
+}
+
+#[derive(Default)]
+pub(super) struct Display {
+    pub setup: u64,
+    pub next: u64,
+    pub apply: u64,
+    pub push: u64,
+    pub scan: u64,
+    pub count: u64,
+    pub pushes: u64,
+    pub catalog: u64,
+    pub finish: u64,
+    pub resume: u64,
+    pub fits: u64,
+    pub publish: u64,
+    pub bytes: Option<u64>,
+}
+impl Drop for Display {
+    fn drop(&mut self) {
+        STAGES.with_borrow_mut(|s| {
+            s.display_setup_ns = self.setup;
+            s.display_next_ns = self.next;
+            s.display_apply_ns = self.apply;
+            s.display_push_ns = self.push;
+            s.display_scan_ns = self.scan;
+            s.display_records = self.count;
+            s.display_pushes = self.pushes;
+            s.display_verify_catalog_ns = self.catalog;
+            s.display_finish_ns = self.finish;
+            s.display_into_resume_ns = self.resume;
+            s.display_state_fits_ns = self.fits;
+            s.display_publish_ns = self.publish;
+            s.display_bytes = self.bytes;
+        });
+    }
+}
+
+#[derive(Serialize)]
+pub(super) struct Meta {
+    op: &'static str,
+    session_id: Option<SessionId>,
+    kind: Option<JournalKind>,
+}
+impl Meta {
+    pub(super) fn new(op: &'static str, sid: Option<SessionId>) -> Self {
+        Self {
+            op,
+            session_id: sid,
+            kind: None,
+        }
+    }
+    pub(super) fn request(r: &SessionStorageRequest) -> Self {
+        use SessionStorageRequest::*;
+        let (op, id) = match r {
+            Create { session_id, .. } => ("create", *session_id),
+            Describe { session } => ("describe", session.session_id),
+            AcquireWriter { session } => ("acquire_writer", session.session_id),
+            HibernateWriter { lease } => ("hibernate_writer", lease.session.session_id),
+            ReleaseWriter { lease } => ("release_writer", lease.session.session_id),
+            Resume { lease } => ("resume", lease.session.session_id),
+            Commit { commit } => {
+                return Self {
+                    op: "commit",
+                    session_id: Some(commit.lease.session.session_id),
+                    kind: Some(commit.entry.kind()),
+                };
+            }
+            CommitStatus { session, .. } => ("commit_status", session.session_id),
+            OpenSnapshot { session } => ("open_snapshot", session.session_id),
+            OpenDisplaySnapshot { session } => ("open_display_snapshot", session.session_id),
+            ReleaseSnapshot { snapshot } => ("release_snapshot", snapshot.session.session_id),
+            CompareSnapshots { snapshot, .. } => ("compare_snapshots", snapshot.session.session_id),
+            ReadRecords { snapshot, .. } => ("read_records", snapshot.session.session_id),
+            ReadDisplayRecords { snapshot, .. } => {
+                ("read_display_records", snapshot.session.session_id)
+            }
+            ReadConversation { snapshot, .. } => ("read_conversation", snapshot.session.session_id),
+            ReadUsage { snapshot } => ("read_usage", snapshot.session.session_id),
+            ReadExecutionState { lease } => ("read_execution_state", lease.session.session_id),
+            ReadCommittedTurn { lease, .. } => ("read_committed_turn", lease.session.session_id),
+            ReadModelContextBeforeTurn { snapshot, .. } => (
+                "read_model_context_before_turn",
+                snapshot.session.session_id,
+            ),
+            ReadWriterModelContextBeforeTurn { lease, .. } => (
+                "read_writer_model_context_before_turn",
+                lease.session.session_id,
+            ),
+            WriteCache { session, .. } => ("write_cache", session.session_id),
+            ReadMetadata { session, .. } => ("read_metadata", session.session_id),
+            CompareExchangeMetadata { lease, .. } => {
+                ("compare_exchange_metadata", lease.session.session_id)
+            }
+            PutBlob { lease, .. } => ("put_blob", lease.session.session_id),
+            ReadBlob { session, .. } => ("read_blob", session.session_id),
+            ReadBlobByHash { session, .. } => ("read_blob_by_hash", session.session_id),
+            Delete { lease, .. } => ("delete", lease.session.session_id),
+            Open { .. } | List { .. } | ListCandidates { .. } | ReadCache { .. } => {
+                unreachable!("not a State request")
+            }
+        };
+        Self::new(op, Some(id))
+    }
+}
+
+pub(super) struct Guard<'a> {
+    inner: Option<MutexGuard<'a, State>>,
+    meta: Meta,
+    wait_ns: u64,
+    acquired_ns: u64,
+    seq: u64,
+    sink: Option<&'static Mutex<File>>,
+}
+impl Deref for Guard<'_> {
+    type Target = State;
+    fn deref(&self) -> &State {
+        self.inner.as_deref().unwrap()
+    }
+}
+impl DerefMut for Guard<'_> {
+    fn deref_mut(&mut self) -> &mut State {
+        self.inner.as_deref_mut().unwrap()
+    }
+}
+impl<'a> Guard<'a> {
+    pub(super) fn lock(m: &'a Mutex<State>, meta: Meta) -> Result<Self> {
+        let sink = log();
+        let seq = SEQUENCE.fetch_add(1, Ordering::Relaxed);
+        STAGES.with_borrow_mut(|s| *s = Stages::default());
+        let wait_ns = now();
+        let inner = m
+            .lock()
+            .map_err(|_| anyhow::anyhow!("storage service lock poisoned"))?;
+        let acquired_ns = now();
+        Ok(Self {
+            inner: Some(inner),
+            meta,
+            wait_ns,
+            acquired_ns,
+            seq,
+            sink,
+        })
+    }
+    pub(super) fn sid(&mut self, sid: SessionId) {
+        self.meta.session_id = Some(sid);
+    }
+}
+impl Drop for Guard<'_> {
+    fn drop(&mut self) {
+        let release_ns = now();
+        drop(self.inner.take());
+        let released_ns = now();
+        let Some(sink) = self.sink else {
+            return;
+        };
+        let stages = STAGES.with(|s| s.take());
+        let thread = std::thread::current();
+        let id = thread
+            .name()
+            .and_then(|n| n.strip_prefix("component-invocation-h-"))
+            .and_then(|s| s.split_once('-'))
+            .filter(|(g, q)| {
+                [g, q].into_iter().all(|p| {
+                    !p.is_empty() && p.len() <= 20 && p.bytes().all(|b| b.is_ascii_digit())
+                })
+            })
+            .map(|(g, q)| format!("h:{g}:{q}"));
+        let row = serde_json::json!({"event":"state","pid":std::process::id(),"id":id,"seq":self.seq,
+            "op":self.meta.op,"session_id":self.meta.session_id,"kind":self.meta.kind,
+            "wait_start_ns":self.wait_ns,"acquired_ns":self.acquired_ns,"release_ns":release_ns,
+            "released_ns":released_ns,"wait_ns":self.acquired_ns-self.wait_ns,"hold_ns":release_ns-self.acquired_ns,"stages":stages});
+        let mut bytes = serde_json::to_vec(&row).expect("safe diagnostic fields");
+        bytes.push(b'\n');
+        sink.lock()
+            .expect("trace sink poisoned")
+            .write_all(&bytes)
+            .expect("trace write failed");
+    }
+}

+fn preview_excerpt(text: &str) -> Option<String> {
+    const LIMIT: usize = 160;
+    let text = text.trim();
+    if text.is_empty() {
+        return None;
+    }
+    if text.len() > LIMIT
+        && let Some((end, _)) = text.char_indices().nth(LIMIT)
+    {
+        let mut preview = String::with_capacity(end + 3);
+        preview.push_str(&text[..end]);
+        preview.push_str("...");
+        Some(preview)
+    } else {
+        Some(text.to_owned())
+    }
+}

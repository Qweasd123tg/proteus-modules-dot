+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::transcript::Role;
+
+    fn rows(keys: impl IntoIterator<Item = u64>) -> Vec<Entry> {
+        keys.into_iter()
+            .map(|key| Entry {
+                key,
+                message_id: None,
+                role: Role::Assistant,
+                text: "".into(),
+                images: Vec::new(),
+                tool: None,
+                subagent: None,
+                streaming: false,
+                time: None,
+            })
+            .collect()
+    }
+
+    #[test]
+    fn unordered_overlap_prefers_old_order_then_first_new_duplicate() {
+        let old = rows(0..200);
+        let mut new = rows(1000..1200);
+        new[2].key = 75;
+        new[6].key = 65;
+        new[30].key = 65;
+        new[31].key = 66;
+        assert_eq!(first_overlap(&old, &new), Some((65, 6)));
+        assert_eq!(
+            window_changes(&old, &new),
+            [
+                Change::Spliced {
+                    start: 66,
+                    removed: 134,
+                    inserted: 0,
+                },
+                Change::Spliced {
+                    start: 0,
+                    removed: 65,
+                    inserted: 6,
+                },
+                Change::Spliced {
+                    start: 7,
+                    removed: 0,
+                    inserted: 193,
+                },
+            ]
+        );
+    }
+    #[test]
+    fn ordered_overlap_chooses_the_first_duplicate() {
+        let old = rows(0..200);
+        let new = rows([65, 65, 66].into_iter().chain(1000..1197));
+        assert_eq!(first_overlap(&old, &new), Some((65, 0)));
+    }

diff --git a/model/model-pack/src/adapters/openai/request_tests.rs b/model/model-pack/src/adapters/openai/request_tests.rs
index e3d572c6478ac3895fd069dcdefd2fc554ff3146..8f9baf0956243fc47cb21ae9ed98c91651c605aa 100644
--- a/model/model-pack/src/adapters/openai/request_tests.rs

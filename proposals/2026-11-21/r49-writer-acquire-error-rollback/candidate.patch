+//! Exercise shared writer acquisition without mutating a valid stored session.
+use super::*;
+use crate::{
+    backend::{Append, PrefixHint, RecordSnapshot},
+    tests::{Fixture, backends, text},
+};
+use std::io;
+
+// Installed only while the hibernated writer is reacquired. No filesystem
+// faults, malformed records or timing-dependent failures are required.
+struct InterruptedRecovery;
+
+impl JournalBackend for InterruptedRecovery {
+    fn recover(&mut self, _: &Path, _: SessionId) -> Result<()> {
+        Err(io::Error::new(io::ErrorKind::Interrupted, "test recovery interruption").into())
+    }
+    fn snapshot(&mut self, _: &Path, _: SessionId) -> Result<Box<dyn RecordSnapshot>> {
+        unreachable!()
+    }
+    fn snapshot_warm(
+        &mut self,
+        _: &Path,
+        _: SessionId,
+        _: &PrefixHint,
+    ) -> Result<Box<dyn RecordSnapshot>> {
+        unreachable!()
+    }
+    fn append(&mut self, _: &Path, _: &JournalRecord) -> Result<Append> {
+        unreachable!()
+    }
+    fn description_path(&self, _: &Path) -> PathBuf {
+        unreachable!()
+    }
+}
+
+#[test]
+fn failed_shared_acquire_preserves_only_delivered_handles() {
+    use SessionStorageRequest::*;
+    use SessionStorageResponse as Response;
+
+    for kind in backends() {
+        let mut f = Fixture::new(kind);
+        f.append(vec![text("committed before hibernation")]);
+        let session = f.descriptor.session;
+        let acquire = AcquireWriter {
+            session: session.clone(),
+        };
+        let Response::Writer { lease, revision } = f.service.execute(acquire.clone()).unwrap()
+        else {
+            panic!("expected shared writer")
+        };
+        f.service.execute(ReleaseWriter { lease: f.lease }).unwrap();
+        f.service
+            .execute(HibernateWriter {
+                lease: lease.clone(),
+            })
+            .unwrap();
+
+        let original = {
+            let mut state = f.service.lock_state().unwrap();
+            std::mem::replace(
+                &mut state.writer(&lease).unwrap().backend,
+                Box::new(InterruptedRecovery),
+            )
+        };
+        let error = f.service.execute(acquire.clone()).unwrap_err();
+        assert_eq!(
+            error.downcast_ref::<io::Error>().unwrap().kind(),
+            io::ErrorKind::Interrupted
+        );
+        f.service
+            .lock_state()
+            .unwrap()
+            .writer(&lease)
+            .unwrap()
+            .backend = original;
+
+        let Response::Writer {
+            lease: next,
+            revision: recovered,
+        } = f.service.execute(acquire.clone()).unwrap()
+        else {
+            panic!("expected retry to recover the writer")
+        };
+        assert_eq!(recovered, revision);
+        assert_ne!(next.token, lease.token);
+        f.service.execute(ReleaseWriter { lease }).unwrap();
+        f.service.execute(ReleaseWriter { lease: next }).unwrap();
+
+        // The worker is still alive; the last delivered handle must have
+        // relinquished actual OS ownership to a second storage service.
+        let other = StorageService::new(kind);
+        let Response::Writer {
+            revision: reopened, ..
+        } = other.execute(acquire).unwrap()
+        else {
+            panic!("expected second owner")
+        };
+        assert_eq!(reopened, revision);
+    }
+}

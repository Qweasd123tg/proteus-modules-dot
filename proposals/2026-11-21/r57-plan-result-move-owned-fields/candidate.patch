+impl PlanStep {
+    fn into_result_value(self) -> Value {
+        result_object([
+            ("step", Value::String(self.step)),
+            (
+                "status",
+                serde_json::to_value(self.status).expect("plan status serializes as a string"),
+            ),
+        ])
+    }

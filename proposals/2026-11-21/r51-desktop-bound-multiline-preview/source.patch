+/// Borrow at most the remaining scalar budget and advance that budget.
+fn take_chars<'a>(text: &'a str, remaining: &mut usize) -> &'a str {
+    if text.len() <= *remaining {
+        *remaining -= text.chars().count();
+        return text;
+    }
+    for (at, _) in text.char_indices() {
+        if *remaining == 0 {
+            return &text[..at];
+        }
+        *remaining -= 1;
+    }
+    text
 }
 

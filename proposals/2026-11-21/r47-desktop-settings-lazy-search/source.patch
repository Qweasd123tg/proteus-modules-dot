+            ("Шрифт чата", &[][..], "exact"),
+            ("Шрифт интерфейса", &["Шрифт темы"][..], "miss"),
+        ] {
+            finder.add(
+                Hit::new(title, id, PageId::Chat).spot(format!("field:{id}")),
+                fields,
+            );
+        }

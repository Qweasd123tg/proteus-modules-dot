+    service: &StorageService,
+    snapshot: &StorageSnapshot,
+    after_seq: u64,
+    limit: u32,
+) -> StorageRecordPage {
+    let SessionStorageResponse::Records { page } = service
+        .execute(SessionStorageRequest::ReadRecords {
+            snapshot: snapshot.clone(),
+            after_seq,
+            limit,
+        })
+        .unwrap()
+    else {
+        panic!();
+    };
+    page
+}

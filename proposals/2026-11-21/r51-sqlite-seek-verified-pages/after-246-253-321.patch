+#[test]
+fn sqlite_verified_seek_preserves_pending_records_at_the_page_byte_budget() {
+    let mut f = Fixture::new(BackendKind::Sqlite);
+    for seq in 0..8 {
+        f.append(vec![text(&format!("small {seq}"))]);
+    }
+    for ch in ['A', 'B', 'C'] {
+        f.append(vec![text(&ch.to_string().repeat(2 * 1024 * 1024))]);
+    }
+    let source = StorageService::new(BackendKind::Sqlite);
+    let SessionStorageResponse::Snapshot { snapshot } = source
+        .execute(SessionStorageRequest::OpenSnapshot {
+            session: f.descriptor.session.clone(),
+        })
+        .unwrap()
+    else {
+        panic!();
+    };
+    crate::diagnostics::reset();
+    for after in [8, 9, 10] {
+        let page = page_for(&source, &snapshot, after, 10);
+        assert_eq!(page.records.len(), 1);
+        assert_eq!(page.records[0].session_seq, after + 1);
+        assert_eq!(page.next_after_seq, (after != 10).then_some(after + 1));
+    }
+    let decoded = crate::diagnostics::get().decoded;
+    eprintln!("SQLite rows decoded with the page byte budget: {decoded}");
+    assert_eq!(decoded, 3);
+}

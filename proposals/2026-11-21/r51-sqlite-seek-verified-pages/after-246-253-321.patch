+#[test]
+fn sqlite_interrupted_seek_does_not_reuse_cursor_or_change_strict_digest() {
+    use crate::{
+        backend::{JournalBackend, RecordSnapshot, Sqlite},
+        snapshot::{Fold, SnapshotState},
+    };
+    use proteus_contracts::domain::SessionId;
+
+    // Inject one ordinary I/O interruption, after the page-only backend cursor
+    // advanced. Do not alter any SQLite rows or filesystem state.
+    struct InterruptPage {
+        inner: Box<dyn RecordSnapshot>,
+        next_error: bool,
+    }
+    impl RecordSnapshot for InterruptPage {
+        fn reset(&mut self) -> anyhow::Result<()> {
+            self.inner.reset()
+        }
+        fn reset_for_page(&mut self, sequence: u64) -> anyhow::Result<()> {
+            self.inner.reset_for_page(sequence)
+        }
+        fn next(&mut self) -> anyhow::Result<Option<JournalRecord>> {
+            self.inner.next()
+        }
+        fn next_page(&mut self) -> anyhow::Result<Option<JournalRecord>> {
+            let record = self.inner.next_page()?;
+            if self.next_error {
+                self.next_error = false;
+                return Err(std::io::Error::from(std::io::ErrorKind::Interrupted).into());
+            }
+            Ok(record)
+        }
+        fn fingerprint(&self) -> &str {
+            self.inner.fingerprint()
+        }
+        fn read_hash(&self) -> ring::digest::Context {
+            self.inner.read_hash()
+        }
+        fn extent(&self) -> u64 {
+            self.inner.extent()
+        }
+        fn prefix_fingerprint(&mut self, sequence: u64) -> anyhow::Result<Option<String>> {
+            self.inner.prefix_fingerprint(sequence)
+        }
+    }
+
+    let mut f = Fixture::new(BackendKind::Sqlite);
+    for index in 1..=20 {
+        f.append(vec![text(&format!("safe record {index}"))]);
+    }
+    let session = f.descriptor.session.clone();
+    let id: SessionId = session.session_id;
+    let mut inner = Sqlite::default()
+        .snapshot(f.descriptor.local_path.as_ref().unwrap(), id)
+        .unwrap();
+    let mut fold = Fold::default();
+    while let Some(record) = inner.next().unwrap() {
+        fold.apply(id, &record).unwrap();
+    }
+    let fingerprint = inner.fingerprint().to_owned();
+    assert_eq!(inner.consumed_fingerprint(), fingerprint);
+    let mut state = SnapshotState::new(
+        StorageSnapshot {
+            session,
+            snapshot_id: uuid::Uuid::new_v4().to_string(),
+            content_sha256: fingerprint.clone(),
+            revision: fold.revision(),
+        },
+        Box::new(InterruptPage {
+            inner,
+            next_error: true,
+        }),
+        true,
+        None,
+    )
+    .unwrap();
+    let error = state.page(17, 2).unwrap_err();
+    assert_eq!(
+        error.downcast_ref::<std::io::Error>().unwrap().kind(),
+        std::io::ErrorKind::Interrupted
+    );
+    let sequences = |page: StorageRecordPage| {
+        page.records
+            .into_iter()
+            .map(|record| record.session_seq)
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(sequences(state.page(17, 2).unwrap()), [18, 19]);
+    assert_eq!(state.source.consumed_fingerprint(), fingerprint);
+    assert_eq!(
+        state.source.prefix_fingerprint(20).unwrap().as_deref(),
+        Some(fingerprint.as_str())
+    );
+    assert_eq!(sequences(state.page(0, 2).unwrap()), [1, 2]);
+    assert_ne!(state.source.consumed_fingerprint(), fingerprint);
+    assert_eq!(sequences(state.page(19, 2).unwrap()), [20]);
+    assert_eq!(state.fold().unwrap().revision(), fold.revision());
+    assert_eq!(state.source.consumed_fingerprint(), fingerprint);
+}

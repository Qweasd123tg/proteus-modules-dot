+#[test]
+fn sqlite_verified_seek_preserves_pinned_records_across_nonmonotonic_pages() {
+    let mut f = Fixture::new(BackendKind::Sqlite);
+    for seq in 1..=32 {
+        f.append(vec![text(&format!("строка {seq}"))]);
+    }
+    let session = f.descriptor.session.clone();
+    let resident = f.snapshot();
+    // The writer supplied a verified catalog head, but this SQL connection
+    // has not yet checked its own EOF digest. Keep the original scan.
+    crate::diagnostics::reset();
+    let resident_page = page_for(&f.service, &resident, 26, 2);
+    assert_eq!(crate::diagnostics::get().decoded, 28);
+
+    // This is a provisional disk-hint snapshot. The first page must still
+    // decode and validate all 32 rows before the direct page can run.
+    let reader = StorageService::new(BackendKind::Sqlite);
+    let SessionStorageResponse::Snapshot { snapshot } = reader
+        .execute(SessionStorageRequest::OpenSnapshot { session })
+        .unwrap()
+    else {
+        panic!();
+    };
+    crate::diagnostics::reset();
+    let first = page_for(&reader, &snapshot, 26, 2);
+    let first_decoded = crate::diagnostics::get().decoded;
+    assert_eq!(resident_page.records, first.records);
+    assert_eq!(first.next_after_seq, Some(28));
+
+    // Ordinary append on an independent writable connection changes the
+    // journal head while this reader's pinned transaction is still open.
+    f.append(vec![text("committed after SQLite snapshot")]);
+    crate::diagnostics::reset();
+    let end = page_for(&reader, &snapshot, 30, 8);
+    assert_eq!(
+        end.records
+            .iter()
+            .map(|r| r.session_seq)
+            .collect::<Vec<_>>(),
+        [31, 32]
+    );
+    assert_eq!(end.next_after_seq, None);
+
+    let retry = page_for(&reader, &snapshot, 26, 2);
+    assert_eq!(retry, first);
+    assert_eq!(page_for(&reader, &snapshot, 28, 3).next_after_seq, Some(31));
+    assert!(page_for(&reader, &snapshot, 32, 1).records.is_empty());
+    let later_decoded = crate::diagnostics::get().decoded;
+
+    let SessionStorageResponse::Conversation { conversation } = reader
+        .execute(SessionStorageRequest::ReadConversation {
+            snapshot: snapshot.clone(),
+            point: StorageHistoryPoint::Current,
+        })
+        .unwrap()
+    else {
+        panic!();
+    };
+    assert_eq!(conversation.revision.session_seq, 32);
+    assert_eq!(conversation.messages.len(), 32);
+    assert_eq!(page_for(&reader, &snapshot, 26, 2), first);
+
+    eprintln!(
+        "SQLite rows decoded: unproven=28; warm first={first_decoded}; four later pages={later_decoded}"
+    );
+    assert_eq!(first_decoded, 34);
+    assert_eq!(later_decoded, 7);
+}

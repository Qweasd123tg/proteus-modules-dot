+def _archive_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    buffer = memoryview(bytearray(256 * 1024))
+    with path.open("rb") as stream:
+        while True:
+            count = stream.readinto(buffer)
+            if not count:
+                break
+            digest.update(buffer[:count])
+    return digest.hexdigest()
+

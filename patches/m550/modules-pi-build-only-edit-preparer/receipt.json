  "alternate_scoped_patch": "diff --git a/workflow/pi-runtime/loop.mjs b/workflow/pi-runtime/loop.mjs\nindex c37e44c301521a59418fc3a2a1028f4184fea557..97c8f9dfefbf77985ecf645b248d68960ac429ca 100644\n--- a/workflow/pi-runtime/loop.mjs\n+++ b/workflow/pi-runtime/loop.mjs\n@@ -1,5 +1,5 @@\n import { randomUUID } from \"node:crypto\";\n-import { runAgentLoop, convertToLlm, buildSystemPrompt, estimateContextTokens, resolveModel, createCodingToolDefinitions, SETTINGS_DEFAULTS, retryDelayMs } from \"./upstream.mjs\";\n+import { runAgentLoop, convertToLlm, buildSystemPrompt, estimateContextTokens, resolveModel, createToolDefinition, SETTINGS_DEFAULTS, retryDelayMs } from \"./upstream.mjs\";\n import { executionCall } from \"./tool-arguments.mjs\";\n import { canonical } from \"../../components/module-runtime-js/canonical.mjs\";\n import { assistant, finishedStream, piContent, piMessage, piMessages } from \"../../components/pi-runtime-js/messages.mjs\";\n@@ -116,15 +116,19 @@\n             contextFiles,\n             skills: [],\n         });\n-        const definitions = new Map(createCodingToolDefinitions(task.cwd).map(t => [t.name, t]));\n+        const definitionCwd = task.cwd;\n+        // Of Pi 1.5.2's four coding tools, only edit has an argument preparer.\n+        let prepareEdit;\n         const tools = specs.map((spec) => ({\n             name: spec.name,\n             label: spec.name,\n             description: spec.description,\n             parameters: spec.input_schema,\n             executionMode: spec.metadata?.[\"pi/execution_mode\"] ?? undefined,\n-            prepareArguments: spec.metadata?.[\"pi/package\"] === \"@earendil-works/pi-coding-agent@1.5.2\"\n-                ? definitions.get(spec.name)?.prepareArguments : undefined,\n+            prepareArguments:\n+                spec.metadata?.[\"pi/package\"] === \"@earendil-works/pi-coding-agent@1.5.2\" && spec.name === \"edit\"\n+                    ? (prepareEdit ??= createToolDefinition(\"edit\", definitionCwd).prepareArguments)\n+                    : undefined,\n             execute: async (id, args) => {\n                 const binding = pending.get(id);\n                 if (!binding) throw new Error(\"Unbound Pi invocation \" + id);\ndiff --git a/workflow/pi-runtime/upstream.mjs b/workflow/pi-runtime/upstream.mjs\nindex 55f1b556eaf7b8353d7c9abddaa46dd32e2f389c..07bbd62fd28633f997b7431edf15f2dc6356e4b4 100644\n--- a/workflow/pi-runtime/upstream.mjs\n+++ b/workflow/pi-runtime/upstream.mjs\n@@ -28,7 +28,7 @@\n }\n \n export { validateToolArguments } from \"../../tool/pi-tools/node_modules/@earendil-works/pi-ai/dist/index.js\";\n-export { createCodingToolDefinitions } from \"../../tool/pi-tools/node_modules/@earendil-works/pi-coding-agent/dist/core/tools/index.js\";\n+export { createCodingToolDefinitions, createToolDefinition } from \"../../tool/pi-tools/node_modules/@earendil-works/pi-coding-agent/dist/core/tools/index.js\";\n \n export { SETTINGS_DEFAULTS } from \"../../tool/pi-tools/node_modules/@earendil-works/pi-coding-agent/dist/core/settings-defaults.js\";\n export { retryDelayMs } from \"../../tool/pi-tools/node_modules/@earendil-works/pi-ai/dist/utils/retry.js\";\n",

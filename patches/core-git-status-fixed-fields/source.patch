+fn status_fields<const N: usize>(record: &str) -> Result<[&str; N]> {
+    let mut parts = record.splitn(N, ' ');
+    let mut fields = [""; N];
+    for field in &mut fields {
+        let Some(part) = parts.next() else {
+            anyhow::bail!("invalid Git status record");
+        };
+        *field = part;
+    }
+    Ok(fields)
+}

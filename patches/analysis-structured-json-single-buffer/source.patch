-        other => other.to_string(),
-    }
+            out.push(b'{');
+            for (i, (key, value)) in map.iter().enumerate() {
+                if i != 0 {
+                    out.extend_from_slice(b", ");
+                }
+                serde_json::to_writer(&mut *out, key).expect("serializing a string to Vec");
+                out.extend_from_slice(b": ");
+                dump_into(out, value);

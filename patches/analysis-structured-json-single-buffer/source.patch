+        Value::Array(items) => {
+            out.push(b'[');
+            for (i, item) in items.iter().enumerate() {
+                if i != 0 {
+                    out.extend_from_slice(b", ");
+                }
+                dump_into(out, item);
+            }
+            out.push(b']');
+        }
         Value::Object(map) => {
-            let fields: Vec<String> = map
-                .iter()
-                .map(|(key, value)| format!("{}: {}", Value::from(key.as_str()), dumps(value)))
-                .collect();
-            format!("{{{}}}", fields.join(", "))

+
+fn log_records(text: &str) -> impl Iterator<Item = [&str; FIELDS]> {
+    // Keep split's final field, including an empty one. Ignore only short groups.
+    let mut fields = text.split('\0');
+    std::iter::from_fn(move || {
+        Some([
+            fields.next()?,
+            fields.next()?,
+            fields.next()?,
+            fields.next()?,
+            fields.next()?,
+            fields.next()?,
+            fields.next()?,
+            fields.next()?,
+        ])
+    })
 }
 

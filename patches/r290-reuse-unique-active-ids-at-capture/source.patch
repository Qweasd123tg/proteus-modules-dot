+            && !ids.messages.contains(&message.id)
+            && !ids.parts.contains(&part.part_id)
+        {
+            ids.messages.insert(message.id);
+            ids.parts.insert(part.part_id);
+            return Ok(());
+        }
+        self.check_active_ids(None)
+    }

 pub(crate) const MAX_PAYLOAD_BYTES: usize = 64 * 1024 * 1024;
 
+pub(crate) fn compact_json_len(value: &impl serde::Serialize) -> Result<usize> {
+    struct Counter(usize);
+    impl std::io::Write for Counter {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0 = self
+                .0
+                .checked_add(bytes.len())
+                .ok_or_else(|| std::io::Error::other("encoded record size overflow"))?;
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut count = Counter(0);
+    serde_json::to_writer(&mut count, value)?;
+    Ok(count.0)
+}
+
 pub(crate) fn sha256_hex(bytes: &[u8]) -> String {
     digest_hex(digest(&SHA256, bytes))
 }

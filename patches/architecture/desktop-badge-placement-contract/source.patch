new file mode 100644
index 0000000000000000000000000000000000000000..62dab854b6b2b68c8c91b96f58029419ba29f0ab
--- /dev/null
+++ b/src/declarative/badge_place.rs
@@ -0,0 +1,59 @@
+//! Placement shared by package declarations and saved user overrides.
+
+use serde::{Deserialize, Serialize};
+
+/// Where the compact icon of an extension is shown: the left or the right
+/// end of the composer row and the top bar, or the top or the bottom of the
+/// rail along the left edge.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum BadgePlace {
+    ComposerStart,
+    ComposerEnd,
+    HeaderStart,
+    HeaderEnd,
+    RailStart,
+    RailEnd,
+    Hidden,
+}
+
+impl BadgePlace {
+    /// Every place where icons are drawn.
+    pub const SHOWN: [BadgePlace; 6] = [
+        BadgePlace::ComposerStart,
+        BadgePlace::ComposerEnd,
+        BadgePlace::HeaderStart,
+        BadgePlace::HeaderEnd,
+        BadgePlace::RailStart,
+        BadgePlace::RailEnd,
+    ];
+
+    /// Icons here stand in a column, so only narrow ones fit.
+    pub fn is_rail(self) -> bool {
+        matches!(self, BadgePlace::RailStart | BadgePlace::RailEnd)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::BadgePlace;
+
+    #[test]
+    fn badge_place_keeps_public_names_visible_order_and_rails() {
+        let places = BadgePlace::SHOWN.into_iter().chain([BadgePlace::Hidden]);
+        for (place, (name, is_rail)) in places.zip([
+            ("composer_start", false),
+            ("composer_end", false),
+            ("header_start", false),
+            ("header_end", false),
+            ("rail_start", true),
+            ("rail_end", true),
+            ("hidden", false),
+        ]) {
+            let serialized = serde_json::to_value(place).unwrap();
+            assert_eq!(serialized.as_str(), Some(name));
+            assert_eq!(serde_json::from_value::<BadgePlace>(serialized).unwrap(), place);
+            assert_eq!(place.is_rail(), is_rail);
+        }
+    }
+}

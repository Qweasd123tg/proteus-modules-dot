+
+    pub(crate) fn replay_catalog<T: Default>(
+        self,
+        dir: &Path,
+        id: SessionId,
+        apply: impl Fn(&mut T, &JournalRecord) -> Result<()>,
+    ) -> Result<(T, PrefixHint)> {
+        match self {
+            Self::Sqlite => Sqlite::replay_catalog(dir, id, apply),
+            Self::Jsonl => {
+                let (source, fold) =
+                    Jsonl::replay_snapshot(dir, id, None, |fold, record, _| apply(fold, record))?;
+                let hint = PrefixHint {
+                    extent: source.extent(),
+                    fingerprint: source.fingerprint().to_owned(),
+                };
+                Ok((fold, hint))
+            }
+        }
+    }
 }

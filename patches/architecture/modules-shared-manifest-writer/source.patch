+spec.loader.exec_module(module)
+"""
+
 
 class OpenCodeCreationMetadata(unittest.TestCase):
     def test_manifest_describes_concrete_creation_defaults_and_wildcard_capacity(self):
@@ -31,3 +44,55 @@ class OpenCodeCreationMetadata(unittest.TestCase):
             self.assertTrue({"opencode-go", "opencode-zen"} <= {entry["id"] for entry in presets})
             self.assertTrue(all(entry["module_id"] != "*" and "HOME" in entry["env_allowlist"] for entry in presets))
             self.assertFalse(any("api_key" in entry["module_config"] for entry in presets))
+
+    def test_standalone_writer_uses_its_code_with_detached_json_only_metadata(self):
+        with tempfile.TemporaryDirectory(prefix="isolated opencode manifest ") as temporary:
+            root = Path(temporary)
+            code = root / "code"
+            relative = Path("workflow/opencode-runtime/install.py")
+            script = code / relative
+            script.parent.mkdir(parents=True)
+            shutil.copy2(ROOT / relative, script)
+            shutil.copy2(ROOT / "package_manifest.py", code / "package_manifest.py")
+            self.assertFalse((code / "package.py").exists())
+
+            source = root / "data" / "metadata"
+            source.mkdir(parents=True)
+            exports = {"model": ["fixture"]}
+            version = "0.1.0-alpha.4"
+            preset = {"id": "creation", "title": "Настройка", "description": "Синтетический пресет",
+                      "module_id": "fixture", "module_config": {"provider": "fixture"},
+                      "env_allowlist": ["HOME"]}
+            (source / "module-exports.json").write_text(json.dumps(exports))
+            (source / "package.json").write_text(json.dumps({"version": version}))
+            presets = source / "model-connections.json"
+            presets.write_text(json.dumps([preset]))
+            prefix = root / "installed"
+            binary = prefix / "bin/proteus-opencode-module"
+            binary.parent.mkdir(parents=True)
+            binary.write_bytes(b"synthetic standalone launcher\n")
+
+            command = [sys.executable, "-I", "-B", "-c",
+                       LOAD_BY_PATH + "module.write_module_manifest(Path(sys.argv[2]), Path(sys.argv[3]))",
+                       str(script), str(prefix), str(source)]
+            subprocess.run(command, cwd=root, check=True, capture_output=True, text=True)
+            manifest = prefix / "share/modules/opencode-runtime/module.json"
+            expected = {"id": "opencode-runtime", "version": version,
+                        "command": ["bin/proteus-opencode-module"], "exports": exports,
+                        "sha256": hashlib.sha256(binary.read_bytes()).hexdigest(),
+                        "model_connections": [preset]}
+            original = (json.dumps(expected, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
+            self.assertEqual(manifest.read_bytes(), original)
+
+            presets.write_text(json.dumps([dict(preset, module_id="not-exported")]))
+            failed = subprocess.run(command, cwd=root, capture_output=True, text=True)
+            self.assertNotEqual(failed.returncode, 0)
+            self.assertIn("Model connection preset is not exported", failed.stderr)
+            self.assertEqual(manifest.read_bytes(), original)
+
+    def test_packager_can_still_load_by_absolute_path_in_isolated_python(self):
+        with tempfile.TemporaryDirectory(prefix="outside packager checkout ") as temporary:
+            command = [sys.executable, "-I", "-B", "-c",
+                       LOAD_BY_PATH + "assert 'model-pack' in module.packages()",
+                       str(ROOT / "package.py")]
+            subprocess.run(command, cwd=temporary, check=True, capture_output=True, text=True)

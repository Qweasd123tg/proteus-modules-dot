 ROOT = Path(__file__).resolve().parent.parent
 
 
+def package_scope(args):
+    """Read explicit Cargo package options, never test filters or libtest args."""
+    flags = {"--lib", "--tests", "--no-run", "--no-fail-fast", "--release", "--locked",
+             "--frozen", "--offline", "-q", "--quiet", "-v", "-vv", "--verbose"}
+    package_options = {"-p", "--package"}
+    valued = package_options | {"-j", "--jobs", "--profile", "--test", "--color",
+                                "--message-format"}
+    # Consume these values without treating a different workspace or a wider
+    # Cargo selection as the narrowly verified standalone storage scope.
+    other_valued = {"--manifest-path", "--exclude", "--config", "--target-dir",
+                    "--target", "--features", "-F", "--bin", "--example", "--bench"}
+    packages = set()
+    narrow = True
+    filter_seen = False
+    cargo = iter(args)
+    for arg in cargo:
+        if arg == "--":
+            break
+        if arg.startswith(("-q", "-v", "-r")):
+            short = arg[1:].lstrip("qvr")
+            if short.startswith("p"):
+                # Cargo can combine quiet/verbose/release flags with a short selector.
+                arg = "-" + short
+                narrow = False
+        option, equals, value = arg.partition("=")
+        if option in valued or option in other_valued:
+            value = value if equals else next(cargo, "")
+            if option in ("-j", "--jobs") and value.startswith("-") and value[1:].isdigit():
+                narrow = False
+                continue
+            if equals and option not in package_options and (not value or value.startswith("-")):
+                narrow = False
+                continue
+            if not value or value.startswith("-"):
+                return packages, False
+            if option in package_options:
+                packages.add(value)
+            if option in other_valued:
+                narrow = False
+        elif arg.startswith("-p"):
+            packages.add(arg[2:])
+        elif arg in flags or (arg.startswith("-j") and arg[2:].isdigit()):
+            continue
+        elif not arg.startswith("-") and arg and not filter_seen:
+            filter_seen = True
+        else:
+            narrow = False
+    return packages, narrow
+
+

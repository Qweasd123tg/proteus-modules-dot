@@ -280,2 +280,41 @@ fn telemetry_cache_detects_same_size_rewrite_even_with_restored_mtime() {
 
+#[test]
+fn telemetry_invalid_utf8_aborts_the_read_without_caching_a_partial_projection() {
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("events.jsonl");
+    let session = new_session_id();
+    let valid = [event(
+        session,
+        1,
+        Event::ContextBuilt {
+            chunks: 7,
+            token_estimate: None,
+        },
+    )];
+    write_events(&path, &valid, false);
+    OpenOptions::new()
+        .append(true)
+        .open(&path)
+        .unwrap()
+        .write_all(b"\xff\n")
+        .unwrap();
+
+    // A cache hit on the unchanged input would hide the second read error.
+    for _ in 0..2 {
+        let Err(error) = telemetry::read(&path, Some(session), None) else {
+            panic!("invalid UTF-8 must not return even a partial projection");
+        };
+        assert_eq!(error.to_string(), format!("failed to read {}", path.display()));
+        assert_eq!(
+            error.downcast_ref::<std::io::Error>().unwrap().kind(),
+            std::io::ErrorKind::InvalidData
+        );
+    }
+
+    write_events(&path, &valid, false);
+    let clean = telemetry::read(&path, Some(session), None).unwrap();
+    assert_eq!(clean.latest_context.as_ref().unwrap().chunks, 7);
+    assert!(clean.diagnostics.is_empty());
+}
+
 #[test]

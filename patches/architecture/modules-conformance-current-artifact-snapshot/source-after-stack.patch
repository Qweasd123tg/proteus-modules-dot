new file mode 100644
index 0000000000000000000000000000000000000000..929b35919d9642a5696a83191563ee03ff750295
--- /dev/null
+++ b/tests/test_reference_artifacts.py
@@ -0,0 +1,41 @@
+"""Conformance tests consume a private receipt from their own package build."""
+import importlib.util
+import json
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+SCRIPTS = Path(__file__).resolve().parents[1] / "scripts"
+spec = importlib.util.spec_from_file_location("reference_test_runner", SCRIPTS / "test.py")
+runner = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(runner)
+
+
+class ReferenceArtifactsTest(unittest.TestCase):
+    def test_fresh_receipt_lives_until_the_test_process_returns(self):
+        receipt = {"packages": {"session-storage": {"executable": "/fresh/storage"}}}
+        report = None
+
+        def check_output(command, **_):
+            if command[:2] == ["cargo", "metadata"]:
+                return json.dumps({"packages": [{"name": "proteus-core",
+                    "manifest_path": "/fixture/core/crates/proteus-core/Cargo.toml"}]})
+            self.assertEqual(command[1:],
+                             [str(runner.ROOT / "package.py"), "--profile", "dev", "--print-artifact-report"])
+            return json.dumps(receipt)
+
+        def cargo_test(command, *, cwd, env):
+            nonlocal report
+            self.assertEqual(command[:3], ["cargo", "test", "--locked"])
+            self.assertEqual(cwd, runner.ROOT)
+            report = Path(env["PROTEUS_TEST_MODULE_ARTIFACTS"])
+            self.assertEqual(json.loads(report.read_text()), receipt)
+            self.assertEqual(env["PROTEUS_TEST_SESSION_STORAGE_MODULE"], "/fresh/storage")
+            return 17
+
+        with patch.object(runner.subprocess, "check_output", side_effect=check_output), \
+             patch.object(runner.subprocess, "run"), \
+             patch.object(runner.subprocess, "call", side_effect=cargo_test):
+            self.assertEqual(runner.main(["-p", "proteus-reference-module"]), 17)
+        self.assertIsNotNone(report)
+        self.assertFalse(report.parent.exists())

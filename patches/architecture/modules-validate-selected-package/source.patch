+    def test_selected_install_does_not_read_unrelated_package_payloads(self):
+        self.build(["one"])
+        unrelated = self.root / "components/two"
+        for filename, invalid in (
+            ("exports.json", "{"),
+            ("model-connections.json", "{}"),
+        ):
+            path = unrelated / filename
+            original = path.read_bytes() if path.exists() else None
+            path.write_text(invalid)
+            with self.subTest(filename=filename):
+                destination = self.root / f"runtime-{filename}"
+                package.main(["--package", "one", "--no-build", "--install", str(destination)],
+                             root=self.root)
+                self.assertEqual((destination / "bin/proteus-one-module").read_bytes(), b"new one")
+                self.assertFalse((destination / "share/modules/two").exists())
+                for args in (["--package", "two"], []):
+                    with self.assertRaises(ValueError):
+                        package.main([*args, "--no-build", "--print-artifacts"], root=self.root)
+                with self.assertRaises(ValueError):
+                    package.packages(self.root)
+            if original is None:
+                path.unlink()
+            else:
+                path.write_bytes(original)
+
+    def test_selected_package_still_rejects_duplicate_workspace_ids(self):
+        manifest = self.root / "components/two/Cargo.toml"
+        manifest.write_text(manifest.read_text().replace('id = "two"', 'id = "one"'))
+        with self.assertRaisesRegex(SystemExit, "Duplicate module package: one"):
+            package.main(["--package", "one", "--no-build", "--print-artifacts"], root=self.root)
+

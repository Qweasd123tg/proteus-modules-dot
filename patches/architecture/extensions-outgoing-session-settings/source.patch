diff --git a/sdk/src/host/session_settings.rs b/sdk/src/host/session_settings.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ed253b55ea09da5eea60e39161aab91724af6786
--- /dev/null
+++ b/sdk/src/host/session_settings.rs
@@ -0,0 +1,72 @@
+//! Admission for outgoing session-setting requests.
+
+use std::io;
+
+use anyhow::bail;
+use serde_json::{Value, json};
+
+use super::{Host, scopes::SessionContext};
+use crate::Result;
+
+impl Host {
+    /// Меняет настройку сессии (`session.settings.v1`); ответ придёт как `command_result`.
+    pub fn set_session(&mut self, kind: &str, value: Value) -> Result {
+        if !self.has_feature("session.settings.v1") {
+            bail!("The client does not support session.settings.v1");
+        }
+        let Some(session) = self.session.clone() else {
+            return Ok(());
+        };
+        settings_budget(
+            std::iter::once(self.pending.as_slice())
+                .chain(self.sessions.values().map(SessionContext::pending)),
+            kind,
+            &value,
+        )?;
+        self.counter += 1;
+        let id = format!("setting-{}", self.counter);
+        self.pending
+            .push((id.clone(), kind.to_owned(), value.clone()));
+        self.command_error = None;
+        self.send(
+            json!({"type": "set_session", "context": self.current_context, "view": self.current_view, "id": id, "session_dir": session,
+                         "setting": {"id": kind, "value": value}}),
+        );
+        Ok(())
+    }
+}
+
+/// Outstanding requests remain ordered until command_result. Reject new work
+/// at admission instead of retaining arbitrary values while the backend stalls.
+fn settings_budget<'a>(
+    pending: impl IntoIterator<Item = &'a [(String, String, Value)]>,
+    kind: &str,
+    value: &Value,
+) -> io::Result<()> {
+    struct Counter(usize);
+    impl io::Write for Counter {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            self.0 = self
+                .0
+                .checked_add(bytes.len())
+                .filter(|size| *size <= 1024 * 1024)
+                .ok_or_else(|| io::Error::other("pending session settings exceed 1 MiB"))?;
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+    // Reserve the next generated id and tuple punctuation as well as values.
+    let mut counter = Counter(64);
+    let mut count = 0usize;
+    for session in pending {
+        count = count.saturating_add(session.len());
+        if count >= 128 {
+            return Err(io::Error::other("too many pending session settings"));
+        }
+        serde_json::to_writer(&mut counter, session)?;
+    }
+    serde_json::to_writer(&mut counter, &(kind, value))?;
+    Ok(())
+}

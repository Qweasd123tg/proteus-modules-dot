+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[::core::prelude::v1::test]
+    fn sidebar_resize_commits_logical_width_only_on_finish() {
+        let mut app = ::gpui::TestAppContext::single();
+        app.update(|cx| {
+            gpui_kit::init(cx);
+            crate::ui::theme::init(cx);
+            prefs::init_in_memory(cx);
+        });
+        let other_handle = app.add_empty_window().window_handle();
+        let mut other = ::gpui::VisualTestContext::from_window(other_handle, &app);
+        let initial = other.update(|_, cx| prefs::visual(cx).sidebar.width);
+        app.add_empty_window().update(|window, cx| {
+            let workspace = cx.new(|cx| Workspace::test_empty(window, cx));
+            workspace.update(cx, |workspace, cx| {
+                prefs::update_visual(cx, |prefs| prefs.view.scale = 200);
+                let scale = prefs::scale(cx);
+                assert_ne!(scale, 1.);
+
+                workspace.move_sidebar_resize(px(350. * scale), cx);
+                assert_eq!(workspace.sidebar_drag, Some(350.));
+                assert_eq!(workspace.sidebar_width(cx), prefs::scaled(initial));
+                assert_eq!(prefs::visual(cx).sidebar.width, initial);
+                workspace.finish_sidebar_resize(cx);
+                assert_eq!(workspace.sidebar_drag, None);
+                assert_eq!(workspace.sidebar_width(cx), prefs::scaled(350.));
+                assert_eq!(prefs::visual(cx).sidebar.width, 350.);
+
+                for (offset, limit) in [(0., *SIDEBAR_WIDTH.start()), (2000., *SIDEBAR_WIDTH.end())] {
+                    workspace.move_sidebar_resize(px(offset * scale), cx);
+                    assert_eq!(workspace.sidebar_drag, Some(limit));
+                    workspace.finish_sidebar_resize(cx);
+                    assert_eq!(prefs::visual(cx).sidebar.width, limit);
+                }
+                workspace.move_sidebar_resize(px(360. * scale), cx);
+                workspace.reset_sidebar_resize(cx);
+                assert_eq!(workspace.sidebar_drag, None);
+                workspace.finish_sidebar_resize(cx);
+                assert_eq!(prefs::visual(cx).sidebar.width, initial);
+            });
+        });
+        other.update(|_, cx| assert_eq!(prefs::visual(cx).sidebar.width, initial));
+    }
+}

diff --git a/sdk/src/widget_primitives.rs b/sdk/src/widget_primitives.rs
new file mode 100644
index 0000000000000000000000000000000000000000..660eadc87e91c1355e000e904fb8162e6f8449da
--- /dev/null
+++ b/sdk/src/widget_primitives.rs
@@ -0,0 +1,60 @@
+//! Widget primitives shared by the host and UI facade.
+
+use serde_json::{Value, json};
+
+/// Adds optional fields to a node.
+pub trait Node {
+    fn with(self, key: &str, value: impl Into<Value>) -> Value;
+    /// Adds the field only when `value` is `Some`.
+    fn maybe(self, key: &str, value: Option<impl Into<Value>>) -> Value;
+}
+
+impl Node for Value {
+    fn with(mut self, key: &str, value: impl Into<Value>) -> Value {
+        if let Value::Object(map) = &mut self {
+            map.insert(key.to_owned(), value.into());
+        }
+        self
+    }
+
+    fn maybe(self, key: &str, value: Option<impl Into<Value>>) -> Value {
+        match value {
+            Some(value) => self.with(key, value),
+            None => self,
+        }
+    }
+}
+
+pub fn text(value: impl ToString) -> Value {
+    json!({"type": "text", "text": value.to_string()})
+}
+
+/// Stack whose immutable widgets are shared with an extension's render cache.
+/// The visible root and error fallback use the same nodes without copying.
+#[derive(serde::Serialize)]
+pub struct SharedColumn {
+    #[serde(rename = "type")]
+    kind: &'static str,
+    direction: &'static str,
+    gap: &'static str,
+    children: Vec<std::sync::Arc<Value>>,
+}
+
+impl SharedColumn {
+    pub fn new(gap: &'static str, children: Vec<std::sync::Arc<Value>>) -> Self {
+        Self {
+            kind: "stack",
+            direction: "column",
+            gap,
+            children,
+        }
+    }
+}
+
+pub fn row(children: Vec<Value>) -> Value {
+    json!({"type": "stack", "direction": "row"}).with("children", Value::Array(children))
+}
+
+pub fn button(label: &str, action: &str) -> Value {
+    json!({"type": "button", "label": label, "action": action, "value": null})
+}

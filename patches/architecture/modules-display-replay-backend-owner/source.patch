+    /// Initialization receives a byte extent for JSONL, never SQLite's row count.
+    pub(crate) fn replay_display<T>(
+        self,
+        dir: &Path,
+        id: SessionId,
+        cut: Option<u64>,
+        initialize: impl Fn(Option<u64>) -> T,
+        apply: impl Fn(&mut T, &JournalRecord, Option<String>, Option<&dyn RecordSnapshot>) -> Result<()>,
+    ) -> Result<(Box<dyn RecordSnapshot>, T)> {
+        match self {
+            Self::Jsonl if cfg!(unix) => Jsonl::replay_snapshot_with(
+                dir,
+                id,
+                cut,
+                |extent| initialize(Some(extent)),
+                |fold, record, hash, source| apply(fold, record, hash, Some(source)),
+            ),
+            Self::Sqlite => Sqlite::replay_display(
+                dir,
+                id,
+                cut,
+                || initialize(None),
+                |fold, record, hash| apply(fold, record, hash, None),
+            ),
+            Self::Jsonl => {
+                let mut source = self.backend().snapshot(dir, id)?;
+                let version = source.source_version()?;
+                let mut staged = initialize(Some(source.extent()));
+                if !source.try_visit_display_rows(cut, &mut |record, hash| {
+                    apply(&mut staged, record, hash, None)
+                })? {
+                    let mut line = Vec::new();
+                    while let Some(record) = source.next_with_scratch(&mut line)? {
+                        let boundary = (cut == Some(record.session_seq)).then(|| {
+                            source.remember_page_boundary(record.session_seq);
+                            source.consumed_fingerprint()
+                        });
+                        apply(&mut staged, &record, boundary, None)?;
+                    }
+                }
+                if source.source_version()? != version {
+                    source.verify_fixed_prefix()?;
+                }
+                Ok((source, staged))
+            }
+        }
+    }
 }

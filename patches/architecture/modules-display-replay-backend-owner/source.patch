+#[test]
+fn display_replay_uses_byte_extent_and_pinned_source_for_the_right_backend() {
+    for kind in backends() {
+        let mut f = Fixture::new(kind);
+        let commit = f.append(vec![text("one display message")]);
+        let is_jsonl = matches!(kind, BackendKind::Jsonl);
+        let expected_extent = is_jsonl.then(|| {
+            let journal = f.descriptor.record_location.as_ref().unwrap();
+            std::fs::metadata(journal).unwrap().len()
+        });
+        let extents = std::cell::RefCell::new(Vec::new());
+        let (_source, seen) = kind
+            .replay_display(
+                f.descriptor.local_path.as_ref().unwrap(),
+                f.descriptor.session.session_id,
+                None,
+                |bytes| {
+                    extents.borrow_mut().push(bytes);
+                    Vec::new()
+                },
+                |seen, record, _, source| {
+                    seen.push((record.record_id, source.is_some()));
+                    Ok(())
+                },
+            )
+            .unwrap();
+        assert_eq!(extents.into_inner(), [expected_extent]);
+        assert_eq!(seen, [(commit.operation_id, is_jsonl && cfg!(unix))]);
+    }
+}

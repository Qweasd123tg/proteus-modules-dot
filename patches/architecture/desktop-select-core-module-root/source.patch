+def check_backend_modules(backend, base, explicit):
+    if not explicit:
+        require_modules(base)
+        return
+    # An explicit alias of the base executable still selects the base runtime.
+    try:
+        base_backend = (base / "bin/proteus").resolve()
+    except (OSError, RuntimeError):
+        base_backend = None
+    if backend == base_backend:
+        require_modules(base)
+        return
+
+    # Match the Native module inventory's layout for an independent backend.
+    # A wrapper without adjacent metadata can select its own installation.
+    parent = backend.parent
+    root = parent.parent if parent.name == "bin" else parent
+    modules = root / "share/modules"
+    try:
+        modules.lstat()
+    except FileNotFoundError:
+        return
+    except OSError as error:
+        raise SystemExit(f"Cannot inspect module metadata in {modules}: {error}") from error
+    require_modules(root)
+
+

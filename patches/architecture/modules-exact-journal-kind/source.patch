+#[test]
+fn journal_backend_classifies_only_exact_os_basenames() {
+    use std::ffi::OsStr;
+
+    assert!(matches!(
+        BackendKind::from_journal_file_name(OsStr::new("journal.jsonl")),
+        Some(BackendKind::Jsonl)
+    ));
+    assert!(matches!(
+        BackendKind::from_journal_file_name(OsStr::new("journal.sqlite")),
+        Some(BackendKind::Sqlite)
+    ));
+    for name in [
+        "",
+        "journal",
+        "Journal.jsonl",
+        "journal.SQLITE",
+        "journal.jsonl.bak",
+        "journal.sqlite.bak",
+        "prefix-journal.jsonl",
+        "nested/journal.sqlite",
+    ] {
+        assert!(BackendKind::from_journal_file_name(OsStr::new(name)).is_none(), "{name:?}");
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStrExt;
+
+        for name in [b"journal.jsonl\xff".as_slice(), b"journal.sqlite\xff".as_slice()] {
+            assert!(BackendKind::from_journal_file_name(OsStr::from_bytes(name)).is_none());
+        }
+    }
+}

+        &mut self,
+        extension: &mut dyn Extension,
+        first: Option<&str>,
+        matches: impl Fn(&Self, &str) -> bool,
+    ) {
+        // Callbacks can change the active scope. Freeze only membership and
+        // order here; render_view still resolves the live view and context.
+        let views = self
+            .views
+            .keys()
+            .filter(|view| matches(self, view.as_str()))
+            .cloned()
+            .collect();
+        self.render_view_ids(extension, views, first);
+    }
+
+    pub(super) fn render_view_ids(
+        &mut self,
+        extension: &mut dyn Extension,
+        mut views: Vec<String>,
+        first: Option<&str>,
+    ) {
+        if let Some(index) = first.and_then(|first| views.iter().position(|view| view == first)) {
+            views[..=index].rotate_right(1);
+        }
+        for view in views {
+            self.render_view(extension, &view);
+        }
+    }

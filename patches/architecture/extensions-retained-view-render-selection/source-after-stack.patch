+#[test]
+fn retained_render_fanout_preserves_scope_and_freezes_membership_before_callbacks() {
+    #[derive(Default)]
+    struct Probe(Vec<(String, Option<String>, Option<String>)>);
+
+    impl Probe {
+        fn rendered(&self) -> Vec<(&str, Option<&str>, Option<&str>)> {
+            self.0
+                .iter()
+                .map(|(view, context, session)| {
+                    (view.as_str(), context.as_deref(), session.as_deref())
+                })
+                .collect()
+        }
+    }
+
+    impl Extension for Probe {
+        fn render(&mut self, host: &mut Host, view: &str, _: Surface, _: Option<&str>) -> Result {
+            self.0.push((
+                view.into(),
+                host.current_context.clone(),
+                host.session.clone(),
+            ));
+            if self.0.len() == 1 {
+                host.activate_context("e");
+            }
+            Ok(())
+        }
+    }
+
+    let mut host = Host::default();
+    let mut probe = Probe::default();
+    for (context, session) in [("a", "/one"), ("b", "/one"), ("e", "/two")] {
+        host.contexts.insert(
+            context.into(),
+            Scope {
+                session: Some(session.into()),
+                ..Scope::default()
+            },
+        );
+    }
+    for (view, context) in [("e", "e"), ("d", "a"), ("c", "b"), ("b", "b"), ("a", "a")] {
+        host.views.insert(view.into(), (Surface::Page, None));
+        host.view_contexts.insert(view.into(), context.into());
+    }
+
+    host.activate_context("a");
+    host.render_all_from(&mut probe, Some("c"));
+    let a = ("a", Some("a"), Some("/one"));
+    let b = ("b", Some("b"), Some("/one"));
+    let c = ("c", Some("b"), Some("/one"));
+    let d = ("d", Some("a"), Some("/one"));
+    assert_eq!(probe.rendered(), [c, a, b, d]);
+
+    probe.0.clear();
+    host.activate_context("a");
+    host.render_visual_context(&mut probe, "a", Some("c"));
+    assert_eq!(probe.rendered(), [a, d]);
+
+    probe.0.clear();
+    host.activate_context("a");
+    host.render_every_context(&mut probe);
+    let e = ("e", Some("e"), Some("/two"));
+    assert_eq!(probe.rendered(), [a, b, c, d, e]);
+}

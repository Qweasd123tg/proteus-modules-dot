-    pub visual_configs: crate::visual_config::Registry,
+    pub visual_configs: VisualConfigRegistry,
+}
+
+/// Stored associations from agent profiles to visual documents.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct VisualConfigRegistry {
+    pub default_config: Option<PathBuf>,
+    pub bindings: BTreeMap<PathBuf, PathBuf>,
+}
+
+impl VisualConfigRegistry {
+    /// Missing files are reported when selected. Persisted metadata is still
+    /// readable while a removable drive or an agent project is unavailable.
+    fn validate(&self) -> Result<()> {
+        for path in self
+            .default_config
+            .iter()
+            .chain(self.bindings.keys())
+            .chain(self.bindings.values())
+        {
+            if !path.is_absolute() {
+                anyhow::bail!(
+                    "visual config registry paths must be absolute: {}",
+                    path.display()
+                );
+            }
+        }
+        Ok(())
+    }
 }
 

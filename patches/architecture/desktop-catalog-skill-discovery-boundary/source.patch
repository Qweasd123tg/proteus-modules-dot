+#[test]
+fn checkout_selects_a_present_index_and_discovers_crlf_skills_when_absent() {
+    let fixture = Fixture::new();
+    fs::write(
+        fixture.0.join("SKILL.md"),
+        "---\r\nname: example\r\ndescription: Fixture\r\n---\r\n# Instructions\r\n",
+    )
+    .unwrap();
+    let trees = BTreeMap::from([(String::new(), "fixture-tree".into())]);
+    let catalog = read_checkout(&fixture.0, "owner/repo", &trees).unwrap();
+    assert_eq!(catalog.title, "owner/repo");
+    assert!(catalog.problems.is_empty());
+    let [entry] = catalog.entries.as_slice() else {
+        panic!("expected one skill");
+    };
+    assert_eq!(entry.kind, Kind::Skill);
+    assert_eq!(entry.id, "example");
+    assert_eq!(entry.version, "fixture-tree");
+    assert_eq!(
+        schema::readme(&catalog, entry).unwrap().as_deref(),
+        Some("# Instructions")
+    );
+
+    let index = fixture.0.join(schema::INDEX);
+    fs::write(
+        &index,
+        r#"{"format":1,"title":"Indexed","categories":[],"entries":[]}"#,
+    )
+    .unwrap();
+    let catalog = read_checkout(&fixture.0, "owner/repo", &trees).unwrap();
+    assert_eq!(catalog.title, "Indexed");
+    assert!(catalog.entries.is_empty());
+
+    fs::write(index, "{bad").unwrap();
+    let Err(error) = read_checkout(&fixture.0, "owner/repo", &trees) else {
+        panic!("a malformed index must not fall back to skill discovery");
+    };
+    assert_eq!(error.to_string(), "Неверный индекс каталога");
+}
+
+#[test]

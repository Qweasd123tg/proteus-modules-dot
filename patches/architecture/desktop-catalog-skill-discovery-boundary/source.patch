+    let fixture = Fixture::new();
+    let raw = "---\nname: example\ndescription: Fixture\n# No closing delimiter\n";
+    fs::write(fixture.0.join("SKILL.md"), raw).unwrap();
+    let trees = BTreeMap::from([(String::new(), "fixture-tree".into())]);
+    let catalog = read_checkout(&fixture.0, "owner/repo", &trees).unwrap();
+    assert!(catalog.entries.is_empty());
+    assert_eq!(catalog.problems, ["SKILL.md: YAML frontmatter не закрыт"]);
+    assert_eq!(
+        schema::read_skill(&fixture.0, Path::new(".")).unwrap(),
+        raw.trim()
+    );
+}
+
+#[test]
+fn checkout_discovery_budget_is_smaller_than_the_preview_budget() {
+    let fixture = Fixture::new();
+    let header = "---\nname: example\ndescription: Fixture\n---\n";
+    let body = "x".repeat(256 * 1024 + 1 - header.len());
+    fs::write(fixture.0.join("SKILL.md"), format!("{header}{body}")).unwrap();
+    let trees = BTreeMap::from([(String::new(), "fixture-tree".into())]);
+    let catalog = read_checkout(&fixture.0, "owner/repo", &trees).unwrap();
+    assert!(catalog.entries.is_empty());
+    assert_eq!(catalog.problems, ["SKILL.md: SKILL.md больше 256 КиБ"]);
+    assert!(schema::read_skill(&fixture.0, Path::new(".")).unwrap() == body);
+}

+    #[::core::prelude::v1::test]
+    fn same_key_role_change_discards_retained_renderer_before_syncing_text() {
+        use crate::agents::codex::{Item, ItemKind};
+        use crate::transcript::Change;
+
+        let item = |kind| Item {
+            id: "one-item".into(),
+            turn_id: "one-turn".into(),
+            kind,
+            status: "completed".into(),
+            timestamp_ms: None,
+        };
+        let mut app = ::gpui::TestAppContext::single();
+        app.update(|cx| {
+            gpui_kit::init(cx);
+            crate::ui::prefs::init_in_memory(cx);
+        });
+        let visual = app.add_empty_window();
+        for reconcile in [false, true] {
+            let (chat, renderer, key) = visual.update(|window, cx| {
+                let chat = cx.new(|cx| {
+                    Chat::base(
+                        None,
+                        WeakEntity::new_invalid(),
+                        super::super::Session::new("/synthetic/role-correction".into()),
+                        std::rc::Rc::new(|_, _, _| None),
+                        window,
+                        cx,
+                    )
+                });
+                let (renderer, key) = chat.update(cx, |chat, cx| {
+                    let transcript = &mut chat.session.transcript;
+                    let change = transcript.external_upsert(item(ItemKind::Assistant {
+                        text: "Draft answer".into(),
+                    }));
+                    assert_eq!(change, Change::Pushed);
+                    let initial = &transcript.entries()[0];
+                    let (key, text) = (initial.key, initial.text.clone());
+                    chat.apply_change(change, cx);
+                    let format = media_type(Role::Assistant).unwrap();
+                    let renderer = content::ContentView::test_unstarted(
+                        Content {
+                            language: format.into(),
+                            source: (&text).into(),
+                            context: serde_json::Value::Null,
+                            source_revision: Some(0),
+                        },
+                        window,
+                        cx,
+                    );
+                    chat.replies.0.insert(
+                        key,
+                        Reply {
+                            text,
+                            languages: Vec::new(),
+                            renderer: "readiness-fixture",
+                            media_type: format,
+                            view: renderer.clone(),
+                            _changes: cx.observe(&renderer, |_, _, _| {}),
+                            _resize: cx.observe(&renderer, |_, _, _| {}),
+                        },
+                    );
+                    (renderer, key)
+                });
+                (chat, renderer, key)
+            });
+            visual.update(|_, cx| {
+                chat.update(cx, |chat, cx| {
+                    let edit = chat.session.transcript.external_upsert(item(ItemKind::Assistant {
+                        text: "Edited answer".into(),
+                    }));
+                    assert_eq!(edit, Change::Updated(0));
+                    chat.apply_change(edit, cx);
+                    assert_eq!(chat.replies.0[&key].view.entity_id(), renderer.entity_id());
+                    assert_eq!(renderer.read(cx).test_payload(), ("Edited answer", Some(1)));
+
+                    let kind = if reconcile {
+                        ItemKind::Reasoning { text: "Notes".into() }
+                    } else {
+                        ItemKind::User { text: "Corrected prompt".into() }
+                    };
+                    let edit = chat.session.transcript.external_upsert(item(kind));
+                    assert_eq!(edit, Change::Updated(0));
+                    assert_eq!(chat.session.transcript.entries()[0].key, key);
+                    chat.apply_change(
+                        if reconcile {
+                            Change::Spliced { start: 0, removed: 1, inserted: 1 }
+                        } else {
+                            edit
+                        },
+                        cx,
+                    );
+                    assert!(chat.replies.is_empty());
+                    assert_eq!(renderer.read(cx).test_payload(), ("Edited answer", Some(1)));
+                });
+            });
+        }
+    }
 }

+fn unstarted_content(
+    content: Content,
+    window: &Window,
+    cx: &mut App,
+) -> (Entity<ContentView>, Entity<super::super::Runtime>) {
+    use super::*;
+    use crate::declarative::manifest::Installed;
+    use crate::ui::extensions::{Host, host::Lifetime};
+
+    let installed = Box::leak(Box::new(Installed {
+        dir: "/synthetic-readiness".into(),
+        revision: 0,
+        manifest: serde_json::from_value(json!({
+            "protocol":4, "id":"readiness-fixture", "title":"Fixture",
+            "command":["never-start"], "surfaces":{"content":{"languages":["fixture"]}}
+        }))
+        .unwrap(),
+    }));
+    let host =
+        Host::new(WeakEntity::new_invalid(), "readiness-fixture").isolated(Lifetime::Preview);
+    let runtime =
+        cx.new(|cx| super::super::runtime::Runtime::new(installed, host.clone(), window, cx));
+    // Attach the native surface without starting a renderer process. The
+    // test supplies accepted protocol trees directly, not a fake parser.
+    runtime.update(cx, |runtime, _| runtime.error = Some("hold startup".into()));
+    let content = cx.new(|cx| {
+        let source = Arc::new(content);
+        let layout_ready = crate::ui::layout_readiness::Token::default();
+        let rendered = cx.new(|cx| {
+            let mut view = DeclarativeView::with_content(
+                runtime.clone(),
+                host,
+                SurfaceKind::Content,
+                Some("fixture".into()),
+                Some(source.clone()),
+                window,
+                cx,
+            );
+            view.layout_owner = Some(layout_ready.clone());
+            view
+        });
+        ContentView {
+            _rendered: cx.observe(&rendered, |_, _, cx| cx.notify()),
+            _resize: cx.subscribe(&rendered, |_, _, _: &super::super::view::WillResize, cx| {
+                cx.emit(WillResize)
+            }),
+            rendered,
+            content: source,
+            extension: "readiness-fixture",
+            lifetime: Lifetime::Preview,
+            show_source: false,
+            body: false,
+            body_layout: None,
+            layout_ready,
+        }
+    });
+    (content, runtime)
+}
+
+impl ContentView {
+    pub(in crate::ui) fn test_unstarted(
+        content: Content,
+        window: &Window,
+        cx: &mut App,
+    ) -> Entity<Self> {
+        unstarted_content(content, window, cx).0
+    }
+
+    pub(in crate::ui) fn test_payload(&self) -> (&str, Option<u64>) {
+        (self.content.source.as_str(), self.content.source_revision)
+    }
+}

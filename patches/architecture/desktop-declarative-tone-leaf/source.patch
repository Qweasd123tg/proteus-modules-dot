diff --git a/src/ui/extensions/declarative/tone.rs b/src/ui/extensions/declarative/tone.rs
new file mode 100644
index 0000000000000000000000000000000000000000..accb80d7ecb321a9ec786322064bc031f7d37e16
--- /dev/null
+++ b/src/ui/extensions/declarative/tone.rs
@@ -0,0 +1,76 @@
+//! Native color projections shared by extension widgets.
+
+use crate::declarative::widget::Tone;
+use gpui_kit::component::{ActiveTheme as _, IconTone};
+use gpui_kit::{App, Hsla, rgb};
+
+pub(super) fn icon_tone(tone: Tone) -> IconTone {
+    match tone {
+        Tone::Default => IconTone::Normal,
+        Tone::Muted => IconTone::Muted,
+        Tone::Accent => IconTone::Accent,
+        Tone::Success => IconTone::Success,
+        Tone::Warning => IconTone::Warning,
+        Tone::Danger => IconTone::Danger,
+        Tone::Color(value) => IconTone::Custom(rgb(value).into()),
+    }
+}
+
+pub(super) fn tone_color(tone: Tone, cx: &App) -> Hsla {
+    let theme = cx.theme();
+    match tone {
+        Tone::Default => theme.foreground,
+        Tone::Muted => theme.muted_foreground,
+        Tone::Accent => theme.primary,
+        Tone::Success => theme.success,
+        Tone::Warning => theme.warning,
+        Tone::Danger => theme.danger,
+        Tone::Color(color) => rgb(color).into(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gpui_kit::component::Theme;
+
+    #[::core::prelude::v1::test]
+    fn semantic_tones_follow_active_theme_and_custom_rgb_stays_literal() {
+        let app = ::gpui::TestAppContext::single();
+        app.update(|cx| {
+            cx.set_global(Theme::default());
+            let cases: [(Tone, IconTone, Hsla); 6] = [
+                (Tone::Default, IconTone::Normal, rgb(0x102030).into()),
+                (Tone::Muted, IconTone::Muted, rgb(0x203040).into()),
+                (Tone::Accent, IconTone::Accent, rgb(0x304050).into()),
+                (Tone::Success, IconTone::Success, rgb(0x405060).into()),
+                (Tone::Warning, IconTone::Warning, rgb(0x506070).into()),
+                (Tone::Danger, IconTone::Danger, rgb(0x607080).into()),
+            ];
+            {
+                let theme = Theme::global_mut(cx);
+                theme.foreground = cases[0].2;
+                theme.muted_foreground = cases[1].2;
+                theme.primary = cases[2].2;
+                theme.success = cases[3].2;
+                theme.warning = cases[4].2;
+                theme.danger = cases[5].2;
+            }
+            for (tone, icon, color) in cases {
+                assert_eq!(icon_tone(tone), icon);
+                assert_eq!(tone_color(tone, cx), color);
+            }
+
+            let custom: Tone = serde_json::from_value(serde_json::json!("#335577")).unwrap();
+            let literal: Hsla = rgb(0x335577).into();
+            assert_eq!(custom, Tone::Color(0x335577));
+            assert_eq!(icon_tone(custom), IconTone::Custom(literal));
+            assert_eq!(tone_color(custom, cx), literal);
+
+            let changed: Hsla = rgb(0x556677).into();
+            Theme::global_mut(cx).primary = changed;
+            assert_eq!(tone_color(Tone::Accent, cx), changed);
+            assert_eq!(tone_color(custom, cx), literal);
+        });
+    }
+}

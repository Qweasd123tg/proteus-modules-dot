diff --git a/src/declarative/tone.rs b/src/declarative/tone.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0b7e2eb5e03ec632cd55bdfaebbed50147d33c46
--- /dev/null
+++ b/src/declarative/tone.rs
@@ -0,0 +1,44 @@
+//! Semantic and literal colors in extension widget declarations.
+
+use anyhow::Result;
+use serde::Deserialize;
+
+/// Parses `#rrggbb` into `0xrrggbb`.
+pub fn hex_color(color: &str) -> Option<u32> {
+    let hex = color.strip_prefix('#')?;
+    (hex.len() == 6 && hex.chars().all(|c| c.is_ascii_hexdigit()))
+        .then(|| u32::from_str_radix(hex, 16).ok())
+        .flatten()
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Tone {
+    #[default]
+    Default,
+    Muted,
+    Accent,
+    Success,
+    Warning,
+    Danger,
+    /// `#rrggbb` from the process.
+    Color(u32),
+}
+
+impl<'de> Deserialize<'de> for Tone {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let name = String::deserialize(deserializer)?;
+        Ok(match name.as_str() {
+            "default" => Tone::Default,
+            "muted" => Tone::Muted,
+            "accent" => Tone::Accent,
+            "success" => Tone::Success,
+            "warning" => Tone::Warning,
+            "danger" => Tone::Danger,
+            color => Tone::Color(hex_color(color).ok_or_else(|| {
+                serde::de::Error::custom(format!(
+                    "tone {color:?} is neither a tone name nor #rrggbb"
+                ))
+            })?),
+        })
+    }
+}

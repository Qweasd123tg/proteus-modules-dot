+def storage_only(args):
+    """Recognize only explicit storage scopes; delegate other cases to the full setup."""
+    flags = {"--lib", "--tests", "--no-run", "--no-fail-fast", "--release", "--locked",
+             "--frozen", "--offline", "-q", "--quiet", "-v", "-vv", "--verbose"}
+    valued = {"-p", "--package", "-j", "--jobs", "--profile", "--test", "--color",
+              "--message-format"}
+    packages = []
+    filter_seen = False
+    cargo = iter(args)
+    for arg in cargo:
+        if arg == "--":
+            break
+        option, equals, value = arg.partition("=")
+        if option in valued:
+            value = value if equals else next(cargo, "")
+            if not value or value.startswith("-"):
+                return False
+            if option in ("-p", "--package"):
+                packages.append(value)
+        elif arg.startswith("-p"):
+            packages.append(arg[2:])
+        elif arg in flags or (arg.startswith("-j") and arg[2:].isdigit()):
+            continue
+        elif not arg.startswith("-") and arg and not filter_seen:
+            filter_seen = True
+        else:
+            return False
+    return bool(packages) and all(package in STORAGE_TARGETS for package in packages)
+
+

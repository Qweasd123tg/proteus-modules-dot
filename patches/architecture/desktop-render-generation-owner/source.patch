diff --git a/src/ui/render_generation.rs b/src/ui/render_generation.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d5fbca873c274a54a876a9d6d76a1a7c52e59f5d
--- /dev/null
+++ b/src/ui/render_generation.rs
@@ -0,0 +1,42 @@
+//! Layout-cache invalidation epochs shared by preferences and renderers.
+use gpui_kit::{App, Global};
+
+/// Content-size estimates can outlive their native renderer views. Keep their
+/// generation separate from process/view lifetime so hidden chats invalidate
+/// old measurements when a renderer's behavior changes.
+#[derive(Default)]
+struct RenderGeneration(u64);
+impl Global for RenderGeneration {}
+
+#[derive(Default, Clone)]
+struct VisualRenderGeneration(u64);
+impl Global for VisualRenderGeneration {}
+
+pub(in crate::ui) fn register_visual(cx: &mut App) {
+    cx.set_global(VisualRenderGeneration::default());
+    cx.register_window_global::<VisualRenderGeneration>();
+}
+
+pub(in crate::ui) fn bump_visual(cx: &mut App) {
+    // A transferred chat must invalidate measurements even if both owners
+    // performed the same number of edits. Only identity allocation is shared.
+    static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+    let next = NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    cx.set_global(VisualRenderGeneration(next));
+}
+
+pub(in crate::ui) fn current(cx: &App) -> u64 {
+    cx.try_global::<RenderGeneration>()
+        .map_or(0, |epoch| epoch.0)
+        .wrapping_add(
+            cx.try_global::<VisualRenderGeneration>()
+                .map_or(0, |epoch| epoch.0.rotate_left(32)),
+        )
+}
+
+pub(in crate::ui) fn bump(cx: &mut App) {
+    let next = cx
+        .try_global::<RenderGeneration>()
+        .map_or(1, |generation| generation.0.wrapping_add(1));
+    cx.set_global(RenderGeneration(next));
+}

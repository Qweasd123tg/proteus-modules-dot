@@ -0,0 +1,261 @@
+//! Physical journal and blob stamps shared by the writer, snapshots and catalog.
+use super::BackendKind;
+use anyhow::Result;
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs::Metadata,
+    path::{Path, PathBuf},
+    time::UNIX_EPOCH,
+};
+
+#[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub(super) struct FileStamp {
+    len: u64,
+    modified: u128,
+    device: u64,
+    inode: u64,
+    changed: (i64, i64),
+}
+
+impl FileStamp {
+    pub(super) fn same_file(&self, other: &Self) -> bool {
+        self.device == other.device && self.inode == other.inode
+    }
+}
+
+fn stamp(path: &Path) -> Result<Option<FileStamp>> {
+    match std::fs::metadata(path) {
+        Ok(meta) => Ok(Some(file_stamp(&meta)?)),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(error.into()),
+    }
+}
+
+pub(super) fn file_stamp(meta: &Metadata) -> Result<FileStamp> {
+    #[cfg(unix)]
+    let (device, inode, changed) = {
+        use std::os::unix::fs::MetadataExt;
+        (meta.dev(), meta.ino(), (meta.ctime(), meta.ctime_nsec()))
+    };
+    #[cfg(not(unix))]
+    let (device, inode, changed) = (0, 0, (0, 0));
+    Ok(FileStamp {
+        len: meta.len(),
+        modified: meta
+            .modified()?
+            .duration_since(UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_nanos(),
+        device,
+        inode,
+        changed,
+    })
+}
+
+pub(super) type SourceStamp = Vec<Option<FileStamp>>;
+
+pub(super) fn source_stamp(dir: &Path, kind: BackendKind) -> Result<SourceStamp> {
+    Ok(source_stamp_items(dir, kind)?.into())
+}
+
+pub(super) fn source_matches(dir: &Path, kind: BackendKind, stamps: &SourceStamp) -> Result<bool> {
+    Ok(source_stamp_items(dir, kind)?.as_slice() == stamps.as_slice())
+}
+
+fn source_stamp_items(dir: &Path, kind: BackendKind) -> Result<[Option<FileStamp>; 3]> {
+    let journal = kind.description_path(dir);
+    let wal = PathBuf::from(format!("{}-wal", journal.to_string_lossy()));
+    Ok([
+        stamp(&journal)?,
+        // Opening a read-only SQLite snapshot may create an empty WAL. It
+        // carries no committed data and is equivalent to a missing WAL.
+        stamp(&wal)?.filter(|stamp| stamp.len != 0),
+        stamp(&dir.join("session.json"))?,
+    ])
+}
+
+const MAX_BLOBS: usize = 16_384;
+pub(super) type BlobStamps = BTreeMap<PathBuf, FileStamp>;
+pub(super) type BlobStampDigest = [u8; 32];
+
+pub(super) fn blob_stamps(dir: &Path) -> Option<BlobStamps> {
+    let mut stamps = BTreeMap::new();
+    walk_blob_stamps(dir, |name, stamp| {
+        stamps.insert(name.to_owned(), stamp);
+        stamps.len()
+    })?;
+    Some(stamps)
+}
+
+// The observer returns the number of distinct paths seen, not the number of
+// directory entries. A changing directory can report a name more than once.
+fn walk_blob_stamps(dir: &Path, mut observe: impl FnMut(&Path, FileStamp) -> usize) -> Option<()> {
+    let root = dir.join("blobs");
+    let mut observed = 0;
+    let mut pending = vec![(PathBuf::new(), 0)];
+    while let Some((mut relative, depth)) = pending.pop() {
+        let mut path = root.join(&relative);
+        let entries = match std::fs::read_dir(&path) {
+            Ok(entries) => entries,
+            Err(error) if depth == 0 && error.kind() == std::io::ErrorKind::NotFound => {
+                return Some(());
+            }
+            Err(_) => return None,
+        };
+        for entry in entries {
+            let entry = entry.ok()?;
+            if observed >= MAX_BLOBS {
+                return None;
+            }
+            let leaf = entry.file_name();
+            // Keep the pathname-based check, but reuse its directory buffer.
+            path.push(&leaf);
+            let meta = std::fs::symlink_metadata(&path).ok()?;
+            path.pop();
+            // The comparator borrows this reusable relative name; only the
+            // collecting observer needs a separate allocation for each path.
+            relative.push(leaf);
+            if meta.is_dir() && depth < 16 {
+                pending.push((relative.clone(), depth + 1));
+            } else if !meta.is_file() {
+                return None;
+            }
+            observed = observe(&relative, file_stamp(&meta).ok()?);
+            relative.pop();
+        }
+    }
+    Some(())
+}
+
+struct BlobStampMatch<'a> {
+    // Index keys are already sorted under the same Path ordering. Borrow
+    // their stamps and keep only the outcome of the last observation.
+    paths: Vec<(&'a PathBuf, &'a FileStamp, Option<bool>)>,
+    seen_expected: usize,
+    saw_mismatch: bool,
+    unexpected: BTreeSet<PathBuf>,
+}
+
+impl<'a> BlobStampMatch<'a> {
+    fn new(expected: &'a BlobStamps) -> Self {
+        Self {
+            paths: expected.iter().map(|(p, s)| (p, s, None)).collect(),
+            seen_expected: 0,
+            saw_mismatch: false,
+            unexpected: BTreeSet::new(),
+        }
+    }
+
+    fn observe(&mut self, name: &Path, stamp: FileStamp) -> usize {
+        match self
+            .paths
+            .binary_search_by(|(p, _, _)| p.as_path().cmp(name))
+        {
+            Ok(index) => {
+                let (_, expected, last) = &mut self.paths[index];
+                self.seen_expected += usize::from(last.is_none());
+                let matches = **expected == stamp;
+                self.saw_mismatch |= !matches;
+                *last = Some(matches);
+            }
+            Err(_) => {
+                // Keep distinct unexpected paths too, so the walk hits the
+                // same cap at the same entry even for an invalid catalog.
+                self.unexpected.insert(name.to_owned());
+            }
+        }
+        self.seen_expected + self.unexpected.len()
+    }
+
+    fn matches(&self) -> bool {
+        // If all paths were observed and none ever differed, the last stamp
+        // matched for every key. A changing directory can repeat a path, so
+        // after any disagreement use the same last-observation rule as before.
+        self.unexpected.is_empty()
+            && self.seen_expected == self.paths.len()
+            && (!self.saw_mismatch || self.paths.iter().all(|(_, _, last)| *last == Some(true)))
+    }
+}
+
+pub(super) fn matches_blob_stamps(dir: &Path, expected: &BlobStamps) -> Option<bool> {
+    let mut seen = BlobStampMatch::new(expected);
+    walk_blob_stamps(dir, |name, stamp| seen.observe(name, stamp))?;
+    Some(seen.matches())
+}
+
+/// Keep only a fixed-size proof in the in-process catalog, including for
+/// archives with thousands of payload files.
+pub(super) fn blob_stamp_digest(stamps: &BlobStamps) -> BlobStampDigest {
+    let mut hash = ring::digest::Context::new(&ring::digest::SHA256);
+    for (path, stamp) in stamps {
+        let path = path.as_os_str().as_encoded_bytes();
+        hash.update(&(path.len() as u64).to_le_bytes());
+        hash.update(path);
+        let mut metadata = [0; 56];
+        metadata[..8].copy_from_slice(&stamp.len.to_le_bytes());
+        metadata[8..24].copy_from_slice(&stamp.modified.to_le_bytes());
+        metadata[24..32].copy_from_slice(&stamp.device.to_le_bytes());
+        metadata[32..40].copy_from_slice(&stamp.inode.to_le_bytes());
+        metadata[40..48].copy_from_slice(&stamp.changed.0.to_le_bytes());
+        metadata[48..].copy_from_slice(&stamp.changed.1.to_le_bytes());
+        hash.update(&metadata);
+    }
+    hash.finish()
+        .as_ref()
+        .try_into()
+        .expect("SHA-256 digest length")
+}
+
+fn update_blobs(dir: &Path, stamps: &mut BlobStamps, touched: Vec<PathBuf>) -> Option<()> {
+    let root = dir.join("blobs");
+    for file in touched {
+        for path in file.ancestors().filter(|p| !p.as_os_str().is_empty()) {
+            let meta = std::fs::symlink_metadata(root.join(path)).ok()?;
+            let expected_type = if path == file {
+                meta.is_file()
+            } else {
+                meta.is_dir()
+            };
+            if !expected_type {
+                return None;
+            }
+            stamps.insert(path.to_owned(), file_stamp(&meta).ok()?);
+        }
+        if stamps.len() > MAX_BLOBS {
+            return None;
+        }
+    }
+    Some(())
+}
+
+/// Authority for a resident fold starts at a verified replay and advances
+/// only across this writer's own successful appends.
+pub(super) struct WriterHead {
+    pub stamps: SourceStamp,
+    pub blobs: BlobStamps,
+    pub extent: u64,
+    pub hash: ring::digest::Context,
+}
+
+impl WriterHead {
+    pub(super) fn matches_source(&self, dir: &Path, kind: BackendKind) -> bool {
+        source_stamp_items(dir, kind).is_ok_and(|items| items.as_slice() == self.stamps.as_slice())
+    }
+
+    pub(super) fn advance(
+        &mut self,
+        dir: &Path,
+        kind: BackendKind,
+        append: crate::backend::Append,
+    ) -> Option<()> {
+        let items = source_stamp_items(dir, kind).ok()?;
+        // Keep the allocation owned by the current verified writer head.
+        self.stamps.clear();
+        self.stamps.extend(items);
+        update_blobs(dir, &mut self.blobs, append.blobs)?;
+        self.extent = append.extent;
+        self.hash.update(&append.bytes);
+        Some(())
+    }
+}

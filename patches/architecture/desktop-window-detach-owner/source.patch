+#[::core::prelude::v1::test]
+fn retained_readonly_detach_is_atomic_when_the_window_opens_or_fails() {
+    use crate::ui::extensions::SurfaceView;
+    use proteus_contracts::app_protocol::AppSubagentSession;
+
+    struct Inert(Option<Entity<Workspace>>);
+    impl Render for Inert {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div()
+        }
+    }
+
+    fn fail(_: DetachedWorkspace, _: &mut App) -> anyhow::Result<(AnyWindowHandle, Entity<Workspace>)> {
+        anyhow::bail!("synthetic window failure");
+    }
+
+    fn open(
+        seed: DetachedWorkspace,
+        cx: &mut App,
+    ) -> anyhow::Result<(AnyWindowHandle, Entity<Workspace>)> {
+        let (handle, root) = gpui_kit::open_window(WindowOptions::default(), cx, |window, cx| {
+            let (workspace, _) = seed.mount(window, cx);
+            // Keep the new workspace alive without rendering a production
+            // chat, probing the extension catalog, or starting a backend.
+            cx.new(|_| Inert(Some(workspace)))
+        })?;
+        Ok((handle, root.read(cx).0.as_ref().unwrap().clone()))
+    }
+
+    let owner = tabs::codex("synthetic-readonly-owner");
+    let document_id = |number: u128| {
+        crate::ui::chat::readonly::Target {
+            owner: owner.clone(),
+            parent: owner.clone(),
+            child_thread_id: None,
+            session: AppSubagentSession {
+                session_id: uuid::Uuid::from_u128(number),
+                session_dir: std::env::temp_dir().join(format!("synthetic-detached-{number}")),
+            },
+        }
+        .id()
+    };
+    let closed = document_id(1);
+    let sibling = document_id(2);
+    let id = document_id(3);
+    let caption = SharedString::from("Saved child caption");
+    let mut original_layout = TabLayout::default();
+    for tab in [&closed, &sibling, &id] {
+        original_layout.open(tab, |_| false);
+    }
+    original_layout.close(&closed);
+    original_layout.set_pinned(&id, true);
+    assert_eq!(original_layout.closed_ids().collect::<Vec<_>>(), [closed.as_str()]);
+
+    let mut app = ::gpui::TestAppContext::single();
+    app.update(|cx| {
+        gpui_kit::init(cx);
+        crate::ui::theme::init(cx);
+        prefs::init_in_memory(cx);
+    });
+    app.add_empty_window().update(|window, cx| {
+        let source_window = window.window_handle().window_id();
+        let windows_before = cx.windows().len();
+        let rehosts = Rc::new(RefCell::new(Vec::new()));
+        let log = rehosts.clone();
+        let source = cx.new(|cx| Workspace::test_empty(window, cx));
+        let subject = cx.new(|_| Inert(None));
+        let sibling_view = cx.new(|_| Inert(None));
+        let identity = subject.entity_id();
+        let sibling_identity = sibling_view.entity_id();
+        let group = source.update(cx, |workspace, cx| {
+            workspace.layout = original_layout.clone();
+            workspace.spaces.set_active(Some(&owner), original_layout.clone());
+            workspace.documents.insert(
+                id.clone(),
+                SurfaceView {
+                    view: subject.into(),
+                    focus: cx.focus_handle(),
+                    rehost: Rc::new(move |workspace, window, cx| {
+                        let window_id = window.window_handle().window_id();
+                        assert_eq!(cx.current_execution_window_id(), Some(window_id));
+                        log.borrow_mut().push((workspace.entity_id(), window_id));
+                    }),
+                },
+            );
+            workspace.documents.insert(
+                sibling.clone(),
+                SurfaceView {
+                    view: sibling_view.into(),
+                    focus: cx.focus_handle(),
+                    rehost: Rc::new(|_, _, _| panic!("the sibling tab must not move")),
+                },
+            );
+            workspace.document_titles.insert(id.clone(), caption.clone());
+            workspace.windows.persist(cx.entity_id(), &workspace.spaces, cx);
+            workspace.windows.clone()
+        });
+        let saved = group.0.borrow().saved_layout();
+        group.0.borrow_mut().open_detached_window = Some(fail);
+        source.update(cx, |workspace, cx| workspace.detach_tab(&id, window, cx));
+        {
+            let source = source.read(cx);
+            assert_eq!(source.layout, original_layout);
+            assert_eq!(source.documents[&id].view.entity_id(), identity);
+            assert_eq!(source.documents[&sibling].view.entity_id(), sibling_identity);
+            assert_eq!(source.document_titles[&id], caption);
+            assert!(Rc::ptr_eq(&source.windows.0, &group.0));
+        }
+        assert_eq!(cx.windows().len(), windows_before);
+        assert_eq!(group.0.borrow().windows.len(), 1);
+        assert_eq!(group.0.borrow().saved_layout(), saved);
+        assert!(rehosts.borrow().is_empty());
+
+        group.0.borrow_mut().open_detached_window = Some(open);
+        source.update(cx, |workspace, cx| workspace.detach_tab(&id, window, cx));
+        assert_eq!(cx.windows().len(), windows_before + 1);
+        let destination = {
+            let group = group.0.borrow();
+            assert_eq!(group.windows.len(), 2);
+            group.windows[1].0.upgrade().unwrap()
+        };
+        let source = source.read(cx);
+        let destination_id = destination.entity_id();
+        let destination = destination.read(cx);
+        assert!(!source.layout.contains(&id));
+        assert!(!source.documents.contains_key(&id));
+        assert!(!source.document_titles.contains_key(&id));
+        assert_eq!(source.documents[&sibling].view.entity_id(), sibling_identity);
+        assert!(source.layout.contains(&sibling));
+        assert_eq!(source.layout.closed_ids().collect::<Vec<_>>(), [closed.as_str()]);
+
+        assert!(Rc::ptr_eq(&destination.windows.0, &group.0));
+        assert_eq!(destination.spaces.active_root(), Some(owner.as_str()));
+        assert_eq!(destination.documents[&id].view.entity_id(), identity);
+        assert_eq!(destination.document_titles[&id], caption);
+        assert_eq!(destination.test_tab_title(&id, cx).as_ref(), "Чат субагента");
+        assert!(destination.layout.is_pinned(&id));
+        assert_eq!(destination.layout.active(destination.layout.focused), Some(id.as_str()));
+        assert!(!destination.layout.contains(&sibling));
+        assert!(destination.layout.closed_ids().next().is_none());
+        assert!(destination.api.is_none());
+        assert!(destination._startup.is_none());
+        let destination_window = destination.window_handle.window_id();
+        assert_ne!(destination_window, source_window);
+        assert_eq!(&*rehosts.borrow(), &[(destination_id, destination_window)]);
+    });
+}

+/// The launcher opens a native shell synchronously; Workspace supplies the
+/// retained state, then transfers the tab only after the open succeeds.
+pub(in crate::ui) type OpenDetachedWindow =
+    fn(DetachedWorkspace, &mut App) -> anyhow::Result<(AnyWindowHandle, Entity<Workspace>)>;
+
+pub(in crate::ui) struct DetachedWorkspace {
+    path: PathBuf,
+    api: Option<Api>,
+    target: Target,
+    spaces: ChatSpaces,
+    group: WindowGroup,
+    sessions: Vec<ConversationSummary>,
+    session_projects: HashMap<PathBuf, PathBuf>,
+    codex_models: Arc<[crate::agents::codex::Model]>,
+    visual: prefs::WindowVisualPreferences,
+}
+
+impl DetachedWorkspace {
+    pub(in crate::ui) fn mount(
+        self,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (Entity<Workspace>, Target) {
+        let shell_target = self.target.clone();
+        prefs::inherit_visual_window(self.visual, cx);
+        let view = cx.new(|cx| {
+            let mut workspace =
+                Workspace::empty(self.path, self.target, self.spaces, self.group, window, cx);
+            workspace.api = self.api;
+            workspace.sessions = self.sessions;
+            workspace.session_projects = self.session_projects;
+            workspace.codex_models = self.codex_models;
+            workspace.status = Status::Ready;
+            workspace
+        });
+        (view, shell_target)
+    }
+}

+    });
+    app.add_empty_window().update(|window, cx| {
+        let host = Host::new(WeakEntity::new_invalid(), selected.id);
+        let raw = current(Some(0));
+        assert!(ContentView::body(host, selected, "text".into(), raw, window, cx).is_none());
+    });
+}

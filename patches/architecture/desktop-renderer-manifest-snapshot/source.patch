+use super::{Content, Manifest, content_entries, updated_content};
+use crate::declarative::manifest::Installed;
 use serde_json::json;
 
+fn renderer(id: &str, language: &str, format: &str) -> &'static Manifest {
+    super::super::entry(Installed {
+        dir: id.into(),
+        revision: 0,
+        manifest: serde_json::from_value(json!({
+            "protocol": 4,
+            "id": id,
+            "title": id,
+            "command": ["never-start"],
+            "surfaces": {"content": {"languages": [language], "formats": [format]}}
+        }))
+        .unwrap(),
+    })
+    .manifest
+}
+
+#[test]
+fn renderer_registration_uses_the_ordered_catalog_snapshot() {
+    let first = renderer("first", "fixture", "text/x-fixture");
+    let second = renderer("second", "fixture", "text/x-fixture");
+    let replacement = renderer("first", "new-language", "text/x-new");
+    let registrations = |ordered: Vec<&'static Manifest>, disabled: Option<&'static str>| {
+        content_entries(ordered, move |id| Some(id) != disabled)
+            .map(|(id, content)| {
+                (
+                    id.id,
+                    content.languages[0].as_str(),
+                    content.formats[0].as_str(),
+                )
+            })
+            .collect::<Vec<_>>()
+    };
+
+    // No runtime registry lookup is needed; a second generation cannot
+    // replace the registration attached to an already captured descriptor.
+    assert_eq!(
+        registrations(vec![second, first], None),
+        [
+            ("second", "fixture", "text/x-fixture"),
+            ("first", "fixture", "text/x-fixture"),
+        ]
+    );
+    assert_eq!(
+        registrations(vec![second, first], Some("second")),
+        [("first", "fixture", "text/x-fixture")]
+    );
+    assert_eq!(
+        registrations(vec![second, replacement], Some("second")),
+        [("first", "new-language", "text/x-new")]
+    );
+}
+
+#[::core::prelude::v1::test]

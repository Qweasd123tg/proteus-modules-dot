diff --git a/src/ui/extensions/declarative/widget_action.rs b/src/ui/extensions/declarative/widget_action.rs
new file mode 100644
index 0000000000000000000000000000000000000000..eaa7e94a8fb16fe2b7cbcc5e4927dff23303ae90
--- /dev/null
+++ b/src/ui/extensions/declarative/widget_action.rs
@@ -0,0 +1,33 @@
+use gpui_kit::App;
+
+/// A retained widget keeps its event sink, but its current declaration names the action.
+pub(super) struct WidgetAction {
+    name: String,
+    send: Box<dyn Fn(String, serde_json::Value, &mut App)>,
+}
+
+impl WidgetAction {
+    pub(super) fn new(
+        name: &str,
+        send: impl Fn(String, serde_json::Value, &mut App) + 'static,
+    ) -> Self {
+        Self {
+            name: name.to_owned(),
+            send: Box::new(send),
+        }
+    }
+
+    pub(super) fn rebind(&mut self, name: &str) {
+        if self.name != name {
+            name.clone_into(&mut self.name);
+        }
+    }
+
+    pub(super) fn emit(&self, value: serde_json::Value, cx: &mut App) {
+        (self.send)(self.name.clone(), value, cx);
+    }
+
+    pub(super) fn row(&self, id: &str, event: &'static str, cx: &mut App) {
+        self.emit(serde_json::json!({"id": id, "event": event}), cx);
+    }
+}

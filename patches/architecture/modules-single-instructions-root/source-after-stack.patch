+    #[test]
+    fn codex_project_instruction_load_and_render_share_one_resolved_root() {
+        let workspace = tempfile::tempdir().expect("workspace");
+        let root = workspace.path().canonicalize().expect("resolved root");
+        let cwd = root.join("nested");
+        std::fs::create_dir(&cwd).expect("nested cwd");
+        std::fs::write(root.join("AGENTS.md"), "root rules\n").expect("root instructions");
+        std::fs::write(cwd.join("AGENTS.override.md"), "child rules\n").expect("child instructions");
+        let mut resolutions = 0;
+        let chunks = codex_project_instruction_chunks(
+            &cwd,
+            &CodexContextConfig::default(),
+            |requested_cwd| {
+                resolutions += 1;
+                assert_eq!(requested_cwd, cwd.as_path());
+                Ok(root.clone())
+            },
+        )
+        .expect("instructions");
+
+        assert_eq!(resolutions, 1);
+        assert_eq!(chunks.len(), 2);
+        for (chunk, directory, path, text) in [
+            (&chunks[0], root.join(""), "AGENTS.md", "root rules"),
+            (
+                &chunks[1],
+                cwd.clone(),
+                "nested/AGENTS.override.md",
+                "child rules",
+            ),
+        ] {
+            assert_eq!(chunk.path.as_deref(), Some(Path::new(path)));
+            assert_eq!(
+                chunk.content,
+                format!(
+                    "# AGENTS.md instructions for {}\n\n<INSTRUCTIONS>\n{text}\n</INSTRUCTIONS>",
+                    directory.display()
+                )
+            );
+            assert_eq!(chunk.render_mode, ContextRenderMode::Verbatim);
+        }
+    }

+pub(super) fn config_builder_target_path(config_path: Option<&Path>) -> Option<PathBuf> {
+    let path = config_path?;
+    let selection = crate::core::config_selection(path).ok()?;
+    let physical = crate::core::physical_config_path(path);
+    let mut target = if physical.is_dir() {
+        if !selection.is_empty() {
+            return None;
+        }
+        physical.join(crate::core::CONFIG_BUILDER_OVERLAY)
+    } else {
+        std::fs::canonicalize(&physical).unwrap_or(physical)
+    };
+    for role in selection {
+        target = crate::core::config_reference(&target, &role).ok()?;
+    }
+    Some(target)
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use std::{fs, os::unix::fs::symlink};
+
+    #[test]
+    fn config_builder_target_preserves_alias_and_role_path_semantics() {
+        const NESTED_ROLES: &str = "#agent=/outer~1role/inner~0stage";
+        let temp = tempfile::tempdir().unwrap();
+        let file = temp.path().join("agent.toml");
+        let file_alias = temp.path().join("alias.toml");
+        fs::write(&file, b"").unwrap();
+        symlink(&file, &file_alias).unwrap();
+        let canonical_file = file.canonicalize().unwrap();
+
+        assert_eq!(
+            config_builder_target_path(Some(&file_alias)),
+            Some(canonical_file.clone())
+        );
+        let with_roles =
+            |path: &Path| PathBuf::from(format!("{}{NESTED_ROLES}", path.to_str().unwrap()));
+        assert_eq!(
+            config_builder_target_path(Some(&with_roles(&file_alias))),
+            Some(with_roles(&canonical_file))
+        );
+
+        let dir = temp.path().join("fragments");
+        let dir_alias = temp.path().join("fragments-alias");
+        fs::create_dir(&dir).unwrap();
+        symlink(&dir, &dir_alias).unwrap();
+        assert_eq!(
+            config_builder_target_path(Some(&dir_alias)),
+            Some(dir_alias.join("config-builder.toml"))
+        );
+        assert_eq!(config_builder_target_path(Some(&with_roles(&dir_alias))), None);
+
+        let unavailable = dir_alias.join("missing/../new.toml");
+        assert_eq!(
+            config_builder_target_path(Some(&unavailable)),
+            Some(unavailable.clone())
+        );
+
+        let malformed = PathBuf::from(format!("{}#agent=/bad~2role", file_alias.display()));
+        assert_eq!(config_builder_target_path(Some(&malformed)), None);
+        assert_eq!(config_builder_target_path(None), None);
+    }
+}

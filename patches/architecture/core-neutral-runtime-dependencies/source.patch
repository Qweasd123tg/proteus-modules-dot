index 0000000000000000000000000000000000000000..cbb60d8388eb0f96c5c899e3b5682991e0589f75
--- /dev/null
+++ b/crates/proteus-core/src/user_path.rs
@@ -0,0 +1,30 @@
+use std::{
+    env,
+    path::{Path, PathBuf},
+};
+
+pub fn expand_user_path(path: impl AsRef<Path>) -> PathBuf {
+    expand_user_path_with_home(path.as_ref(), env::var_os("HOME").as_deref())
+}
+
+pub(crate) fn expand_user_path_with_home(path: &Path, home: Option<&std::ffi::OsStr>) -> PathBuf {
+    let Some(path_str) = path.to_str() else {
+        return path.to_path_buf();
+    };
+    let Some(home) = home else {
+        return path.to_path_buf();
+    };
+    if path_str == "~" || path_str == "$HOME" || path_str == "${HOME}" {
+        return PathBuf::from(home);
+    }
+    if let Some(stripped) = path_str.strip_prefix("~/") {
+        return PathBuf::from(home).join(stripped);
+    }
+    if let Some(stripped) = path_str.strip_prefix("$HOME/") {
+        return PathBuf::from(home).join(stripped);
+    }
+    if let Some(stripped) = path_str.strip_prefix("${HOME}/") {
+        return PathBuf::from(home).join(stripped);
+    }
+    path.to_path_buf()
+}

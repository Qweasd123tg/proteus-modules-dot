@@ -64,2 +64,37 @@ fn startup_save_preserves_borrowed_cache_bytes_and_operations() {
 
+#[test]
+fn startup_save_plain_and_full_keep_identical_cache_bytes_and_operations() {
+    let (backend, store) = Backend::store();
+    backend.append(4_096);
+    let read = RemoteValidatedRead::open(store.clone()).unwrap();
+    let source = RemoteCacheSource::from_cursor(&read.cursor());
+    let mut model = SessionReadModel::from_validated(&store, read, full).unwrap();
+    let rows = std::mem::take(&mut model.conversation.messages);
+    let plain = StartupHistory::prepare(rows.clone(), true);
+    assert!(matches!(&plain, StartupHistory::Plain { .. }));
+    let save = |history: StartupHistory| {
+        cache::StartupProjection {
+            summary: model.summary.clone(),
+            revision: model.conversation.revision,
+            context_summary: history.context_summary(),
+            history,
+            context: model.conversation.model_context.clone(),
+            prefix: None,
+        }
+        .save(&store, &source, &model.usage, &model.transcript)
+    };
+
+    let initial = {
+        let mut state = backend.0.lock().unwrap();
+        state.cache_reads.clear();
+        state.writes.clear();
+        state.cache.clone()
+    };
+    assert_eq!(save(StartupHistory::Full(rows)), Some(()));
+    let full = capture_io(&backend);
+    backend.0.lock().unwrap().cache = initial;
+    assert_eq!(save(plain), Some(()));
+    assert_eq!(capture_io(&backend), full);
+}
+
 #[test]

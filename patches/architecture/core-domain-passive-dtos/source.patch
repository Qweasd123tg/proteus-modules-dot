--- /dev/null
+++ b/crates/proteus-contracts/src/contracts/domain_dto_tests.rs
@@ -0,0 +1,52 @@
+use super::{
+    ModelCallOrigin, ToolTerminalRef, execution_recorder::ModelCallOrigin as NestedOrigin,
+    tool_terminal::ToolTerminalRef as NestedTerminalRef,
+};
+use crate::domain;
+
+#[test]
+fn passive_domain_dtos_keep_public_paths_and_serde() {
+    let terminal: domain::ToolTerminalRef = NestedTerminalRef {
+        id: uuid::Uuid::from_u128(42),
+        title: "Synthetic".into(),
+        tty: true,
+    };
+    let terminal: ToolTerminalRef = terminal;
+    let encoded = serde_json::to_string(&terminal).unwrap();
+    assert_eq!(
+        encoded,
+        r#"{"id":"00000000-0000-0000-0000-00000000002a","title":"Synthetic","tty":true}"#
+    );
+    assert_eq!(
+        serde_json::from_str::<NestedTerminalRef>(&encoded).unwrap(),
+        terminal
+    );
+
+    let mut invalid = serde_json::to_value(&terminal).unwrap();
+    invalid["unexpected"] = true.into();
+    assert!(
+        serde_json::from_value::<NestedTerminalRef>(invalid.clone())
+            .unwrap_err()
+            .to_string()
+            .contains("unknown field `unexpected`")
+    );
+    let invalid_fields = invalid.as_object_mut().unwrap();
+    invalid_fields.remove("unexpected");
+    invalid_fields.remove("tty");
+    assert!(
+        serde_json::from_value::<ToolTerminalRef>(invalid)
+            .unwrap_err()
+            .to_string()
+            .contains("missing field `tty`")
+    );
+
+    for (origin, expected) in [
+        (NestedOrigin::Direct, r#""direct""#),
+        (NestedOrigin::Auxiliary, r#""auxiliary""#),
+    ] {
+        let origin: ModelCallOrigin = origin;
+        let origin: domain::ModelCallOrigin = origin;
+        assert_eq!(serde_json::to_string(&origin).unwrap(), expected);
+        assert_eq!(serde_json::from_str::<NestedOrigin>(expected).unwrap(), origin);
+    }
+}

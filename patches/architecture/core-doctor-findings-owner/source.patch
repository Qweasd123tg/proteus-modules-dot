diff --git a/crates/proteus-core/src/cli_doctor/findings.rs b/crates/proteus-core/src/cli_doctor/findings.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f87b1d799025eb4219d34d728cfd4258994b97cf
--- /dev/null
+++ b/crates/proteus-core/src/cli_doctor/findings.rs
@@ -0,0 +1,68 @@
+//! Ordered findings shared by the doctor command and its checks.
+
+#[derive(Default)]
+pub(crate) struct DoctorFindings {
+    pub(crate) entries: Vec<DoctorFinding>,
+}
+
+impl DoctorFindings {
+    pub(super) fn ok(&mut self, message: impl Into<String>) {
+        self.entries.push(DoctorFinding::new("ok", message));
+    }
+
+    pub(super) fn warn(&mut self, message: impl Into<String>) {
+        self.entries.push(DoctorFinding::new("warn", message));
+    }
+
+    pub(super) fn error(&mut self, message: impl Into<String>) {
+        self.entries.push(DoctorFinding::new("error", message));
+    }
+
+    pub(crate) fn has_errors(&self) -> bool {
+        self.entries.iter().any(|entry| entry.level == "error")
+    }
+}
+
+pub(crate) struct DoctorFinding {
+    pub(crate) level: &'static str,
+    pub(crate) message: String,
+}
+
+impl DoctorFinding {
+    fn new(level: &'static str, message: impl Into<String>) -> Self {
+        Self {
+            level,
+            message: message.into(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preserves_finding_order_and_reports_only_errors_as_errors() {
+        let mut findings = DoctorFindings::default();
+        findings.ok("first check");
+        findings.warn("warning check");
+        assert!(!findings.has_errors());
+
+        findings.error("failing check");
+        findings.ok("last check");
+        assert!(findings.has_errors());
+        assert_eq!(
+            findings
+                .entries
+                .iter()
+                .map(|entry| (entry.level, entry.message.as_str()))
+                .collect::<Vec<_>>(),
+            [
+                ("ok", "first check"),
+                ("warn", "warning check"),
+                ("error", "failing check"),
+                ("ok", "last check"),
+            ]
+        );
+    }
+}

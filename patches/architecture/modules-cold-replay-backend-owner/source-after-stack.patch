+//! Backend selection, physical locations and cold snapshot replay.
+use super::{
+    JSONL_JOURNAL_FILE, JournalBackend, Jsonl, RecordSnapshot, SQLITE_JOURNAL_FILE, Sqlite,
+    replay_records,
+};
+use crate::types::JournalRecord;
+use anyhow::Result;
+use proteus_contracts::domain::SessionId;
+use serde::{Deserialize, Serialize};
+use std::path::{Path, PathBuf};
+
+#[derive(Debug, Clone, Copy, Default, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum BackendKind {
+    #[default]
+    Jsonl,
+    Sqlite,
+}
+
+impl BackendKind {
+    pub(crate) fn description_path(self, dir: &Path) -> PathBuf {
+        dir.join(match self {
+            Self::Jsonl => JSONL_JOURNAL_FILE,
+            Self::Sqlite => SQLITE_JOURNAL_FILE,
+        })
+    }
+
+    pub(crate) fn backend(self) -> Box<dyn JournalBackend> {
+        match self {
+            Self::Jsonl => Box::new(Jsonl::new()),
+            Self::Sqlite => Box::new(Sqlite::default()),
+        }
+    }
+
+    pub(crate) fn replay_snapshot<T: Default>(
+        self,
+        dir: &Path,
+        id: SessionId,
+        cut: Option<u64>,
+        apply: impl Fn(&mut T, &JournalRecord, Option<String>) -> Result<()>,
+    ) -> Result<(Box<dyn RecordSnapshot>, T)> {
+        match self {
+            Self::Jsonl => Jsonl::replay_snapshot(dir, id, cut, apply),
+            Self::Sqlite => {
+                let mut source = self.backend().snapshot(dir, id)?;
+                let fold = replay_records(source.as_mut(), cut, &apply)?;
+                Ok((source, fold))
+            }
+        }
+    }
+}

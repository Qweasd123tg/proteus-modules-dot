+#[test]
+fn cold_snapshots_replay_both_engines_without_a_catalog_head() {
+    for kind in backends() {
+        let mut f = Fixture::new(kind);
+        let messages = [text("first"), text("second")];
+        let first = f.append(vec![messages[0].clone()]);
+        let second = f.append(vec![messages[1].clone()]);
+        let dir = f.descriptor.local_path.as_ref().unwrap();
+        assert!(!dir.join(".storage-catalog-v1.json").exists());
+
+        let storage = StorageService::new(kind);
+        crate::diagnostics::reset();
+        let SessionStorageResponse::Snapshot { snapshot } = storage
+            .execute(SessionStorageRequest::OpenSnapshot {
+                session: f.descriptor.session.clone(),
+            })
+            .unwrap()
+        else {
+            panic!("expected a cold snapshot")
+        };
+        assert_eq!(crate::diagnostics::get().decoded, 2);
+        assert_eq!(snapshot.revision, f.revision);
+        assert_eq!(snapshot.content_sha256, f.snapshot().content_sha256);
+        let SessionStorageResponse::Records { page } = storage
+            .execute(SessionStorageRequest::ReadRecords {
+                snapshot,
+                after_seq: 0,
+                limit: 10,
+            })
+            .unwrap()
+        else {
+            panic!("expected the cold snapshot's records")
+        };
+        assert_eq!(page.next_after_seq, None);
+        assert_eq!(page.records.len(), 2);
+        for ((record, commit), message) in page.records.iter().zip([first, second]).zip(&messages) {
+            assert_eq!(record.record_id, commit.operation_id);
+            let JournalEntry::HistoryMutated(change) = &record.entry else {
+                panic!("expected a history append")
+            };
+            assert_eq!(change.messages.as_slice(), std::slice::from_ref(message));
+        }
+    }
+}

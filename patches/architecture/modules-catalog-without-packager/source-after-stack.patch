+"""Shared source-package metadata, validation and atomic JSON publication."""
+from dataclasses import dataclass
 import json
 import os
 from pathlib import Path
 import re
 import tempfile
+import tomllib
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+@dataclass(frozen=True)
+class Package:
+    identity: str
+    binary: str
+    version: str
+    manifest: Path
+    implementation: Path
+    exports: dict
+    requirements: tuple[str, ...] = ()
+    model_connections: tuple[dict, ...] = ()
 
 
 def model_connections(path, exports):
@@ -54,3 +71,36 @@ def atomic_json(value, destination):
         os.replace(temporary, destination)
     finally:
         Path(temporary).unlink(missing_ok=True)
+
+
+def package_index(root):
+    """Validate the workspace package identities without reading their payloads."""
+    found = {}
+    for exports in sorted((root / "components").glob("*/exports.json")):
+        manifest = exports.with_name("Cargo.toml")
+        spec = tomllib.loads(manifest.read_text())["package"]
+        metadata = spec["metadata"]["proteus"]
+        identity = metadata["id"]
+        if identity in found:
+            raise SystemExit(f"Duplicate module package: {identity}")
+        requirements = metadata.get("requirements", [])
+        if (not isinstance(requirements, list)
+                or not all(isinstance(value, str) and value.strip() for value in requirements)):
+            raise SystemExit(f"Invalid build requirements for module package: {identity}")
+        found[identity] = (manifest, spec["name"], spec["version"],
+                           root / metadata["implementation"], tuple(dict.fromkeys(requirements)))
+    if not found:
+        raise SystemExit(f"No module packages in {root}")
+    return found
+
+
+def load_package(identity, indexed):
+    manifest, binary, version, implementation, requirements = indexed
+    exports = json.loads(manifest.with_name("exports.json").read_text())
+    return Package(identity, binary, version, manifest.resolve(), implementation, exports,
+                   requirements, model_connections(manifest.with_name("model-connections.json"), exports))
+
+
+def packages(root=ROOT):
+    return {identity: load_package(identity, indexed)
+            for identity, indexed in package_index(root).items()}

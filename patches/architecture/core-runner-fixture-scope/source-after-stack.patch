@@ -49,2 +49,52 @@ def core_library_only(args, packages):
 
+# These targets use repository-local workers or explicitly bound reference/storage
+# fixtures. New integration targets default to the full package set.
+NAMED_FIXTURE_TESTS = {
+    "acp_server",
+    "cli_dispatch",
+    "execution_boundary",
+    "hook_runtime",
+    "mcp_client",
+    "model_process",
+    "permission_modes",
+    "process_agent_control",
+    "process_agent_pool",
+    "session_ownership_slice",
+    "session_storage_swap",
+    "session_writer_lock",
+}
+
+
+def named_integration_only(args):
+    """Recognize a single verified integration target without widening Cargo selection."""
+    flags = {"--offline", "--locked", "--frozen", "--release", "--no-run", "--no-fail-fast"}
+    package = target = filter_seen = False
+    cargo = iter(args)
+    for arg in cargo:
+        if arg in ("-p", "--package"):
+            arg = "--package=" + next(cargo, "")
+        elif arg == "-pproteus-core":
+            arg = "--package=proteus-core"
+        if arg == "--package=proteus-core":
+            if package:
+                return False
+            package = True
+        elif arg == "--test" or arg.startswith("--test="):
+            spaced = arg == "--test"
+            name = next(cargo, "") if spaced else arg.partition("=")[2]
+            # Preserve the documented spaced command. Its profile still resolves
+            # session-storage through PATH, so do not narrow the existing equals form.
+            legacy = spaced and name == "component_sandbox"
+            if target or (name not in NAMED_FIXTURE_TESTS and not legacy):
+                return False
+            target = True
+        elif arg in flags:
+            continue
+        elif arg and not arg.startswith("-") and not filter_seen:
+            filter_seen = True
+        else:
+            return False
+    return package and target
+
+

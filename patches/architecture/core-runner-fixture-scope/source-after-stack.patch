+    def test_session_storage_swap_spellings_use_only_named_fixtures(self):
+        for prefix in (
+            ["-p", "proteus-core", "--test", "session_storage_swap"],
+            ["--test=session_storage_swap", "--package=proteus-core", "--offline"],
+            ["--package", "proteus-core", "--test=session_storage_swap"],
+            ["-pproteus-core", "--test", "session_storage_swap"],
+        ):
+            with self.subTest(prefix=prefix):
+                arguments = [*prefix, "--", "--skip", "module_swap", "--test=config_profiles"]
+                command, builds, env = self.invoke(arguments, {"PATH": "/bin"})
+                self.assertEqual(command, ["cargo", "test", "--locked", *arguments])
+                self.assertEqual(builds, (0, 1, 1))
+                self.assertEqual(env["PROTEUS_TEST_SESSION_STORAGE_MODULE"], STORAGE)
+                self.assertEqual(env["PROTEUS_TEST_REFERENCE_MODULE"], "/fixture/reference")
+                self.assertNotIn("PROTEUS_TEST_MODULE_BINARIES", env)
+                self.assertEqual(env["PATH"], "/bin")
+
+    def test_session_storage_swap_preserves_inherited_map_and_explicit_paths(self):
+        mapping = json.dumps({"session-storage": STORAGE})
+        for selector in (["--test", "session_storage_swap"], ["--test=session_storage_swap"]):
+            with self.subTest(selector=selector):
+                arguments = ["-p", "proteus-core", *selector]
+                given = {"PATH": "/bin", "PROTEUS_TEST_MODULE_BINARIES": mapping}
+                command, builds, env = self.invoke(arguments, given)
+                self.assertEqual(command, ["cargo", "test", "--locked", *arguments])
+                self.assertEqual(builds, (0, 1, 0))
+                self.assertEqual(env["PROTEUS_TEST_SESSION_STORAGE_MODULE"], STORAGE)
+                self.assertEqual(env["PROTEUS_TEST_MODULE_BINARIES"], mapping)
+                self.assertEqual(env["PATH"], "/bin")
+
+                overrides = {
+                    **given,
+                    "PROTEUS_TEST_SESSION_STORAGE_MODULE": "/explicit/storage",
+                    "PROTEUS_TEST_REFERENCE_MODULE": "/explicit/reference",
+                }
+                with patch.object(runner.Path, "is_file", autospec=True, return_value=True) as exists:
+                    _, builds, env = self.invoke(arguments, overrides)
+                exists.assert_called_once_with(runner.Path("/explicit/reference"))
+                self.assertEqual(builds, (0, 0, 0))
+                self.assertEqual(env, overrides)
+
+    def test_known_integration_targets_accept_one_positional_filter(self):

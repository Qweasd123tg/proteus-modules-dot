@@ -1,2 +1,27 @@
-use std::path::{Path, PathBuf};
+use std::{
+    io,
+    path::{Path, PathBuf},
+};
+
+use anyhow::{Context, Result};
+
+/// Resolve the physical configuration key without rewriting the unmaterialized suffix.
+pub(super) fn physical_config_identity(path: &Path) -> io::Result<Option<PathBuf>> {
+    let absolute = std::path::absolute(crate::core::physical_config_path(path))?;
+    Ok(absolute.ancestors().find_map(|ancestor| {
+        std::fs::canonicalize(ancestor).ok().map(|canonical| {
+            canonical.join(absolute.strip_prefix(ancestor).expect("path ancestor"))
+        })
+    }))
+}
+
+pub(super) fn resolve_config_reference(path: &Path) -> Result<PathBuf> {
+    let selection = crate::core::config_selection(path)?;
+    let mut resolved =
+        physical_config_identity(path)?.context("cannot resolve selection profile path")?;
+    for role in selection {
+        resolved = crate::core::config_reference(&resolved, &role)?;
+    }
+    Ok(resolved)
+}
 
@@ -73,2 +98,36 @@ mod tests {
     }
+
+    #[test]
+    fn config_identity_preserves_missing_suffix_through_a_symlink() {
+        let temp = tempfile::tempdir().unwrap();
+        let real = temp.path().join("real");
+        let alias = temp.path().join("alias");
+        fs::create_dir(&real).unwrap();
+        symlink(&real, &alias).unwrap();
+        let suffix = "missing/../profile.toml";
+        let path = alias.join(suffix);
+        let expected = real.canonicalize().unwrap().join(suffix);
+        let with_roles = |path: &Path| {
+            PathBuf::from(format!(
+                "{}#agent=/outer~1role/inner~0stage",
+                path.to_str().unwrap()
+            ))
+        };
+
+        assert_eq!(
+            physical_config_identity(&path).unwrap().unwrap().as_os_str(),
+            expected.as_os_str()
+        );
+        assert_eq!(
+            physical_config_identity(&with_roles(&path))
+                .unwrap()
+                .unwrap()
+                .as_os_str(),
+            expected.as_os_str()
+        );
+        assert_eq!(
+            resolve_config_reference(&with_roles(&path)).unwrap().as_os_str(),
+            with_roles(&expected).as_os_str()
+        );
+    }
 }

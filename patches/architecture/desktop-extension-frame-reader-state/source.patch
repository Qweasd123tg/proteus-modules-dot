+#[test]
+fn framing_closed_transport_still_reports_empty_eof_before_reserving() {
+    let incoming = Budget::new(QUEUE_COUNT, INCOMING_BYTES);
+    let closed = AtomicBool::new(true);
+    let mut empty = std::io::Cursor::new(b"");
+    assert!(
+        io::read_frame(&mut empty, &incoming, &closed)
+            .unwrap()
+            .is_none()
+    );
+
+    let mut frame = std::io::Cursor::new(b"{}\n");
+    let Err(error) = io::read_frame(&mut frame, &incoming, &closed) else {
+        panic!("closed transport must reject a nonempty frame");
+    };
+    assert_eq!(error.to_string(), "транспорт расширения закрыт");
+    assert_eq!(frame.position(), 0);
+    assert_eq!(incoming.usage(), (0, 0));
+}

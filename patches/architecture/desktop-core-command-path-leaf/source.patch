diff --git a/src/runtime_paths.rs b/src/runtime_paths.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7acbdffa67c299a09b79c7c8fc65973c6bdac023
--- /dev/null
+++ b/src/runtime_paths.rs
@@ -0,0 +1,71 @@
+//! Select the local backend command independently of its process lifetime.
+
+use std::{ffi::OsString, path::PathBuf};
+
+/// Preserve the command spelling: launch and provider auth use its parent for
+/// module lookup. Inventory resolves the underlying file separately.
+pub(crate) fn proteus_binary() -> PathBuf {
+    select_proteus_binary(std::env::var_os("PROTEUS_BIN"), || {
+        std::env::current_exe().ok()
+    })
+}
+
+fn select_proteus_binary(
+    explicit: Option<OsString>,
+    desktop_exe: impl FnOnce() -> Option<PathBuf>,
+) -> PathBuf {
+    if let Some(path) = explicit {
+        return path.into();
+    }
+    desktop_exe()
+        .and_then(|exe| exe.parent().map(|dir| dir.join("proteus")))
+        .filter(|path| path.is_file())
+        .unwrap_or_else(|| PathBuf::from("proteus"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn backend_selection_preserves_raw_override_and_prefers_existing_sibling() {
+        use std::{
+            fs,
+            os::unix::{ffi::OsStringExt, fs::symlink},
+        };
+
+        struct Fixture(PathBuf);
+        impl Drop for Fixture {
+            fn drop(&mut self) {
+                let _ = fs::remove_dir_all(&self.0);
+            }
+        }
+
+        let root = std::env::temp_dir().join(format!("proteus-backend-path-{}", uuid::Uuid::new_v4()));
+        fs::create_dir(&root).unwrap();
+        let root = Fixture(root);
+        let desktop = root.0.join("proteus-native");
+        let sibling = root.0.join("proteus");
+        assert_eq!(
+            select_proteus_binary(None, || Some(desktop.clone())),
+            PathBuf::from("proteus")
+        );
+        assert_eq!(select_proteus_binary(None, || None), PathBuf::from("proteus"));
+
+        fs::write(&sibling, "synthetic backend").unwrap();
+        assert_eq!(select_proteus_binary(None, || Some(desktop)), sibling);
+        let alias = root.0.join("alias").join("proteus");
+        fs::create_dir(alias.parent().unwrap()).unwrap();
+        symlink(&sibling, &alias).unwrap();
+        for spelling in [
+            alias.into_os_string(),
+            OsString::new(),
+            OsString::from_vec(b"./relative//raw-\xff".to_vec()),
+        ] {
+            let command = select_proteus_binary(Some(spelling.clone()), || {
+                panic!("explicit selection never checks the desktop executable")
+            });
+            assert_eq!(command.into_os_string(), spelling);
+        }
+    }
+}

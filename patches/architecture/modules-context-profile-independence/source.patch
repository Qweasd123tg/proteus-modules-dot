+#[test]
+fn context_profiles_send_their_own_retrieval_limits_in_provider_order() {
+    use proteus_contracts::process_module::{ContextBuilderModuleHost, ProcessModuleResult};
+
+    #[derive(Default)]
+    struct FixtureHost(std::sync::Mutex<Vec<(&'static str, usize)>>);
+
+    impl ContextBuilderModuleHost for FixtureHost {
+        fn context_provider_json(
+            &self,
+            provider_id: String,
+            request: String,
+        ) -> ProcessModuleResult<String> {
+            let request: ProcessContextProviderInput = serde_json::from_str(&request).unwrap();
+            assert_eq!(request.provider_id, provider_id);
+            let call = match provider_id.as_str() {
+                "memory-fixture" => {
+                    let query: MemoryQuery = serde_json::from_value(request.metadata).unwrap();
+                    assert_eq!(query.text, "needle");
+                    ("memory", query.limit)
+                }
+                "search-fixture" => {
+                    let query: SearchQuery = serde_json::from_value(request.metadata).unwrap();
+                    assert_eq!(query.text, "needle");
+                    assert_eq!(query.cwd, request.task.cwd);
+                    assert_eq!(query.use_case.as_deref(), Some("repo_aware_context"));
+                    ("search", query.max_results)
+                }
+                _ => panic!("unexpected fixture provider {provider_id}"),
+            };
+            self.0.lock().unwrap().push(call);
+            Ok("[]".to_owned())
+        }
+    }
+
+    let run = |builder: &dyn ContextBuilderModule, providers, memory_limit, max_search_results| {
+        let input = ContextBuilderModuleInput {
+            task: proteus_contracts::domain::AgentTask::new("needle", "fixture-root".into()),
+            attribution: proteus_contracts::contracts::ExecutionAttribution::detached(
+                proteus_contracts::domain::new_execution_id(),
+            ),
+            config: json!({
+                "providers": providers,
+                "memory_provider": "memory-fixture",
+                "search_provider": "search-fixture",
+                "memory_limit": memory_limit,
+                "max_search_results": max_search_results,
+            }),
+        };
+        let mut host = FixtureHost::default();
+        builder
+            .build_json(serde_json::to_string(&input).unwrap(), &mut host)
+            .unwrap();
+        host.0.into_inner().unwrap()
+    };
+    let repo = &RepoAwareContextBuilderModule as &dyn ContextBuilderModule;
+    let codex = &CodexContextBuilderModule as &dyn ContextBuilderModule;
+    assert_eq!(
+        run(repo, ["search", "memory"], 7, 3),
+        [("search", 3), ("memory", 7)],
+    );
+    assert_eq!(
+        run(codex, ["memory", "search"], 11, 5),
+        [("memory", 11), ("search", 5)],
+    );
+    for builder in [repo, codex] {
+        assert_eq!(run(builder, ["search", "memory"], 0, 0), [("memory", 0)]);
+    }
+}

{
  "schema_version": 1,
  "suite_id": "draft-release-v1",
  "documents": [{
    "id": "release",
    "path": "fixtures/release.json",
    "assertions": [
      {"id": "version", "pointer": "/schema_version", "rule": {"kind": "equals", "expected": 1}},
      {"id": "draft-only", "pointer": "/release/channel", "rule": {"kind": "equals", "expected": "draft"}},
      {"id": "not-publishing", "pointer": "/release/publish", "rule": {"kind": "equals", "expected": false}},
      {"id": "has-artifacts", "pointer": "/artifacts", "rule": {"kind": "non_empty"}},
      {"id": "owner-label", "pointer": "/owner~1label/~0name", "rule": {"kind": "type", "expected": "string"}}
    ]
  }]
}

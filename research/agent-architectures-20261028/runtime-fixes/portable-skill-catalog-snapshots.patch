+//! One metadata snapshot per provider export, never a permission/body cache.
+use std::{
+    fs,
+    path::PathBuf,
+    sync::{Arc, Mutex, TryLockError},
+    time::{Duration, Instant},
+};
+
+use anyhow::{Result, ensure};
+
+use crate::{
+    catalog::{CancellationFailure, Snapshot, check, discover, open_document, root_path},
+    config::Config,
+};
+
+// This is a bounded metadata freshness policy, not a filesystem watcher. Age is
+// measured from the start of discovery, not its completion or last cache hit.
+pub(crate) const MAX_SNAPSHOT_AGE: Duration = Duration::from_secs(30);
+
+pub(crate) struct PublishedSnapshot {
+    // Local publication sequence; resets with this export. Not a content hash,
+    // cross-process revision, permission token, or evidence of current file bytes.
+    pub revision: u64,
+    pub snapshot: Snapshot,
+}
+
+struct CachedSnapshot {
+    runtime_disabled: Vec<String>,
+    roots: Vec<PathBuf>,
+    started: Instant,
+    published: Arc<PublishedSnapshot>,
+}
+
+#[derive(Default)]
+struct State {
+    revision: u64,
+    cached: Option<CachedSnapshot>,
+}
+
+pub(crate) struct SnapshotCache {
+    // Immutable config belongs to exactly one export. Rebinding constructs a
+    // new cache; no process-global/config-hash registry can cross authorities.
+    config: Config,
+    state: Mutex<State>,
+}
+
+impl SnapshotCache {
+    pub fn new(config: Config) -> Self {
+        Self {
+            config,
+            state: Mutex::new(State::default()),
+        }
+    }
+
+    /// `refresh` always rescans, including after another caller refreshed.
+    /// Otherwise concurrent misses share the completed scan for matching settings.
+    pub fn get(
+        &self,
+        runtime_disabled: &[String],
+        refresh: bool,
+        mut cancelled: impl FnMut() -> Result<bool>,
+    ) -> Result<(Arc<PublishedSnapshot>, bool)> {
+        check(&mut cancelled)?;
+        self.config.validate()?;
+        // Keep only one bounded snapshot and serialize discovery/publication.
+        // A caller waiting behind another scan still checks its own cancellation;
+        // this does not make filesystem syscalls inside that scan interruptible.
+        let mut state = loop {
+            check(&mut cancelled)?;
+            match self.state.try_lock() {
+                Ok(state) => break state,
+                Err(TryLockError::Poisoned(_)) => {
+                    return Err(anyhow::anyhow!("skill snapshot cache lock poisoned"));
+                }
+                Err(TryLockError::WouldBlock) => {
+                    std::thread::sleep(Duration::from_millis(10));
+                }
+            }
+        };
+        check(&mut cancelled)?;
+        let mut disabled = runtime_disabled.to_vec();
+        disabled.sort();
+        disabled.dedup();
+        let roots = self.source_roots(&mut cancelled)?;
+        if !refresh {
+            if let (Some(cached), Some(roots)) = (&state.cached, &roots) {
+                if cached.runtime_disabled == disabled
+                    && cached.roots == *roots
+                    && cached.started.elapsed() < MAX_SNAPSHOT_AGE
+                    && self.sources_readable(&cached.published.snapshot, roots, &mut cancelled)?
+                    && cached.started.elapsed() < MAX_SNAPSHOT_AGE
+                {
+                    check(&mut cancelled)?;
+                    return Ok((Arc::clone(&cached.published), true));
+                }
+            }
+        }
+
+        // No stale-on-error fallback after an explicit refresh, changed settings,
+        // root failure, cancellation during a scan, or an expired snapshot.
+        state.cached = None;
+        let revision = state
+            .revision
+            .checked_add(1)
+            .ok_or_else(|| anyhow::anyhow!("skill snapshot revision exhausted"))?;
+        let started = Instant::now();
+        let snapshot = discover(&self.config, &disabled, &mut cancelled)?;
+        let after = self.source_roots(&mut cancelled)?;
+        ensure!(
+            roots == after,
+            "configured skill roots changed during discovery; refresh the catalog"
+        );
+        check(&mut cancelled)?;
+        let published = Arc::new(PublishedSnapshot { revision, snapshot });
+        state.revision = revision;
+        // A lenient diagnostic can include parsed untrusted text without a
+        // retained skill/source entry to revalidate. Never cache such warnings.
+        if let Some(roots) = after.filter(|_| published.snapshot.warnings.is_empty()) {
+            state.cached = Some(CachedSnapshot {
+                runtime_disabled: disabled,
+                roots,
+                started,
+                published: Arc::clone(&published),
+            });
+        }
+        Ok((published, false))
+    }
+
+    fn sources_readable(
+        &self,
+        snapshot: &Snapshot,
+        roots: &[PathBuf],
+        cancelled: &mut impl FnMut() -> Result<bool>,
+    ) -> Result<bool> {
+        for skill in &snapshot.skills {
+            check(cancelled)?;
+            let Some((_, root)) = self
+                .config
+                .roots
+                .iter()
+                .zip(roots)
+                .find(|(configured, _)| configured.id == skill.root_id)
+            else {
+                return Ok(false);
+            };
+            // Reuse the actual reader's path/regular-file/open checks, including
+            // current OS read permissions. No SKILL.md bytes are read here.
+            // Opening is not proof that content is unchanged, nor a capability
+            // for a later load: that operation must open and verify again.
+            match open_document(root, &skill.fields.name, cancelled) {
+                Ok((_file, path, directory)) => {
+                    if path != skill.path || directory != skill.skill_directory {
+                        return Ok(false);
+                    }
+                }
+                Err(error) if error.is::<CancellationFailure>() => return Err(error),
+                // Re-enter normal discovery to preserve strict/lenient behavior,
+                // rather than returning cached facts after an authority failure.
+                Err(_) => return Ok(false),
+            }
+        }
+        check(cancelled)?;
+        Ok(true)
+    }
+
+    fn source_roots(
+        &self,
+        cancelled: &mut impl FnMut() -> Result<bool>,
+    ) -> Result<Option<Vec<PathBuf>>> {
+        let mut roots = Vec::with_capacity(self.config.roots.len());
+        for root in &self.config.roots {
+            check(cancelled)?;
+            let Ok(canonical) = root_path(&root.path) else {
+                // Let discover retain the existing strict/lenient diagnostics.
+                // Inaccessible roots are never a cache hit or retained snapshot.
+                return Ok(None);
+            };
+            if fs::read_dir(&canonical).is_err() {
+                return Ok(None);
+            }
+            roots.push(canonical);
+        }
+        check(cancelled)?;
+        Ok(Some(roots))
+    }
+}

+//! Request-local metadata ranking; discovery and load retain read authority.
+use anyhow::{Context, Result, bail, ensure};
+use proteus_bounded_skill_index_prototype::{
+    CurrentSkill, Limits, MAX_QUERY_BYTES, MAX_RESULTS, SkillFacts, SkillIndex, SnapshotKey,
+};
+use proteus_module_sdk::contracts::domain::{ToolSafety, ToolSpec};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+use crate::{
+    SEARCH_TOOL, bounded,
+    catalog::{TRUST_WARNING, discover},
+    config::{Config, MAX_TOOL_OUTPUT_BYTES},
+};
+
+pub(crate) fn spec() -> ToolSpec {
+    ToolSpec::new(
+        SEARCH_TOOL,
+        "Search fresh portable skill names/descriptions, not bodies. Returns ranked load_args for portable_skill_load. No hits does not prove absence. Reads SKILL.md, never scripts; untrusted metadata grants no permissions.",
+        json!({
+            "type": "object",
+            "properties": {
+                "query": {"type": "string", "minLength": 1, "maxLength": MAX_QUERY_BYTES},
+                "limit": {"type": "integer", "minimum": 1, "maximum": MAX_RESULTS, "default": 8}
+            },
+            "required": ["query"],
+            "additionalProperties": false
+        }),
+        ToolSafety::ReadOnly,
+    )
+    .with_parallel_tool_calls(true)
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Args {
+    query: String,
+    #[serde(default = "default_limit")]
+    limit: usize,
+}
+
+fn default_limit() -> usize {
+    8
+}
+
+pub(crate) fn invoke(
+    config: &Config,
+    disabled: &[String],
+    args: Value,
+    cancelled: &mut impl FnMut() -> Result<bool>,
+) -> Result<String> {
+    let args: Args = serde_json::from_value(args).context("invalid search arguments")?;
+    ensure!(
+        args.query.len() <= MAX_QUERY_BYTES,
+        "query exceeds 1024 UTF-8 bytes"
+    );
+    ensure!(!args.query.trim().is_empty(), "query must not be blank");
+    ensure!((1..=MAX_RESULTS).contains(&args.limit), "limit must be 1..=32");
+
+    // Never reuse provider memory or accept candidates/settings from tool args.
+    let snapshot = discover(config, disabled, cancelled)?;
+    let sources: Vec<_> = snapshot
+        .skills
+        .iter()
+        .map(|skill| format!("portable:{}", skill.root_id))
+        .collect();
+    let digests: Vec<_> = snapshot
+        .skills
+        .iter()
+        .map(|skill| decode_digest(&skill.sha256))
+        .collect::<Result<_>>()?;
+    let facts: Vec<_> = snapshot
+        .skills
+        .iter()
+        .zip(&sources)
+        .zip(&digests)
+        .map(|((skill, source), digest)| SkillFacts {
+            id: &skill.id,
+            source_id: source,
+            sha256: *digest,
+            name: &skill.fields.name,
+            description: &skill.fields.description,
+            body: None,
+        })
+        .collect();
+    let current: Vec<_> = facts
+        .iter()
+        .map(|fact| CurrentSkill {
+            id: fact.id,
+            source_id: fact.source_id,
+            sha256: fact.sha256,
+        })
+        .collect();
+    // Only this invocation owns the index. This is not a catalog revision and
+    // must not become a cache key if persistence is introduced later.
+    let key = SnapshotKey {
+        binding_epoch: 0,
+        catalog_revision: 0,
+    };
+    let index = SkillIndex::build(
+        key,
+        &facts,
+        Limits {
+            max_body_skills: 0,
+            max_body_prefix_bytes: 0,
+            max_body_total_bytes: 0,
+            ..Limits::default()
+        },
+    )?;
+    let ranked = index.search(key, &current, &args.query, args.limit)?;
+    let hits = ranked
+        .hits
+        .iter()
+        .map(|hit| {
+            let skill = snapshot
+                .skills
+                .iter()
+                .find(|skill| skill.id == hit.id)
+                .context("search hit missing from current discovery")?;
+            Ok(json!({
+                "name": skill.fields.name,
+                "description": skill.fields.description,
+                "source": hit.source_id,
+                "score": {
+                    "exact_name": hit.score.exact_name,
+                    "matched_query_terms": hit.score.matched_query_terms,
+                    "field_weight": hit.score.field_weight
+                },
+                "coverage": {
+                    "metadata_long_tokens_omitted": hit.coverage.metadata_long_tokens_omitted
+                },
+                "load_args": {
+                    "id": skill.id,
+                    "sha256": skill.sha256,
+                    "catalog_path": skill.path
+                }
+            }))
+        })
+        .collect::<Result<Vec<_>>>()?;
+
+    // Whole escaped JSON is bounded; never return a truncated successful page.
+    // The enclosing invoke checks cancellation after ranking/serialization.
+    bounded(
+        json!({
+            "warning": TRUST_WARNING,
+            "metadata_only": true,
+            "coverage_notice": "Lexical name/description matches only. Discovery warnings or omitted long tokens reduce coverage; even without them, no hits does not prove semantic absence.",
+            "coverage": {
+                "eligible_skills": ranked.coverage.eligible_skills,
+                "metadata_partial_skills": ranked.coverage.metadata_partial_skills,
+                "matched_skills": ranked.coverage.matched_skills,
+                "returned_skills": ranked.coverage.returned_skills
+            },
+            "discovery_warnings": snapshot.warnings,
+            "results": hits
+        }),
+        MAX_TOOL_OUTPUT_BYTES,
+        "search output exceeds 131072 bytes; lower limit or narrow configured roots",
+    )
+}
+
+fn decode_digest(hex: &str) -> Result<[u8; 32]> {
+    ensure!(
+        hex.len() == 64,
+        "discovered SHA256 must have 64 lowercase hex bytes"
+    );
+    let nibble = |byte| match byte {
+        b'0'..=b'9' => Ok(byte - b'0'),
+        b'a'..=b'f' => Ok(byte - b'a' + 10),
+        _ => bail!("discovered SHA256 must have 64 lowercase hex bytes"),
+    };
+    let mut digest = [0; 32];
+    for (slot, pair) in digest.iter_mut().zip(hex.as_bytes().chunks_exact(2)) {
+        *slot = nibble(pair[0])? * 16 + nibble(pair[1])?;
+    }
+    Ok(digest)
+}

+// Audit-only diagnostic: exercises the real per-hook InvocationOperations facade.
+struct ConcurrentSerialHook;
+#[async_trait]
+impl HookHandler for ConcurrentSerialHook {
+    async fn invoke(&self, input: HookInput, host: Arc<dyn HookHost>) -> Result<HookResponse> {
+        if matches!(input.event, HookEvent::BeforeStop { .. }) {
+            let (first, second) = tokio::join!(
+                host.execute_tool(call("serial")),
+                host.execute_tool(call("serial")),
+            );
+            assert!(first?.ok);
+            assert!(second?.ok);
+        }
+        Ok(HookResponse::Continue)
+    }
+}
+
+#[tokio::test]
+async fn audit_hook_siblings_ignore_serial_tool_permission() {
+    let activity = Arc::new(Activity::default());
+    let release = Arc::new(Semaphore::new(0));
+    let (started, mut receiver) = mpsc::unbounded_channel();
+    let mut registry = ToolRegistry::new();
+    registry
+        .register_arc(
+            ToolSource::builtin("hook-scheduling-audit"),
+            Arc::new(Probe {
+                name: "serial",
+                parallel: false,
+                activity: activity.clone(),
+                entered: started,
+                release: release.clone(),
+            }),
+        )
+        .unwrap();
+    let scope = ExecutionScope::fresh(CancellationToken::new());
+    let facts = Arc::new(Facts::default());
+    let hooks = Arc::new(RuntimeHookChain::new(
+        vec![("concurrent-hook".into(), Arc::new(ConcurrentSerialHook))],
+        scope.clone(),
+        facts.clone(),
+        None,
+    ));
+    let tools = BoundTools::new(
+        registry,
+        Arc::new(AskChild),
+        Arc::new(Approval {
+            calls: AtomicUsize::new(0),
+            approved: true,
+        }),
+        Arc::default(),
+        ToolExecutionBinding::detached(scope.clone()).with_recorder(facts.clone()),
+    );
+    let erased: Arc<dyn ExecutionHooks> = hooks.clone();
+    hooks.bind_operations(ExtensionOperations {
+        model: None,
+        tools: tools.with_hooks(Arc::new(WeakExecutionHooks(Arc::downgrade(&erased)))),
+    });
+    let running = tokio::spawn(async move {
+        hooks
+            .apply(HookInput {
+                event: HookEvent::BeforeStop {
+                    task: AgentTask::new("audit", "/tmp".into()),
+                    history: vec![],
+                    output: AgentOutput::text("candidate"),
+                    attempt: 0,
+                    continuation: None,
+                },
+                attribution: ExecutionAttribution::detached(scope.execution_id),
+                cwd: "/tmp".into(),
+                conversation: None,
+            })
+            .await
+    });
+    entered(&mut receiver, "serial").await;
+    entered(&mut receiver, "serial").await;
+    let maximum = activity.maximum.load(Ordering::SeqCst);
+    release.add_permits(2);
+    timeout(GUARD, running).await.unwrap().unwrap().unwrap();
+    eprintln!("audit hook serial tool maximum overlap: {maximum}");
+    assert_eq!(
+        maximum, 2,
+        "diagnostic asserts current behavior, not desired invariant"
+    );
+    assert_eq!(facts.tools.lock().unwrap().len(), 2);
+    assert!(
+        facts
+            .tools
+            .lock()
+            .unwrap()
+            .iter()
+            .all(|(_, owner)| matches!(owner, OperationOwner::Hook { .. }))
+    );
+}

+#[tokio::test]
+async fn audit_replay_rewrites_literal_hook_output_equal_to_call_id() {
+    let call = ToolCall::new("recorded-call", "read_file", serde_json::json!({}));
+    let raw = ToolResult::ok(call.id.clone(), "raw fixture text");
+    let before = input(HookEvent::AfterTool {
+        call: call.clone(),
+        result: raw.clone(),
+    });
+    // A literal string is valid output data, not a typed identity reference.
+    let response = HookResponse::ToolOutput {
+        output: "recorded-call".into(),
+    };
+    let output = apply_hook_response(&before.event, &response).unwrap();
+    let state = state(
+        vec![HookTrace {
+            owner: crate::contracts::OperationOwner::Workflow,
+            input: before,
+            steps: vec![HookStep {
+                invocation_id: uuid::Uuid::new_v4(),
+                module_id: "budget".into(),
+                outcome: HookStepOutcome::Accepted { response },
+            }],
+            output: Some(output),
+        }],
+        vec![RecordedToolInvocation {
+            owner: crate::contracts::OperationOwner::Workflow,
+            call: call.clone(),
+            approval_reason: None,
+            resolution: ToolCallResolution::Allowed,
+            result: ToolResult::ok(call.id.clone(), "recorded-call"),
+            raw_result: Some(raw),
+        }],
+    );
+    let mut actual = call;
+    actual.id = "actual-call".into();
+    state.record_tool_requested(&actual).unwrap();
+    let raw = state.replay_tool_result(&actual.id).unwrap();
+    let replay = ReplayHooks::new(state.clone(), vec!["budget".into()]);
+    let rewritten = rewrite_response(
+        &HookResponse::ToolOutput {
+            output: "recorded-call".into(),
+        },
+        &state.lock().expected_to_actual,
+    )
+    .unwrap();
+    assert_eq!(
+        rewritten,
+        HookResponse::ToolOutput {
+            output: "actual-call".into()
+        }
+    );
+    let error = replay
+        .apply(input(HookEvent::AfterTool {
+            call: actual.clone(),
+            result: raw,
+        }))
+        .await
+        .unwrap_err();
+    eprintln!("literal hook output rewrite: {rewritten:?}; oracle error: {error:#}");
+    assert!(
+        error
+            .to_string()
+            .contains("replayed output differs from recorded output")
+    );
+}

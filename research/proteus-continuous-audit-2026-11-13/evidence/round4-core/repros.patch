+#[cfg(test)]
+mod round4_path_repro {
+    use super::*;
+
+    #[test]
+    fn repro_round4_worktree_preserves_significant_trailing_space_in_root() {
+        let root = tempfile::tempdir().unwrap();
+        let repo = root.path().join("repo with trailing space ");
+        fs::create_dir(&repo).unwrap();
+        for args in [vec!["init", "-q", "-b", "main"], vec!["config", "user.email", "test@example.test"], vec!["config", "user.name", "test"], vec!["commit", "--allow-empty", "-qm", "base"]] {
+            run_git(&repo, &args).unwrap();
+        }
+        let result = create_worktree(&repo, "child");
+        eprintln!("root={repo:?}, result={result:?}");
+        assert!(result.is_ok(), "worktree must use Git's exact path, not whitespace-trimmed path");
+    }
+}

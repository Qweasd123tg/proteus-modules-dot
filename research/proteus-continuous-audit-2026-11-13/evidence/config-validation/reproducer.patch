+#[tokio::test]
+async fn audit_round12_http_save_accepts_unknown_slot_then_rejects_valid_save() {
+    let root = tempfile::tempdir().unwrap();
+    let source = root.path().join("config.json");
+    let mut config = AppConfig::default();
+    config.active_provider = None;
+    config.providers.clear();
+    config.agent_control.surface = crate::core::AgentControlSurface::None;
+    config.tools.enabled = vec!["probe_command".into()];
+    let fixture =
+        PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/process_commands.py");
+    config.components.insert(
+        "audit-probe".into(),
+        serde_json::from_value(json!({
+            "command": "python3", "args": [fixture],
+            "exports": {"tool": {"probe.commands": {}}}
+        }))
+        .unwrap(),
+    );
+    std::fs::write(&source, serde_json::to_vec(&config).unwrap()).unwrap();
+    let server = AgentAppServer::launch(config, root.path().into(), Some(&source))
+        .await
+        .unwrap();
+    let (shutdown, _) = broadcast::channel(1);
+    let state = HttpAppState::new(server.clone(), shutdown, test_security()).await;
+    let uri = session_uri("/config/builder", &server);
+    let first = route_request(
+        state.clone(),
+        authed_json_request(
+            &uri,
+            json!({
+                "module_config": {"unknown_slot": {"unselected": {"audit": 1}}}
+            }),
+        ),
+    )
+    .await
+    .unwrap();
+    assert_eq!(first.status(), StatusCode::OK);
+    let body: Value = serde_json::from_slice(&response_bytes(first).await).unwrap();
+    assert_eq!(
+        body["module_config"]["unknown_slot"]["unselected"]["audit"],
+        1
+    );
+    let second = route_request(
+        state,
+        authed_json_request(
+            &uri,
+            json!({
+                "permission_mode": "plan"
+            }),
+        ),
+    )
+    .await
+    .unwrap();
+    assert_eq!(second.status(), StatusCode::BAD_REQUEST);
+    let error = String::from_utf8(response_bytes(second).await.to_vec()).unwrap();
+    assert!(error.contains("unknown module_config slot"));
+    eprintln!(
+        "ROUND12 HTTP ROUTE: malformed slot Save HTTP 200; subsequent valid permission-mode Save HTTP 400: {error}"
+    );
+    server.shutdown().await;
+}

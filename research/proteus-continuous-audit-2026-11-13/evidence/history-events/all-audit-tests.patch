+#[path = "/workspace/shared/state-install-trace/src/ui/chat/feedback/mod.rs"]
+mod desktop_feedback;
+
+struct BurstFollowupWorkflow {
+    started: Notify,
+    release: Notify,
+}
+
+#[async_trait::async_trait]
+impl Workflow for BurstFollowupWorkflow {
+    async fn run(&self, task: AgentTask, _history: Vec<CanonicalMessage>, _ctx: crate::contracts::WorkflowInvocationContext) -> Result<WorkflowOutput> {
+        if task.text == "initial" {
+            self.started.notify_one();
+            self.release.notified().await;
+            Ok(WorkflowOutput::new(AgentOutput::text("first answer"), vec![CanonicalMessage::text(MessageRole::Assistant, "first answer")]))
+        } else {
+            assert_eq!(task.text, "queued payload");
+            let messages = (0..60).map(|index| CanonicalMessage::text(MessageRole::Assistant, format!("followup part {index}"))).collect();
+            Ok(WorkflowOutput::new(AgentOutput::text("followup complete"), messages))
+        }
+    }
+}

+#[tokio::test]
+async fn audit_accepted_queued_receipt_survives_reconnect_after_user_row_leaves_tail() {
+    let root = tempfile::tempdir().unwrap();
+    let workflow = Arc::new(BurstFollowupWorkflow { started: Notify::new(), release: Notify::new() });
+    let mut config = AppConfig::default();
+    config.active_provider = None;
+    config.providers.clear();
+    crate::test_support::select_test_modules(&mut config, "coding.single_loop");
+    let mut catalog = crate::test_support::module_catalog_for(&config);
+    catalog.register_test_workflow("coding.single_loop", workflow.clone());
+    let config_path = root.path().join("configs/config.toml");
+    let server = AgentAppServer::launch_with_module_catalog(config, root.path().to_owned(), Some(&config_path), catalog).await.unwrap();
+    let SendDispatch::Started(result) = server.dispatch_user_message(Some("initial-run".into()), "initial".to_owned(), Default::default(), CancellationToken::new()).await.unwrap() else { panic!("initial") };
+    bounded(workflow.started.notified()).await;
+    let mut feedback = desktop_feedback::Feedback::default();
+    feedback.begin("queued-request".into(), "queued payload".into(), &[], &[]);
+    let SendDispatch::Queued(receipt) = server.dispatch_user_message(Some("queued-request".into()), "queued payload".to_owned(), Default::default(), CancellationToken::new()).await.unwrap() else { panic!("queue") };
+    // HTTP acceptance reaches the client, but its stream is disconnected.
+    assert!(!feedback.complete("queued-request", true, Some(receipt.message_id)));
+    workflow.release.notify_one();
+    assert_eq!(bounded(result).await.unwrap().unwrap().text, "followup complete");
+    let snapshot = reopen_snapshot(&server).await;
+    assert_eq!(snapshot.transcript.len(), 50);
+    let message_ids: Vec<_> = snapshot.transcript.iter().filter_map(|row| row.message_id).collect();
+    assert!(!message_ids.contains(&receipt.message_id));
+    assert_eq!(snapshot.execution.last.as_ref().unwrap().run_id, "initial-run");
+    feedback.snapshot(&snapshot.execution, false, &message_ids);
+    feedback.queued(&[]);
+    assert_eq!(feedback.visible_sends().count(), 1);
+    assert_eq!(feedback.latest_receipt().unwrap().0.status(), "Отправлено");
+    eprintln!("AUDIT: completed_queued_user_is_outside_tail=true live_rows={} last_run={} stale_receipt={} status={}", snapshot.transcript.len(), snapshot.execution.last.as_ref().unwrap().run_id, feedback.visible_sends().count(), feedback.latest_receipt().unwrap().0.status());
+    // Reading older history cannot invoke Feedback::snapshot; providing its ID
+    // manually is a control showing the missing correlation is the blocker.
+    feedback.snapshot(&snapshot.execution, false, &[receipt.message_id]);
+    assert_eq!(feedback.visible_sends().count(), 0);
+    server.shutdown().await;
+}

+#[tokio::test]
+async fn audit_lifecycle_stream_reconnect_and_cold_tool_result_agree() {
+    use crate::domain::{ToolCall, ToolResult};
+    use crate::model_standard::{CanonicalMessage, ContentPart, MessageRole};
+    let (events, _) = test_event_channel(8);
+    let sink = RuntimeEventSink::default();
+    assert!(sink.0.set(events.clone()).is_ok());
+    let context = EventContext::new(events.pending_snapshot().session_id,
+        new_thread_id(), Some(new_turn_id()));
+    let mut streaming_client = events.subscribe();
+    let call = ToolCall::new("large-root-result", "read_file", serde_json::json!({"path": "synthetic"}));
+    let output = format!("{}FINAL_DIAGNOSTIC", "x".repeat(10_001));
+    let result = ToolResult::ok(call.id.clone(), output.clone());
+    for (seq, event) in [
+        Event::TurnStarted { session_id: context.session_id, thread_id: context.thread_id,
+            turn_id: context.turn_id.unwrap() },
+        Event::ToolCallRequested { call: call.clone() },
+        Event::ToolFinished { result: result.clone() },
+    ].into_iter().enumerate() {
+        sink.append(EventEnvelope::new(context.clone(), seq as u64 + 1, event)).await.unwrap();
+    }
+    let mut streaming_output = String::new();
+    while let Ok(event) = streaming_client.try_recv() {
+        if let AppServerEvent::Runtime { envelope } = event {
+            if let Event::ToolFinished { result } = envelope.event {
+                streaming_output = result.text_or_status();
+            }
+        }
+    }
+    let mut reconnecting_client = events.subscribe_session();
+    assert!(matches!(reconnecting_client.recv().await.unwrap(),
+        AppServerEvent::PendingRequestsUpdated { .. }));
+    let AppServerEvent::SessionSnapshot { snapshot } = reconnecting_client.recv().await.unwrap()
+        else { panic!("reconnect baseline") };
+    let restored = snapshot.transcript[0].tool.as_ref().unwrap().result.as_ref().unwrap();
+    let cold = crate::app_server::transcript_messages(&[
+        CanonicalMessage::new(MessageRole::Assistant, vec![ContentPart::ToolCall { call }]),
+        CanonicalMessage::new(MessageRole::Tool, vec![ContentPart::ToolResult { result }]),
+    ]);
+    let cold_output = cold[0].tool.as_ref().unwrap().result.as_ref().unwrap();
+    eprintln!("stream_bytes={}, reconnect_bytes={}, cold_bytes={}",
+        streaming_output.len(), restored.len(), cold_output.len());
+    assert_eq!(streaming_output, output);
+    assert_eq!(cold_output, &output);
+    assert_eq!(restored, &output, "reconnect snapshot loses output that stream and cold history retain");
+}

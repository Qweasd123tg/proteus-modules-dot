+#[test]
+fn audit_lifecycle_root_tool_reconnect_preserves_result_or_marks_truncation() {
+    let mut progress = TurnProgress::default();
+    let call = ToolCall::new("root-output", "read_file", json!({"path": "synthetic.txt"}));
+    let output = format!("{}FINAL_DIAGNOSTIC", "x".repeat(10_001));
+    let result = ToolResult::ok(call.id.clone(), output.clone());
+    apply(&mut progress, Event::ToolCallRequested { call });
+    apply(&mut progress, Event::ToolFinished { result });
+    let tool = progress.messages[0].tool.as_ref().unwrap();
+    let restored = tool.result.as_ref().unwrap();
+    eprintln!("source_bytes={}, reconnect_bytes={}, tail_retained={}, metadata={}",
+        output.len(), restored.len(), restored.contains("FINAL_DIAGNOSTIC"), tool.metadata);
+    assert!(restored == &output || restored.contains("truncated") || tool.metadata.get("truncated").is_some(),
+        "root live snapshot silently loses the result tail");
+}

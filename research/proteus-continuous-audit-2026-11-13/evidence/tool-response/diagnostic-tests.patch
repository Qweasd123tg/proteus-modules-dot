+#[tokio::test]
+async fn audit_lifecycle_approval_after_requester_cancel_is_not_acknowledged() {
+    let (events, _) = super::events::test_event_channel(8);
+    let pending: PendingApprovalResponders = Arc::new(Mutex::new(HashMap::new()));
+    let (responder, receiver) = oneshot::channel();
+    register_test_approval(&pending, &events, "cancel-race", responder).await;
+    let mut event_rx = events.subscribe();
+    // The runtime has already abandoned the approval before the UI answers.
+    // Current-thread Tokio makes the schedule deterministic: the spawned
+    // watcher has not polled yet, and the unlocked map does not yield.
+    drop(receiver);
+    let ack = approvals::resolve_pending_approval(
+        &pending, &events, "cancel-race", ApprovalResponse::approve(),
+    ).await;
+    let published = event_rx.try_recv().expect("resolution event");
+    tokio::task::yield_now().await;
+    eprintln!("ack={ack:?}, published={published:?}, pending={}", pending.lock().await.len());
+    assert!(ack.is_err(), "approval was acknowledged after its requester was already gone");
+}

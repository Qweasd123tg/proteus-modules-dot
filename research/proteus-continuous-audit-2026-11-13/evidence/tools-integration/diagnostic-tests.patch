+#[cfg(unix)]
+#[test]
+fn audit_find_limit_splits_a_single_legal_filename_into_unreadable_result() {
+    let dir = tempfile::tempdir().unwrap();
+    let name = "first\nsecond.txt";
+    let create = invoke(&WriteFileTool, dir.path(), json!({"path":name, "content":"payload"}));
+    assert_eq!(create["ok"], true);
+    let direct = invoke(&ReadFileTool, dir.path(), json!({"path":name}));
+    assert_eq!(direct["output"], "payload");
+    let found = invoke(&FindFilesTool, dir.path(), json!({"pattern":"**/*.txt", "max_results":1}));
+    let followup = invoke(&ReadFileTool, dir.path(), json!({"path":found["output"]}));
+    let all = invoke(&FindFilesTool, dir.path(), json!({"pattern":"**/*.txt"}));
+    println!("AUDIT find_limit={found}; followup={followup}; find_all={all}");
+    assert_eq!(found["ok"], true);
+    assert_eq!(found["output"], "first");
+    assert_eq!(followup["ok"], false);
+    assert_eq!(all["metadata"]["match_count"], 2);
+}

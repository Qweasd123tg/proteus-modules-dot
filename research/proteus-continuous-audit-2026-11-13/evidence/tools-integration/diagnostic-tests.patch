+#[test]
+fn audit_crlf_patch_is_unrepresentable_even_with_matching_crlf_patch_transport() {
+    let dir = tempfile::tempdir().unwrap();
+    for (name, original, patch_newline) in [
+        ("lf.txt", "old\nkeep\n", "\n"),
+        ("crlf_lfpatch.txt", "old\r\nkeep\r\n", "\n"),
+        ("crlf_crlfpatch.txt", "old\r\nkeep\r\n", "\r\n"),
+    ] {
+        fs::write(dir.path().join(name), original).unwrap();
+        let patch = ["*** Begin Patch".to_owned(), format!("*** Update File: {name}"),
+            "@@".to_owned(), "-old".to_owned(), "+new".to_owned(), " keep".to_owned(),
+            "*** End Patch".to_owned()].join(patch_newline);
+        let result = apply_patch(&patch, dir.path());
+        println!("AUDIT {name}: {result:?}; after={:?}", fs::read_to_string(dir.path().join(name)).unwrap());
+        if name == "lf.txt" {
+            assert!(result.is_ok());
+            assert_eq!(fs::read_to_string(dir.path().join(name)).unwrap(), "new\nkeep\n");
+        } else {
+            assert_eq!(result.unwrap_err(), "failed to match update hunk against current file content");
+            assert_eq!(fs::read_to_string(dir.path().join(name)).unwrap(), original);
+        }
+    }
+}

+#[test]
+fn audit_ranged_read_to_edit_normalizes_crlf_and_breaks_exact_multiline_edit() {
+    for newline in ["\n", "\r\n"] {
+        let dir = tempfile::tempdir().unwrap();
+        let original = format!("old{newline}keep{newline}");
+        let write = invoke(&WriteFileTool, dir.path(), json!({"path":"f", "content":original}));
+        assert_eq!(write["ok"], true);
+        let read = invoke(&ReadFileTool, dir.path(), json!({"path":"f", "start_line":1, "limit":2}));
+        assert_eq!(read["ok"], true);
+        assert_eq!(read["output"], "old\nkeep");
+        let edit = invoke(&EditFileTool, dir.path(), json!({"path":"f", "old_string":read["output"], "new_string":"new\nkeep"}));
+        println!("AUDIT newline={newline:?} read={} edit={} after={:?}", read, edit, std::fs::read_to_string(dir.path().join("f")).unwrap());
+        assert_eq!(edit["ok"], newline == "\n");
+        if newline == "\r\n" {
+            assert_eq!(std::fs::read_to_string(dir.path().join("f")).unwrap(), original);
+            // A whole-file read preserves CRLF, confirming that the fault is the
+            // range representation, not unsupported UTF-8 or file creation.
+            let full = invoke(&ReadFileTool, dir.path(), json!({"path":"f"}));
+            assert_eq!(full["output"], original);
+        }
+    }
+}

+use super::*;
+use std::{io::{Read, Write}, net::TcpListener, sync::Arc, thread};
+use futures_util::StreamExt;
+use model_pack::adapters::anthropic::AnthropicMessagesClient;
+use proteus_contracts::{contracts::Model, model_standard::{ModelFailure, ModelFailureKind, ModelStreamEvent, RequestShaper}};
+
+// One loopback-only provider fixture. It rejects histories containing OLD_MARKER,
+// so the same server proves both the failing route and a typed-error control.
+fn fixture() -> (String, Arc<Mutex<Vec<serde_json::Value>>>, thread::JoinHandle<()>) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let endpoint = format!("http://{}", listener.local_addr().unwrap());
+    let requests = Arc::new(Mutex::new(Vec::new()));
+    let captured = requests.clone();
+    let server = thread::spawn(move || {
+        for _ in 0..2 {
+            let (mut stream, _) = listener.accept().unwrap();
+            stream.set_read_timeout(Some(std::time::Duration::from_secs(10))).unwrap();
+            let mut wire = Vec::new();
+            let (end, len) = loop {
+                let mut buf = [0; 4096];
+                let n = stream.read(&mut buf).unwrap();
+                assert_ne!(n, 0);
+                wire.extend_from_slice(&buf[..n]);
+                if let Some(p) = wire.windows(4).position(|x| x == b"\r\n\r\n") {
+                    let headers = String::from_utf8_lossy(&wire[..p]).to_lowercase();
+                    let len: usize = headers.lines().find_map(|s| s.strip_prefix("content-length: ")).unwrap().parse().unwrap();
+                    break (p + 4, len);
+                }
+            };
+            while wire.len() < end + len {
+                let mut buf = [0; 4096];
+                let n = stream.read(&mut buf).unwrap();
+                assert_ne!(n, 0);
+                wire.extend_from_slice(&buf[..n]);
+            }
+            let request: serde_json::Value = serde_json::from_slice(&wire[end..end + len]).unwrap();
+            let too_long = request["messages"].to_string().contains("OLD_MARKER");
+            captured.lock().unwrap().push(request);
+            let (status, body) = if too_long {
+                ("400 Bad Request", json!({"type":"error", "error":{"type":"invalid_request_error", "message":"prompt is too long: 200001 tokens > 200000 maximum"}, "request_id":"req_local_fixture"}))
+            } else {
+                ("200 OK", json!({"id":"msg_fixture", "type":"message", "role":"assistant", "model":"claude-fixture", "content":[{"type":"text","text":"summary"}], "stop_reason":"end_turn", "usage":{"input_tokens":100,"output_tokens":3}}))
+            };
+            let body = body.to_string();
+            write!(stream, "HTTP/1.1 {status}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}", body.len()).unwrap();
+        }
+    });
+    (endpoint, requests, server)
+}
+
+struct NativeHost {
+    client: AnthropicMessagesClient,
+    runtime: tokio::runtime::Runtime,
+    typed_control: bool,
+    failures: Mutex<Vec<ModelFailure>>,
+}
+impl HookModuleHost for NativeHost {
+    fn is_cancelled(&self) -> Result<bool, ProcessModuleError> { Ok(false) }
+    fn complete_model_json(&self, input: String) -> Result<String, ProcessModuleError> {
+        let request: CanonicalModelRequest = serde_json::from_str(&input).unwrap();
+        let caps = self.client.capabilities(&request.model).unwrap();
+        let request = RequestShaper.shape(request, &caps).unwrap();
+        // Identical shaping and typed error extraction to Core model service.
+        let result = self.runtime.block_on(async {
+            match self.client.stream(request).await {
+                Err(error) => Err(ModelFailure::from_error(&error)),
+                Ok(mut events) => {
+                    while let Some(event) = events.next().await {
+                        match event {
+                            Ok(ModelStreamEvent::Response { response }) => return Ok(response),
+                            Ok(ModelStreamEvent::Error { failure }) => return Err(failure),
+                            Err(error) => return Err(ModelFailure::from_error(&error)),
+                            _ => {}
+                        }
+                    }
+                    panic!("fixture missing terminal event");
+                }
+            }
+        });
+        match result {
+            Ok(response) => Ok(serde_json::to_string(&response).unwrap()),
+            Err(mut failure) => {
+                self.failures.lock().unwrap().push(failure.clone());
+                // Diagnostic control ONLY, not a suggested blanket classifier.
+                if self.typed_control { failure.kind = ModelFailureKind::ContextWindowExceeded; }
+                Err(ProcessModuleError::from_model_failure(failure))
+            }
+        }
+    }
+}
+
+#[test]
+fn audit_anthropic_overflow_prevents_real_compactor_trimming() {
+    for (stream, typed_control) in [(false, false), (true, false), (false, true)] {
+        let (endpoint, requests, server) = fixture();
+        let mut host = NativeHost {
+            client: AnthropicMessagesClient::from_provider_config(json!({"base_url":endpoint, "api_key":"local-fixture-only", "stream":stream})).unwrap(),
+            runtime: tokio::runtime::Runtime::new().unwrap(), typed_control,
+            failures: Mutex::new(Vec::new()),
+        };
+        let input = input(vec![
+            CanonicalMessage::text(MessageRole::User, "OLD_MARKER old request"),
+            CanonicalMessage::text(MessageRole::Assistant, "old answer"),
+            CanonicalMessage::text(MessageRole::User, "current request"),
+        ], 500).with_config(json!({"trigger_tokens":100, "stream_max_retries":1}));
+        let config = crate::config::CompactorConfig::parse(&input.config).unwrap();
+        let result = compact_algorithm(input.preparation(), &config, &mut host);
+        server.join().unwrap();
+        let requests = requests.lock().unwrap();
+        assert_eq!(requests.len(), 2);
+        let failures = host.failures.lock().unwrap();
+        assert!(failures.iter().all(|f| f.kind == ModelFailureKind::Other));
+        if typed_control {
+            assert!(result.unwrap().changed);
+            assert!(requests[0]["messages"].to_string().contains("OLD_MARKER"));
+            assert!(!requests[1]["messages"].to_string().contains("OLD_MARKER"));
+        } else {
+            assert_eq!(result.unwrap_err().model_failure.unwrap().kind, ModelFailureKind::Other);
+            assert_eq!(requests[0]["messages"], requests[1]["messages"]);
+            assert_eq!(requests[0]["max_tokens"], 64000); // Reject previous budget hypothesis.
+            assert_eq!(failures[0].message.contains("prompt is too long"), !stream);
+        }
+        eprintln!("AUDIT native stream={stream} typed_control={typed_control}: requests={} history_lengths={:?} native_failures={:?}", requests.len(), requests.iter().map(|r|r["messages"].as_array().unwrap().len()).collect::<Vec<_>>(), *failures);
+    }
+}

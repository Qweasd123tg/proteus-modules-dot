+#[test]
+fn audit_no_argument_tool_stream_matches_json_response() {
+    let block = json!({"type":"tool_use","id":"call-clock","name":"clock","input":{}});
+    let events = run_trace(&[
+        ("message_start", json!({"message":{"id":"fixture","type":"message","role":"assistant","model":"fixture","content":[],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"output_tokens":0}}})),
+        ("content_block_start", json!({"index":0,"content_block":block})),
+        ("content_block_delta", json!({"index":0,"delta":{"type":"input_json_delta","partial_json":""}})),
+        ("content_block_stop", json!({"index":0})),
+        ("message_delta", json!({"delta":{"stop_reason":"tool_use"},"usage":{"output_tokens":1}})),
+        ("message_stop", json!({})),
+    ]);
+    let ModelStreamEvent::Response { response: streamed } = events.last().unwrap() else { panic!("terminal") };
+    let plain = from_anthropic_response(json!({"stop_reason":"tool_use","content":[block]})).unwrap();
+    println!("EMPTY_TOOL_STREAM_ARGS={:?}; JSON_ARGS={:?}", streamed.tool_calls[0].args, plain.tool_calls[0].args);
+    assert_eq!(streamed.tool_calls[0].args, plain.tool_calls[0].args);
+}

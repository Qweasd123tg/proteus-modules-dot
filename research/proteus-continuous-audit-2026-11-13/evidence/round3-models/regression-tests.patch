+#[test]
+fn audit_tool_result_image_reaches_anthropic_vision_request() {
+    use crate::domain::{ToolCall, ToolContent, ToolResult};
+    let data = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC";
+    let call = ToolCall::new("read-1", "read", serde_json::json!({"path":"image.png"}));
+    let result = ToolResult::ok("read-1".into(), "Read image file [image/png]").with_content(vec![
+        ToolContent::Image { mime_type:"image/png".into(), data:data.into() }
+    ]);
+    let request = CanonicalModelRequest::new(ModelRef::new("anthropic", "vision"), vec![
+        CanonicalMessage::new(MessageRole::Assistant, vec![ContentPart::ToolCall{call}]),
+        CanonicalMessage::new(MessageRole::Tool, vec![ContentPart::ToolResult{result}]),
+    ]);
+    let body = to_anthropic_request(&request).unwrap();
+    println!("ANTHROPIC_TOOL_IMAGE_BODY={body}");
+    assert!(body.to_string().contains(data), "tool result image bytes silently lost");
+}

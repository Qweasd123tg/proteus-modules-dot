+#[tokio::test]
+async fn audit_http_clients_preserve_tool_result_image_payload() {
+    use crate::domain::{ToolCall, ToolContent, ToolResult};
+    use crate::model_standard::ContentPart;
+    let image_data = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC";
+    let mut missing = Vec::new();
+    for anthropic in [false, true] {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let endpoint = format!("http://{}", listener.local_addr().unwrap());
+        let server = tokio::spawn(async move {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            let request = test_http::read(&mut socket).await;
+            let response = if anthropic {
+                json!({"type":"message","role":"assistant","content":[{"type":"text","text":"fixture response"}],"stop_reason":"end_turn"})
+            } else {
+                json!({"status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"fixture response"}]}]})
+            };
+            test_http::reply(&mut socket, 200, "application/json", &response.to_string()).await;
+            request.body
+        });
+        let config = json!({"base_url":endpoint,"api_key":"local-fixture-only","stream":false,"capabilities":{"supports_image_input":true}});
+        let client: Box<dyn Model> = if anthropic {
+            Box::new(AnthropicMessagesClient::from_provider_config(config).unwrap())
+        } else {
+            Box::new(OpenAiResponsesClient::from_provider_config(config).unwrap())
+        };
+        let request = CanonicalModelRequest::new(ModelRef::new("fixture", "vision"), vec![
+            CanonicalMessage::new(MessageRole::Assistant, vec![ContentPart::ToolCall {call:ToolCall::new("read-1", "read", json!({"path":"image.png"}))}]),
+            CanonicalMessage::new(MessageRole::Tool, vec![ContentPart::ToolResult {result:ToolResult::ok("read-1".into(), "Read image file [image/png]").with_content(vec![ToolContent::Image {mime_type:"image/png".into(), data:image_data.into()}])}]),
+        ]);
+        let capabilities = client.capabilities(&request.model).unwrap();
+        assert!(capabilities.supports_image_input);
+        let request = crate::model_standard::RequestShaper.shape(request, &capabilities).unwrap();
+        let events = tokio::time::timeout(std::time::Duration::from_secs(5), async {
+            client.stream(request).await.unwrap().collect::<Vec<_>>().await
+        }).await.unwrap();
+        assert!(matches!(events.as_slice(), [Ok(ModelStreamEvent::Response { .. })]));
+        let body = server.await.unwrap();
+        println!("HTTP_TOOL_IMAGE {}={body}", if anthropic { "Anthropic" } else { "OpenAI" });
+        if !body.contains(image_data) { missing.push(if anthropic { "Anthropic" } else { "OpenAI" }); }
+    }
+    assert!(missing.is_empty(), "tool image missing on actual HTTP wire: {missing:?}");
+}

+    let ModelStreamEvent::Response { response: streamed } = events.last().unwrap() else { panic!("terminal") };
+    let plain = from_anthropic_response(json!({"stop_reason":"end_turn","content":[{"type":"text","text":"1 + 1 = 2"}]})).unwrap();
+    println!("INITIAL_TEXT_STREAM={:?}; JSON_TEXT={:?}", streamed.messages[0].display_text(), plain.messages[0].display_text());
+    assert_eq!(streamed.messages[0].display_text(), plain.messages[0].display_text());

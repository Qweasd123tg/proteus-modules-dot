index 0000000..410bfda
--- /dev/null
+++ b/workflow/coding-workflow/src/tests/audit_request_context.rs
@@ -0,0 +1,235 @@
+use super::*;
+use proteus_contracts::{
+    contracts::*,
+    model_standard::{PartScope, RequestShaper},
+    process_module::*,
+};
+use std::{
+    io::{Read, Write},
+    net::TcpListener,
+    thread,
+};
+
+struct Registry {
+    config: Value,
+    hook: Option<HookModuleObject>,
+}
+impl ModuleRegistry for Registry {
+    fn module_config(&self) -> &Value {
+        &self.config
+    }
+    fn register_hook(&mut self, _: String, hook: HookModuleObject) -> ProcessModuleResult<()> {
+        self.hook = Some(hook);
+        Ok(())
+    }
+    fn register_model(&mut self, _: String, _: ModelModuleObject) -> ProcessModuleResult<()> {
+        unreachable!()
+    }
+    fn register_tool(&mut self, _: ToolModuleObject) -> ProcessModuleResult<()> {
+        unreachable!()
+    }
+    fn register_policy(&mut self, _: String, _: PolicyModuleObject) -> ProcessModuleResult<()> {
+        unreachable!()
+    }
+    fn register_context_provider(
+        &mut self,
+        _: String,
+        _: ContextProviderModuleObject,
+    ) -> ProcessModuleResult<()> {
+        unreachable!()
+    }
+    fn register_context(
+        &mut self,
+        _: String,
+        _: ContextBuilderModuleObject,
+    ) -> ProcessModuleResult<()> {
+        unreachable!()
+    }
+    fn register_workflow(&mut self, _: String, _: WorkflowModuleObject) -> ProcessModuleResult<()> {
+        unreachable!()
+    }
+}
+struct SummaryHost;
+impl HookModuleHost for SummaryHost {
+    fn is_cancelled(&self) -> ProcessModuleResult<bool> {
+        Ok(false)
+    }
+    fn complete_model_json(&self, request: String) -> ProcessModuleResult<String> {
+        let request: CanonicalModelRequest = serde_json::from_str(&request).unwrap();
+        assert!(!request.messages.is_empty());
+        Ok(serde_json::to_string(&CanonicalModelResponse::new(
+            CanonicalMessage::text(MessageRole::Assistant, "Previous task was interrupted."),
+            vec![],
+            FinishReason::Stop,
+        ))
+        .unwrap())
+    }
+}
+pub(super) fn compact_with_real_hook(input: &ContextPreparationInput) -> ContextPreparationOutput {
+    let mut registry = Registry {
+        config: json!({"trigger_tokens": 1}),
+        hook: None,
+    };
+    codex_context_preparation::register_modules(&mut registry).unwrap();
+    let event = HookEvent::BeforeContext {
+        input: input.clone(),
+        output: ContextPreparationOutput::unchanged(input.messages.clone()),
+        target: None,
+    };
+    let input_json = serde_json::to_string(&HookInput {
+        event: event.clone(),
+        attribution: ExecutionAttribution::detached(proteus_contracts::domain::new_execution_id()),
+        cwd: std::env::current_dir().unwrap(),
+        conversation: None,
+    })
+    .unwrap();
+    let response = registry
+        .hook
+        .unwrap()
+        .invoke_json(input_json, &mut SummaryHost)
+        .unwrap();
+    let response: HookResponse = serde_json::from_str(&response).unwrap();
+    // Use the real contract composition/validation, not only the hook response.
+    let event = apply_hook_response(&event, &response).unwrap();
+    match event {
+        HookEvent::BeforeContext { output, .. } => output,
+        _ => unreachable!(),
+    }
+}
+
+fn tool_counts(messages: &[CanonicalMessage]) -> (usize, usize) {
+    let mut calls = 0;
+    let mut results = 0;
+    for part in messages.iter().flat_map(|m| &m.parts) {
+        match &part.payload {
+            ContentPart::ToolCall { .. } => calls += 1,
+            ContentPart::ToolResult { .. } => results += 1,
+            _ => {}
+        }
+    }
+    (calls, results)
+}
+
+fn capture_anthropic_request(request: CanonicalModelRequest) -> Value {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let endpoint = format!("http://{}", listener.local_addr().unwrap());
+    let server = thread::spawn(move || {
+        let (mut stream, _) = listener.accept().unwrap();
+        stream
+            .set_read_timeout(Some(std::time::Duration::from_secs(5)))
+            .unwrap();
+        let mut raw = Vec::new();
+        let mut buf = [0u8; 4096];
+        let header_end = loop {
+            let n = stream.read(&mut buf).unwrap();
+            assert!(n > 0);
+            raw.extend_from_slice(&buf[..n]);
+            if let Some(i) = raw.windows(4).position(|b| b == b"\r\n\r\n") {
+                break i + 4;
+            }
+        };
+        let headers = String::from_utf8_lossy(&raw[..header_end]);
+        let length: usize = headers
+            .lines()
+            .find_map(|line| {
+                let (key, value) = line.split_once(':')?;
+                key.eq_ignore_ascii_case("content-length")
+                    .then(|| value.trim().parse().unwrap())
+            })
+            .unwrap();
+        while raw.len() < header_end + length {
+            let n = stream.read(&mut buf).unwrap();
+            assert!(n > 0);
+            raw.extend_from_slice(&buf[..n]);
+        }
+        let body: Value = serde_json::from_slice(&raw[header_end..header_end + length]).unwrap();
+        let response = r#"{"id":"fixture","type":"message","role":"assistant","content":[{"type":"text","text":"accepted by fixture"}],"stop_reason":"end_turn","usage":{"input_tokens":1,"output_tokens":1}}"#;
+        write!(stream, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", response.len(), response).unwrap();
+        body
+    });
+    let client = model_pack::adapters::anthropic::AnthropicMessagesClient::from_provider_config(
+        json!({"base_url":endpoint,"api_key":"fixture-not-a-secret","stream":false}),
+    )
+    .unwrap();
+    let capabilities = client.capabilities(&request.model).unwrap();
+    let request = RequestShaper.shape(request, &capabilities).unwrap();
+    tokio::runtime::Runtime::new()
+        .unwrap()
+        .block_on(client.complete(request))
+        .unwrap();
+    server.join().unwrap()
+}
+
+#[test]
+fn audit_interrupted_tool_result_survives_compaction_without_tool_call() {
+    for (compact, completed) in [(false, false), (true, false), (true, true)] {
+        let mut input = workflow_input("continue");
+        let current = input.history.pop().unwrap();
+        let call = ToolCall::new("interrupted-call", "read_file", json!({"path":"README.md"}));
+        input.history = vec![
+            CanonicalMessage::text(MessageRole::User, "Read README and explain it"),
+            CanonicalMessage::new(
+                MessageRole::Assistant,
+                vec![ContentPart::ToolCall { call: call.clone() }],
+            ),
+        ];
+        if completed {
+            input
+                .history
+                .push(crate::history::tool_result_message(ToolResult::ok(
+                    call.id.clone(),
+                    "read succeeded",
+                )));
+        } else {
+            input.runtime.interrupted_turns = vec![WorkflowHistoryInterruption {
+                turn_id: new_turn_id(),
+                after_message_id: input.history[1].id,
+            }];
+        }
+        input.history.push(current);
+        let mut host = FakeHost {
+            audit_compactor: compact,
+            ..FakeHost::default()
+        };
+        let output = CodingCodexLoopWorkflow
+            .run_json(serde_json::to_string(&input).unwrap(), &mut host)
+            .unwrap();
+        let output: WorkflowModuleOutput = serde_json::from_str(&output).unwrap();
+        let requests = host.requests.lock().unwrap();
+        assert_eq!(requests.len(), 1);
+        let canonical = &requests[0];
+        let expected = match (compact, completed) {
+            (false, false) => (1, 1),
+            (true, false) => (0, 1),
+            (true, true) => (0, 0),
+            _ => unreachable!(),
+        };
+        assert_eq!(tool_counts(&canonical.messages), expected);
+        if compact && !completed {
+            let result = canonical
+                .messages
+                .iter()
+                .find(|m| tool_counts(std::slice::from_ref(m)).1 == 1)
+                .unwrap();
+            assert_eq!(result.parts[0].scope, PartScope::Request);
+            assert_eq!(
+                output.history_replacement.as_ref().map(|m| tool_counts(m)),
+                Some((0, 0))
+            );
+            assert_eq!(tool_counts(&output.new_messages), (0, 0));
+        }
+        let wire = capture_anthropic_request(canonical.clone());
+        let blocks: Vec<_> = wire["messages"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .flat_map(|m| m["content"].as_array().unwrap())
+            .collect();
+        let calls = blocks.iter().filter(|b| b["type"] == "tool_use").count();
+        let results = blocks.iter().filter(|b| b["type"] == "tool_result").count();
+        assert_eq!((calls, results), expected);
+        eprintln!(
+            "compact={compact} completed={completed}: canonical {expected:?}; real Anthropic HTTP {calls} tool_use / {results} tool_result; wire={wire}"
+        );
+    }
+}

+#[cfg(test)]
+mod audit_query_tokenization {
+    use super::*;
+
+    #[test]
+    fn audit_exact_saved_developer_terms_do_not_recall_after_punctuation_merging() {
+        for (stored, positive_query, expected_broken_expression) in [
+            ("src/config.rs", "src config rs", "\"srcconfigrs\"*"),
+            ("Config::load", "Config load", "\"Configload\"*"),
+            ("v1.2.3", "v1 2 3", "\"v123\"*"),
+        ] {
+            let conn = Connection::open_in_memory().unwrap();
+            conn.execute_batch(SCHEMA).unwrap();
+            let conn = Mutex::new(conn);
+            let store = SqliteMemoryStore { conn };
+            store.remember(&MemoryItem::new("fact", stored, Value::Null)).unwrap();
+            let exact = store.recall(&MemoryQuery::new(stored, 10)).unwrap();
+            let words = store.recall(&MemoryQuery::new(positive_query, 10)).unwrap();
+            assert_eq!(fts_match_expression(stored), expected_broken_expression);
+            assert_eq!(exact.len(), 0);
+            assert_eq!(words.len(), 1);
+            assert_eq!(words[0].content, stored);
+            eprintln!("exact query={stored:?}, expression={expected_broken_expression:?}: {} results; separated words={positive_query:?}: {}", exact.len(), words.len());
+        }
+    }
+}

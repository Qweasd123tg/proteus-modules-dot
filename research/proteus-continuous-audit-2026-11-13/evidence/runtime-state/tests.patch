+#[tokio::test]
+async fn audit_clear_history_retains_completed_background_agent_snapshot() {
+    use crate::domain::{EventEnvelope, ToolCall, ToolResult, new_thread_id, new_turn_id};
+    let root = tempfile::tempdir().unwrap();
+    let (server, workflow) = launch(root.path(), true).await;
+    let run_server = server.clone();
+    let run = tokio::spawn(async move { run_server.send_user_message("Первый запрос".into()).await });
+    bounded(workflow.first_started.notified()).await;
+    let root_thread = reopen_snapshot(&server).await.root_thread_id.unwrap();
+    let context = EventContext::new(server.session_id(), root_thread, Some(new_turn_id()));
+    let child = new_thread_id();
+    for (index, event) in [
+        Event::ToolCallRequested {
+            call: ToolCall::new("spawn-audit", "spawn_agent", serde_json::json!({"task_name":"old-audit"})),
+        },
+        Event::SubagentStarted { role: "explore".into(), description: Some("old-audit".into()), child_thread_id: child },
+        Event::ToolFinished { result: ToolResult::ok("spawn-audit".into(), "started") },
+        Event::SubagentFinished { role: "explore".into(), status: "completed".into(), iterations: 1, child_thread_id: child },
+    ].into_iter().enumerate() {
+        let _ = server.events.send(AppServerEvent::Runtime {
+            envelope: Box::new(EventEnvelope::new(context.clone(), index as u64, event)),
+        });
+    }
+    workflow.release_first.notify_one();
+    bounded(run).await.unwrap().unwrap();
+    assert_eq!(server.runtime.history_len().await, 2);
+    assert_eq!(reopen_snapshot(&server).await.transcript.len(), 3);
+    // Invoke the actual public clear API: it durably appends Replace([]), clears
+    // canonical history, and publishes a new authoritative session snapshot.
+    server.clear_history().await.unwrap();
+    assert_eq!(server.runtime.history_len().await, 0);
+    let snapshot = reopen_snapshot(&server).await;
+    println!("AUDIT clear: canonical_messages={}, snapshot_rows={}, stale_child_status={}",
+        server.runtime.history_len().await, snapshot.transcript.len(),
+        snapshot.transcript[0].subagent.as_ref().unwrap().status);
+    assert_eq!(snapshot.transcript.len(), 1, "reproduces stale child after clear");
+    let child = snapshot.transcript[0].subagent.as_ref().unwrap();
+    assert_eq!(child.description.as_deref(), Some("old-audit"));
+    assert_eq!(child.status, "completed");
+    server.shutdown().await;
+}

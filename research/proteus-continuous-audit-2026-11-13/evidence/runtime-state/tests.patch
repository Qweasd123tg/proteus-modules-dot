+#[tokio::test]
+async fn audit_parallel_child_user_inputs_with_same_provider_call_id_replace_each_other() {
+    use crate::contracts::{RequestOrigin, UserInputQuestion, UserInputQuestionOption};
+    let (events, _) = events::test_event_channel(32);
+    let pending: user_inputs::PendingUserInputResponders = Arc::new(Mutex::new(HashMap::new()));
+    let (first_tx, first_rx) = oneshot::channel();
+    let (second_tx, second_rx) = oneshot::channel();
+    let child_one = crate::domain::new_thread_id();
+    let child_two = crate::domain::new_thread_id();
+    for (child, seq, sender) in [(child_one, 1, first_tx), (child_two, 2, second_tx)] {
+        let origin = RequestOrigin::for_turn(
+            crate::domain::new_execution_id(), child, crate::domain::new_turn_id(),
+        );
+        let request = UserInputRequest::new("call_0", "/synthetic".into(), vec![
+            UserInputQuestion::new("choice", "Choice", format!("Child {seq}?"), vec![UserInputQuestionOption::new("Yes", "Proceed")]),
+        ]).with_origin(origin).with_seq(seq);
+        user_inputs::register_pending_user_input(&pending, &events, request, sender).await;
+    }
+    let first = tokio::time::timeout(Duration::from_secs(2), first_rx).await.unwrap();
+    assert!(first.is_err(), "first child loses its responder without a user answer");
+    let projection = events.pending_snapshot();
+    assert_eq!(projection.user_inputs.len(), 1);
+    assert_eq!(projection.user_inputs[0].origin.as_ref().unwrap().thread_id, Some(child_two));
+    assert_eq!(pending.lock().await.len(), 1);
+    user_inputs::resolve_pending_user_input(&pending, &events, "call_0", UserInputResponse::empty()).await.unwrap();
+    second_rx.await.unwrap();
+    println!("AUDIT identical call_id across distinct child threads: first response channel dropped; only second remains; answer routes to second");
+}

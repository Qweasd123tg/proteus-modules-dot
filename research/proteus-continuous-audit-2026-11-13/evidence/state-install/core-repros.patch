+#[tokio::test]
+async fn audit_include_save_ack_and_next_save_disagree() {
+    let dir = tempfile::Builder::new().prefix("audit-include-roundtrip-")
+        .tempdir_in(env!("CARGO_MANIFEST_DIR")).unwrap();
+    let base = dir.path().join("base.toml");
+    let profile = dir.path().join("profile.toml");
+    let initial = crate::test_model::config();
+    tokio::fs::write(&base, toml::to_string_pretty(&initial).unwrap()).await.unwrap();
+    tokio::fs::write(&profile, "include=['base.toml']\n").await.unwrap();
+    let loaded = AppConfig::load(Some(&profile)).await.unwrap();
+    let server = AgentAppServer::launch(loaded, dir.path().into(), Some(&profile))
+        .await.unwrap();
+    let mut values = initial.module_config["model"].clone();
+    values.get_mut("fake").unwrap().as_object_mut().unwrap().remove("stream_delay_ms");
+    let request = proteus_contracts::app_protocol::http::SetConfigBuilderRequest {
+        module_config: BTreeMap::from([("model".into(), values)]),
+        ..Default::default()
+    };
+    let accepted = server.set_profile_config(request).await.unwrap();
+    assert_eq!(accepted.module_config["model"]["fake"].get("stream_delay_ms"), None);
+    let disk = AppConfig::load(Some(&profile)).await.unwrap();
+    assert_eq!(disk.module_config["model"]["fake"]["stream_delay_ms"], serde_json::json!(1));
+    let after_next_save = server.set_profile_config(
+        proteus_contracts::app_protocol::http::SetConfigBuilderRequest {
+            permission_mode: Some(PermissionMode::Plan),
+            ..Default::default()
+        }
+    ).await.unwrap();
+    assert_eq!(after_next_save.module_config["model"]["fake"]["stream_delay_ms"], serde_json::json!(1));
+    eprintln!("accepted={}; on_disk={}; after_unrelated_save={}",
+        accepted.module_config["model"]["fake"], disk.module_config["model"]["fake"],
+        after_next_save.module_config["model"]["fake"]);
+    server.shutdown().await;
+}

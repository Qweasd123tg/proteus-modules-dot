+#[tokio::test]
+async fn audit_catalog_after_history_payload_is_rejected() {
+    let path = std::env::var("AUDIT_PLUGIN_ADDONS_JSON").expect("bind actual Desktop probe output");
+    let addons: proteus_contracts::app_protocol::addons::AppAddonsUpdate =
+        serde_json::from_slice(&tokio::fs::read(path).await.unwrap()).unwrap();
+    assert_eq!(addons.addons.plugins.len(), 2);
+    let dir = tempfile::Builder::new().prefix("audit-catalog-history-")
+        .tempdir_in(env!("CARGO_MANIFEST_DIR")).unwrap();
+    let profile = dir.path().join("profile.toml");
+    let server = AgentAppServer::launch(crate::test_model::config(), dir.path().into(), Some(&profile))
+        .await.unwrap();
+    let result = server.set_profile_config(
+        proteus_contracts::app_protocol::http::SetConfigBuilderRequest {
+            addon_settings: Some(addons), ..Default::default()
+        }
+    ).await;
+    let message = format!("{:#}", result.unwrap_err());
+    eprintln!("actual Desktop post-history connect payload rejection: {message}");
+    assert!(message.contains("duplicate Agent Plugin name: demo"));
+    server.shutdown().await;
+}

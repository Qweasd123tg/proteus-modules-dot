+#[tokio::test]
+async fn audit_real_history_can_contain_none_provider() {
+    let dir = tempfile::Builder::new().prefix("audit-history-provider-")
+        .tempdir_in(env!("CARGO_MANIFEST_DIR")).unwrap();
+    let profile = dir.path().join("profile.toml");
+    let mut initial = crate::test_model::config();
+    initial.active_provider = None;
+    tokio::fs::write(&profile, toml::to_string_pretty(&initial).unwrap()).await.unwrap();
+    let server = AgentAppServer::launch(initial, dir.path().into(), Some(&profile)).await.unwrap();
+    let accepted = server.set_profile_config(
+        proteus_contracts::app_protocol::http::SetConfigBuilderRequest {
+            active_provider: Some("fake".into()),
+            ..Default::default()
+        }
+    ).await.unwrap();
+    let history = server.config_history().await.unwrap();
+    assert_eq!(accepted.active_provider.as_deref(), Some("fake"));
+    assert_eq!(history.revisions.len(), 1);
+    assert_eq!(history.revisions[0].state.active_provider, None);
+    eprintln!("current provider={:?}; replaced history provider={:?}",
+        accepted.active_provider, history.revisions[0].state.active_provider);
+    server.shutdown().await;
+}

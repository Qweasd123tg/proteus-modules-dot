+#[tokio::test]
+async fn audit_included_config_clear_does_not_survive_reload() {
+    let dir = tempfile::Builder::new().prefix("audit-included-config-")
+        .tempdir_in(env!("CARGO_MANIFEST_DIR")).unwrap();
+    let base = dir.path().join("base.toml");
+    let profile = dir.path().join("profile.toml");
+    tokio::fs::write(&base, "[module_config.tool.example]\nkept=1\nremoved=2\n").await.unwrap();
+    tokio::fs::write(&profile, "include=['base.toml']\n").await.unwrap();
+    let mut config = AppConfig::load(Some(&profile)).await.unwrap();
+    config.module_config.get_mut("tool").unwrap().get_mut("example").unwrap()
+        .as_object_mut().unwrap().remove("removed");
+    persist_config_builder(&profile, &config).await.unwrap();
+    let reloaded = AppConfig::load(Some(&profile)).await.unwrap();
+    eprintln!("intended module_config={}, reloaded module_config={}",
+        serde_json::to_string(&config.module_config).unwrap(),
+        serde_json::to_string(&reloaded.module_config).unwrap());
+    assert_eq!(reloaded.module_config["tool"]["example"]["removed"], serde_json::json!(2),
+        "current bug: removed key from include should reappear");
+    assert_ne!(config.module_config, reloaded.module_config);
+}

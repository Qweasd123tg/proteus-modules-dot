+#[tokio::test]
+async fn audit_round9_rejected_image_poisoning_persists_after_cold_resume() {
+    let workspace = tempfile::tempdir().unwrap();
+    let capture = workspace.path().join("poisoned-requests.jsonl");
+    let config = config(false, &capture);
+    let config_path = workspace.path().join("config.toml");
+    let thread = new_thread_id();
+    let runtime = AgentRuntime::builder(config.clone(), workspace.path().into())
+        .with_config_path(Some(&config_path))
+        .with_session_ids(new_session_id(), thread)
+        .build_async().await.unwrap();
+    let baseline = runtime.run("Plain text baseline".into()).await.unwrap();
+    assert_eq!(baseline.text, "Images received: 0");
+    let error = runtime.run_input(input("Describe this"), CancellationToken::new())
+        .await.unwrap_err();
+    assert!(format!("{error:#}").contains("does not support image input"));
+    let warm = runtime.run("No image this time".into()).await;
+    println!("warm text-only followup: {warm:#?}");
+    assert!(format!("{:#}", warm.unwrap_err()).contains("does not support image input"));
+    let dir = runtime.session_dir().unwrap().to_path_buf();
+    drop(runtime);
+    let resumed = AgentRuntime::builder(config, workspace.path().into())
+        .resume_from_session_dir(&dir, thread).unwrap()
+        .build_async().await.unwrap();
+    let cold = resumed.run("Still plain text after reopening".into()).await;
+    println!("cold text-only followup: {cold:#?}");
+    assert!(format!("{:#}", cold.unwrap_err()).contains("does not support image input"));
+    let requests = std::fs::read_to_string(&capture).unwrap();
+    assert_eq!(requests.lines().count(), 1, "only baseline reaches provider");
+    let records = SessionStore::open(dir).unwrap().load_records().unwrap();
+    let settlements: Vec<_> = records.iter().filter_map(|r| match &r.entry {
+        JournalEntry::TurnSettled(s) => Some(s.status), _ => None
+    }).collect();
+    println!("settlements: {settlements:?}");
+    assert_eq!(settlements, [TurnSettlementStatus::Success, TurnSettlementStatus::Error,
+        TurnSettlementStatus::Error, TurnSettlementStatus::Error]);
+    resumed.clear_history().await.unwrap();
+    assert_eq!(resumed.run("Plain text after clear".into()).await.unwrap().text, "Images received: 0");
+    assert_eq!(std::fs::read_to_string(&capture).unwrap().lines().count(), 2);
+}

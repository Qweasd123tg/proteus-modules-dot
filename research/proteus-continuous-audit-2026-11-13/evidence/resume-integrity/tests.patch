+#[tokio::test]
+async fn audit_round9_supported_session_relocation_breaks_image_context() {
+    let root = tempfile::tempdir().unwrap();
+    let source_workspace = tempfile::tempdir().unwrap();
+    let target_workspace = tempfile::tempdir().unwrap();
+    let capture = root.path().join("relocation-requests.jsonl");
+    let config = config(true, &capture);
+    let config_path = root.path().join("config.toml");
+    let thread = new_thread_id();
+    let runtime = AgentRuntime::builder(config.clone(), source_workspace.path().into())
+        .with_config_path(Some(&config_path))
+        .with_session_ids(new_session_id(), thread)
+        .build_async().await.unwrap();
+    assert_eq!(runtime.run_input(input("Image before moving"), CancellationToken::new())
+        .await.unwrap().text, "Images received: 1");
+    let image = runtime.history().await.unwrap()[0].parts.iter().find_map(|part| match &part.payload {
+        ContentPart::Image { image } => Some(image.clone()), _ => None
+    }).unwrap();
+    let source = runtime.session_dir().unwrap().to_path_buf();
+    drop(runtime);
+    let target_parent = source.parent().unwrap().parent().unwrap()
+        .join(proteus_core::core::encode_workspace_path(target_workspace.path()).unwrap());
+    std::fs::create_dir_all(&target_parent).unwrap();
+    let target = target_parent.join(source.file_name().unwrap());
+    std::fs::rename(&source, &target).unwrap();
+    let resumed = AgentRuntime::builder(config, source_workspace.path().into())
+        .resume_from_session_dir(&target, thread).unwrap()
+        .build_async().await.unwrap();
+    assert_eq!(SessionStore::open(target.clone()).unwrap().workspace_path().unwrap(),
+        target_workspace.path().canonicalize().unwrap());
+    // The image physically travelled with the canonical session and reads correctly by id.
+    assert_eq!(resumed.image_bytes(&image.id).unwrap().0, PNG);
+    assert_eq!(std::fs::read(target.join("images").join(&image.id)).unwrap(), PNG);
+    assert!(!image.path.exists());
+    let restored = resumed.history().await.unwrap()[0].parts.iter().find_map(|part| match &part.payload {
+        ContentPart::Image { image } => Some(image.clone()), _ => None
+    }).unwrap();
+    assert_eq!(restored.path, image.path, "resume retained old absolute path");
+    let result = resumed.run("Continue after supported move".into()).await;
+    println!("relocated image result: {result:#?}");
+    let error = format!("{:#}", result.unwrap_err());
+    assert!(error.contains("No such file or directory"), "{error}");
+    assert!(error.contains(&image.id), "{error}");
+    assert_eq!(std::fs::read_to_string(capture).unwrap().lines().count(), 1);
+}

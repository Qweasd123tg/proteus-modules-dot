+#[tokio::test]
+async fn audit_round9_crash_prefix_discards_durable_effect_from_next_model_context() {
+    use proteus_contracts::{contracts::CancellationToken, model_standard::ContentPart};
+    use std::{sync::Arc, time::Duration};
+    let workspace = tempfile::tempdir().unwrap();
+    let snapshot_root = tempfile::tempdir().unwrap();
+    let marker = workspace.path().join("round9-after-hook-entered");
+    let mut config = config().await;
+    config.modules.hooks = vec!["fixture".into()];
+    config.components.insert("hook-fixture".into(), serde_json::from_value(json!({
+        "command":"python3",
+        "args":[workspace_file("crates/proteus-core/tests/fixtures/process_hook.py"),"after_wait","fixture","hook-fixture",marker],
+        "exports":{"hook":{"fixture":{"timeout_ms":5000}}}
+    })).unwrap());
+    config.tools.enabled = vec!["apply_patch".into()];
+    config.runtime.workflow_timeout_ms = 10000;
+    let runtime = Arc::new(AgentRuntime::builder(config.clone(), workspace.path().into())
+        .with_config_path(Some(&workspace.path().join("config.toml")))
+        .build_async().await.unwrap());
+    let cancellation = CancellationToken::new();
+    let running = tokio::spawn({
+        let runtime = runtime.clone();
+        let cancellation = cancellation.clone();
+        async move { runtime.run_with_cancellation("apply_patch".into(), cancellation).await }
+    });
+    tokio::time::timeout(Duration::from_secs(3), async {
+        while !marker.exists() { tokio::time::sleep(Duration::from_millis(5)).await; }
+    }).await.expect("after-tool barrier");
+    assert!(workspace.path().join("smoke.txt").exists());
+    let source = runtime.session_dir().unwrap().to_path_buf();
+    let target = snapshot_root.path().join("sessions")
+        .join(source.parent().unwrap().file_name().unwrap())
+        .join(source.file_name().unwrap());
+    // A closed, complete journal prefix at the exact effect -> after-hook boundary.
+    // Copying this prefix simulates restart after loss of the process, without
+    // killing a shared test process or truncating an active source journal.
+    fn copy_tree(source: &Path, target: &Path) {
+        std::fs::create_dir_all(target).unwrap();
+        for entry in std::fs::read_dir(source).unwrap() {
+            let entry = entry.unwrap();
+            if entry.file_type().unwrap().is_dir() { copy_tree(&entry.path(), &target.join(entry.file_name())); }
+            else { std::fs::copy(entry.path(), target.join(entry.file_name())).unwrap(); }
+        }
+    }
+    copy_tree(&source, &target);
+    cancellation.cancel();
+    assert!(running.await.unwrap().is_err());
+    let settled_history = SessionStore::open(source).unwrap().load_messages().unwrap();
+    assert!(settled_history.iter().flat_map(|m| &m.parts).any(|p| matches!(&p.payload,
+        ContentPart::ToolResult { result } if result.ok && result.output == "added smoke.txt")));
+    drop(runtime);
+    let store = SessionStore::open(target.clone()).unwrap();
+    let crashed = store.load_projection().unwrap();
+    let effect = crashed.records.iter().find_map(|record| match &record.entry {
+        JournalEntry::ToolEffectRecorded(effect) => Some(effect.result.clone()), _ => None
+    }).expect("actual completed effect durably present");
+    assert!(effect.ok);
+    assert_eq!(crashed.unsettled_turns.len(), 1);
+    assert!(crashed.unresolved_tool_calls.is_empty(), "effect classified as known, not unresolved");
+    assert!(!crashed.history.iter().flat_map(|m| &m.parts).any(|p| matches!(&p.payload,
+        ContentPart::ToolResult { result } if result.call_id == effect.call_id)));
+    assert!(!crashed.records.iter().any(|r| matches!(r.entry, JournalEntry::TurnSettled(_))));
+    let resumed = proteus_core::app_server::AgentAppServer::launch_resumed(
+        config, workspace.path().into(), Some(&snapshot_root.path().join("config.toml")), target)
+        .await.unwrap();
+    let transcript = resumed.transcript().await.unwrap();
+    let row = transcript.iter().filter_map(|row| row.tool.as_ref())
+        .find(|tool| tool.call_id == effect.call_id).unwrap();
+    println!("cold transcript: status={}, result={:?}", row.status, row.result);
+    assert_eq!(row.status, "done");
+    assert_eq!(row.result.as_deref(), Some("added smoke.txt"));
+    resumed.send_user_message("continue without tools".into()).await.unwrap();
+    let next_request = store.load_records().unwrap().into_iter().rev().find_map(|record| match record.entry {
+        JournalEntry::ModelRequestRecorded(model) => Some(model.request), _ => None
+    }).unwrap();
+    let presented = next_request.messages.iter().flat_map(|m| &m.parts).find_map(|part| match &part.payload {
+        ContentPart::ToolResult { result } if result.call_id == effect.call_id => Some(result.clone()), _ => None
+    }).unwrap();
+    println!("durable effect: {effect:?}\nnext model sees: {presented:?}");
+    assert!(!presented.ok);
+    assert_eq!(presented.error.as_deref(), Some("aborted"));
+    assert!(workspace.path().join("smoke.txt").exists());
+    resumed.shutdown().await;
+}

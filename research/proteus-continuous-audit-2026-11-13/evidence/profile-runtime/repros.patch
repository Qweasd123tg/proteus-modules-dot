+use super::*;
+
+fn isolation_process_profile(log: &Path, persist_deltas: bool) -> AppConfig {
+    let mut config = crate::test_model::config();
+    config.event_log.path = log.into();
+    config.event_log.persist_deltas = persist_deltas;
+    config.components.insert(
+        "audit-flow".into(),
+        serde_json::from_value(serde_json::json!({
+            "command": crate::test_model::reference_module(),
+            "exports": {"workflow": {"coding.single_loop": {}}, "context": {"simple": {}}}
+        }))
+        .unwrap(),
+    );
+    config.modules.workflow = Some("coding.single_loop".into());
+    config.modules.context = Some("simple".into());
+    config
+}
+
+fn isolation_delta_count(path: &Path) -> usize {
+    std::fs::read_to_string(path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str::<crate::domain::EventEnvelope>(line).unwrap())
+        .filter(|envelope| crate::contracts::is_streaming_delta(&envelope.event))
+        .count()
+}
+
+#[tokio::test]
+async fn audit_isolation_hot_log_path_loses_context_telemetry_but_writer_stays_old() {
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("config.toml");
+    let old_log = root.path().join("events-a.jsonl");
+    let new_log = root.path().join("events-b.jsonl");
+    let mut config = isolation_process_profile(&old_log, true);
+    std::fs::write(&path, toml::to_string(&config).unwrap()).unwrap();
+    let server = AgentAppServer::launch(config.clone(), root.path().into(), Some(&path))
+        .await
+        .unwrap();
+    let mut events = server.subscribe();
+    server
+        .runtime
+        .run("Reply with a short greeting.".into())
+        .await
+        .unwrap();
+    let before = server.context_map_snapshot(None).await.unwrap();
+    assert!(before.latest_usage.is_some());
+    assert!(before.latest_context.is_some());
+    let old_len = std::fs::metadata(&old_log).unwrap().len();
+    config.event_log.path = new_log.clone();
+    std::fs::write(&path, toml::to_string(&config).unwrap()).unwrap();
+    next_reload(&mut events).await;
+    assert_eq!(server.config.read().await.event_log.path, new_log);
+    assert!(server.addons_snapshot().await.reload_error.is_none());
+    server
+        .runtime
+        .run("Reply with another short greeting.".into())
+        .await
+        .unwrap();
+    let after = server.context_map_snapshot(None).await.unwrap();
+    let old_after_len = std::fs::metadata(&old_log).unwrap().len();
+    assert!(old_after_len > old_len);
+    assert!(
+        !new_log.exists(),
+        "hot event sink still appends exclusively to old path"
+    );
+    assert!(after.latest_usage.is_none());
+    assert!(after.latest_context.is_none());
+    assert!(
+        after
+            .diagnostics
+            .iter()
+            .any(|s| s.contains("event log not found"))
+    );
+    eprintln!(
+        "ISOLATION path: epoch={}, old_log_bytes={old_len}->{old_after_len}, new_exists={}, usage_before={}, usage_after={}, diagnostics={:?}",
+        server.runtime.module_epoch().await.as_u64(),
+        new_log.exists(),
+        before.latest_usage.is_some(),
+        after.latest_usage.is_some(),
+        after.diagnostics
+    );
+    server.shutdown().await;
+    let cold = AgentAppServer::launch(
+        AppConfig::load(Some(&path)).await.unwrap(),
+        root.path().into(),
+        Some(&path),
+    )
+    .await
+    .unwrap();
+    cold.runtime
+        .run("Reply with a cold-start greeting.".into())
+        .await
+        .unwrap();
+    assert!(new_log.exists());
+    assert!(
+        cold.context_map_snapshot(None)
+            .await
+            .unwrap()
+            .latest_usage
+            .is_some()
+    );
+    eprintln!("ISOLATION path cold control: new_exists=true, usage=true");
+    cold.shutdown().await;
+}

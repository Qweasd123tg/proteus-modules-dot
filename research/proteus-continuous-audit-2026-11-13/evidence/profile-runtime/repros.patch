+#[tokio::test]
+async fn audit_isolation_hot_persist_deltas_setting_does_not_change_the_writer() {
+    for initial in [false, true] {
+        let root = tempfile::tempdir().unwrap();
+        let path = root.path().join("config.toml");
+        let log = root.path().join("events.jsonl");
+        let mut config = isolation_process_profile(&log, initial);
+        std::fs::write(&path, toml::to_string(&config).unwrap()).unwrap();
+        let server = AgentAppServer::launch(config.clone(), root.path().into(), Some(&path))
+            .await
+            .unwrap();
+        let mut events = server.subscribe();
+        server
+            .runtime
+            .run("Reply with a short greeting.".into())
+            .await
+            .unwrap();
+        let before = isolation_delta_count(&log);
+        assert_eq!(before > 0, initial);
+        config.event_log.persist_deltas = !initial;
+        std::fs::write(&path, toml::to_string(&config).unwrap()).unwrap();
+        next_reload(&mut events).await;
+        assert_eq!(
+            server.config.read().await.event_log.persist_deltas,
+            !initial
+        );
+        server
+            .runtime
+            .run("Reply with another short greeting.".into())
+            .await
+            .unwrap();
+        let after = isolation_delta_count(&log);
+        assert_eq!(
+            after > before,
+            initial,
+            "writer keeps launch-time filtering despite new published config"
+        );
+        eprintln!(
+            "ISOLATION deltas: launch={initial}, published={}, before={before}, after={after}",
+            !initial
+        );
+        server.shutdown().await;
+        let cold = AgentAppServer::launch(
+            AppConfig::load(Some(&path)).await.unwrap(),
+            root.path().into(),
+            Some(&path),
+        )
+        .await
+        .unwrap();
+        cold.runtime
+            .run("Reply with a cold-start greeting.".into())
+            .await
+            .unwrap();
+        let after_cold = isolation_delta_count(&log);
+        assert_eq!(after_cold > after, !initial);
+        eprintln!(
+            "ISOLATION deltas cold control: published={}, after={after}, after_cold={after_cold}",
+            !initial
+        );
+        cold.shutdown().await;
+    }
+}
+
+async fn isolation_next_question(
+    events: &mut tokio::sync::broadcast::Receiver<AppServerEvent>,
+) -> String {
+    tokio::time::timeout(Duration::from_secs(3), async {
+        loop {
+            if let AppServerEvent::UserInputRequested { request } = events.recv().await.unwrap() {
+                return request.request_id;
+            }
+        }
+    })
+    .await
+    .unwrap()
+}

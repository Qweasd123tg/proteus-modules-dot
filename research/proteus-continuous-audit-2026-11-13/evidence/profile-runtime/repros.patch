+#[tokio::test]
+async fn audit_isolation_hot_question_timeout_keeps_launch_value_for_new_requests() {
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("config.toml");
+    let mut config = isolation_process_profile(&root.path().join("events.jsonl"), false);
+    crate::test_model::add_allow_all_policy(&mut config);
+    config.tools.enabled = vec!["request_user_input".into()];
+    config.app_server.approval_timeout_ms = 50;
+    std::fs::write(&path, toml::to_string(&config).unwrap()).unwrap();
+    let server = AgentAppServer::launch(config.clone(), root.path().into(), Some(&path))
+        .await
+        .unwrap();
+    let mut events = server.subscribe();
+    config.app_server.approval_timeout_ms = 0;
+    std::fs::write(&path, toml::to_string(&config).unwrap()).unwrap();
+    next_reload(&mut events).await;
+    assert_eq!(server.config.read().await.app_server.approval_timeout_ms, 0);
+    let runtime = server.runtime.clone();
+    let running = tokio::spawn(async move { runtime.run("request_user_input".into()).await });
+    let request_id = isolation_next_question(&mut events).await;
+    let started = Instant::now();
+    tokio::time::timeout(Duration::from_secs(1), async {
+        loop {
+            if let AppServerEvent::UserInputResolved {
+                request_id: resolved,
+            } = events.recv().await.unwrap()
+                && resolved == request_id
+            {
+                break;
+            }
+        }
+    })
+    .await
+    .expect("new post-reload question incorrectly expires despite configured no-timeout");
+    assert!(!server.has_pending_user_input(&request_id).await);
+    eprintln!(
+        "ISOLATION question: launch_timeout=50, published_timeout=0, expired_after_ms={}",
+        started.elapsed().as_millis()
+    );
+    running.await.unwrap().unwrap();
+    server.shutdown().await;
+    let cold = AgentAppServer::launch(
+        AppConfig::load(Some(&path)).await.unwrap(),
+        root.path().into(),
+        Some(&path),
+    )
+    .await
+    .unwrap();
+    let mut cold_events = cold.subscribe();
+    let runtime = cold.runtime.clone();
+    let running = tokio::spawn(async move { runtime.run("request_user_input".into()).await });
+    let request_id = isolation_next_question(&mut cold_events).await;
+    tokio::time::sleep(Duration::from_millis(200)).await;
+    assert!(cold.has_pending_user_input(&request_id).await);
+    assert!(!running.is_finished());
+    cold.respond_user_input(&request_id, crate::contracts::UserInputResponse::empty())
+        .await
+        .unwrap();
+    running.await.unwrap().unwrap();
+    eprintln!(
+        "ISOLATION question cold control: timeout=0, still_pending_after_ms=200, manually_resolved=true"
+    );
+    cold.shutdown().await;
+}

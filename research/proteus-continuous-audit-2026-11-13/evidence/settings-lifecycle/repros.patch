+#[tokio::test]
+async fn audit_round10_unrelated_save_freezes_inherited_provider_models() {
+    use proteus_contracts::app_protocol::http::SetConfigBuilderRequest;
+    for directory in [false, true] {
+        let home = tempfile::tempdir().unwrap();
+        let fragment = home.path().join("provider.toml");
+        let mut original = crate::test_model::config();
+        original.providers.get_mut("fake").unwrap().model = "inherited-v1".into();
+        std::fs::write(&fragment, toml::to_string_pretty(&original).unwrap()).unwrap();
+        let path = if directory {
+            home.path().to_path_buf()
+        } else {
+            let path = home.path().join("profile.toml");
+            std::fs::write(&path, "include = ['provider.toml']\n").unwrap();
+            path
+        };
+        let loaded = AppConfig::load(Some(&path)).await.unwrap();
+        let server = AgentAppServer::launch(loaded, home.path().into(), Some(&path))
+            .await
+            .unwrap();
+        server
+            .set_profile_config(SetConfigBuilderRequest {
+                permission_mode: Some(PermissionMode::Plan),
+                ..Default::default()
+            })
+            .await
+            .unwrap();
+        let target = config_builder_target_path(Some(&path)).unwrap();
+        let saved: toml::Value =
+            toml::from_str(&std::fs::read_to_string(&target).unwrap()).unwrap();
+        assert_eq!(
+            saved["providers"]["fake"]["model"].as_str(),
+            Some("inherited-v1")
+        );
+        original.providers.get_mut("fake").unwrap().model = "inherited-v2".into();
+        std::fs::write(&fragment, toml::to_string_pretty(&original).unwrap()).unwrap();
+        let control = AppConfig::load(Some(&fragment)).await.unwrap();
+        let after = AppConfig::load(Some(&path)).await.unwrap();
+        assert_eq!(control.providers["fake"].model, "inherited-v2");
+        assert_eq!(after.providers["fake"].model, "inherited-v1");
+        server.reload_tools().await.unwrap();
+        assert_eq!(
+            server.runtime.model_ref().await.unwrap().model,
+            "inherited-v1"
+        );
+        println!(
+            "round10 directory={directory}: fragment={}, merged={}, runtime={}, saved_providers=true",
+            control.providers["fake"].model,
+            after.providers["fake"].model,
+            server.runtime.model_ref().await.unwrap().model
+        );
+        server.shutdown().await;
+    }
+}

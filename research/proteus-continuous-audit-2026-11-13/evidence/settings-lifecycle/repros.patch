+#[tokio::test]
+async fn audit_round10_route_setting_save_preserves_live_choice_but_drops_it_on_resume() {
+    use proteus_contracts::app_protocol::http::SetConfigBuilderRequest;
+    for change in ["mode", "module_config", "component_package"] {
+        let home = tempfile::tempdir().unwrap();
+        let path = home.path().join("profile.toml");
+        let mut original = crate::test_model::config();
+        original.providers.get_mut("fake").unwrap().model = "profile-baseline".into();
+        std::fs::write(&path, toml::to_string_pretty(&original).unwrap()).unwrap();
+        let server = AgentAppServer::launch(original.clone(), home.path().into(), Some(&path))
+            .await
+            .unwrap();
+        server.set_model_name("user-selected".into()).await.unwrap();
+        let session = server.session_dir_path().unwrap();
+        let mut request = SetConfigBuilderRequest::default();
+        if change == "module_config" {
+            request.module_config = original.module_config.clone();
+            request
+                .module_config
+                .get_mut("model")
+                .unwrap()
+                .get_mut("fake")
+                .unwrap()["stream_delay_ms"] = serde_json::json!(2);
+        } else if change == "component_package" {
+            use proteus_contracts::app_protocol::http::{
+                ComponentPackageInstall, ComponentReplacement,
+            };
+            let old = crate::test_model::reference_module();
+            let package_dir = home.path().join("installed-v2");
+            std::fs::create_dir(&package_dir).unwrap();
+            let new = package_dir.join(old.file_name().unwrap());
+            std::fs::copy(&old, &new).unwrap();
+            request.component_packages = vec![ComponentPackageInstall {
+                id: "model-package".into(),
+                command: vec![new.to_str().unwrap().into()],
+                exports: BTreeMap::from([("model".into(), vec!["fake".into()])]),
+                replace: vec![ComponentReplacement {
+                    id: "test-model".into(),
+                    command: old.to_str().unwrap().into(),
+                    expected_executable: Some(old),
+                }],
+            }];
+        } else {
+            request.permission_mode = Some(PermissionMode::Plan);
+        }
+        server.set_profile_config(request).await.unwrap();
+        let live = server.runtime.model_ref().await.unwrap().model;
+        assert_eq!(live, "user-selected");
+        server.shutdown().await;
+        drop(server);
+        let reloaded = AppConfig::load(Some(&path)).await.unwrap();
+        let resumed =
+            AgentAppServer::launch_resumed(reloaded, home.path().into(), Some(&path), session)
+                .await
+                .unwrap();
+        let cold = resumed.runtime.model_ref().await.unwrap().model;
+        assert_eq!(
+            cold,
+            if change != "mode" {
+                "profile-baseline"
+            } else {
+                "user-selected"
+            }
+        );
+        println!("round10 change={change}: after_save={live}, after_resume={cold}");
+        resumed.shutdown().await;
+    }
+}

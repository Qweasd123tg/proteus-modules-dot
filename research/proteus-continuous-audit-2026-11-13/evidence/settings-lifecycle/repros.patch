+#[cfg(unix)]
+#[tokio::test]
+async fn audit_round10_symlink_profiles_with_equal_target_basename_share_history() {
+    use proteus_contracts::app_protocol::http::SetConfigBuilderRequest;
+    let home = tempfile::tempdir().unwrap();
+    let store = home.path().join("app");
+    let configs = store.join("configs");
+    std::fs::create_dir_all(&configs).unwrap();
+    let mut handles = Vec::new();
+    let mut history_dirs = Vec::new();
+    for (name, source_mode, target_mode) in [
+        ("work", PermissionMode::Normal, PermissionMode::Plan),
+        ("personal", PermissionMode::Auto, PermissionMode::Normal),
+    ] {
+        let repository = home.path().join(name);
+        std::fs::create_dir(&repository).unwrap();
+        let source = repository.join("config.toml");
+        let alias = configs.join(format!("{name}.toml"));
+        let mut config = crate::test_model::config();
+        config.profile.name = name.into();
+        config.permissions.mode = source_mode;
+        config.providers.get_mut("fake").unwrap().model = name.into();
+        config
+            .module_config
+            .get_mut("model")
+            .unwrap()
+            .get_mut("fake")
+            .unwrap()["stream_delay_ms"] = serde_json::json!(if name == "work" { 1 } else { 2 });
+        std::fs::write(&source, toml::to_string_pretty(&config).unwrap()).unwrap();
+        std::os::unix::fs::symlink(&source, &alias).unwrap();
+        let server = AgentAppServer::launch(
+            AppConfig::load(Some(&alias)).await.unwrap(),
+            repository.clone(),
+            Some(&alias),
+        )
+        .await
+        .unwrap();
+        server
+            .set_profile_config(SetConfigBuilderRequest {
+                permission_mode: Some(target_mode),
+                ..Default::default()
+            })
+            .await
+            .unwrap();
+        history_dirs.push(super::super::config_history::config_history_dir(&alias));
+        handles.push(server);
+    }
+    assert_eq!(history_dirs[0], history_dirs[1]);
+    let work = handles[0].config_history().await.unwrap();
+    let personal = handles[1].config_history().await.unwrap();
+    assert_eq!(work.revisions.len(), 2);
+    assert_eq!(personal.revisions.len(), 2);
+    assert_eq!(work.revisions[0].id, personal.revisions[0].id);
+    assert_eq!(work.revisions[0].state.permission_mode, "auto");
+    assert_eq!(
+        work.revisions[0].state.module_config["model"]["fake"]["stream_delay_ms"],
+        serde_json::json!(2)
+    );
+    println!(
+        "round10 symlink collision: two profiles, history_dirs_equal=true, work.revisions={}, personal.revisions={}, work.latest.mode={}, work.latest.stream_delay_ms={}",
+        work.revisions.len(),
+        personal.revisions.len(),
+        work.revisions[0].state.permission_mode,
+        work.revisions[0].state.module_config["model"]["fake"]["stream_delay_ms"]
+    );
+    for handle in handles {
+        handle.shutdown().await;
+    }
+}

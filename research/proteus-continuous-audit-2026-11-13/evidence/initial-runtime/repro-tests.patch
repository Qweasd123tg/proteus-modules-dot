+struct AuditSettlementBarrier {
+    entered: Arc<tokio::sync::Notify>,
+    release: Arc<tokio::sync::Notify>,
+}
+#[async_trait]
+impl crate::contracts::HookHandler for AuditSettlementBarrier {
+    async fn invoke(
+        &self,
+        input: crate::contracts::HookInput,
+        _host: Arc<dyn crate::contracts::HookHost>,
+    ) -> Result<crate::contracts::HookResponse> {
+        if let crate::contracts::HookEvent::TurnSettled { status, .. } = input.event {
+            assert_eq!(status, crate::contracts::HookTurnStatus::Success);
+            self.entered.notify_one();
+            self.release.notified().await;
+        }
+        Ok(crate::contracts::HookResponse::Continue)
+    }
+}
+
+#[tokio::test]
+async fn audit_cancel_during_settled_hook_returns_error_but_persists_success() {
+    let cwd = tempfile::tempdir().unwrap();
+    let runtime = Arc::new(
+        AgentRuntime::builder(AppConfig::default(), cwd.path().into())
+            .with_config_path(Some(&cwd.path().join("config.toml")))
+            .with_module_catalog(test_catalog())
+            .build()
+            .unwrap(),
+    );
+    replace_workflow_for_test(&runtime, Arc::new(DelayedWorkflow)).await;
+    let entered = Arc::new(tokio::sync::Notify::new());
+    let release = Arc::new(tokio::sync::Notify::new());
+    runtime
+        .services
+        .execution_state
+        .write()
+        .await
+        .runtime
+        .registry
+        .hooks = vec![(
+        "review.settlement_barrier".into(),
+        Arc::new(AuditSettlementBarrier {
+            entered: entered.clone(),
+            release: release.clone(),
+        }),
+    )];
+    let cancellation = crate::contracts::CancellationToken::new();
+    let task = tokio::spawn({
+        let runtime = runtime.clone();
+        let cancellation = cancellation.clone();
+        async move {
+            runtime
+                .run_with_cancellation("complete then cancel in cleanup".into(), cancellation)
+                .await
+        }
+    });
+    tokio::time::timeout(Duration::from_secs(5), entered.notified())
+        .await
+        .unwrap();
+    cancellation.cancel();
+    release.notify_one();
+    let result = tokio::time::timeout(Duration::from_secs(5), task)
+        .await
+        .unwrap()
+        .unwrap();
+    let error = result.expect_err("late cancel turns successful root result into an error");
+    let projection = runtime
+        .session
+        .session_store
+        .as_ref()
+        .unwrap()
+        .load_projection()
+        .unwrap();
+    let settlement = projection
+        .records
+        .iter()
+        .rev()
+        .find_map(|r| match &r.entry {
+            crate::core::JournalEntry::TurnSettled(s) => Some(s),
+            _ => None,
+        })
+        .unwrap();
+    eprintln!(
+        "returned error={error:#}, persisted status={:?}, output={:?}",
+        settlement.status, settlement.output
+    );
+    assert_eq!(
+        settlement.status,
+        crate::core::TurnSettlementStatus::Success
+    );
+    assert!(settlement.output.is_some());
+}

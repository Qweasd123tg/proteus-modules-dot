+/// Review reproduction: callback was emitted before cancel, but the broker's
+/// control-first tick processes Cancel before its already buffered input frame.
+#[tokio::test]
+async fn audit_inflight_callback_cancel_resets_unrelated_sibling() -> Result<()> {
+    let mut state = state(fixture())?;
+    state.options.max_active_roots = 2;
+    let (mut start, ack, parent_result) = request(&state, json!({"op": "callback"}), None);
+    start.executor = Some(tokio::runtime::Handle::current());
+    state.accept_start(start);
+    let parent = ack.recv_timeout(WAIT)??;
+    // Receive a real callback from the cooperative worker and retain it exactly
+    // as the transport's receive queue can while a control command arrives.
+    let callback = receive(&mut state)?;
+    ensure!(callback["method"] == "host.context.build");
+    ensure!(callback["params"]["invocation_id"].as_str() == Some(parent.invocation.id()));
+    let (sibling, sibling_result) = admit(
+        &mut state,
+        json!({"op":"wait_cancel", "notify_started":true}),
+        None,
+    )?;
+    let started = receive(&mut state)?;
+    ensure!(started["params"]["invocation_id"].as_str() == Some(sibling.invocation.id()));
+    state.handle_frame(started);
+    state.cancel(
+        parent.invocation.id(),
+        parent.invocation.generation,
+        CancelCause::User,
+    )?;
+    ensure!(state.generation == 1 && state.worker.is_some());
+    state.handle_frame(callback);
+    eprintln!(
+        "observed generation={}, failure={:?}, reason={:?}",
+        state.generation, state.last_failure, state.last_failure_reason
+    );
+    terminal(&parent_result, InvocationTerminal::Canceled)?;
+    terminal(
+        &sibling_result,
+        InvocationTerminal::ComponentLost(ComponentFailure::Protocol),
+    )?;
+    ensure!(state.generation == 2);
+    ensure!(
+        state
+            .last_failure_reason
+            .as_ref()
+            .unwrap()
+            .contains("arrived after parent")
+    );
+    assert_clean(&state)?;
+    Ok(())
+}

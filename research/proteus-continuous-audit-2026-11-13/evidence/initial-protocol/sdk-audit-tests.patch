+// Audit-only regressions, 2026-11-12; no production change.
+#[test]
+fn audit_rehost_error_must_not_reuse_tree_from_old_session() {
+    #[derive(Default)]
+    struct FailsInSecondSession;
+    impl Extension for FailsInSecondSession {
+        fn render(&mut self, host: &mut Host, view: &str, _: Surface, _: Option<&str>) -> Result {
+            if host.session.as_deref() == Some("/two") {
+                bail!("synthetic destination unavailable");
+            }
+            host.show(view, ui::text("OLD_SESSION_PRIVATE_CONTENT"));
+            Ok(())
+        }
+    }
+    let mut host = Host::default();
+    let mut extension = FailsInSecondSession;
+    host.handle(&mut extension, json!({"type":"context","context":"a","workspace":"/one","session_dir":"/one"})).unwrap();
+    host.handle(&mut extension, json!({"type":"render","context":"a","surface":"panel","view":"panel","session_dir":"/one"})).unwrap();
+    host.handle(&mut extension, json!({"type":"context","context":"b","workspace":"/two","session_dir":"/two"})).unwrap();
+    host.handle(&mut extension, json!({"type":"rehost","view":"panel","context":"b"})).unwrap();
+    let reply = host.sent.borrow().last().unwrap().clone();
+    eprintln!("rehost reply = {reply}");
+    assert_eq!(reply["session_dir"], "/two");
+    assert!(!reply.to_string().contains("OLD_SESSION_PRIVATE_CONTENT"), "old session tree must be invalidated before rendering a different session");
+}

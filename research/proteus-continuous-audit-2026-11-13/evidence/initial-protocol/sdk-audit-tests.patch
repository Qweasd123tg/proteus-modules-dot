+#[test]
+fn audit_setting_ack_after_source_switch_updates_live_original_session() {
+    let mut host = Host::default();
+    let mut extension = Ordered::default();
+    host.features.insert("session.settings.v1".into());
+    let original = json!({"session_settings":[{"id":"mode","control":{"type":"select","value":"plan","options":[]}}]});
+    let changed = json!({"session_settings":[{"id":"mode","control":{"type":"select","value":"auto","options":[]}}]});
+    host.handle(&mut extension, json!({"type":"context","context":"source","workspace":"/one","session_dir":"/one"})).unwrap();
+    host.handle(&mut extension, json!({"type":"session_snapshot","context":"source","session_dir":"/one","state":{"config":original},"entries":[]})).unwrap();
+    host.handle(&mut extension, json!({"type":"context","context":"sibling","workspace":"/one","session_dir":"/one"})).unwrap();
+    host.activate_context("source");
+    host.set_session("mode", json!("auto")).unwrap();
+    let id = host.pending[0].0.clone();
+    host.handle(&mut extension, json!({"type":"context","context":"source","workspace":"/two","session_dir":"/two"})).unwrap();
+    host.handle(&mut extension, json!({"type":"command_result","context":"source","id":id,"session_dir":"/one","config":changed,"error":null})).unwrap();
+    host.activate_context("sibling");
+    assert!(host.pending.is_empty());
+    eprintln!("sibling setting after successful ACK = {:?}", host.setting_value("mode"));
+    assert_eq!(host.setting_value("mode"), Some(json!("auto")), "successful ACK must update the live sibling session, not merely clear its optimistic pending value");
+}

+#[test]
+fn audit_local_coreless_extension_poll_is_not_preview() {
+    #[derive(Default)]
+    struct Ticker;
+    impl Extension for Ticker {
+        fn poll(&self) -> Option<Duration> { Some(Duration::from_millis(10)) }
+        fn render(&mut self, _: &mut Host, _: &str, _: Surface, _: Option<&str>) -> Result { Ok(()) }
+    }
+    let mut host = Host::default();
+    let mut extension = Ticker;
+    host.handle(&mut extension, json!({"type":"hello","protocol":4,"features":[],"workspace":"/project","server":{"origin":"","token":""}})).unwrap();
+    host.handle(&mut extension, json!({"type":"context","context":"workspace","workspace":"/project","session_dir":null})).unwrap();
+    host.handle(&mut extension, json!({"type":"render","context":"workspace","view":"panel","surface":"panel","session_dir":null})).unwrap();
+    assert_eq!(host.poll(&extension), Some(Duration::from_millis(10)), "a production core:false panel must not be treated as an isolated Preview");
+}

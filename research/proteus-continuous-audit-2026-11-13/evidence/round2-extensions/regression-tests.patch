+#[test]
+fn line_audit_deep_folded_row_can_open_its_leaf() {
+    for levels in [31, 32, 33] {
+        let mut folders = HashMap::new();
+        let mut current = String::new();
+        for _ in 0..levels {
+            let next = paths::join(&current, "d").unwrap();
+            folders.insert(current.clone(), Listing { entries: vec![Entry {
+                name: "d".into(), path: next.clone(), kind: Kind::Directory,
+            }], truncated: false });
+            current = next;
+        }
+        let leaf = paths::join(&current, "leaf.txt").unwrap();
+        folders.insert(current, Listing { entries: vec![Entry {
+            name: "leaf.txt".into(), path: leaf.clone(), kind: Kind::File,
+        }], truncated: false });
+        let mut project = Project::default();
+        let mut load = loader(&folders);
+        let folded = project.lines("root", &mut load).unwrap()[1].path.clone();
+        for _ in 0..3 { project.expand(&folded, &mut load); }
+        let lines = project.lines("root", &mut load).unwrap();
+        eprintln!("levels={levels} shown={:?}", shown(&lines));
+        assert!(lines.iter().any(|line| line.path == leaf), "folded row must be openable at {levels} levels");
+    }
+}

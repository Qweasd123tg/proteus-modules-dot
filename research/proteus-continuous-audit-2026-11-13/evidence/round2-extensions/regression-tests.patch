+#[cfg(test)]
+mod line_audit_tests {
+    use super::*;
+
+    #[test]
+    fn changed_closing_line_must_invalidate_cached_fence() {
+        let languages = vec!["mermaid".to_string()];
+        let mut warm = Document::default();
+        warm.render("```mermaid\nA-->B\n```\n", &languages).unwrap();
+        let edited = "```mermaid\nA-->B\n``` no longer a closing fence\n";
+        let warm = warm.render(edited, &languages).unwrap();
+        let cold = Document::default().render(edited, &languages).unwrap();
+        eprintln!("warm={warm}\ncold={cold}");
+        assert_eq!(warm, cold, "same current source must render identically warm/cold");
+    }
+
+    #[test]
+    fn footnote_definition_must_survive_separating_code_fence() {
+        let source = "Read this note[^n].\n\n```rust\nlet x = 1;\n```\n\n[^n]: Important footnote text.\n";
+        let output = Document::default().render(source, &[]).unwrap();
+        let html = output["children"].as_array().unwrap().iter()
+            .filter_map(|child| child["html"].as_str()).collect::<Vec<_>>().join("\n");
+        eprintln!("rendered={output}");
+        assert!(html.contains("Important footnote text"), "the canonical footnote content was lost");
+        assert!(html.contains("data-footnote-ref"), "footnote reference must resolve across code segments");
+    }
+}

+#[test]
+fn review_concurrent_edits_lose_successful_update() {
+    use std::sync::{Arc, Barrier};
+    let dir = tempfile::tempdir().unwrap();
+    let target = dir.path().join("shared.txt");
+    let input = format!("OLD_A\n{}\nOLD_B\n", "x".repeat(1024*1024));
+    let mut reproduced = false;
+    for attempt in 0..20 {
+        std::fs::write(&target, &input).unwrap();
+        let gate = Arc::new(Barrier::new(3));
+        let mut workers = Vec::new();
+        for (old,new) in [("OLD_A","NEW_A"),("OLD_B","NEW_B")] {
+            let gate = gate.clone(); let cwd = dir.path().to_path_buf();
+            workers.push(std::thread::spawn(move || {
+                gate.wait();
+                invoke(&EditFileTool, &cwd, json!({"path":"shared.txt","old_string":old,"new_string":new}))
+            }));
+        }
+        gate.wait();
+        let results = workers.into_iter().map(|w|w.join().unwrap()).collect::<Vec<_>>();
+        assert!(results.iter().all(|r|r["ok"] == true), "{results:?}");
+        let content = std::fs::read_to_string(&target).unwrap();
+        let a = content.contains("NEW_A"); let b = content.contains("NEW_B");
+        if !(a && b) {
+            eprintln!("attempt={attempt}; both tool calls ok=true; NEW_A={a}, NEW_B={b}");
+            reproduced = true; break;
+        }
+    }
+    assert!(reproduced, "candidate not reproduced in 20 attempts");
+}

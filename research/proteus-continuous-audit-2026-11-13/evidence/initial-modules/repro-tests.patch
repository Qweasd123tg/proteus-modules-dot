+#[test]
+fn review_utf8_split_across_polls_is_corrupted() {
+    let dir = tempfile::tempdir().unwrap();
+    let context = invocation_context(dir.path());
+    let first = exec_command_with_context(&context, json!({
+        "cmd": "printf '\\360\\237'; sleep 0.8; printf '\\230\\200'",
+        "yield_time_ms":250
+    }));
+    let id = first["metadata"]["session_id"].as_i64().unwrap();
+    let second = write_stdin(&context, json!({"session_id":id,"yield_time_ms":1000}));
+    eprintln!("first={first}\nsecond={second}");
+    assert!(first["output"].as_str().unwrap().contains('\u{fffd}'));
+    assert!(second["output"].as_str().unwrap().contains('\u{fffd}'));
+    assert!(!first["output"].as_str().unwrap().contains('😀'));
+    assert!(!second["output"].as_str().unwrap().contains('😀'));
+}

+#[test]
+fn review_read_many_silently_accepts_invalid_utf8_suffix() {
+    let dir = tempfile::tempdir().unwrap();
+    std::fs::write(dir.path().join("broken.txt"), b"valid\xc3").unwrap();
+    let result = invoke(&ReadManyFilesTool, dir.path(), json!({"paths":["broken.txt"]}));
+    eprintln!("{result}");
+    assert_eq!(result["ok"], true);
+    assert_eq!(result["metadata"]["files"][0]["truncated"], false);
+    assert_eq!(result["output"], "== broken.txt ==\nvalid");
+}

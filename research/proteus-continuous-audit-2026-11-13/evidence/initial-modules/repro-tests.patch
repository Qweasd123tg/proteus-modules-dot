+// Review-only reproducer; production sources unchanged.
+#[test]
+fn review_large_pty_input_does_not_observe_cancellation() {
+    let dir = tempfile::tempdir().unwrap();
+    let context = invocation_context(dir.path());
+    let started = exec_command_with_context(&context, json!({
+        "cmd": "stty raw -echo; printf READY; exec sleep 10",
+        "tty": true, "yield_time_ms": 250,
+    }));
+    assert!(started["output"].as_str().unwrap().contains("READY"), "{started}");
+    let id = started["metadata"]["session_id"].as_i64().unwrap();
+    let session = owned_session(id, &context).unwrap();
+    let canceled = Arc::new(AtomicBool::new(false));
+    let canceled_task = canceled.clone();
+    let call = json!({"id":"review","name":"write_stdin","args":{
+        "session_id":id,"chars":"x".repeat(64*1024),"yield_time_ms":250}});
+    let context = serde_json::to_string(&context).unwrap();
+    let (send,recv) = std::sync::mpsc::channel();
+    let worker = std::thread::spawn(move || {
+        let result = with_host(canceled_task, |host| write_stdin_impl(&call.to_string(), &context, None, host));
+        send.send(result.map_err(|e| e.to_string())).unwrap();
+    });
+    std::thread::sleep(Duration::from_millis(200));
+    canceled.store(true, AtomicOrdering::SeqCst);
+    let result = recv.recv_timeout(Duration::from_millis(500));
+    let blocked_after_cancel = result.is_err();
+    // Cleanup is independent of the blocked writer and the tool cancellation.
+    session.kill();
+    let after_kill = if blocked_after_cancel { recv.recv_timeout(Duration::from_secs(1)) } else { result };
+    let blocked_after_kill = after_kill.is_err();
+    let leader_exited = lock(&session.output).exited;
+    lock(sessions()).remove(&id);
+    // If blocked, dropping JoinHandle detaches only within this short-lived
+    // isolated test executable; the killed child is already reaped by owner.
+    if !blocked_after_kill { worker.join().unwrap(); } else { drop(worker); }
+    eprintln!("input_bytes=65536; blocked_500ms_after_cancel={blocked_after_cancel}; blocked_1s_after_kill={blocked_after_kill}; leader_exited={leader_exited}");
+    assert!(blocked_after_cancel, "candidate not reproduced");
+
+}

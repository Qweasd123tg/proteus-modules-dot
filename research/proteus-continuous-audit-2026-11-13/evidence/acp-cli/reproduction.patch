+#[tokio::test]
+async fn repro_chain_acp_editor_mcp_survives_unchanged_profile() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("config.toml");
+    let mut config = crate::test_model::config();
+    config.tools.enabled.clear();
+    config.event_log.path = dir.path().join("events.jsonl");
+    std::fs::write(&path, toml::to_string(&config).unwrap()).unwrap();
+    let original = std::fs::read(&path).unwrap();
+    let state = State {
+        config: AppConfig::load(Some(&path)).await.unwrap(),
+        config_path: Some(path.clone()),
+        initialized: Mutex::new(true),
+        sessions: Mutex::new(HashMap::new()),
+    };
+    let request = serde_json::from_value(serde_json::json!({
+        "cwd": dir.path(),
+        "mcpServers": [{
+            "name": "editor",
+            "command": "/usr/bin/python3",
+            "args": [PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("tests/mcp_client/server.py")],
+            "env": [
+                {"name": "MCP_FIXTURE_EVENT_LOG", "value": dir.path().join("mcp-events.log").to_str().unwrap()},
+                {"name": "MCP_FIXTURE_GENERATION_FILE", "value": dir.path().join("generations.log").to_str().unwrap()}
+            ]
+        }]
+    })).unwrap();
+    let response = state.new_session(request).await.unwrap();
+    let server = state.sessions.lock().await.get(&response.session_id).unwrap().server.clone();
+    let before = server.addons_snapshot().await;
+    let initial_epoch = server.runtime.module_epoch().await;
+    eprintln!("ACP immediately after session/new: {:?}", before.mcp_servers);
+    assert_eq!(before.mcp_servers.len(), 1, "MCP fixture was discovered at session creation");
+    assert!(before.mcp_servers[0].error.is_none());
+    assert!(before.mcp_servers[0].tools.contains(&"editor__echo".into()));
+    tokio::time::sleep(std::time::Duration::from_millis(900)).await;
+    let after = server.addons_snapshot().await;
+    let after_epoch = server.runtime.module_epoch().await;
+    eprintln!("ACP after idle: {:?}; epoch {initial_epoch:?} -> {after_epoch:?}; reload_error={:?}", after.mcp_servers, after.reload_error);
+    assert_eq!(std::fs::read(&path).unwrap(), original, "profile was never modified");
+    state.shutdown().await;
+    assert_eq!(after.mcp_servers.len(), 1, "unchanged disk profile must not discard session/new editor MCP servers");
+}

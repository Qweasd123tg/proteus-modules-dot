+#[tokio::test]
+async fn repro_chain_cli_initial_mode_survives_unchanged_profile() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("config.toml");
+    let mut config = crate::test_model::config();
+    config.permissions.mode = crate::domain::PermissionMode::Normal;
+    config.event_log.path = dir.path().join("events.jsonl");
+    std::fs::write(&path, toml::to_string(&config).unwrap()).unwrap();
+    let mut launch_config = AppConfig::load(Some(&path)).await.unwrap();
+    // run_cli resolves --plan / --permission-mode into config before launching stdio/ACP.
+    launch_config.permissions.mode = crate::domain::PermissionMode::Plan;
+    let server = AgentAppServer::launch(launch_config, dir.path().to_path_buf(), Some(&path)).await.unwrap();
+    let before = server.permission_mode().await;
+    assert_eq!(before, crate::domain::PermissionMode::Plan);
+    tokio::time::sleep(std::time::Duration::from_millis(900)).await;
+    let after = server.permission_mode().await;
+    eprintln!("CLI initial override mode {before:?} -> {after:?}; unchanged profile default Normal");
+    server.shutdown().await;
+    assert_eq!(after, crate::domain::PermissionMode::Plan, "CLI-selected launch mode must survive idle profile scans");
+}

+
+    #[tokio::test]
+    async fn repro_chain_expired_control_response_does_not_poison_next_request() {
+        // Real approval-timeout E2E leaves a control response pending after the
+        // original command's terminal response has already returned to the REPL.
+        let mut child = Command::new("python3")
+            .args(["-c", r#"
+import json, sys
+for index, line in enumerate(sys.stdin):
+    request = json.loads(line)
+    if index == 0:
+        print(json.dumps({"type":"response", "id":"late-approval", "ok":False,
+            "output":None, "error":"unknown approval id: expired"}), flush=True)
+    print(json.dumps({"type":"response", "id":request["id"], "ok":True,
+        "output":{"permission_mode":"Normal"}, "error":None}), flush=True)
+"#])
+            .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::null())
+            .kill_on_drop(true).spawn().unwrap();
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap()).lines();
+        let mut client = CliAppClient {
+            child, stdin, stdout, interactive_terminal: false, next_id: 1,
+            pending_control_responses: HashSet::from(["late-approval".into()]),
+        };
+        let first = client.config_summary().await;
+        let second = client.config_summary().await;
+        eprintln!("valid config requests after stale control reply: first={first:?}; second={second:?}");
+        client.child.start_kill().unwrap();
+        client.child.wait().await.unwrap();
+        assert!(first.is_ok() && second.is_ok(), "a failed ancillary approval response must not steal the current command's response or desynchronize every subsequent request");
+    }
 }

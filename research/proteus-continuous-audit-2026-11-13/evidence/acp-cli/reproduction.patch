+#[tokio::test]
+async fn repro_chain_reload_preserves_command_catalog_after_conflicting_profile() {
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("config.toml");
+    let mut config = crate::test_model::config();
+    config.event_log.path = root.path().join("events.jsonl");
+    std::fs::write(&path, toml::to_string(&config).unwrap()).unwrap();
+    let server = AgentAppServer::launch(config.clone(), root.path().into(), Some(&path)).await.unwrap();
+    assert!(server.execute_command(None, "/history").await.is_ok());
+    // Allow the watcher to establish the original on-disk baseline.
+    tokio::time::sleep(Duration::from_millis(750)).await;
+    let epoch = server.runtime.module_epoch().await;
+    config.commands.insert("help".into(), crate::core::PromptCommandConfig {
+        description: "Conflicts with host command".into(),
+        prompt: "Explain the project".into(),
+    });
+    // This exact profile is rejected on cold startup.
+    let cold = AgentAppServer::launch(config.clone(), root.path().into(), None).await;
+    let cold_error = match cold {
+        Ok(handle) => { handle.shutdown().await; None },
+        Err(error) => Some(format!("{error:#}")),
+    };
+    eprintln!("cold launch invalid command profile: {cold_error:?}");
+    assert!(cold_error.as_ref().is_some_and(|e| e.contains("duplicate command: /help")));
+    std::fs::write(&path, toml::to_string(&config).unwrap()).unwrap();
+    tokio::time::sleep(Duration::from_millis(1100)).await;
+    let after_epoch = server.runtime.module_epoch().await;
+    let history = server.execute_command(None, "/history").await;
+    let reload_error = server.profile_error.lock().await.clone();
+    eprintln!("hot reload same invalid profile: epoch {epoch:?} -> {after_epoch:?}; unrelated /history={history:?}; reload_error={reload_error:?}");
+    server.shutdown().await;
+    assert!(history.is_ok(), "invalid replacement profile must preserve the previous working command catalog");
+    assert_eq!(after_epoch, epoch);
+    assert!(reload_error.is_some());
+}

+// Audit-only probe. The existing production watcher is replaced by its
+// repository-provided controlled Polling seam; save/load/publication are real.
+async fn audit_controlled_watch(
+    handle: AppServerHandle,
+    path: PathBuf,
+) -> (AppServerHandle, tokio::sync::mpsc::UnboundedSender<polling::Poll>) {
+    handle.profile_stop.cancel();
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while std::sync::Arc::strong_count(&handle.inner) != 1 {
+            tokio::task::yield_now().await;
+        }
+    }).await.unwrap();
+    let mut state = std::sync::Arc::try_unwrap(handle.inner)
+        .unwrap_or_else(|_| panic!("watcher still owns handle"));
+    state.profile_stop = CancellationToken::new();
+    let handle = AppServerHandle { inner: std::sync::Arc::new(state) };
+    let (polling, sender) = Polling::controlled();
+    start_with_polling(&handle, path, polling).await;
+    (handle, sender)
+}
+
+async fn audit_poll(
+    sender: &tokio::sync::mpsc::UnboundedSender<polling::Poll>,
+    now: Instant,
+) -> polling::PollReport {
+    let (completed, receiver) = tokio::sync::oneshot::channel();
+    sender.send(polling::Poll::controlled(now, completed)).unwrap();
+    tokio::time::timeout(Duration::from_secs(5), receiver).await.unwrap().unwrap()
+}

+#[tokio::test]
+async fn audit_save_after_missing_profile_serializes_resolved_instruction_twice() {
+    use proteus_contracts::app_protocol::http::SetConfigBuilderRequest;
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("profile.toml");
+    std::fs::write(root.path().join("rules.md"), "Keep the fixture answer short.").unwrap();
+    let mut config = crate::test_model::config();
+    config.instructions = vec![serde_json::from_value(serde_json::json!({
+        "kind": "System", "priority": 100, "file": "rules.md"
+    })).unwrap()];
+    std::fs::write(&path, toml::to_string_pretty(&config).unwrap()).unwrap();
+    let loaded = AppConfig::load(Some(&path)).await.unwrap();
+    assert!(loaded.instructions[0].text.is_some());
+    assert!(loaded.instructions[0].file.is_some());
+    let handle = AgentAppServer::launch(loaded, root.path().into(), Some(&path)).await.unwrap();
+    // Control: ordinary Save of an existing file keeps the file reference only.
+    handle.set_profile_config(SetConfigBuilderRequest::default()).await.unwrap();
+    AppConfig::load(Some(&path)).await.unwrap();
+    let existing: toml::Value = toml::from_str(&std::fs::read_to_string(&path).unwrap()).unwrap();
+    assert!(existing["instructions"][0].get("file").is_some());
+    assert!(existing["instructions"][0].get("text").is_none());
+    // Source is gone while a valid live profile still exists, for example after
+    // a mistaken local move/delete. Save advertises recovery by recreating it.
+    std::fs::remove_file(&path).unwrap();
+    let snapshot = handle.set_profile_config(SetConfigBuilderRequest {
+        permission_mode: Some(PermissionMode::Plan),
+        ..Default::default()
+    }).await.unwrap();
+    assert_eq!(snapshot.permission_mode, "plan");
+    assert!(path.is_file());
+    let bytes = std::fs::read_to_string(&path).unwrap();
+    let saved: toml::Value = toml::from_str(&bytes).unwrap();
+    let instruction = &saved["instructions"][0];
+    assert!(instruction.get("text").is_some());
+    assert!(instruction.get("file").is_some());
+    let error = AppConfig::load(Some(&path)).await.unwrap_err();
+    eprintln!("missing-profile save ACK={}; reload error={error:#}; saved instruction={instruction}", snapshot.permission_mode);
+    assert!(format!("{error:#}").contains("either text or file, not both"));
+    let second = handle.set_profile_config(SetConfigBuilderRequest::default()).await;
+    assert!(second.is_err(), "next UI save cannot recover the invalid profile");
+    handle.shutdown().await;
+}

+#[tokio::test]
+async fn audit_external_revert_after_watcher_observed_ui_save_is_applied_control() {
+    use proteus_contracts::app_protocol::http::SetConfigBuilderRequest;
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("config.toml");
+    let mut baseline = crate::test_model::config();
+    baseline.permissions.mode = PermissionMode::Normal;
+    let original = toml::to_string_pretty(&baseline).unwrap();
+    std::fs::write(&path, &original).unwrap();
+    let handle = AgentAppServer::launch(baseline.clone(), root.path().into(), Some(&path)).await.unwrap();
+    let (handle, polls) = audit_controlled_watch(handle, path.clone()).await;
+    let now = Instant::now();
+    audit_poll(&polls, now).await;
+    audit_poll(&polls, now + Duration::from_secs(4)).await;
+    handle.set_profile_config(SetConfigBuilderRequest {
+        permission_mode: Some(PermissionMode::Auto),
+        ..Default::default()
+    }).await.unwrap();
+    audit_poll(&polls, now + Duration::from_secs(8)).await;
+    audit_poll(&polls, now + Duration::from_secs(12)).await;
+    std::fs::write(&path, &original).unwrap();
+    audit_poll(&polls, now + Duration::from_secs(16)).await;
+    let report = audit_poll(&polls, now + Duration::from_secs(20)).await;
+    assert!(report.refresh_attempted);
+    assert_eq!(handle.config.read().await.permissions.mode, PermissionMode::Normal);
+    assert_eq!(handle.permission_mode().await, PermissionMode::Normal);
+    eprintln!("observed save control: disk=Normal; published=Normal; live=Normal");
+    handle.shutdown().await;
+}

+#[tokio::test]
+async fn audit_fast_external_revert_after_ui_save_leaves_live_profile_stale() {
+    use proteus_contracts::app_protocol::http::SetConfigBuilderRequest;
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("config.toml");
+    let mut baseline = crate::test_model::config();
+    baseline.permissions.mode = PermissionMode::Normal;
+    let original = toml::to_string_pretty(&baseline).unwrap();
+    std::fs::write(&path, &original).unwrap();
+    let handle = AgentAppServer::launch(baseline.clone(), root.path().into(), Some(&path)).await.unwrap();
+    let (handle, polls) = audit_controlled_watch(handle, path.clone()).await;
+    let now = Instant::now();
+    audit_poll(&polls, now).await;
+    audit_poll(&polls, now + Duration::from_secs(4)).await;
+    handle.set_profile_config(SetConfigBuilderRequest {
+        permission_mode: Some(PermissionMode::Auto),
+        ..Default::default()
+    }).await.unwrap();
+    let saved_epoch = handle.runtime.module_epoch().await;
+    assert_eq!(handle.permission_mode().await, PermissionMode::Auto);
+    // E.g. editor Undo or git checkout, before watcher observed the UI save.
+    std::fs::write(&path, &original).unwrap();
+    for seconds in [8, 12, 16, 20] {
+        let report = audit_poll(&polls, now + Duration::from_secs(seconds)).await;
+        assert!(report.scanned);
+        assert!(!report.refresh_attempted);
+    }
+    let disk = AppConfig::load(Some(&path)).await.unwrap().permissions.mode;
+    let published = handle.config.read().await.permissions.mode;
+    let live = handle.permission_mode().await;
+    eprintln!("fast revert: disk={disk:?}; published={published:?}; live={live:?}; reload_error={:?}", handle.profile_error.lock().await);
+    assert_eq!(disk, PermissionMode::Normal);
+    assert_eq!(published, PermissionMode::Auto);
+    assert_eq!(live, PermissionMode::Auto);
+    assert_eq!(handle.runtime.module_epoch().await, saved_epoch);
+    assert!(handle.profile_error.lock().await.is_none());
+    handle.shutdown().await;
+}

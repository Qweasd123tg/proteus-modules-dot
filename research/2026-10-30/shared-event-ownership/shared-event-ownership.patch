diff --git a/crates/proteus-core/src/app_server/events/shared_tests.rs b/crates/proteus-core/src/app_server/events/shared_tests.rs
new file mode 100644
index 0000000..0ab2eb1
--- /dev/null
+++ b/crates/proteus-core/src/app_server/events/shared_tests.rs
@@ -0,0 +1,114 @@
+use super::*;
+
+#[test]
+fn raw_and_sequenced_rings_share_one_payload() {
+    let (publisher, mut raw) = test_event_channel(2);
+    let mut sequenced = publisher.0.sequenced.subscribe();
+    publisher
+        .send(AppServerEvent::Error {
+            message: "shared".into(),
+        })
+        .unwrap();
+    let raw = raw.try_recv().unwrap();
+    let sequenced = sequenced.try_recv().unwrap();
+    assert!(Arc::ptr_eq(&raw, &sequenced.event));
+}
+
+#[test]
+fn snapshot_publication_shares_one_payload() {
+    let (publisher, mut raw) = test_event_channel(2);
+    let mut sequenced = publisher.0.sequenced.subscribe();
+    publisher.publish_snapshot().unwrap();
+    let raw = raw.try_recv().unwrap();
+    let sequenced = sequenced.try_recv().unwrap();
+    assert!(matches!(
+        raw.as_ref(),
+        AppServerEvent::SessionSnapshot { .. }
+    ));
+    assert!(Arc::ptr_eq(&raw, &sequenced.event));
+}
+
+#[test]
+fn failed_raw_send_returns_the_payload_retained_by_sequenced_ring() {
+    let (publisher, raw) = test_event_channel(2);
+    drop(raw);
+    let mut sequenced = publisher.0.sequenced.subscribe();
+    let error = publisher.send(AppServerEvent::Shutdown).unwrap_err();
+    assert!(Arc::ptr_eq(&error.0, &sequenced.try_recv().unwrap().event));
+    drop(sequenced);
+    let error = publisher.send(AppServerEvent::Shutdown).unwrap_err();
+    assert_eq!(Arc::strong_count(&error.0), 1);
+    assert!(matches!(
+        Arc::try_unwrap(error.0).unwrap(),
+        AppServerEvent::Shutdown
+    ));
+}
+
+#[test]
+fn raw_only_delivery_preserves_lag_and_releases_evicted_payload() {
+    let (publisher, mut raw) = test_event_channel(1);
+    publisher.send(AppServerEvent::Shutdown).unwrap();
+    let first = raw.try_recv().unwrap();
+    let weak = Arc::downgrade(&first);
+    drop(first);
+    publisher.send(AppServerEvent::Shutdown).unwrap();
+    publisher.send(AppServerEvent::Shutdown).unwrap();
+    assert!(weak.upgrade().is_none());
+    assert!(matches!(
+        raw.try_recv(),
+        Err(broadcast::error::TryRecvError::Lagged(1))
+    ));
+    assert!(matches!(
+        raw.try_recv().unwrap().as_ref(),
+        AppServerEvent::Shutdown
+    ));
+}
+
+#[tokio::test]
+async fn owned_delivery_is_independent_and_covered_shutdown_is_not_filtered() {
+    let (publisher, mut raw) = test_event_channel(8);
+    let mut subscription = publisher.subscribe_session();
+    subscription.recv().await.unwrap(); // Initial pending projection.
+    subscription.recv().await.unwrap(); // Initial session baseline.
+    publisher
+        .send(AppServerEvent::Error {
+            message: "original".into(),
+        })
+        .unwrap();
+    let retained = raw.try_recv().unwrap();
+    let AppServerEvent::Error { mut message } = subscription.recv().await.unwrap() else {
+        panic!("owned error");
+    };
+    message.push_str(" changed");
+    assert!(
+        matches!(retained.as_ref(), AppServerEvent::Error { message } if message == "original")
+    );
+    // Explicitly put a covered event before Shutdown at the same sequence.
+    let seq = subscription.seq;
+    assert!(
+        publisher
+            .0
+            .sequenced
+            .send(SequencedEvent {
+                seq,
+                event: Arc::new(AppServerEvent::Error {
+                    message: "covered".into()
+                }),
+            })
+            .is_ok()
+    );
+    assert!(
+        publisher
+            .0
+            .sequenced
+            .send(SequencedEvent {
+                seq,
+                event: Arc::new(AppServerEvent::Shutdown),
+            })
+            .is_ok()
+    );
+    assert!(matches!(
+        subscription.recv().await.unwrap(),
+        AppServerEvent::Shutdown
+    ));
+}

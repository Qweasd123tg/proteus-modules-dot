diff --git a/components/module-runtime/src/exports/workflow_tests.rs b/components/module-runtime/src/exports/workflow_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d7d4f23f594ef5b76324899058bbd30b24cafe28
--- /dev/null
+++ b/components/module-runtime/src/exports/workflow_tests.rs
@@ -0,0 +1,213 @@
+use std::sync::{Arc, Mutex};
+
+use proteus_contracts::{
+    contracts::{
+        PROCESS_WORKFLOW_CONTRACT_VERSION, ProcessModuleComposition, ProcessWorkflowRuntimeInfo,
+        WorkflowFailure, WorkflowHistoryUpdate,
+    },
+    domain::{AgentOutput, AgentTask, PermissionMode, ReasoningConfig, new_execution_id},
+    model_standard::{CanonicalMessage, ContentPart, MessageRole, ModelFailure, ModelFailureKind},
+    process_module::{WorkflowModule, WorkflowModuleOutput},
+};
+use serde_json::json;
+
+use super::*;
+
+mod host;
+use host::NoHost;
+
+struct Probe {
+    seen: Arc<Mutex<Vec<WorkflowModuleInput>>>,
+    result: Mutex<Option<Result<WorkflowModuleOutput, WorkflowFailure>>>,
+}
+
+impl WorkflowModule for Probe {
+    fn run(
+        &self,
+        input: WorkflowModuleInput,
+        _host: &mut dyn WorkflowModuleHost,
+    ) -> Result<WorkflowModuleOutput, WorkflowFailure> {
+        self.seen.lock().unwrap().push(input);
+        self.result.lock().unwrap().take().expect("one invocation")
+    }
+}
+
+fn fixture(
+    result: Result<WorkflowModuleOutput, WorkflowFailure>,
+) -> (ModuleExport, Arc<Mutex<Vec<WorkflowModuleInput>>>) {
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let mut modules = CollectedModules::default();
+    modules.workflows.insert(
+        "probe".into(),
+        Box::new(Probe {
+            seen: Arc::clone(&seen),
+            result: Mutex::new(Some(result)),
+        }),
+    );
+    let binding = ProcessComponentExportInitialize::new(
+        "workflow",
+        "probe",
+        PROCESS_WORKFLOW_CONTRACT_VERSION,
+        ProcessModuleComposition::SelectOne,
+        json!({"selected_export": true}),
+        std::iter::empty::<String>(),
+    );
+    (ModuleExport::new(binding, modules, None), seen)
+}
+
+fn input() -> ProcessWorkflowInput {
+    ProcessWorkflowInput {
+        task: AgentTask::new("owned task", ".".into()),
+        history: vec![CanonicalMessage::text(MessageRole::User, "owned history")],
+        runtime: ProcessWorkflowRuntimeInfo {
+            execution_id: new_execution_id(),
+            conversation: None,
+            model_ref: None,
+            model_context: Vec::new(),
+            interrupted_turns: Vec::new(),
+            instructions: Vec::new(),
+            intent: None,
+            continuation: None,
+            permission_mode: PermissionMode::Normal,
+            reasoning: ReasoningConfig::default(),
+            max_input_tokens: None,
+            model_timeout_ms: 1000,
+            context_timeout_ms: 1000,
+            workflow_timeout_ms: 0,
+        },
+    }
+}
+
+fn output() -> WorkflowModuleOutput {
+    WorkflowModuleOutput {
+        output: AgentOutput::new("done", json!({})),
+        new_messages: vec![CanonicalMessage::text(MessageRole::Assistant, "done")],
+        history_replacement: None,
+        compactions: Vec::new(),
+    }
+}
+
+#[test]
+fn helper_receives_owned_input_and_only_the_bound_export_config() {
+    let expected = input();
+    let params = serde_json::to_value(&expected).unwrap();
+    let task_pointer = params["task"]["text"].as_str().unwrap().as_ptr();
+    let (export, seen) = fixture(Ok(output()));
+    let response = export.workflow(params, &mut NoHost).unwrap();
+    assert_eq!(response["status"], "success");
+    let seen = seen.lock().unwrap();
+    assert_eq!(seen.len(), 1);
+    assert_eq!(seen[0].task, expected.task);
+    assert_eq!(seen[0].history, expected.history);
+    assert_eq!(seen[0].runtime, expected.runtime);
+    assert_eq!(seen[0].config, json!({"selected_export": true}));
+    assert_eq!(seen[0].task.text.as_ptr(), task_pointer);
+}
+
+#[test]
+fn process_decode_stays_strict_before_helper_invocation() {
+    let valid = serde_json::to_value(input()).unwrap();
+    let mut malformed = vec![{
+        let mut value = valid.clone();
+        value["config"] = json!({"cannot_override_binding": true});
+        value
+    }];
+    for field in ["conversation", "model_ref", "continuation"] {
+        let mut value = valid.clone();
+        value["runtime"].as_object_mut().unwrap().remove(field);
+        malformed.push(value);
+    }
+    let mut missing_history = valid;
+    missing_history.as_object_mut().unwrap().remove("history");
+    malformed.push(missing_history);
+    for params in malformed {
+        let (export, seen) = fixture(Ok(output()));
+        assert!(export.workflow(params, &mut NoHost).is_err());
+        assert!(seen.lock().unwrap().is_empty());
+    }
+}
+
+#[test]
+fn history_replacement_option_is_not_collapsed() {
+    for replacement in [None, Some(Vec::new())] {
+        let mut expected = output();
+        expected.history_replacement = replacement.clone();
+        let (export, _) = fixture(Ok(expected.clone()));
+        let response = export
+            .workflow(serde_json::to_value(input()).unwrap(), &mut NoHost)
+            .unwrap();
+        let ProcessWorkflowResponse::Success { result } = serde_json::from_value(response).unwrap()
+        else {
+            panic!("expected successful envelope")
+        };
+        assert_eq!(result.history_replacement, replacement);
+        assert_eq!(result.new_messages, expected.new_messages);
+        assert_eq!(result.compactions, expected.compactions);
+    }
+}
+
+#[test]
+fn algorithm_failure_preserves_explicit_history_and_model_cause() {
+    let completed = CanonicalMessage::text(MessageRole::Assistant, "completed before failure");
+    let model_failure = ModelFailure::new(ModelFailureKind::StreamDisconnected, "stream lost")
+        .with_completed_messages(vec![completed.clone()]);
+    let expected = WorkflowFailure {
+        message: "workflow stopped".into(),
+        history: Some(
+            WorkflowHistoryUpdate::new(vec![completed]).with_history_replacement(Vec::new()),
+        ),
+        model_failure: Some(model_failure),
+    };
+    let (export, _) = fixture(Err(expected.clone()));
+    let response = export
+        .workflow(serde_json::to_value(input()).unwrap(), &mut NoHost)
+        .unwrap();
+    assert_eq!(
+        serde_json::from_value::<ProcessWorkflowResponse>(response).unwrap(),
+        ProcessWorkflowResponse::failed(expected),
+    );
+}
+
+#[test]
+fn helper_no_longer_imposes_a_text_parser_depth_limit() {
+    let mut expected = output();
+    let mut metadata = Value::Null;
+    for _ in 0..160 {
+        metadata = Value::Array(vec![metadata]);
+    }
+    expected.output.metadata = metadata.clone();
+    // Characterize the removed helper parse, not the actual transport parser.
+    let old_text = serde_json::to_string(&expected).unwrap();
+    assert!(serde_json::from_str::<WorkflowModuleOutput>(&old_text).is_err());
+    let (export, _) = fixture(Ok(expected));
+    let response = export
+        .workflow(serde_json::to_value(input()).unwrap(), &mut NoHost)
+        .unwrap();
+    assert_eq!(response["result"]["output"]["metadata"], metadata);
+    // The real wire reader remains strict; typed helper acceptance is not a
+    // promise that this deliberately oversized nesting can cross that boundary.
+    assert!(serde_json::from_str::<Value>(&serde_json::to_string(&response).unwrap()).is_err());
+}
+
+#[cfg(unix)]
+#[test]
+fn unencodable_output_path_is_a_transport_error_not_an_algorithm_failure() {
+    use std::{ffi::OsString, os::unix::ffi::OsStringExt, path::PathBuf};
+
+    let mut expected = output();
+    expected.new_messages = vec![CanonicalMessage::new(
+        MessageRole::Assistant,
+        vec![ContentPart::FileRef {
+            path: PathBuf::from(OsString::from_vec(vec![0xff])),
+            content: None,
+        }],
+    )];
+    // Previously workflows.rs mapped this encoding error to WorkflowFailure.
+    assert!(serde_json::to_string(&expected).is_err());
+    let (export, seen) = fixture(Ok(expected));
+    let error = export
+        .workflow(serde_json::to_value(input()).unwrap(), &mut NoHost)
+        .unwrap_err();
+    assert!(error.downcast_ref::<serde_json::Error>().is_some());
+    assert_eq!(seen.lock().unwrap().len(), 1);
+}

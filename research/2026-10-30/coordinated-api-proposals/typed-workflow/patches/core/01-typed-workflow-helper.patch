index 0000000000000000000000000000000000000000..aad78a8ee05c97c0cb8fe0cdab488937b392e1fb
--- /dev/null
+++ b/crates/proteus-contracts/src/process_module/workflow_tests.rs
@@ -0,0 +1,76 @@
+use super::*;
+use crate::{
+    domain::ContextChunk,
+    model_standard::{ContentPart, MessageRole},
+};
+use serde_json::{Value, json};
+
+fn output() -> WorkflowModuleOutput {
+    WorkflowModuleOutput {
+        output: AgentOutput::new("done", Value::Null),
+        new_messages: Vec::new(),
+        history_replacement: None,
+        compactions: Vec::new(),
+    }
+}
+
+#[test]
+fn typed_output_does_not_normalize_nonfinite_optional_scores() {
+    for score in [f32::NAN, f32::INFINITY, f32::NEG_INFINITY] {
+        let mut typed = output();
+        typed.new_messages.push(CanonicalMessage::new(
+            MessageRole::Assistant,
+            vec![ContentPart::Context {
+                chunk: ContextChunk::new("probe", "context").with_score(score),
+            }],
+        ));
+        let old_text = serde_json::to_string(&typed).unwrap();
+        let old_normalized: WorkflowModuleOutput = serde_json::from_str(&old_text).unwrap();
+        let ContentPart::Context { chunk } = &typed.new_messages[0].parts[0].payload else {
+            panic!("context")
+        };
+        assert!(!chunk.score.unwrap().is_finite());
+        let ContentPart::Context { chunk } = &old_normalized.new_messages[0].parts[0].payload
+        else {
+            panic!("context")
+        };
+        assert_eq!(chunk.score, None);
+        // Actual JSON encoding still normalizes the score to null. Typed helper
+        // values are not automatically valid root history; domain validation
+        // remains the host's responsibility and is not exercised by this fixture.
+        assert_eq!(
+            serde_json::to_value(typed).unwrap(),
+            serde_json::to_value(old_normalized).unwrap(),
+        );
+    }
+}
+
+#[test]
+fn serde_defaults_and_explicit_empty_replacement_remain_distinct() {
+    let minimal = json!({"output": {"text": "done", "metadata": null}});
+    let decoded: WorkflowModuleOutput = serde_json::from_value(minimal).unwrap();
+    assert!(decoded.new_messages.is_empty());
+    assert!(decoded.compactions.is_empty());
+    assert_eq!(decoded.history_replacement, None);
+    let mut value = serde_json::to_value(decoded).unwrap();
+    assert!(value.get("history_replacement").is_none());
+    value["history_replacement"] = json!([]);
+    let explicit: WorkflowModuleOutput = serde_json::from_value(value).unwrap();
+    assert_eq!(explicit.history_replacement, Some(Vec::new()));
+}
+
+#[test]
+fn explicit_serde_readers_stay_strict_but_are_not_a_helper_stage() {
+    let mut value = serde_json::to_value(output()).unwrap();
+    value["unknown"] = json!(true);
+    assert!(serde_json::from_value::<WorkflowModuleOutput>(value).is_err());
+
+    let malformed = json!({"output": {"text": [], "metadata": null}});
+    let old_text_error =
+        serde_json::from_str::<WorkflowModuleOutput>(&serde_json::to_string(&malformed).unwrap())
+            .unwrap_err();
+    let value_error = serde_json::from_value::<WorkflowModuleOutput>(malformed).unwrap_err();
+    assert!(old_text_error.line() > 0);
+    assert_eq!(value_error.line(), 0);
+    assert_eq!(value_error.column(), 0);
+}

+use proteus_contracts::{
+    contracts::{
+        ExecutionAttribution, PROCESS_TOOL_CONTRACT_VERSION, PROCESS_TOOL_INVOKE_METHOD,
+        PROCESS_TOOL_LIST_METHOD, ProcessToolInvokeInput,
+    },
+    domain::{ToolCall, new_execution_id},
+    process_module::{ProcessModuleResult, ToolModule, ToolModuleHost, ToolModuleInvocationContext},
+};
+use serde_json::json;
+
+use super::*;
+
+struct NoHost;
+
+impl ToolModuleHost for NoHost {
+    fn is_cancelled(&self) -> ProcessModuleResult<bool> {
+        Ok(false)
+    }
+}
+
+fn binding() -> ProcessComponentExportInitialize {
+    let authority = process_contract_authority("tool", PROCESS_TOOL_CONTRACT_VERSION).unwrap();
+    ProcessComponentExportInitialize::new(
+        "tool",
+        "plan_tool",
+        PROCESS_TOOL_CONTRACT_VERSION,
+        authority.composition,
+        json!({"opaque": "preserved"}),
+        ["unknown.optional.feature"],
+    )
+}
+
+#[test]
+fn factory_admits_only_the_explicit_plan_identity_and_contract() {
+    for (slot, id) in [
+        ("policy", "plan_tool"),
+        ("tool", "reference.tools"),
+        ("tool", "file_tools"),
+        ("tool", "Plan_tool"),
+    ] {
+        let mut binding = binding();
+        binding.slot = slot.into();
+        binding.module_id = id.into();
+        assert!(PlanExport::load(binding).is_err());
+    }
+    let mut wrong_version = binding();
+    wrong_version.contract_version = "unknown".into();
+    assert!(PlanExport::load(wrong_version).is_err());
+}
+
+#[test]
+fn manifest_and_catalog_match_the_existing_plan_registration() {
+    let binding = binding();
+    let export = PlanExport::load(binding.clone()).unwrap();
+    assert_eq!(
+        export.manifest(),
+        ProcessComponentExportManifest {
+            slot: binding.slot,
+            module_id: binding.module_id,
+            contract_version: binding.contract_version,
+            composition: binding.composition,
+            module_features: Vec::new(),
+            config_schema: Some(ModuleConfigSchema::default()),
+        }
+    );
+    let response = export
+        .tools
+        .invoke(
+            PROCESS_TOOL_LIST_METHOD,
+            Value::Null,
+            &export.binding.module_config,
+            &mut NoHost,
+        )
+        .unwrap();
+    let tool = plan_tool::PlanTool;
+    let expected: Value = serde_json::from_str(&tool.spec_json()).unwrap();
+    assert_eq!(response["result"].as_array().unwrap().len(), 1);
+    assert_eq!(response["result"][0]["spec"], expected);
+    assert_eq!(response["result"][0]["model_visible"], tool.model_visible());
+    assert_eq!(
+        response["result"][0]["user_command"],
+        serde_json::to_value(tool.user_command()).unwrap()
+    );
+}
+
+#[test]
+fn shared_adapter_preserves_plan_domain_results_and_legacy_validation() {
+    let export = PlanExport::load(binding()).unwrap();
+    for args in [
+        json!({"plan": []}),
+        json!({"plan": [
+            {"step": "", "status": "in_progress"},
+            {"step": "next", "status": "in_progress"}
+        ]}),
+        json!({"explanation": "done", "plan": [{"step": "read", "status": "completed"}]}),
+        json!({"plan": [{"step": "bad status", "status": "done"}]}),
+        json!({"plan": [], "unexpected": true}),
+    ] {
+        let mut input = ProcessToolInvokeInput {
+            call: ToolCall::new("plan-call", "update_plan", args),
+            cwd: std::path::PathBuf::from("workspace"),
+            attribution: ExecutionAttribution::detached(new_execution_id()),
+            skills: Default::default(),
+        };
+        // Deliberately contradictory raw input: the legacy module consumes
+        // call.args, and the adapter must not silently normalize it differently.
+        input.call.raw_arguments = Some("{not normalized here".into());
+        let context = ToolModuleInvocationContext {
+            cwd: input.cwd.clone(),
+            attribution: input.attribution,
+            skills: input.skills.clone(),
+            config: export.binding.module_config.clone(),
+        };
+        let expected: Value = serde_json::from_str(
+            &plan_tool::PlanTool
+                .invoke_json(
+                    serde_json::to_string(&input.call).unwrap(),
+                    serde_json::to_string(&context).unwrap(),
+                    &mut NoHost,
+                )
+                .unwrap(),
+        )
+        .unwrap();
+        let actual = export
+            .tools
+            .invoke(
+                PROCESS_TOOL_INVOKE_METHOD,
+                serde_json::to_value(input).unwrap(),
+                &export.binding.module_config,
+                &mut NoHost,
+            )
+            .unwrap();
+        assert_eq!(actual["result"], expected);
+    }
+}

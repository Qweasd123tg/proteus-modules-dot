+use anyhow::{Result, anyhow, bail};
+use proteus_contracts::{
+    contracts::{ProcessComponentExportInitialize, ProcessComponentExportManifest},
+    domain::ModuleConfigSchema,
+};
+use proteus_module_sdk::{
+    Export,
+    hosts::{HostBridge, ToolHostBridge},
+    protocol::process_contract_authority,
+};
+use proteus_tool_adapter::{ToolAdapter, collect_tools};
+use serde_json::Value;
+
+fn main() {
+    if let Err(error) = run() {
+        eprintln!("proteus-plan-module: {error:#}");
+        std::process::exit(1);
+    }
+}
+
+fn run() -> Result<()> {
+    let args = std::env::args_os().collect::<Vec<_>>();
+    if args.len() == 2 && args[1] == "--version" {
+        println!("proteus-plan-module {}", env!("CARGO_PKG_VERSION"));
+        return Ok(());
+    }
+    if args.len() != 1 {
+        bail!("usage: proteus-plan-module [--version]");
+    }
+    proteus_module_sdk::run(|binding| Ok(Box::new(PlanExport::load(binding)?)))
+}
+
+struct PlanExport {
+    binding: ProcessComponentExportInitialize,
+    tools: ToolAdapter,
+}
+
+impl PlanExport {
+    fn load(binding: ProcessComponentExportInitialize) -> Result<Self> {
+        if (binding.slot.as_str(), binding.module_id.as_str()) != ("tool", "plan_tool") {
+            bail!(
+                "plan module has no {} module {:?}",
+                binding.slot,
+                binding.module_id
+            );
+        }
+        process_contract_authority(&binding.slot, &binding.contract_version)
+            .ok_or_else(|| anyhow!("unsupported tool contract {}", binding.contract_version))?;
+        let tools = collect_tools(binding.module_config.clone(), plan_tool::register_modules)?;
+        Ok(Self {
+            binding,
+            tools: ToolAdapter::new(tools),
+        })
+    }
+}
+
+impl Export for PlanExport {
+    fn manifest(&self) -> ProcessComponentExportManifest {
+        let authority =
+            process_contract_authority(&self.binding.slot, &self.binding.contract_version)
+                .expect("validated process authority");
+        ProcessComponentExportManifest {
+            slot: self.binding.slot.clone(),
+            module_id: self.binding.module_id.clone(),
+            contract_version: self.binding.contract_version.clone(),
+            composition: authority.composition,
+            module_features: Vec::new(),
+            config_schema: Some(ModuleConfigSchema::default()),
+        }
+    }
+
+    fn invoke(&self, method: &str, params: Value, bridge: &HostBridge) -> Result<Value> {
+        let authority =
+            process_contract_authority(&self.binding.slot, &self.binding.contract_version)
+                .expect("validated process authority");
+        if !authority.allows_module_method(method) {
+            bail!(
+                "method {method:?} is not allowed for slot {}",
+                self.binding.slot
+            );
+        }
+        self.tools.invoke(
+            method,
+            params,
+            &self.binding.module_config,
+            &mut ToolHostBridge(bridge.clone()),
+        )
+    }
+}
+
+#[cfg(test)]
+mod tests;

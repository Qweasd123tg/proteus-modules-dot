+use anyhow::Result;
+use proteus_contracts::process_module::{
+    ContextBuilderModuleObject, ContextProviderModuleObject, HookModuleObject, ModelModuleObject,
+    ModuleRegistry, PolicyModuleObject, ProcessModuleError, ProcessModuleResult, ToolModuleObject,
+    WorkflowModuleObject,
+};
+use serde_json::Value;
+
+/// Use an implementation's existing registration function without linking an
+/// aggregate registry. This collector admits only tool-only implementations.
+pub fn collect_tools(
+    module_config: Value,
+    register: fn(&mut dyn ModuleRegistry) -> ProcessModuleResult<()>,
+) -> Result<Vec<ToolModuleObject>> {
+    let mut registry = ToolRegistry {
+        module_config,
+        tools: Vec::new(),
+    };
+    register(&mut registry)?;
+    Ok(registry.tools)
+}
+
+struct ToolRegistry {
+    module_config: Value,
+    tools: Vec<ToolModuleObject>,
+}
+
+fn unsupported(slot: &str) -> ProcessModuleResult<()> {
+    Err(ProcessModuleError::new(format!(
+        "tool-only component cannot register {slot}"
+    )))
+}
+
+impl ModuleRegistry for ToolRegistry {
+    fn module_config(&self) -> &Value {
+        &self.module_config
+    }
+
+    fn register_tool(&mut self, tool: ToolModuleObject) -> ProcessModuleResult<()> {
+        self.tools.push(tool);
+        Ok(())
+    }
+
+    fn register_model(
+        &mut self,
+        _module_id: String,
+        _model: ModelModuleObject,
+    ) -> ProcessModuleResult<()> {
+        unsupported("model")
+    }
+
+    fn register_policy(
+        &mut self,
+        _module_id: String,
+        _policy: PolicyModuleObject,
+    ) -> ProcessModuleResult<()> {
+        unsupported("policy")
+    }
+
+    fn register_context_provider(
+        &mut self,
+        _provider_id: String,
+        _provider: ContextProviderModuleObject,
+    ) -> ProcessModuleResult<()> {
+        unsupported("context_provider")
+    }
+
+    fn register_context(
+        &mut self,
+        _module_id: String,
+        _builder: ContextBuilderModuleObject,
+    ) -> ProcessModuleResult<()> {
+        unsupported("context")
+    }
+
+    fn register_hook(
+        &mut self,
+        _module_id: String,
+        _hook: HookModuleObject,
+    ) -> ProcessModuleResult<()> {
+        unsupported("hook")
+    }
+
+    fn register_workflow(
+        &mut self,
+        _module_id: String,
+        _workflow: WorkflowModuleObject,
+    ) -> ProcessModuleResult<()> {
+        unsupported("workflow")
+    }
+}

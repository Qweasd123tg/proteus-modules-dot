+use std::sync::{Arc, Mutex};
+
+use proteus_contracts::{
+    contracts::{
+        ExecutionAttribution, PROCESS_TOOL_INVOKE_METHOD, PROCESS_TOOL_LIST_METHOD,
+        ProcessToolInvokeInput,
+    },
+    domain::{ToolCall, ToolResult, ToolSafety, ToolSpec, new_execution_id},
+    process_module::{
+        HookModule, HookModuleHostMut, ModuleRegistry, ProcessModuleError, ProcessModuleResult,
+        ToolModule, ToolModuleHost, ToolModuleInvocationContext,
+    },
+};
+use serde_json::{Value, json};
+
+use super::{ToolAdapter, collect_tools};
+
+type CapturedCalls = Arc<Mutex<Vec<(Value, Value, bool)>>>;
+
+struct Probe {
+    calls: CapturedCalls,
+    output: Result<String, ProcessModuleError>,
+}
+
+impl ToolModule for Probe {
+    fn spec_json(&self) -> String {
+        serde_json::to_string(&ToolSpec::new(
+            "probe",
+            "adapter probe",
+            json!({"type": "object"}),
+            ToolSafety::ReadOnly,
+        ))
+        .unwrap()
+    }
+
+    fn invoke_json(
+        &self,
+        call: String,
+        context: String,
+        host: &mut dyn ToolModuleHost,
+    ) -> ProcessModuleResult<String> {
+        self.calls.lock().unwrap().push((
+            serde_json::from_str(&call).unwrap(),
+            serde_json::from_str(&context).unwrap(),
+            host.is_cancelled()?,
+        ));
+        self.output.clone()
+    }
+}
+
+struct Host;
+
+impl ToolModuleHost for Host {
+    fn is_cancelled(&self) -> ProcessModuleResult<bool> {
+        Ok(true)
+    }
+}
+
+fn input(name: &str) -> ProcessToolInvokeInput {
+    ProcessToolInvokeInput {
+        call: ToolCall::new("call-probe", name, json!({"value": 7})),
+        cwd: std::path::PathBuf::from("workspace"),
+        attribution: ExecutionAttribution::detached(new_execution_id()),
+        skills: Default::default(),
+    }
+}
+
+fn adapter(output: Result<String, ProcessModuleError>) -> (ToolAdapter, CapturedCalls) {
+    let calls = Arc::new(Mutex::new(Vec::new()));
+    (
+        ToolAdapter::new(vec![Box::new(Probe {
+            calls: Arc::clone(&calls),
+            output,
+        })]),
+        calls,
+    )
+}
+
+#[test]
+fn invocation_preserves_raw_arguments_context_result_and_host() {
+    // The shared adapter must not acquire typed SDK ToolExport validation:
+    // Core remains responsible for input validation and output identity.
+    let result = ToolResult::ok("legacy-result-id".into(), "legacy output");
+    let (adapter, calls) = adapter(Ok(serde_json::to_string(&result).unwrap()));
+    let mut input = input("probe");
+    input.call.raw_arguments = Some("{not parsed by this adapter".into());
+    let config = json!({"opaque": {"value": 3}});
+    let expected_call = serde_json::to_value(&input.call).unwrap();
+    let expected_context = serde_json::to_value(ToolModuleInvocationContext {
+        cwd: input.cwd.clone(),
+        attribution: input.attribution,
+        skills: input.skills.clone(),
+        config: config.clone(),
+    })
+    .unwrap();
+
+    let response = adapter
+        .invoke(
+            PROCESS_TOOL_INVOKE_METHOD,
+            serde_json::to_value(input).unwrap(),
+            &config,
+            &mut Host,
+        )
+        .unwrap();
+    assert_eq!(response["result"], serde_json::to_value(result).unwrap());
+    assert_eq!(
+        *calls.lock().unwrap(),
+        vec![(expected_call, expected_context, true)]
+    );
+}
+
+#[test]
+fn list_requires_null_and_invocation_keeps_exact_name_errors() {
+    let (adapter, calls) = adapter(Ok("null".into()));
+    let list = adapter
+        .invoke(PROCESS_TOOL_LIST_METHOD, Value::Null, &json!({}), &mut Host)
+        .unwrap();
+    assert_eq!(list["result"][0]["spec"]["name"], "probe");
+    assert_eq!(
+        adapter
+            .invoke(PROCESS_TOOL_LIST_METHOD, json!({}), &json!({}), &mut Host)
+            .unwrap_err()
+            .to_string(),
+        "tool list params must be null"
+    );
+    for name in ["Probe", " probe", "probe ", "missing"] {
+        assert_eq!(
+            adapter
+                .invoke(
+                    PROCESS_TOOL_INVOKE_METHOD,
+                    serde_json::to_value(input(name)).unwrap(),
+                    &json!({}),
+                    &mut Host,
+                )
+                .unwrap_err()
+                .to_string(),
+            format!("tool module does not provide {name}")
+        );
+    }
+    assert!(calls.lock().unwrap().is_empty());
+}
+
+#[test]
+fn module_failures_and_malformed_results_stay_errors() {
+    let (failed, _) = adapter(Err(ProcessModuleError::new("probe failed")));
+    assert_eq!(
+        failed
+            .invoke(
+                PROCESS_TOOL_INVOKE_METHOD,
+                serde_json::to_value(input("probe")).unwrap(),
+                &json!({}),
+                &mut Host,
+            )
+            .unwrap_err()
+            .to_string(),
+        "probe failed"
+    );
+    let (malformed, _) = adapter(Ok("{".into()));
+    assert!(
+        malformed
+            .invoke(
+                PROCESS_TOOL_INVOKE_METHOD,
+                serde_json::to_value(input("probe")).unwrap(),
+                &json!({}),
+                &mut Host,
+            )
+            .is_err()
+    );
+    assert!(
+        malformed
+            .invoke(PROCESS_TOOL_INVOKE_METHOD, json!({}), &json!({}), &mut Host)
+            .is_err()
+    );
+}
+
+struct HookProbe;
+
+impl HookModule for HookProbe {
+    fn invoke_json(
+        &self,
+        _input_json: String,
+        _host: &mut HookModuleHostMut<'_>,
+    ) -> ProcessModuleResult<String> {
+        unreachable!("collector must not invoke registrations")
+    }
+}
+
+#[test]
+fn registration_passes_config_and_does_not_admit_other_slots() {
+    fn register(registry: &mut dyn ModuleRegistry) -> ProcessModuleResult<()> {
+        assert_eq!(registry.module_config(), &json!({"probe": true}));
+        registry.register_hook("hook.probe".into(), Box::new(HookProbe))
+    }
+    let error = collect_tools(json!({"probe": true}), register)
+        .err()
+        .expect("tool-only collector rejects non-tool registration");
+    assert_eq!(
+        error.to_string(),
+        "tool-only component cannot register hook"
+    );
+}

+//! Shared adapter for existing registered tools, not a new runtime or ABI.
+//! The caller retains slot authority checks and supplies the invocation host.
+
+use anyhow::{Result, anyhow, bail};
+use proteus_contracts::{
+    contracts::{
+        PROCESS_TOOL_INVOKE_METHOD, PROCESS_TOOL_LIST_METHOD, ProcessToolInvokeInput,
+        ProcessToolInvokeResponse, ProcessToolListResponse,
+    },
+    process_module::{ToolModuleHost, ToolModuleInvocationContext, ToolModuleObject},
+};
+use serde_json::Value;
+
+mod catalog;
+mod registry;
+
+pub use registry::collect_tools;
+
+use catalog::ToolCatalog;
+
+/// One independent catalog and implementation set for one loaded tool export.
+pub struct ToolAdapter {
+    tools: Vec<ToolModuleObject>,
+    catalog: ToolCatalog,
+}
+
+impl ToolAdapter {
+    pub fn new(tools: Vec<ToolModuleObject>) -> Self {
+        let catalog = ToolCatalog::new(&tools);
+        Self { tools, catalog }
+    }
+
+    pub fn invoke(
+        &self,
+        method: &str,
+        params: Value,
+        module_config: &Value,
+        host: &mut dyn ToolModuleHost,
+    ) -> Result<Value> {
+        match method {
+            PROCESS_TOOL_LIST_METHOD => {
+                if !params.is_null() {
+                    bail!("tool list params must be null");
+                }
+                Ok(serde_json::to_value(ProcessToolListResponse::new(
+                    self.catalog.definitions()?,
+                ))?)
+            }
+            PROCESS_TOOL_INVOKE_METHOD => {
+                let input: ProcessToolInvokeInput = serde_json::from_value(params)?;
+                let index = self
+                    .catalog
+                    .index(&input.call.name)
+                    .ok_or_else(|| anyhow!("tool module does not provide {}", input.call.name))?;
+                let tool = &self.tools[index];
+                let call_json = serde_json::to_string(&input.call)?;
+                let context_json = serde_json::to_string(&ToolModuleInvocationContext {
+                    cwd: input.cwd,
+                    attribution: input.attribution,
+                    skills: input.skills,
+                    config: module_config.clone(),
+                })?;
+                let output = tool.invoke_json(call_json, context_json, host)?;
+                let result = serde_json::from_str(output.as_str())?;
+                Ok(serde_json::to_value(ProcessToolInvokeResponse::new(result))?)
+            }
+            _ => bail!("unsupported tool method {method:?}"),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests;
